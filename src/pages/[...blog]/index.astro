---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';

import SiteLayout from '~/components/site/SiteLayout.astro';
import Image from '~/components/common/Image.astro';
import ShareBar from '~/components/site/ShareBar.astro';
import PostCard from '~/components/site/PostCard.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots, fetchPosts } from '~/utils/blog';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';
import type { MetaData } from '~/types';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(image
        ? {
            images: [
              {
                url: image,
                // Copertine da public/ (Pages CMS): formato richiesto 1200x675
                width: (image as ImageMetadata)?.width ?? 1200,
                height: (image as ImageMetadata)?.height ?? 675,
                alt: post.title,
              },
            ],
          }
        : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;

// Continua a leggere: prima stessa categoria, poi tag in comune, poi i più recenti
const tagSlugs = new Set((post.tags ?? []).map((t) => t.slug));
const related = (await fetchPosts())
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    p,
    score:
      (p.category && p.category.slug === post.category?.slug ? 5 : 0) +
      (p.tags ?? []).filter((t) => tagSlugs.has(t.slug)).length,
  }))
  .sort((a, b) => b.score - a.score || b.p.publishDate.valueOf() - a.p.publishDate.valueOf())
  .slice(0, 3)
  .map(({ p }) => p);

const headings = post.headings ?? [];
const shareUrl = String(url);
---

<SiteLayout metadata={metadata}>
  <!-- Barra di avanzamento della lettura -->
  <div aria-hidden="true" class="fixed top-0 inset-x-0 z-50 h-[3px] pointer-events-none">
    <div data-reading-progress class="h-full bg-ember origin-left scale-x-0"></div>
  </div>

  <article class="bg-white" data-article>
    {
      image && (
        <div class="bg-gray-200 aspect-[16/9] md:aspect-[21/8] overflow-hidden" transition:name={`cover-${post.slug}`}>
          <Image
            src={image}
            alt={post.title}
            widths={[640, 1280, 1920]}
            sizes="100vw"
            width={1280}
            aspectRatio="21:8"
            layout="cover"
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
      )
    }

    <header class="max-w-3xl mx-auto px-4 md:px-8 pt-10 md:pt-16">
      <nav aria-label="Percorso" class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.15em]">
        <a href="/blog" class="text-brand hover:text-charcoal transition-colors">Finanza in pillole</a>
        {
          post.category && (
            <>
              <span aria-hidden="true" class="text-charcoal/30">/</span>
              <span class="inline-block bg-ivory text-charcoal px-2.5 py-1">{post.category.title}</span>
            </>
          )
        }
      </nav>
      <h1
        class="mt-6 font-sans font-light uppercase tracking-[0.06em] text-2xl md:text-4xl leading-snug text-charcoal text-balance"
      >
        {post.title}
      </h1>
      {
        post.excerpt && (
          <p class="mt-6 font-playfair text-xl md:text-2xl leading-relaxed text-charcoal/80 text-pretty">{post.excerpt}</p>
        )
      }
      <div
        class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-y border-charcoal/10 py-4 text-sm text-charcoal/70"
      >
        <span class="flex items-center gap-2">
          <Icon name="tabler:calendar" class="w-4 h-4" aria-hidden="true" />
          <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
        </span>
        {
          post.readingTime && (
            <span class="flex items-center gap-2">
              <Icon name="tabler:clock" class="w-4 h-4" aria-hidden="true" />
              {post.readingTime} min di lettura
            </span>
          )
        }
        {post.author && <span>di {post.author}</span>}
        <ShareBar url={shareUrl} title={post.title} class="lg:hidden w-full pt-2" />
      </div>
    </header>

    <div
      class="max-w-6xl mx-auto px-4 md:px-8 lg:grid lg:grid-cols-[3.5rem_minmax(0,1fr)] xl:grid-cols-[3.5rem_minmax(0,1fr)_15rem] lg:gap-10"
    >
      <!-- Condivisione: colonna fissa su desktop -->
      <aside class="hidden lg:block pt-14">
        <ShareBar url={shareUrl} title={post.title} variant="rail" class="sticky top-28" />
      </aside>

      <div class="min-w-0 max-w-prose mx-auto w-full">
        {
          headings.length > 1 && (
            <details class="xl:hidden group mt-10 border border-charcoal/10 bg-linen">
              <summary class="flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden px-5 py-4 text-sm uppercase tracking-[0.15em] text-charcoal">
                <span class="flex items-center gap-2">
                  <Icon name="tabler:list" class="w-4 h-4" aria-hidden="true" />
                  In questo articolo
                </span>
                <Icon name="tabler:chevron-down" class="w-4 h-4 transition-transform group-open:rotate-180" aria-hidden="true" />
              </summary>
              <ol class="px-5 pb-5 space-y-2 text-sm">
                {headings.map((h) => (
                  <li class:list={[h.depth === 3 && 'pl-4']}>
                    <a href={`#${h.slug}`} class="text-charcoal/80 hover:text-brand">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <div class="article-body prose prose-lg max-w-none py-10 md:py-14">
          {post.Content ? <post.Content /> : <Fragment set:html={post.content || ''} />}
        </div>

        <div class="border-t border-charcoal/10 pt-8 pb-4">
          <ShareBar url={shareUrl} title={post.title} />
          {
            post.tags && post.tags.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tag">
                {post.tags.map((t) => (
                  <li class="text-xs bg-ivory text-charcoal/80 px-3 py-1.5">#{t.title}</li>
                ))}
              </ul>
            )
          }
        </div>
      </div>

      <!-- Sommario: colonna fissa su schermi larghi, con la sezione in lettura evidenziata -->
      {
        headings.length > 1 && (
          <aside class="hidden xl:block pt-14">
            <nav aria-label="In questo articolo" class="sticky top-28">
              <p class="text-[11px] uppercase tracking-[0.15em] text-charcoal/60 mb-4">In questo articolo</p>
              <ol class="space-y-1 border-l border-charcoal/10">
                {headings.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link={h.slug}
                      class:list={[
                        'block -ml-px border-l-2 border-transparent py-1.5 text-sm leading-snug text-charcoal/70 hover:text-brand transition-colors [&.is-active]:border-ember [&.is-active]:text-charcoal',
                        h.depth === 3 ? 'pl-7' : 'pl-4',
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>

    <aside class="max-w-prose mx-auto px-4 md:px-0 py-12 md:py-16">
      <div class="bg-ivory px-6 py-10 md:px-10 text-center">
        <p class="font-sans font-light text-xl md:text-2xl text-charcoal">Vuoi approfondire questo tema?</p>
        <a
          href="/blog#chiedi"
          class="inline-block mt-6 bg-brand text-white uppercase tracking-[0.15em] text-sm py-4 px-8 hover:bg-brand/90 transition-colors"
        >
          Chiedimi una spiegazione
        </a>
      </div>
    </aside>
  </article>

  {
    related.length > 0 && (
      <section class="bg-linen py-16 md:py-20" aria-labelledby="continua-a-leggere">
        <div class="max-w-6xl mx-auto px-4 md:px-8">
          <h2
            id="continua-a-leggere"
            class="font-sans font-light uppercase tracking-[0.12em] md:tracking-[0.15em] text-lg md:text-2xl text-charcoal mb-10"
          >
            Continua a leggere
          </h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </ul>
        </div>
      </section>
    )
  }
</SiteLayout>

<style is:global>
  /* Tipografia dell'articolo: lettura comoda e gerarchia chiara, come nei report editoriali */
  .article-body {
    --tw-prose-body: #2a322e;
    --tw-prose-headings: #1e2421;
    --tw-prose-links: #006937;
    --tw-prose-bold: #1e2421;
    --tw-prose-counters: #e04403;
    --tw-prose-bullets: #e04403;
    --tw-prose-quotes: #00482a;
    --tw-prose-th-borders: rgba(30, 36, 33, 0.15);
    --tw-prose-td-borders: rgba(30, 36, 33, 0.08);
    line-height: 1.8;
  }
  .article-body :is(h2, h3) {
    font-family: var(--aw-font-sans);
    letter-spacing: -0.01em;
    scroll-margin-top: 6.5rem;
  }
  .article-body h2 {
    position: relative;
    font-weight: 600;
    font-size: 1.5em;
    margin-top: 2.4em;
    padding-top: 1.2em;
    border-top: 1px solid rgba(30, 36, 33, 0.08);
  }
  .article-body h2::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 2.5rem;
    height: 3px;
    background: #e04403;
  }
  .article-body h3 {
    font-weight: 600;
  }
  .article-body a {
    text-decoration-color: rgba(224, 68, 3, 0.5);
    text-underline-offset: 4px;
  }
  /* Citazione in evidenza */
  .article-body blockquote {
    font-family: 'Playfair Display', serif;
    font-style: normal;
    font-weight: 400;
    font-size: 1.3em;
    line-height: 1.5;
    border-left: 3px solid #e04403;
    background: #f6f3ed;
    padding: 1.25em 1.5em;
    margin: 2em 0;
  }
  .article-body blockquote p:first-of-type::before,
  .article-body blockquote p:last-of-type::after {
    content: none;
  }
  .article-body table {
    font-size: 0.9em;
  }
  .article-body thead {
    background: #f6f3ed;
  }
  .article-body thead th {
    padding: 0.75em 1em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8em;
  }
  .article-body tbody td {
    padding: 0.75em 1em;
  }
  .article-body img {
    border-radius: 6px;
  }
</style>

<script>
  import { onPageLoad } from '~/scripts/page-load';

  function initArticle() {
    const article = document.querySelector<HTMLElement>('[data-article]');
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    if (!article || !bar || article.dataset.ready) return;
    article.dataset.ready = 'true';

    // Avanzamento della lettura
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      bar.style.transform = `scaleX(${progress})`;
    };

    // Sommario: evidenzia la sezione in lettura
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const targets = links
      .map((l) => document.getElementById(l.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));
    const setActive = () => {
      if (targets.length === 0) return;
      let current = targets[0].id;
      for (const t of targets) if (t.getBoundingClientRect().top < 140) current = t.id;
      links.forEach((l) => l.classList.toggle('is-active', l.dataset.tocLink === current));
    };

    const onScroll = () => {
      update();
      setActive();
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  onPageLoad(initArticle);
</script>
