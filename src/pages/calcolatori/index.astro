---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { calcolatori } from '~/data/calcolatori';

const metadata = {
  title: 'Calcolatori e strumenti | Andrea Giardini',
  description:
    'Una raccolta di strumenti pratici e didattici per orientarti nelle decisioni finanziarie più comuni: pensione, interesse composto, mutuo, rendita, obbligazioni e molto altro.',
};
---

<Layout metadata={metadata}>

  <!-- ======================================================
       HERO — titolo + sottotitolo
       ====================================================== -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs tracking-[0.18em] uppercase text-[var(--aw-color-accent)] font-semibold mb-4">Strumenti</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-[var(--aw-color-text-heading)] mb-6 leading-[1.1] font-heading">
        Calcolatori e strumenti
      </h1>
      <p class="text-lg md:text-xl text-[var(--aw-color-text-muted)] leading-relaxed max-w-2xl mx-auto">
        Una raccolta di strumenti pratici e didattici per orientarti nelle decisioni finanziarie più comuni. Sono pensati come stime indicative — per un'analisi precisa della tua situazione, <a href="/richiedi-diagnosi" class="text-[var(--aw-color-primary)] underline decoration-1 underline-offset-4 hover:decoration-2">contattami</a>.
      </p>
    </div>
  </section>

  <!-- ======================================================
       GRIGLIA CALCOLATORI
       ====================================================== -->
  <section class="bg-[rgb(245_241_232)] py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">

        {calcolatori.map((c) => (
          c.disponibile ? (
            <a
              href={c.href}
              class="group flex flex-col bg-white rounded-sm shadow-sm hover:shadow-xl transition-all duration-300 border border-[var(--aw-color-accent)]/20 hover:border-[var(--aw-color-accent)]/60 hover:-translate-y-1 overflow-hidden"
            >
              <div class="p-8 flex flex-col h-full">
                {c.icona && (
                  <div class="w-12 h-12 rounded-sm bg-[var(--aw-color-primary)]/10 text-[var(--aw-color-primary)] flex items-center justify-center mb-6 group-hover:bg-[var(--aw-color-primary)] group-hover:text-white transition-colors">
                    <Icon name={c.icona} class="w-6 h-6" />
                  </div>
                )}
                <h2 class="text-xl md:text-2xl font-bold text-[var(--aw-color-text-heading)] mb-3 leading-snug font-heading">
                  {c.titolo}
                </h2>
                <p class="text-base text-[var(--aw-color-text-muted)] leading-relaxed mb-8 flex-grow">
                  {c.descrizione}
                </p>
                <span class="inline-flex items-center gap-2 text-sm font-semibold tracking-wide text-[var(--aw-color-primary)] group-hover:gap-3 transition-all">
                  Apri calcolatore
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </span>
              </div>
            </a>
          ) : (
            <div
              class="relative flex flex-col bg-white rounded-sm border border-[var(--aw-color-accent)]/15 overflow-hidden opacity-60 cursor-not-allowed"
              aria-disabled="true"
            >
              <span class="absolute top-4 right-4 text-[10px] tracking-[0.15em] uppercase font-semibold text-[var(--aw-color-accent)] bg-[var(--aw-color-accent)]/10 px-2.5 py-1 rounded-sm">
                In arrivo
              </span>
              <div class="p-8 flex flex-col h-full">
                {c.icona && (
                  <div class="w-12 h-12 rounded-sm bg-[var(--aw-color-text-muted)]/10 text-[var(--aw-color-text-muted)] flex items-center justify-center mb-6">
                    <Icon name={c.icona} class="w-6 h-6" />
                  </div>
                )}
                <h2 class="text-xl md:text-2xl font-bold text-[var(--aw-color-text-heading)] mb-3 leading-snug font-heading">
                  {c.titolo}
                </h2>
                <p class="text-base text-[var(--aw-color-text-muted)] leading-relaxed mb-8 flex-grow">
                  {c.descrizione}
                </p>
                <span class="inline-flex items-center gap-2 text-sm font-semibold tracking-wide text-[var(--aw-color-text-muted)]">
                  In arrivo
                </span>
              </div>
            </div>
          )
        ))}

      </div>
    </div>
  </section>

  <!-- ======================================================
       CTA finale
       ====================================================== -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--aw-color-text-heading)] mb-4 font-heading leading-tight">
        Vuoi un'analisi precisa, non una stima?
      </h2>
      <p class="text-base md:text-lg text-[var(--aw-color-text-muted)] leading-relaxed mb-8">
        I calcolatori sono utili per inquadrare un'idea, ma ogni situazione ha le sue variabili. Se vuoi capire cosa è meglio per te, prenotiamo una chiacchierata.
      </p>
      <a
        href="/richiedi-diagnosi"
        class="inline-flex items-center justify-center px-8 py-4 bg-[var(--aw-color-primary)] hover:bg-[var(--aw-color-secondary)] text-white font-semibold rounded-sm transition-all hover:shadow-lg font-heading"
      >
        Richiedi diagnosi gratuita
      </a>
    </div>
  </section>

</Layout>
