      .calc-ob .chart-legend { gap: 12px; font-size: 0.78rem; }
    }
  </style>

  <script>
    import { calcolaRendimentoObbligazione } from '~/lib/calcolatori/rendimento-obbligazioni';
    import type {
      ModalitaCalcolo,
      Tipologia,
      Frequenza,
      FlussoCassa,
    } from '~/lib/calcolatori/rendimento-obbligazioni';
    import {
      Chart,
      BarController,
      BarElement,
      CategoryScale,
      LinearScale,
      Tooltip,
      Legend,
    } from 'chart.js';

    Chart.register(BarController, BarElement, CategoryScale, LinearScale, Tooltip, Legend);

    // -------------------- FORMATTERS --------------------
    const fmtEuro = new Intl.NumberFormat('it-IT', {
      style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2,
    });
    const fmtEuroShort = (v: number): string => {
      if (!Number.isFinite(v)) return '';
      const a = Math.abs(v);
      if (a >= 1_000_000) {
        const m = v / 1_000_000;
        return (Number.isInteger(m) ? m.toString() : m.toFixed(1).replace('.', ',')) + 'M €';
      }
      if (a >= 1_000) return Math.round(v / 1000) + 'K €';
      return Math.round(v) + ' €';
    };
    const fmtPct = (v: number, digits = 3): string => {
      if (!Number.isFinite(v)) return '—';
      const fixed = v.toFixed(digits);
      const trimmed = fixed.replace(/\.?0+$/, '');
      return trimmed.replace('.', ',') + '%';
    };
    const fmtPctFixed = (v: number, digits = 3): string => {
      if (!Number.isFinite(v)) return '—';
      return v.toFixed(digits).replace('.', ',') + '%';
    };
    const fmtDate = (d: Date) => d.toLocaleDateString('it-IT');
    const fmtDateShort = (d: Date): string => {
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const y = String(d.getFullYear()).slice(-2);
      return `${m}/${y}`;
    };

    function parseISODate(s: string): Date | null {
      if (!s) return null;
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
      if (!m) return null;
      const y = parseInt(m[1], 10);
      const mo = parseInt(m[2], 10) - 1;
      const d = parseInt(m[3], 10);
      const dt = new Date(y, mo, d);
      if (dt.getFullYear() !== y || dt.getMonth() !== mo || dt.getDate() !== d) return null;
      return dt;
    }
    function toISODate(d: Date): string {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const dd = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${dd}`;
    }
    function addYearsTo(d: Date, years: number): Date {
      const r = new Date(d); r.setFullYear(r.getFullYear() + years); return r;
    }
    function addMonthsTo(d: Date, months: number): Date {
      const r = new Date(d); r.setMonth(r.getMonth() + months); return r;
    }
    function parseNum(v: string): number {
      if (!v) return NaN;
      return parseFloat(v.replace(',', '.'));
    }

    // -------------------- DOM REFS --------------------
    const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
      document.getElementById(id) as T;
    const inputs = {
      modalitaRadios: document.querySelectorAll<HTMLInputElement>('input[name="ob-modalita"]'),
      tipologia: $<HTMLSelectElement>('ob-tipologia'),
      aliquota: $<HTMLInputElement>('ob-aliquota'),
      dataAcquisto: $<HTMLInputElement>('ob-data-acquisto'),
      dataScadenza: $<HTMLInputElement>('ob-data-scadenza'),
      prezzoAcq: $<HTMLInputElement>('ob-prezzo-acq'),
      prezzoRimb: $<HTMLInputElement>('ob-prezzo-rimb'),
      nominale: $<HTMLInputElement>('ob-nominale'),
      numeroTitoli: $<HTMLInputElement>('ob-numero-titoli'),
      cedola: $<HTMLInputElement>('ob-cedola'),
      frequenza: $<HTMLSelectElement>('ob-frequenza'),
      dataProxCedola: $<HTMLInputElement>('ob-data-prox-cedola'),
      rateo: $<HTMLInputElement>('ob-rateo'),
      reinvesti: $<HTMLInputElement>('ob-reinvesti'),
      tassoR: $<HTMLInputElement>('ob-tasso-r'),
    };

    // -------------------- INIT DEFAULTS --------------------
    const oggi = new Date();
    oggi.setHours(0, 0, 0, 0);
    inputs.dataAcquisto.value = toISODate(oggi);
    inputs.dataScadenza.value = toISODate(addYearsTo(oggi, 5));
    inputs.dataProxCedola.value = toISODate(addMonthsTo(oggi, 6));

    function getModalita(): ModalitaCalcolo {
      const r = document.querySelector<HTMLInputElement>('input[name="ob-modalita"]:checked');
      return (r?.value === 'avanzata' ? 'avanzata' : 'semplice') as ModalitaCalcolo;
    }

    function setVisibility(): void {
      const modalita = getModalita();
      const advancedSection = document.querySelector<HTMLElement>('.advanced-only');
      if (advancedSection) advancedSection.hidden = modalita !== 'avanzata';

      const tipologia = inputs.tipologia.value as Tipologia;
      const aliquotaRow = $('ob-row-aliquota');
      if (aliquotaRow) aliquotaRow.hidden = tipologia !== 'personalizzata';

      const tassoRRow = $('ob-row-tassoR');
      if (tassoRRow) tassoRRow.hidden = !inputs.reinvesti.checked;
    }

    // -------------------- CHART --------------------
    const COLORS = {
      acquisto: '#373D42',
      cedola: '#79B9AD',
      rimborso: '#00A652',
    };

    let chartInstance: import('chart.js').Chart | null = null;
    let firstRender = true;

    type GroupedFlow = { data: Date; label: string; items: FlussoCassa[] };
    const currentChart: { byDate: GroupedFlow[] } = { byDate: [] };

    function aggregateByDate(flussi: FlussoCassa[]): GroupedFlow[] {
      const map = new Map<string, GroupedFlow>();
      for (const f of flussi) {
        const key = toISODate(f.data);
        if (!map.has(key)) {
          map.set(key, { data: f.data, label: fmtDateShort(f.data), items: [] });
        }
        map.get(key)!.items.push(f);
      }
      return Array.from(map.values()).sort((a, b) => a.data.getTime() - b.data.getTime());
    }

    function disegnaChart(flussi: FlussoCassa[]): void {
      const canvas = $('ob-chart') as unknown as HTMLCanvasElement;
      if (!canvas) return;

      const grouped = aggregateByDate(flussi);
      currentChart.byDate = grouped;

      const labels = grouped.map((g) => g.label);
      const dataAcquisto = grouped.map((g) =>
        g.items.filter((i) => i.tipo === 'acquisto').reduce((s, i) => s + i.importoLordo, 0)
      );
      const dataCedola = grouped.map((g) =>
        g.items.filter((i) => i.tipo === 'cedola').reduce((s, i) => s + i.importoNetto, 0)
      );
      const dataRimborso = grouped.map((g) =>
        g.items.filter((i) => i.tipo === 'rimborso').reduce((s, i) => s + i.importoNetto, 0)
      );

      const N = grouped.length;
      const showXTick = (idx: number): boolean =>
        N > 30 ? idx % 4 === 0 || idx === N - 1
        : N > 18 ? idx % 2 === 0 || idx === N - 1
        : true;
      const rotate = N > 12;

      if (chartInstance) {
        chartInstance.data.labels = labels;
        chartInstance.data.datasets[0].data = dataAcquisto;
        chartInstance.data.datasets[1].data = dataCedola;
        chartInstance.data.datasets[2].data = dataRimborso;
        const xs = chartInstance.options.scales?.x as any;
        if (xs?.ticks) {
          xs.ticks.maxRotation = rotate ? 45 : 0;
          xs.ticks.minRotation = rotate ? 45 : 0;
          xs.ticks.callback = function (_v: unknown, idx: number) {
            return showXTick(idx) ? labels[idx] : '';
          };
        }
        chartInstance.setActiveElements([]);
        if (chartInstance.tooltip) {
          chartInstance.tooltip.setActiveElements([], { x: 0, y: 0 });
        }
        chartInstance.update('none');
        return;
      }

      chartInstance = new Chart(canvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            { label: 'Esborso iniziale', data: dataAcquisto, backgroundColor: COLORS.acquisto, stack: 'cf', borderWidth: 0, borderRadius: 4 },
            { label: 'Cedole nette', data: dataCedola, backgroundColor: COLORS.cedola, stack: 'cf', borderWidth: 0, borderRadius: 4 },
            { label: 'Rimborso netto', data: dataRimborso, backgroundColor: COLORS.rimborso, stack: 'cf', borderWidth: 0, borderRadius: 4 },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: firstRender ? { duration: 600, easing: 'easeOutQuart' } : false,
          layout: { padding: { top: 8, right: 8, bottom: 4, left: 4 } },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#FFFFFF',
              borderColor: 'rgba(22, 105, 99, 0.25)',
              borderWidth: 1,
              titleColor: '#0F4F4A',
              titleFont: { family: 'Manrope, sans-serif', weight: 700, size: 13 },
              bodyColor: '#373D42',
              bodyFont: { family: 'Manrope, sans-serif', size: 12 },
              footerColor: '#6B7672',
              footerFont: { family: 'Manrope, sans-serif', weight: 400, size: 11 },
              padding: 12,
              cornerRadius: 8,
              displayColors: true,
              boxPadding: 4,
              callbacks: {
                title: (items) => {
                  const idx = items[0].dataIndex;
                  const g = currentChart.byDate[idx];
                  return g ? fmtDate(g.data) : '';
                },
                label: (ctx) => {
                  const v = Number(ctx.parsed.y);
                  if (Math.abs(v) < 0.005) return '';
                  return `  ${ctx.dataset.label}: ${fmtEuro.format(v)}`;
                },
                footer: (items) => {
                  const idx = items[0].dataIndex;
                  const g = currentChart.byDate[idx];
                  if (!g) return '';
                  const lines: string[] = [];
                  for (const it of g.items) {
                    const segno = it.tipo === 'acquisto' ? '−' : '+';
                    lines.push(
                      `${it.descrizione} (${segno} lordo ${fmtEuro.format(Math.abs(it.importoLordo))}, imposte ${fmtEuro.format(it.imposte)})`
                    );
                  }
                  return lines.join('\n');
                },
              },
            },
          },
          scales: {
            x: {
              stacked: true,
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                maxRotation: rotate ? 45 : 0,
                minRotation: rotate ? 45 : 0,
                autoSkip: false,
                callback: function (_v: any, idx: number) {
                  return showXTick(idx) ? labels[idx] : '';
                },
              },
            },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(22, 105, 99, 0.15)', lineWidth: 1 },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (v) => fmtEuroShort(v as number),
              },
            },
          },
        },
      });

      requestAnimationFrame(() => {
        if (chartInstance && chartInstance.options) {
          (chartInstance.options as any).animation = false;
        }
      });
      firstRender = false;
    }

    function updateChartFallback(flussi: FlussoCassa[]): void {
      const el = $('ob-chart-fallback');
      if (!el) return;
      const totIngressi = flussi
        .filter((f) => f.tipo !== 'acquisto')
        .reduce((s, f) => s + f.importoNetto, 0);
      const esborso = flussi
        .filter((f) => f.tipo === 'acquisto')
        .reduce((s, f) => s + Math.abs(f.importoLordo), 0);
      el.textContent =
        `Flussi: esborso totale ${fmtEuro.format(esborso)}, ` +
        `ingressi netti totali ${fmtEuro.format(totIngressi)} su ${flussi.length} eventi.`;
    }

    // -------------------- MAIN --------------------
    function aggiorna(): void {
      setVisibility();

      const modalita = getModalita();
      const tipologia = inputs.tipologia.value as Tipologia;
      const aliquotaPersonalizzata = parseNum(inputs.aliquota.value);
      const dataAcquisto = parseISODate(inputs.dataAcquisto.value);
      const dataScadenza = parseISODate(inputs.dataScadenza.value);
      const prezzoAcquisto = parseNum(inputs.prezzoAcq.value);
      const prezzoRimborso = parseNum(inputs.prezzoRimb.value);
      const capitaleNominale = parseNum(inputs.nominale.value);
      const cedolaLordaAnnua = parseNum(inputs.cedola.value);
      const frequenzaCedolare = inputs.frequenza.value as Frequenza;
      const dataProssimaCedola = parseISODate(inputs.dataProxCedola.value);
      const includiRateo = inputs.rateo.checked;
      const reinvestiCedole = inputs.reinvesti.checked;
      const tassoReinvestimento = parseNum(inputs.tassoR.value);

      // Numero titoli (informativo)
      inputs.numeroTitoli.value = Number.isFinite(capitaleNominale) && capitaleNominale > 0
        ? (capitaleNominale / 1000).toFixed(2).replace(/\.?0+$/, '').replace('.', ',')
        : '0';

      const blocking = $('ob-blocking');

      if (!dataAcquisto || !dataScadenza) {
        blocking.textContent = 'Inserisci date valide.';
        return;
      }
      if (dataScadenza.getTime() <= dataAcquisto.getTime()) {
        blocking.textContent = 'La data di scadenza deve essere successiva alla data di acquisto.';
        return;
      }
      if (!Number.isFinite(capitaleNominale) || capitaleNominale <= 0) {
        blocking.textContent = 'Inserisci un capitale nominale maggiore di zero.';
        return;
      }
      blocking.textContent = '';

      const result = calcolaRendimentoObbligazione({
        modalita,
        tipologia,
        aliquotaPersonalizzata: Number.isFinite(aliquotaPersonalizzata) ? aliquotaPersonalizzata : 0,
        dataAcquisto,
        dataScadenza,
        prezzoAcquisto: Number.isFinite(prezzoAcquisto) ? prezzoAcquisto : 0,
        prezzoRimborso: Number.isFinite(prezzoRimborso) ? prezzoRimborso : 0,
        capitaleNominale,
        cedolaLordaAnnua: Number.isFinite(cedolaLordaAnnua) ? cedolaLordaAnnua : 0,
        frequenzaCedolare,
        dataProssimaCedola: dataProssimaCedola ?? undefined,
        includiRateo,
        reinvestiCedole,
        tassoReinvestimento: Number.isFinite(tassoReinvestimento) ? tassoReinvestimento : 0,
      });

      if (!result.ok) {
        blocking.textContent = result.errore ?? 'Dati non validi.';
        return;
      }

      // Output principali
      $('ob-out-capitale-finale').textContent = fmtEuro.format(result.capitaleFinaleNetto);
      $('ob-out-rendimento-tot').textContent = fmtEuro.format(result.rendimentoTotaleNetto);
      $('ob-out-rendimento-medio').textContent = fmtPctFixed(result.rendimentoPercMedioAnnuoNetto, 3);

      // Output dettaglio
      $('ob-out-aliquota').textContent =
        result.aliquotaApplicata.toFixed(1).replace(/\.?0+$/, '').replace('.', ',') + '%';
      $('ob-out-anni').textContent = result.anniResidui.toFixed(2).replace('.', ',');
      $('ob-out-cg-lordo').textContent = fmtEuro.format(result.guadagnoContoCapitaleLordo);
      $('ob-out-cg-netto').textContent = fmtEuro.format(result.guadagnoContoCapitaleNetto);
      $('ob-out-imposte').textContent = fmtEuro.format(result.impostePagateTotali);

      // Cedole (se > 0)
      const showCedole = result.cedoleTotaliLorde > 0;
      $('ob-row-cedole-lorde').hidden = !showCedole;
      $('ob-row-cedole-nette').hidden = !showCedole;
      if (showCedole) {
        $('ob-out-cedole-lorde').textContent = fmtEuro.format(result.cedoleTotaliLorde);
        $('ob-out-cedole-nette').textContent = fmtEuro.format(result.cedoleTotaliNette);
      }

      // YTM (solo Avanzata)
      const isAvanzata = modalita === 'avanzata';
      $('ob-row-ytm-netto').hidden = !isAvanzata;
      $('ob-row-ytm-lordo').hidden = !isAvanzata;
      if (isAvanzata) {
        $('ob-out-ytm-netto').textContent =
          result.ytmNetto !== null ? fmtPctFixed(result.ytmNetto, 3) : '—';
        $('ob-out-ytm-lordo').textContent =
          result.ytmLordo !== null ? fmtPctFixed(result.ytmLordo, 3) : '—';
      }

      // Rateo / credito (se applicabile)
      const showRateo = result.rateoVersato > 0;
      $('ob-row-rateo').hidden = !showRateo;
      if (showRateo) $('ob-out-rateo').textContent = fmtEuro.format(result.rateoVersato);

      const showCredito = result.creditoImpostaMaturato > 0;
      $('ob-row-credito').hidden = !showCredito;
      if (showCredito)
        $('ob-out-credito').textContent = fmtEuro.format(result.creditoImpostaMaturato);

      // Warnings
      const warnEl = $('ob-warnings');
      warnEl.innerHTML = '';
      if (result.warning.length) {
        const ul = document.createElement('ul');
        for (const w of result.warning) {
          const li = document.createElement('li');
          li.textContent = w;
          ul.appendChild(li);
        }
        warnEl.appendChild(ul);
      }

      disegnaChart(result.flussi);
      updateChartFallback(result.flussi);
    }

    // -------------------- DEBOUNCE + WIRING --------------------
    let timer: ReturnType<typeof setTimeout> | null = null;
    function schedule(): void {
      if (timer) clearTimeout(timer);
      timer = setTimeout(aggiorna, 200);
    }

    const allInputs: Array<HTMLInputElement | HTMLSelectElement> = [
      inputs.tipologia,
      inputs.aliquota,
      inputs.dataAcquisto,
      inputs.dataScadenza,
      inputs.prezzoAcq,
      inputs.prezzoRimb,
      inputs.nominale,
      inputs.cedola,
      inputs.frequenza,
      inputs.dataProxCedola,
      inputs.tassoR,
    ];
    for (const el of allInputs) {
      el.addEventListener('input', schedule);
      el.addEventListener('change', schedule);
    }
    inputs.rateo.addEventListener('change', schedule);
    inputs.reinvesti.addEventListener('change', schedule);
    inputs.modalitaRadios.forEach((el) => el.addEventListener('change', schedule));

    aggiorna();
  </script>
</Layout>
