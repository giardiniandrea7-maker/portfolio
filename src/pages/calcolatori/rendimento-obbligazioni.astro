---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Calcolatore Rendimento Obbligazioni e BTP | Andrea Giardini',
  description:
    'Calcolatore gratuito per il rendimento di BTP, BOT, CTZ, CCT e obbligazioni corporate. Calcola YTM, capitale finale netto e fiscalità con due modalità: semplice e avanzata.',
};
---

<Layout metadata={metadata}>
  <div class="calc-ob">
    <!-- ============== HERO ============== -->
    <header class="calc-header">
      <h1>Calcolatore di Rendimento per Obbligazioni e Titoli di Stato</h1>
      <p>
        Calcola rendimento, capitale finale e impatto fiscale per BTP, BOT, CTZ, CCT e
        obbligazioni corporate. Lo strumento gestisce correttamente rateo cedolare,
        credito d'imposta e tassazione differenziata.
      </p>
    </header>

    <!-- ============== TAB MODALITÀ ============== -->
    <fieldset class="modal-tabs" role="radiogroup" aria-label="Modalità di calcolo">
      <legend class="sr-only">Modalità di calcolo</legend>
      <label class="tab-pill">
        <input type="radio" name="ob-modalita" value="semplice" checked />
        <span class="tab-content">
          <span class="tab-title">Semplice</span>
          <span class="tab-desc">BOT, CTZ o stima alla scadenza</span>
        </span>
      </label>
      <label class="tab-pill">
        <input type="radio" name="ob-modalita" value="avanzata" />
        <span class="tab-content">
          <span class="tab-title">Avanzata</span>
          <span class="tab-desc">BTP, CCT con cedole intermedie</span>
        </span>
      </label>
    </fieldset>

    <!-- ============== FORM + RISULTATI ============== -->
    <div class="main-grid">
      <!-- COLONNA SX: FORM -->
      <div class="card form-card">
        <h2 class="card-title">Inserisci i dati del titolo</h2>

        <div class="form-group">
          <label for="ob-tipologia">Tipologia titolo</label>
          <select id="ob-tipologia">
            <option value="titolo_stato">Titolo di Stato italiano (12,5%)</option>
            <option value="corporate">Obbligazione corporate (26%)</option>
            <option value="personalizzata">Aliquota personalizzata</option>
          </select>
        </div>

        <div class="form-group" id="ob-row-aliquota" hidden>
          <label for="ob-aliquota">Aliquota fiscale</label>
          <div class="input-with-suffix">
            <input
              type="number"
              id="ob-aliquota"
              min="0"
              max="100"
              step="0.5"
              value="12.5"
              inputmode="decimal"
            />
            <span class="suffix">%</span>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="ob-data-acquisto">Data di acquisto</label>
            <input type="date" id="ob-data-acquisto" />
          </div>
          <div class="form-group">
            <label for="ob-data-scadenza">Data di scadenza/vendita</label>
            <input type="date" id="ob-data-scadenza" />
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="ob-prezzo-acq">Prezzo di acquisto</label>
            <div class="input-with-suffix">
              <input
                type="number"
                id="ob-prezzo-acq"
                min="0"
                max="200"
                step="0.01"
                value="98"
                inputmode="decimal"
              />
              <span class="suffix">/100</span>
            </div>
          </div>
          <div class="form-group">
            <label for="ob-prezzo-rimb">Prezzo di rimborso</label>
            <div class="input-with-suffix">
              <input
                type="number"
                id="ob-prezzo-rimb"
                min="0"
                max="200"
                step="0.01"
                value="100"
                inputmode="decimal"
              />
              <span class="suffix">/100</span>
            </div>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="ob-nominale">Capitale nominale</label>
            <div class="input-with-suffix">
              <input
                type="number"
                id="ob-nominale"
                min="0"
                step="1000"
                value="10000"
                inputmode="decimal"
              />
              <span class="suffix">€</span>
            </div>
          </div>
          <div class="form-group">
            <label for="ob-numero-titoli">Numero titoli (taglio 1000€)</label>
            <input type="text" id="ob-numero-titoli" disabled value="10" aria-readonly="true" />
          </div>
        </div>

        <div class="form-group">
          <label for="ob-cedola">Cedola lorda annua</label>
          <div class="input-with-suffix">
            <input
              type="number"
              id="ob-cedola"
              min="0"
              max="15"
              step="0.05"
              value="0"
              inputmode="decimal"
            />
            <span class="suffix">%</span>
          </div>
        </div>

        <!-- SOLO AVANZATA -->
        <div class="advanced-only" hidden>
          <hr class="form-sep" />
          <div class="form-row-2">
            <div class="form-group">
              <label for="ob-frequenza">Frequenza cedolare</label>
              <select id="ob-frequenza">
                <option value="annuale">Annuale</option>
                <option value="semestrale" selected>Semestrale</option>
                <option value="trimestrale">Trimestrale</option>
              </select>
            </div>
            <div class="form-group">
              <label for="ob-data-prox-cedola">Data prossima cedola</label>
              <input type="date" id="ob-data-prox-cedola" />
            </div>
          </div>

          <div class="toggle-block">
            <label class="toggle-row">
              <input type="checkbox" id="ob-rateo" checked />
              <span class="toggle-text">Includi rateo cedolare in acquisto</span>
            </label>
            <p class="toggle-hint">
              Il prezzo "tel quel" comprende corso secco + rateo. Per i Titoli di Stato il
              rateo genera credito d'imposta del 12,5% sulle cedole successive.
            </p>
          </div>

          <div class="toggle-block">
            <label class="toggle-row">
              <input type="checkbox" id="ob-reinvesti" />
              <span class="toggle-text">Reinvesti cedole</span>
            </label>
            <div id="ob-row-tassoR" hidden class="toggle-extra">
              <label for="ob-tasso-r">Tasso di reinvestimento</label>
              <div class="input-with-suffix">
                <input
                  type="number"
                  id="ob-tasso-r"
                  min="0"
                  max="20"
                  step="0.1"
                  value="3"
                  inputmode="decimal"
                />
                <span class="suffix">%</span>
              </div>
            </div>
          </div>
        </div>

        <p class="form-hint">Il calcolo si aggiorna automaticamente.</p>
        <p class="warn warn-blocking" id="ob-blocking" role="alert" aria-live="assertive"></p>
      </div>

      <!-- COLONNA DX: RISULTATI -->
      <div class="card results-card" aria-live="polite" aria-atomic="true">
        <h2 class="card-title">Risultati</h2>

        <div class="result-block result-primary">
          <span class="result-label">Capitale finale netto</span>
          <span class="result-value result-value-xl" id="ob-out-capitale-finale">—</span>
        </div>
        <div class="result-block">
          <span class="result-label">Rendimento totale netto</span>
          <span class="result-value" id="ob-out-rendimento-tot">—</span>
        </div>
        <div class="result-block">
          <span class="result-label">Rendimento medio annuo netto</span>
          <span class="result-value" id="ob-out-rendimento-medio">—</span>
        </div>
        <div class="result-block ytm-block" id="ob-row-ytm-netto" hidden>
          <span class="result-label">YTM netto (annuo)</span>
          <span class="result-value result-value-accent" id="ob-out-ytm-netto">—</span>
        </div>

        <h3 class="metrics-title">Dettaglio</h3>
        <ul class="metrics-list">
          <li><span class="m-label">Aliquota applicata</span><span class="m-value" id="ob-out-aliquota">—</span></li>
          <li><span class="m-label">Anni residui</span><span class="m-value" id="ob-out-anni">—</span></li>
          <li id="ob-row-ytm-lordo" hidden><span class="m-label">YTM lordo (annuo)</span><span class="m-value" id="ob-out-ytm-lordo">—</span></li>
          <li id="ob-row-cedole-lorde" hidden><span class="m-label">Cedole totali lorde</span><span class="m-value" id="ob-out-cedole-lorde">—</span></li>
          <li id="ob-row-cedole-nette" hidden><span class="m-label">Cedole totali nette</span><span class="m-value" id="ob-out-cedole-nette">—</span></li>
          <li><span class="m-label">Guadagno conto capitale lordo</span><span class="m-value" id="ob-out-cg-lordo">—</span></li>
          <li><span class="m-label">Guadagno conto capitale netto</span><span class="m-value" id="ob-out-cg-netto">—</span></li>
          <li id="ob-row-rateo" hidden><span class="m-label">Rateo cedolare versato</span><span class="m-value" id="ob-out-rateo">—</span></li>
          <li id="ob-row-credito" hidden><span class="m-label">Credito d'imposta maturato</span><span class="m-value" id="ob-out-credito">—</span></li>
          <li><span class="m-label">Imposte totali pagate</span><span class="m-value" id="ob-out-imposte">—</span></li>
        </ul>

        <div class="warn-list" id="ob-warnings" aria-live="polite"></div>
      </div>
    </div>

    <!-- ============== GRAFICO ============== -->
    <section class="card chart-card" aria-label="Flussi di cassa nel tempo">
      <div class="chart-header">
        <h2 class="card-title">Flussi di cassa nel tempo</h2>
        <div class="chart-legend">
          <span class="legend-item"><span class="legend-swatch legend-acquisto"></span>Esborso iniziale</span>
          <span class="legend-item"><span class="legend-swatch legend-cedola"></span>Cedole nette</span>
          <span class="legend-item"><span class="legend-swatch legend-rimborso"></span>Rimborso netto</span>
        </div>
      </div>
      <div class="chart-wrap">
        <canvas id="ob-chart" aria-label="Grafico a barre dei flussi di cassa nel tempo" role="img"></canvas>
      </div>
      <p id="ob-chart-fallback" class="sr-only" aria-live="polite"></p>
    </section>

    <!-- ============== COME FUNZIONA ============== -->
    <section class="how-it-works">
      <details class="math-details">
        <summary>
          <span class="summary-text">Mostra le formule e la fiscalità</span>
          <span class="summary-icon" aria-hidden="true"></span>
        </summary>
        <div class="math-content">
          <h2>Come funziona il calcolatore</h2>
          <p>
            Il <em>rendimento</em> di un'obbligazione non è il solo tasso di cedola. È la somma
            di tre componenti: la <b>cedola</b> che incassi periodicamente, il <b>guadagno (o
            perdita) in conto capitale</b> tra prezzo di acquisto e prezzo di rimborso, e
            l'effetto delle <b>imposte</b>. Una stima onesta deve tenere conto di tutto.
          </p>
          <p>
            Lo standard professionale per misurare il rendimento è lo <b>YTM</b> (<em>Yield to
            Maturity</em>): il tasso annuo che rende il valore attuale di tutti i flussi futuri
            pari al prezzo che paghi oggi. È la "media implicita" del titolo che tiene conto
            del valore temporale del denaro. Per BTP, BOT, CTZ e obbligazioni corporate è la
            metrica giusta.
          </p>
          <p>
            La <b>fiscalità italiana</b> è asimmetrica: i Titoli di Stato (e gli equiparati)
            sono tassati al <b>12,5%</b>, le obbligazioni societarie al <b>26%</b>. Le
            minusvalenze in conto capitale finiscono nel "zainetto fiscale" e si compensano
            solo con plusvalenze future della stessa natura: il calcolatore non le tassa
            ma non le scarica automaticamente. Il <b>rateo cedolare</b> che paghi al venditore
            quando compri tra una cedola e l'altra genera, sui Titoli di Stato, un
            <b>credito d'imposta</b> del 12,5% che si recupera sulle prime cedole successive.
          </p>

          <h3>Rendimento medio annuo netto</h3>
          <div class="formula-block">
            <i>R</i><sub>medio</sub> =
            <span class="frac">
              <span class="frac-top">rendimento totale netto</span>
              <span class="frac-bottom">capitale investito</span>
            </span>
            ·
            <span class="frac">
              <span class="frac-top">1</span>
              <span class="frac-bottom">anni residui</span>
            </span>
            · 100
          </div>
          <p class="formula-note">
            È una media aritmetica semplice — utile come confronto, ma non tiene conto del
            valore temporale del denaro. Per un confronto rigoroso usa lo YTM.
          </p>

          <h3>Yield to Maturity (YTM)</h3>
          <div class="formula-block">
            0 = Σ<sub>i</sub>
            <span class="frac">
              <span class="frac-top">flusso<sub>i</sub></span>
              <span class="frac-bottom">(1 + <i>r</i>)<sup>t<sub>i</sub></sup></span>
            </span>
          </div>
          <p>
            Si risolve numericamente per <i>r</i>, dove t<sub>i</sub> è il tempo (in periodi
            cedolari) dall'acquisto al flusso i-esimo, e i flussi includono l'esborso iniziale
            (negativo), tutte le cedole e il rimborso finale. Il calcolatore restituisce
            <i>r</i> come tasso annuo, espresso alla frequenza cedolare.
          </p>
          <p class="formula-note">
            Lo YTM assume implicitamente che le cedole siano reinvestite al tasso YTM stesso —
            ipotesi non sempre realistica. Se vuoi simulare un tasso di reinvestimento diverso,
            attiva l'opzione "Reinvesti cedole" in modalità Avanzata.
          </p>

          <h3>Capitale finale netto</h3>
          <p>
            È quanto torna in tasca a scadenza, al netto di tutte le imposte:
          </p>
          <div class="formula-block">
            <i>F</i> = esborso a corso secco + cedole nette + guadagno netto in conto capitale
          </div>
          <p class="formula-note">
            In presenza di rateo, il <i>capitale investito</i> aumenta dell'importo del rateo,
            ma il credito d'imposta sui Titoli di Stato riduce le tasse sulle cedole successive,
            recuperando parte di quel costo.
          </p>
        </div>
      </details>
    </section>

    <!-- ============== CTA ============== -->
    <section class="cta-section">
      <div class="eyebrow">Vuoi un parere professionale?</div>
      <h2>Vuoi un parere sulle tue obbligazioni o sui tuoi BTP?</h2>
      <p>
        Posso aiutarti ad analizzare il tuo portafoglio obbligazionario, valutare se i
        rendimenti che stai ottenendo sono in linea con il rischio e capire come ottimizzare
        la tua allocazione. La prima chiamata è gratuita e senza impegno.
      </p>
      <div class="cta-buttons">
        <a href="/contatti" class="btn btn-primary">Prenota una consulenza</a>
        <a href="/calcolatori" class="btn btn-secondary">Torna ai calcolatori</a>
      </div>
    </section>

    <!-- ============== DISCLAIMER ============== -->
    <div class="final-disclaimer">
      <strong>Nota informativa:</strong> Questo calcolatore ha finalità esclusivamente educative
      e illustrative. Le ipotesi di calcolo (in particolare per il rateo cedolare, la
      liquidazione del credito d'imposta e la compensazione delle minusvalenze) possono
      semplificare alcune casistiche del regime fiscale italiano. Per una valutazione adatta
      al tuo specifico portafoglio è necessaria una consulenza personalizzata. I rendimenti
      passati non sono garanzia di rendimenti futuri.
    </div>
  </div>

  <style is:global>
    .calc-ob {
      --sage: #166963; --sage-light: #79B9AD; --sage-dark: #0F4F4A;
      --ochre: #AB7F62; --ochre-light: #C49A7E; --ochre-dark: #8A6449;
      --ivory: rgb(238 247 246); --ivory-warm: rgb(245 250 249);
      --charcoal: #373D42;
      --emerald: #00A652;
      --gray-soft: #DDE4E2; --gray-text: #6B7672;
      --shadow-soft: 0 4px 20px rgba(55, 61, 66, 0.06);
      --radius: 12px;

      font-family: 'Manrope', -apple-system, sans-serif;
      color: var(--charcoal);
      line-height: 1.65;
      font-size: 16px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px 60px;
    }
    .calc-ob * { box-sizing: border-box; }

    .calc-ob .calc-header {
      text-align: center;
      margin-bottom: 28px;
      padding-bottom: 22px;
      border-bottom: 1px solid var(--gray-soft);
    }
    .calc-ob .calc-header h1 {
      font-family: var(--aw-font-heading, 'Manrope', sans-serif);
      font-size: clamp(1.7rem, 3.6vw, 2.2rem);
      color: var(--sage-dark);
      font-weight: 600;
      margin-bottom: 14px;
      letter-spacing: -0.01em;
    }
    .calc-ob .calc-header p {
      color: var(--gray-text);
      font-size: 1rem;
      max-width: 760px;
      margin: 0 auto;
      line-height: 1.65;
    }

    /* ============== TAB MODALITÀ ============== */
    .calc-ob .modal-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 0 0 24px;
      border: 0;
      padding: 0;
    }
    .calc-ob .tab-pill {
      position: relative;
      display: block;
      padding: 14px 18px;
      border: 1.5px solid var(--gray-soft);
      border-radius: 10px;
      cursor: pointer;
      background: white;
      transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
    }
    .calc-ob .tab-pill input[type="radio"] {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }
    .calc-ob .tab-pill:hover { border-color: var(--sage-light); }
    .calc-ob .tab-pill:has(input:checked) {
      border-color: var(--emerald);
      background: rgba(0, 166, 82, 0.06);
      box-shadow: 0 0 0 3px rgba(0, 166, 82, 0.10);
    }
    .calc-ob .tab-pill:has(input:focus-visible) {
      outline: 2px solid var(--emerald);
      outline-offset: 2px;
    }
    .calc-ob .tab-content { display: block; }
    .calc-ob .tab-title {
      display: block;
      font-weight: 600;
      color: var(--sage-dark);
      font-size: 0.98rem;
    }
    .calc-ob .tab-desc {
      display: block;
      color: var(--gray-text);
      font-size: 0.82rem;
      margin-top: 2px;
    }

    /* ============== GRID ============== */
    .calc-ob .main-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 30px;
      align-items: start;
    }
    .calc-ob .card {
      background: white;
      border: 1px solid rgba(22, 105, 99, 0.15);
      border-radius: var(--radius);
      padding: 26px 28px;
      box-shadow: var(--shadow-soft);
    }
    .calc-ob .card-title {
      font-family: var(--aw-font-heading, 'Manrope', sans-serif);
      font-size: 1.15rem;
      color: var(--sage-dark);
      font-weight: 600;
      margin: 0 0 18px;
      letter-spacing: -0.01em;
    }

    /* ============== FORM ============== */
    .calc-ob .form-group { margin-bottom: 16px; }
    .calc-ob .form-group:last-child { margin-bottom: 0; }
    .calc-ob .form-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .calc-ob label,
    .calc-ob .modal-tabs legend {
      display: block;
      font-weight: 500;
      color: var(--charcoal);
      margin-bottom: 6px;
      font-size: 0.9rem;
      padding: 0;
    }
    .calc-ob input[type="number"],
    .calc-ob input[type="text"],
    .calc-ob input[type="date"],
    .calc-ob select {
      width: 100%;
      padding: 10px 12px;
      border: 1.5px solid var(--gray-soft);
      border-radius: 8px;
      font-family: 'Manrope', sans-serif;
      font-size: 0.95rem;
      color: var(--charcoal);
      background: white;
      transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .calc-ob input:focus,
    .calc-ob select:focus {
      outline: none;
      border-color: var(--emerald);
      box-shadow: 0 0 0 3px rgba(0, 166, 82, 0.15);
    }
    .calc-ob input[type="number"]::-webkit-outer-spin-button,
    .calc-ob input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none; margin: 0;
    }
    .calc-ob input[type="number"] { -moz-appearance: textfield; }
    .calc-ob input[disabled] {
      background: var(--ivory-warm);
      color: var(--gray-text);
      cursor: not-allowed;
    }

    .calc-ob .input-with-suffix { position: relative; }
    .calc-ob .input-with-suffix .suffix {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--gray-text);
      font-size: 0.9rem;
      pointer-events: none;
    }
    .calc-ob .input-with-suffix input { padding-right: 42px; }

    .calc-ob .form-sep {
      border: 0;
      border-top: 1px dashed var(--gray-soft);
      margin: 18px 0 16px;
    }
    .calc-ob .toggle-block {
      margin-bottom: 14px;
      padding: 10px 12px;
      border-radius: 8px;
      background: var(--ivory-warm);
    }
    .calc-ob .toggle-row {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      margin: 0;
      font-weight: 500;
      font-size: 0.93rem;
    }
    .calc-ob .toggle-row input[type="checkbox"] {
      accent-color: var(--emerald);
      width: 17px; height: 17px;
      flex-shrink: 0;
    }
    .calc-ob .toggle-text { color: var(--charcoal); }
    .calc-ob .toggle-hint {
      color: var(--gray-text);
      font-size: 0.8rem;
      margin: 6px 0 0 27px;
      line-height: 1.45;
    }
    .calc-ob .toggle-extra { margin: 12px 0 0 27px; }
    .calc-ob .toggle-extra label {
      font-size: 0.85rem;
      color: var(--gray-text);
    }

    .calc-ob .warn {
      min-height: 0;
      margin: 8px 0 0;
      font-size: 0.84rem;
      color: var(--ochre-dark);
      line-height: 1.45;
    }
    .calc-ob .warn-blocking:not(:empty) {
      padding: 8px 12px;
      background: rgba(171, 127, 98, 0.08);
      border-left: 3px solid var(--ochre);
      border-radius: 4px;
      color: var(--ochre-dark);
      font-weight: 500;
    }
    .calc-ob .form-hint {
      font-size: 0.82rem;
      color: var(--gray-text);
      font-style: italic;
      margin: 14px 0 0;
    }

    /* ============== RISULTATI ============== */
    .calc-ob .results-card {
