  </style>

  <script>
    import { calcolaMutuo } from '~/lib/calcolatori/mutuo';
    import type {
      ModalitaMutuo,
      TipoTasso,
      FrequenzaRata,
      DatoAnnuale,
      RigaAmmortamento,
    } from '~/lib/calcolatori/mutuo';
    import {
      Chart,
      BarController,
      BarElement,
      CategoryScale,
      LinearScale,
      Tooltip,
    } from 'chart.js';

    Chart.register(BarController, BarElement, CategoryScale, LinearScale, Tooltip);

    // -------------------- FORMATTERS --------------------
    const fmtEuro = new Intl.NumberFormat('it-IT', {
      style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2,
    });
    const fmtEuroNoCents = new Intl.NumberFormat('it-IT', {
      style: 'currency', currency: 'EUR', maximumFractionDigits: 0,
    });
    const fmtEuroShort = (v: number): string => {
      if (!Number.isFinite(v)) return '';
      const a = Math.abs(v);
      if (a >= 1_000_000) {
        const m = v / 1_000_000;
        return (Number.isInteger(m) ? m.toString() : m.toFixed(1).replace('.', ',')) + 'M €';
      }
      if (a >= 1_000) return Math.round(v / 1000) + 'K €';
      return Math.round(v) + ' €';
    };
    const fmtPct = (v: number, digits = 2): string => {
      if (!Number.isFinite(v)) return '—';
      return v.toFixed(digits).replace('.', ',') + '%';
    };
    const parseNum = (v: string): number => {
      if (!v) return NaN;
      return parseFloat(v.replace(',', '.'));
    };

    // -------------------- DOM REFS --------------------
    const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
      document.getElementById(id) as T;
    const inputs = {
      modalitaRadios: document.querySelectorAll<HTMLInputElement>('input[name="mu-modalita"]'),
      tipoTassoRadios: document.querySelectorAll<HTMLInputElement>('input[name="mu-tipo-tasso"]'),
      // Mode A
      valoreImmobile: $<HTMLInputElement>('mu-valore-immobile'),
      anticipo: $<HTMLInputElement>('mu-anticipo'),
      // Mode B
      rataSostenibile: $<HTMLInputElement>('mu-rata-sostenibile'),
      anticipoDisponibile: $<HTMLInputElement>('mu-anticipo-disponibile'),
      // Comuni
      durata: $<HTMLInputElement>('mu-durata'),
      durataSlider: $<HTMLInputElement>('mu-durata-slider'),
      tassoFisso: $<HTMLInputElement>('mu-tasso-fisso'),
      spread: $<HTMLInputElement>('mu-spread'),
      euribor: $<HTMLInputElement>('mu-euribor'),
      frequenza: $<HTMLSelectElement>('mu-frequenza'),
      includiTaeg: $<HTMLInputElement>('mu-includi-taeg'),
      istruttoria: $<HTMLInputElement>('mu-istruttoria'),
      perizia: $<HTMLInputElement>('mu-perizia'),
      imposta: $<HTMLInputElement>('mu-imposta'),
      polizzaIncendio: $<HTMLInputElement>('mu-polizza-incendio'),
      polizzaVita: $<HTMLInputElement>('mu-polizza-vita'),
      incasso: $<HTMLInputElement>('mu-incasso'),
    };

    // -------------------- VISIBILITÀ --------------------
    function getModalita(): ModalitaMutuo {
      const r = document.querySelector<HTMLInputElement>('input[name="mu-modalita"]:checked');
      return (r?.value === 'sostenibilita' ? 'sostenibilita' : 'rata') as ModalitaMutuo;
    }
    function getTipoTasso(): TipoTasso {
      const r = document.querySelector<HTMLInputElement>('input[name="mu-tipo-tasso"]:checked');
      return (r?.value === 'variabile' ? 'variabile' : 'fisso') as TipoTasso;
    }

    function setVisibility(): void {
      const modalita = getModalita();
      const modeRata = document.querySelector<HTMLElement>('.mode-rata');
      const modeSost = document.querySelector<HTMLElement>('.mode-sostenibilita');
      if (modeRata) modeRata.hidden = modalita !== 'rata';
      if (modeSost) modeSost.hidden = modalita !== 'sostenibilita';

      const tipoTasso = getTipoTasso();
      const tFisso = document.querySelector<HTMLElement>('.tasso-fisso-group');
      const tVar = document.querySelector<HTMLElement>('.tasso-variabile-group');
      if (tFisso) tFisso.hidden = tipoTasso !== 'fisso';
      if (tVar) tVar.hidden = tipoTasso !== 'variabile';

      const taegSection = $('mu-taeg-section');
      if (taegSection) taegSection.hidden = !inputs.includiTaeg.checked;
    }

    // -------------------- CHART --------------------
    const COLORS = {
      interessi: '#00A652',  // emerald
      capitale: '#79B9AD',   // sage-light
    };

    let chartInstance: import('chart.js').Chart | null = null;
    let firstRender = true;

    const currentChart: { dati: DatoAnnuale[] } = { dati: [] };

    function disegnaChart(dati: DatoAnnuale[]): void {
      const canvas = $('mu-chart') as unknown as HTMLCanvasElement;
      if (!canvas || !dati.length) return;

      currentChart.dati = dati;

      const labels = dati.map((d) => `Anno ${d.anno}`);
      const dataInteressi = dati.map((d) => d.quotaInteressiAnnua);
      const dataCapitale = dati.map((d) => d.quotaCapitaleAnnua);

      const N = dati.length;
      const showXTick = (idx: number): boolean =>
        N > 30 ? idx % 5 === 0 || idx === N - 1
        : N > 18 ? idx % 2 === 0 || idx === N - 1
        : true;
      const rotate = N > 15;

      if (chartInstance) {
        chartInstance.data.labels = labels;
        chartInstance.data.datasets[0].data = dataInteressi;
        chartInstance.data.datasets[1].data = dataCapitale;
        const xs = chartInstance.options.scales?.x as any;
        if (xs?.ticks) {
          xs.ticks.maxRotation = rotate ? 45 : 0;
          xs.ticks.minRotation = rotate ? 45 : 0;
          xs.ticks.callback = function (_v: unknown, idx: number) {
            return showXTick(idx) ? labels[idx] : '';
          };
        }
        chartInstance.setActiveElements([]);
        if (chartInstance.tooltip) {
          chartInstance.tooltip.setActiveElements([], { x: 0, y: 0 });
        }
        chartInstance.update('none');
        return;
      }

      chartInstance = new Chart(canvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            {
              label: 'Quota interessi',
              data: dataInteressi,
              backgroundColor: COLORS.interessi,
              stack: 'rata',
              borderWidth: 0,
            },
            {
              label: 'Quota capitale',
              data: dataCapitale,
              backgroundColor: COLORS.capitale,
              stack: 'rata',
              borderWidth: 0,
              borderRadius: { topLeft: 4, topRight: 4, bottomLeft: 0, bottomRight: 0 },
              borderSkipped: false,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: firstRender ? { duration: 600, easing: 'easeOutQuart' } : false,
          layout: { padding: { top: 8, right: 8, bottom: 4, left: 4 } },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#FFFFFF',
              borderColor: 'rgba(22, 105, 99, 0.25)',
              borderWidth: 1,
              titleColor: '#0F4F4A',
              titleFont: { family: 'Manrope, sans-serif', weight: 700, size: 13 },
              bodyColor: '#373D42',
              bodyFont: { family: 'Manrope, sans-serif', size: 12 },
              footerColor: '#373D42',
              footerFont: { family: 'Manrope, sans-serif', weight: 700, size: 12 },
              padding: 12,
              cornerRadius: 8,
              displayColors: true,
              boxPadding: 4,
              callbacks: {
                title: (items) => {
                  const idx = items[0].dataIndex;
                  const d = currentChart.dati[idx];
                  return d ? `Anno ${d.anno}` : '';
                },
                label: (ctx) =>
                  `  ${ctx.dataset.label}: ${fmtEuro.format(Number(ctx.parsed.y))}`,
                footer: (items) => {
                  const idx = items[0].dataIndex;
                  const d = currentChart.dati[idx];
                  if (!d) return '';
                  return [
                    `Totale rate annue: ${fmtEuro.format(d.rateAnnuTotali)}`,
                    `Capitale residuo a fine anno: ${fmtEuroNoCents.format(d.capitaleResiduoFineAnno)}`,
                  ];
                },
              },
            },
          },
          scales: {
            x: {
              stacked: true,
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                maxRotation: rotate ? 45 : 0,
                minRotation: rotate ? 45 : 0,
                autoSkip: false,
                callback: function (_v: any, idx: number) {
                  return showXTick(idx) ? labels[idx] : '';
                },
              },
            },
            y: {
              stacked: true,
              beginAtZero: true,
              grid: { color: 'rgba(22, 105, 99, 0.15)', lineWidth: 1 },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (v) => fmtEuroShort(v as number),
              },
            },
          },
        },
      });

      requestAnimationFrame(() => {
        if (chartInstance && chartInstance.options) {
          (chartInstance.options as any).animation = false;
        }
      });
      firstRender = false;
    }

    function updateChartFallback(dati: DatoAnnuale[]): void {
      const el = $('mu-chart-fallback');
      if (!el || !dati.length) return;
      const totInteressi = dati.reduce((s, d) => s + d.quotaInteressiAnnua, 0);
      const totCapitale = dati.reduce((s, d) => s + d.quotaCapitaleAnnua, 0);
      el.textContent =
        `Su ${dati.length} anni: capitale rimborsato ${fmtEuro.format(totCapitale)}, ` +
        `interessi pagati ${fmtEuro.format(totInteressi)}.`;
    }

    // -------------------- AMMORTAMENTO TABLE --------------------
    let pianoCorrente: RigaAmmortamento[] = [];

    function aggiornaTabellaAmmortamento(dati: DatoAnnuale[]): void {
      const tbody = $('mu-ammortamento-body');
      if (!tbody) return;
      // Pulisci e ricostruisci
      while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
      for (const d of dati) {
        const tr = document.createElement('tr');
        tr.innerHTML =
          `<td>Anno ${d.anno}</td>` +
          `<td>${fmtEuro.format(d.rateAnnuTotali)}</td>` +
          `<td>${fmtEuro.format(d.quotaInteressiAnnua)}</td>` +
          `<td>${fmtEuro.format(d.quotaCapitaleAnnua)}</td>` +
          `<td>${fmtEuroNoCents.format(d.capitaleResiduoFineAnno)}</td>`;
        tbody.appendChild(tr);
      }
    }

    function exportCSV(): void {
      if (!pianoCorrente.length) return;
      const header = ['Numero rata', 'Anno', 'Quota capitale', 'Quota interessi', 'Rata totale', 'Capitale residuo'];
      const rows = pianoCorrente.map((r) => [
        r.numero,
        r.anno,
        r.quotaCapitale.toFixed(2).replace('.', ','),
        r.quotaInteressi.toFixed(2).replace('.', ','),
        r.rataTotale.toFixed(2).replace('.', ','),
        r.capitaleResiduo.toFixed(2).replace('.', ','),
      ]);
      const csv = [header, ...rows]
        .map((r) => r.map((v) => `"${String(v).replace(/"/g, '""')}"`).join(';'))
        .join('\n');
      const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `piano-ammortamento-mutuo.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // -------------------- MAIN --------------------
    function aggiorna(): void {
      setVisibility();

      const modalita = getModalita();
      const tipoTasso = getTipoTasso();
      const durata = parseNum(inputs.durata.value);
      const tassoFisso = parseNum(inputs.tassoFisso.value);
      const spread = parseNum(inputs.spread.value);
      const euribor = parseNum(inputs.euribor.value);
      const frequenza = inputs.frequenza.value as FrequenzaRata;

      // Sync slider ↔ number per durata
      const durataDisplay = $('mu-durata-display');
      if (durataDisplay && Number.isFinite(durata)) {
        durataDisplay.textContent = `${Math.round(durata)} ann${Math.round(durata) === 1 ? 'o' : 'i'}`;
      }

      // Display tasso variabile attuale
      const tassoVarInfo = $('mu-tasso-variabile-info');
      if (tassoVarInfo && Number.isFinite(spread) && Number.isFinite(euribor)) {
        tassoVarInfo.textContent = `Tasso variabile attuale: ${fmtPct(spread + euribor, 2)}`;
      }

      const blocking = $('mu-blocking');

      // Validazione preliminare
      if (!Number.isFinite(durata) || durata < 1) {
        blocking.textContent = 'Inserisci una durata di almeno 1 anno.';
        return;
      }
      if (durata > 40) {
        blocking.textContent = 'La durata massima è 40 anni.';
        return;
      }

      let valoreImmobile: number | undefined;
      let anticipo: number | undefined;
      let rataSostenibile: number | undefined;
      let anticipoDisponibile: number | undefined;

      if (modalita === 'rata') {
        valoreImmobile = parseNum(inputs.valoreImmobile.value);
        anticipo = parseNum(inputs.anticipo.value);
        if (!Number.isFinite(valoreImmobile) || valoreImmobile <= 0) {
          blocking.textContent = "Inserisci il valore dell'immobile.";
          return;
        }
        if (!Number.isFinite(anticipo) || anticipo < 0) anticipo = 0;
        if (anticipo >= valoreImmobile) {
          blocking.textContent = "L'anticipo è maggiore o uguale al valore dell'immobile: nessun mutuo necessario.";
          return;
        }
      } else {
        rataSostenibile = parseNum(inputs.rataSostenibile.value);
        anticipoDisponibile = parseNum(inputs.anticipoDisponibile.value);
        if (!Number.isFinite(rataSostenibile) || rataSostenibile <= 0) {
          blocking.textContent = 'Inserisci una rata sostenibile maggiore di zero.';
          return;
        }
        if (!Number.isFinite(anticipoDisponibile) || anticipoDisponibile < 0) anticipoDisponibile = 0;
      }

      blocking.textContent = '';

      // Anticipo info (mode A)
      if (modalita === 'rata' && Number.isFinite(valoreImmobile) && Number.isFinite(anticipo)) {
        const importo = (valoreImmobile as number) - (anticipo as number);
        const pct = ((valoreImmobile as number) - (anticipo as number)) / (valoreImmobile as number) * 100;
        const anticipoInfo = $('mu-anticipo-info');
        if (anticipoInfo) {
          anticipoInfo.textContent =
            `Mutuo richiesto: ${fmtEuroNoCents.format(importo)} (${pct.toFixed(0)}% del valore)`;
        }
      }

      // Auto-update imposta sostitutiva (0,25% del mutuo) se non manualmente editata
      if (inputs.imposta.dataset.auto !== 'false') {
        let importoStimato = 0;
        if (modalita === 'rata') {
          importoStimato = Math.max(0, (valoreImmobile as number) - (anticipo as number));
        } else {
          // Stima rapida con la formula base
          const ra = frequenza === 'mensile' ? 12 : frequenza === 'trimestrale' ? 4 : frequenza === 'semestrale' ? 2 : 1;
          const n = Math.round(durata * ra);
          const tan = tipoTasso === 'fisso' ? (tassoFisso || 0) : ((spread || 0) + (euribor || 0));
          const i = (tan / 100) / ra;
          importoStimato = i === 0
            ? (rataSostenibile as number) * n
            : ((rataSostenibile as number) * (1 - Math.pow(1 + i, -n))) / i;
        }
        const imposta = Math.round(importoStimato * 0.0025);
        if (Number.isFinite(imposta) && imposta >= 0) {
          inputs.imposta.value = String(imposta);
        }
      }

      const result = calcolaMutuo({
        modalita,
        valoreImmobile,
        anticipo,
        rataSostenibile,
        anticipoDisponibile,
        durataAnni: durata,
        tipoTasso,
        tassoFisso: Number.isFinite(tassoFisso) ? tassoFisso : 0,
        spread: Number.isFinite(spread) ? spread : 0,
        euribor: Number.isFinite(euribor) ? euribor : 0,
        frequenzaRata: frequenza,
        includiTaeg: inputs.includiTaeg.checked,
        speseAccessorie: inputs.includiTaeg.checked
          ? {
              istruttoria: parseNum(inputs.istruttoria.value) || 0,
              perizia: parseNum(inputs.perizia.value) || 0,
              impostaSostitutiva: parseNum(inputs.imposta.value) || 0,
              polizzaIncendioAnnua: parseNum(inputs.polizzaIncendio.value) || 0,
              polizzaVitaAnnua: parseNum(inputs.polizzaVita.value) || 0,
              speseIncassoRata: parseNum(inputs.incasso.value) || 0,
            }
          : undefined,
      });

      if (!result.ok) {
        blocking.textContent = result.errore ?? 'Dati non validi.';
        return;
      }

      pianoCorrente = result.pianoAmmortamento;

      // Output
      const primaryLabel = $('mu-out-primary-label');
      const primaryVal = $('mu-out-primary');
      const rowImmobile = $('mu-row-immobile');
      const outImmobile = $('mu-out-immobile');

      const rataLabel =
        result.rateAnnuali === 12 ? 'Rata mensile'
        : result.rateAnnuali === 4 ? 'Rata trimestrale'
        : result.rateAnnuali === 2 ? 'Rata semestrale'
        : 'Rata annuale';

      if (modalita === 'rata') {
        primaryLabel.textContent = rataLabel;
        primaryVal.textContent = fmtEuro.format(result.rataPeriodica);
        rowImmobile.hidden = true;
      } else {
        primaryLabel.textContent = 'Importo finanziabile';
        primaryVal.textContent = fmtEuroNoCents.format(result.importoMutuo);
        rowImmobile.hidden = false;
        outImmobile.textContent =
          result.valoreImmobileCalcolato !== undefined
            ? fmtEuroNoCents.format(result.valoreImmobileCalcolato)
            : '—';
      }

      $('mu-out-importo').textContent = fmtEuroNoCents.format(result.importoMutuo);
      $('mu-out-numero-rate').textContent = String(result.numeroRate);
      $('mu-out-interessi').textContent = fmtEuroNoCents.format(result.totaleInteressi);
      $('mu-out-totale').textContent = fmtEuroNoCents.format(result.costoTotaleMutuo);
      $('mu-out-pct').textContent = fmtPct(result.percentualeInteressiSuTotale, 2);
      $('mu-out-tan').textContent = fmtPct(result.tan, 2);
      $('mu-out-ltv').textContent = fmtPct(result.ltv, 1);

      const taegRow = $('mu-row-taeg');
      if (inputs.includiTaeg.checked && result.taeg !== null) {
        taegRow.hidden = false;
        $('mu-out-taeg').textContent = fmtPct(result.taeg, 2);
      } else {
        taegRow.hidden = true;
      }

      // Warnings
      const warnEl = $('mu-warnings');
      while (warnEl.firstChild) warnEl.removeChild(warnEl.firstChild);
      if (result.warning.length) {
        const ul = document.createElement('ul');
        for (const w of result.warning) {
          const li = document.createElement('li');
          li.textContent = w;
          ul.appendChild(li);
        }
        warnEl.appendChild(ul);
      }

      // Subtitle del grafico (educativa)
      const sub = $('mu-chart-subtitle');
      if (sub && result.datiAnnuali.length > 0) {
        const primo = result.datiAnnuali[0];
        const pctInteressiPrimoAnno =
          primo.rateAnnuTotali > 0
            ? (primo.quotaInteressiAnnua / primo.rateAnnuTotali) * 100
            : 0;
        sub.textContent =
          `Anno 1: il ${pctInteressiPrimoAnno.toFixed(0)}% delle rate è interessi. ` +
          `Con gli anni la quota capitale (sage) cresce e quella di interessi (emerald) si riduce.`;
      }

      disegnaChart(result.datiAnnuali);
      updateChartFallback(result.datiAnnuali);
      aggiornaTabellaAmmortamento(result.datiAnnuali);
    }

    // -------------------- DEBOUNCE + WIRING --------------------
    let timer: ReturnType<typeof setTimeout> | null = null;
    function schedule(): void {
      if (timer) clearTimeout(timer);
      timer = setTimeout(aggiorna, 200);
    }

    // Sync slider ↔ number per durata
    inputs.durataSlider.addEventListener('input', () => {
      inputs.durata.value = inputs.durataSlider.value;
      schedule();
    });
    inputs.durata.addEventListener('input', () => {
      const v = parseNum(inputs.durata.value);
      if (Number.isFinite(v) && v >= 5 && v <= 40) {
        inputs.durataSlider.value = String(Math.round(v));
      }
      schedule();
    });

    // Imposta sostitutiva: traccia se l'utente la edita manualmente
    inputs.imposta.addEventListener('input', () => {
      inputs.imposta.dataset.auto = 'false';
      schedule();
    });

    // Reset auto-imposta quando cambia modalità (nuovo scenario)
    inputs.modalitaRadios.forEach((el) =>
      el.addEventListener('change', () => {
        inputs.imposta.dataset.auto = 'true';
        schedule();
      })
    );

    // Tutti gli altri input
    const altri: Array<HTMLInputElement | HTMLSelectElement> = [
      inputs.valoreImmobile,
      inputs.anticipo,
      inputs.rataSostenibile,
      inputs.anticipoDisponibile,
      inputs.tassoFisso,
      inputs.spread,
      inputs.euribor,
      inputs.frequenza,
      inputs.istruttoria,
      inputs.perizia,
      inputs.polizzaIncendio,
      inputs.polizzaVita,
      inputs.incasso,
    ];
    for (const el of altri) {
      el.addEventListener('input', schedule);
      el.addEventListener('change', schedule);
    }
    inputs.includiTaeg.addEventListener('change', schedule);
    inputs.tipoTassoRadios.forEach((el) => el.addEventListener('change', schedule));

    // Export CSV
    const csvBtn = $('mu-export-csv');
    if (csvBtn) csvBtn.addEventListener('click', exportCSV);

    aggiorna();
  </script>
</Layout>
