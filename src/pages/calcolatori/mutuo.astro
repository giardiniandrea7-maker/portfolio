---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Calcolatore Rata Mutuo | Andrea Giardini',
  description:
    'Calcolatore mutuo gratuito: rata, piano di ammortamento, TAEG, confronto tasso fisso e variabile. Calcola anche quanto puoi permetterti in base alla rata sostenibile.',
};
---

<Layout metadata={metadata}>
  <div class="calc-mu">
    <!-- ============== HERO ============== -->
    <header class="calc-header">
      <h1>Calcolatore Rata Mutuo</h1>
      <p>
        Stima la rata del tuo mutuo, scopri come si compone tra capitale e interessi e simula
        scenari diversi tra tasso fisso e variabile. Strumento puramente indicativo: per
        un'offerta reale, rivolgiti alla tua banca o al tuo consulente.
      </p>
    </header>

    <!-- ============== TAB MODALITÀ ============== -->
    <fieldset class="modal-tabs" role="radiogroup" aria-label="Modalità di calcolo">
      <legend class="sr-only">Modalità di calcolo</legend>
      <label class="tab-pill">
        <input type="radio" name="mu-modalita" value="rata" checked />
        <span class="tab-content">
          <span class="tab-title">Calcola la rata</span>
          <span class="tab-desc">Inserisci immobile e anticipo</span>
        </span>
      </label>
      <label class="tab-pill">
        <input type="radio" name="mu-modalita" value="sostenibilita" />
        <span class="tab-content">
          <span class="tab-title">Quanto posso permettermi</span>
          <span class="tab-desc">Inserisci la rata sostenibile</span>
        </span>
      </label>
    </fieldset>

    <!-- ============== FORM + RISULTATI ============== -->
    <div class="main-grid">
      <!-- COLONNA SX: FORM -->
      <div class="card form-card">
        <h2 class="card-title">Inserisci i dati del mutuo</h2>

        <!-- Modalità: Calcola la rata -->
        <div class="mode-rata">
          <div class="form-group">
            <label for="mu-valore-immobile">Valore dell'immobile</label>
            <div class="input-with-suffix">
              <input type="number" id="mu-valore-immobile" min="0" step="5000" value="250000" inputmode="decimal" />
              <span class="suffix">€</span>
            </div>
          </div>
          <div class="form-group">
            <label for="mu-anticipo">Anticipo</label>
            <div class="input-with-suffix">
              <input type="number" id="mu-anticipo" min="0" step="1000" value="50000" inputmode="decimal" />
              <span class="suffix">€</span>
            </div>
            <p class="form-hint hint-info" id="mu-anticipo-info">Mutuo richiesto: —</p>
          </div>
        </div>

        <!-- Modalità: Quanto posso permettermi -->
        <div class="mode-sostenibilita" hidden>
          <div class="form-group">
            <label for="mu-rata-sostenibile">Rata mensile sostenibile</label>
            <div class="input-with-suffix">
              <input type="number" id="mu-rata-sostenibile" min="100" step="50" value="800" inputmode="decimal" />
              <span class="suffix">€</span>
            </div>
            <p class="form-hint">
              Le banche generalmente richiedono che la rata non superi il 30–35% del reddito
              netto mensile.
            </p>
          </div>
          <div class="form-group">
            <label for="mu-anticipo-disponibile">Anticipo disponibile</label>
            <div class="input-with-suffix">
              <input type="number" id="mu-anticipo-disponibile" min="0" step="1000" value="30000" inputmode="decimal" />
              <span class="suffix">€</span>
            </div>
          </div>
        </div>

        <!-- Durata -->
        <div class="form-group">
          <label for="mu-durata">Durata mutuo: <span class="durata-display" id="mu-durata-display">25 anni</span></label>
          <div class="durata-row">
            <input type="range" id="mu-durata-slider" min="5" max="40" step="1" value="25" />
            <input type="number" id="mu-durata" min="5" max="40" step="1" value="25" inputmode="numeric" class="durata-number" />
          </div>
        </div>

        <!-- Tipo tasso -->
        <fieldset class="form-group radio-group">
          <legend>Tipologia tasso</legend>
          <div class="radio-inline">
            <label><input type="radio" name="mu-tipo-tasso" value="fisso" checked /> Fisso</label>
            <label><input type="radio" name="mu-tipo-tasso" value="variabile" /> Variabile</label>
          </div>
        </fieldset>

        <!-- Tasso fisso -->
        <div class="tasso-fisso-group">
          <div class="form-group">
            <label for="mu-tasso-fisso">Tasso annuo (TAN)</label>
            <div class="input-with-suffix">
              <input type="number" id="mu-tasso-fisso" min="0" max="15" step="0.05" value="3.5" inputmode="decimal" />
              <span class="suffix">%</span>
            </div>
          </div>
        </div>

        <!-- Tasso variabile -->
        <div class="tasso-variabile-group" hidden>
          <div class="form-row-2">
            <div class="form-group">
              <label for="mu-spread">Spread</label>
              <div class="input-with-suffix">
                <input type="number" id="mu-spread" min="0" max="5" step="0.05" value="1.2" inputmode="decimal" />
                <span class="suffix">%</span>
              </div>
            </div>
            <div class="form-group">
              <label for="mu-euribor">Euribor di riferimento</label>
              <div class="input-with-suffix">
                <input type="number" id="mu-euribor" min="-1" max="10" step="0.05" value="2.5" inputmode="decimal" />
                <span class="suffix">%</span>
              </div>
            </div>
          </div>
          <p class="form-hint hint-info" id="mu-tasso-variabile-info">Tasso variabile attuale: —</p>
          <p class="form-hint">
            Per il calcolo iniziale assumiamo che il tasso variabile rimanga costante per tutta
            la durata. La composizione interesse/capitale potrebbe variare nel tempo.
          </p>
        </div>

        <!-- Frequenza rata -->
        <div class="form-group">
          <label for="mu-frequenza">Frequenza rata</label>
          <select id="mu-frequenza">
            <option value="mensile" selected>Mensile</option>
            <option value="trimestrale">Trimestrale</option>
            <option value="semestrale">Semestrale</option>
            <option value="annuale">Annuale</option>
          </select>
        </div>

        <!-- TAEG toggle -->
        <div class="toggle-block">
          <label class="toggle-row">
            <input type="checkbox" id="mu-includi-taeg" />
            <span class="toggle-text">Includi TAEG (con spese accessorie)</span>
          </label>
          <p class="toggle-hint">
            Il TAEG è il costo effettivo del mutuo, inclusi spese di istruttoria, polizze
            obbligatorie e oneri ricorrenti. È sempre ≥ TAN.
          </p>

          <div class="toggle-extra" id="mu-taeg-section" hidden>
            <h3 class="taeg-subtitle">Spese accessorie</h3>
            <div class="form-row-2">
              <div class="form-group">
                <label for="mu-istruttoria">Spese istruttoria</label>
                <div class="input-with-suffix">
                  <input type="number" id="mu-istruttoria" min="0" step="50" value="500" inputmode="decimal" />
                  <span class="suffix">€</span>
                </div>
              </div>
              <div class="form-group">
                <label for="mu-perizia">Spese perizia</label>
                <div class="input-with-suffix">
                  <input type="number" id="mu-perizia" min="0" step="50" value="300" inputmode="decimal" />
                  <span class="suffix">€</span>
                </div>
              </div>
            </div>
            <div class="form-row-2">
              <div class="form-group">
                <label for="mu-imposta">Imposta sostitutiva</label>
                <div class="input-with-suffix">
                  <input type="number" id="mu-imposta" min="0" step="10" value="500" inputmode="decimal" data-auto="true" />
                  <span class="suffix">€</span>
                </div>
                <p class="form-hint">Default: 0,25% del mutuo (prima casa).</p>
              </div>
              <div class="form-group">
                <label for="mu-incasso">Spese incasso rata</label>
                <div class="input-with-suffix">
                  <input type="number" id="mu-incasso" min="0" step="0.5" value="2" inputmode="decimal" />
                  <span class="suffix">€/rata</span>
                </div>
              </div>
            </div>
            <div class="form-row-2">
              <div class="form-group">
                <label for="mu-polizza-incendio">Polizza incendio</label>
                <div class="input-with-suffix">
                  <input type="number" id="mu-polizza-incendio" min="0" step="10" value="200" inputmode="decimal" />
                  <span class="suffix">€/anno</span>
                </div>
              </div>
              <div class="form-group">
                <label for="mu-polizza-vita">Polizza vita (opzionale)</label>
                <div class="input-with-suffix">
                  <input type="number" id="mu-polizza-vita" min="0" step="10" value="0" inputmode="decimal" />
                  <span class="suffix">€/anno</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <p class="form-hint">Il calcolo si aggiorna automaticamente.</p>
        <p class="warn warn-blocking" id="mu-blocking" role="alert" aria-live="assertive"></p>
      </div>

      <!-- COLONNA DX: RISULTATI -->
      <div class="card results-card" aria-live="polite" aria-atomic="true">
        <h2 class="card-title">Risultati</h2>

        <div class="result-block result-primary">
          <span class="result-label" id="mu-out-primary-label">Rata mensile</span>
          <span class="result-value result-value-xl" id="mu-out-primary">—</span>
        </div>
        <div class="result-block" id="mu-row-immobile" hidden>
          <span class="result-label">Immobile teoricamente acquistabile</span>
          <span class="result-value" id="mu-out-immobile">—</span>
        </div>

        <h3 class="metrics-title">Dettaglio</h3>
        <ul class="metrics-list">
          <li><span class="m-label">Mutuo richiesto</span><span class="m-value" id="mu-out-importo">—</span></li>
          <li><span class="m-label">Numero rate</span><span class="m-value" id="mu-out-numero-rate">—</span></li>
          <li><span class="m-label">Totale interessi pagati</span><span class="m-value" id="mu-out-interessi">—</span></li>
          <li><span class="m-label">Costo totale del mutuo</span><span class="m-value" id="mu-out-totale">—</span></li>
          <li><span class="m-label">% interessi sul totale</span><span class="m-value" id="mu-out-pct">—</span></li>
          <li><span class="m-label">TAN</span><span class="m-value" id="mu-out-tan">—</span></li>
          <li id="mu-row-taeg" hidden><span class="m-label">TAEG</span><span class="m-value" id="mu-out-taeg">—</span></li>
          <li><span class="m-label">Loan-to-Value (LTV)</span><span class="m-value" id="mu-out-ltv">—</span></li>
        </ul>

        <div class="warn-list" id="mu-warnings" aria-live="polite"></div>
      </div>
    </div>

    <!-- ============== GRAFICO ============== -->
    <section class="card chart-card" aria-label="Composizione delle rate nel tempo">
      <div class="chart-header">
        <h2 class="card-title">Composizione delle rate nel tempo</h2>
        <p class="chart-subtitle" id="mu-chart-subtitle">Nei primi anni paghi soprattutto interessi; con gli anni cresce la quota di capitale rimborsato.</p>
        <div class="chart-legend">
          <span class="legend-item"><span class="legend-swatch legend-interessi" aria-hidden="true"></span>Quota interessi</span>
          <span class="legend-item"><span class="legend-swatch legend-capitale" aria-hidden="true"></span>Quota capitale</span>
        </div>
      </div>
      <div class="chart-wrap">
        <canvas id="mu-chart" aria-label="Grafico a barre impilate della composizione interesse/capitale per anno" role="img"></canvas>
      </div>
      <p id="mu-chart-fallback" class="sr-only" aria-live="polite"></p>
    </section>

    <!-- ============== PIANO DI AMMORTAMENTO ============== -->
    <section class="how-it-works">
      <details class="math-details">
        <summary>
          <span class="summary-text">Mostra il piano di ammortamento dettagliato</span>
          <span class="summary-icon" aria-hidden="true"></span>
        </summary>
        <div class="ammortamento-content">
          <p class="ammortamento-intro">
            Vista aggregata anno per anno. Per ottenere il piano completo rata per rata,
            usa il pulsante "Esporta CSV" in fondo.
          </p>
          <div class="table-scroll">
            <table class="ammortamento-table" id="mu-ammortamento">
              <caption class="sr-only">Piano di ammortamento aggregato per anno</caption>
              <thead>
                <tr>
                  <th scope="col">Anno</th>
                  <th scope="col">Rate annue</th>
                  <th scope="col">Quota interessi</th>
                  <th scope="col">Quota capitale</th>
                  <th scope="col">Capitale residuo</th>
                </tr>
              </thead>
              <tbody id="mu-ammortamento-body"></tbody>
            </table>
          </div>
          <button type="button" class="btn btn-secondary csv-btn" id="mu-export-csv">
            Esporta CSV (rata per rata)
          </button>
        </div>
      </details>
    </section>

    <!-- ============== COME FUNZIONA ============== -->
    <section class="how-it-works">
      <details class="math-details">
        <summary>
          <span class="summary-text">Mostra la matematica del mutuo</span>
          <span class="summary-icon" aria-hidden="true"></span>
        </summary>
        <div class="math-content">
          <h2>Come funziona il calcolatore</h2>
          <p>
            Il calcolo usa il modello dell'<b>ammortamento alla francese</b>: la rata è
            <em>costante</em> per tutta la durata del mutuo, ma la sua composizione cambia anno
            dopo anno. Nei primi anni paghi soprattutto interessi (perché il capitale residuo è
            ancora alto e gli interessi si calcolano su quello), via via la quota capitale
            cresce e quella di interessi si riduce. È esattamente quello che vedi nel grafico
            sopra.
          </p>
          <p>
            Il <b>TAN</b> (Tasso Annuo Nominale) è il tasso "puro" applicato al capitale; il
            <b>TAEG</b> (Tasso Annuo Effettivo Globale) è il costo complessivo che include
            tutte le spese obbligatorie (istruttoria, perizia, imposte, polizze obbligatorie,
            spese di incasso). Il TAEG è sempre <b>≥ TAN</b>: serve per confrontare offerte
            diverse a parità di costo reale.
          </p>
          <p>
            Tasso <b>fisso</b> e <b>variabile</b>: il fisso ti dà certezza sulla rata per tutta
            la durata, al prezzo di un tasso più alto al momento della firma; il variabile
            (di norma <em>spread</em> + <em>Euribor</em>) parte spesso più basso ma può salire
            o scendere nel tempo. Storicamente nessuno dei due "vince sempre": la scelta
            dipende dall'orizzonte, dalla tua tolleranza al rischio e dal contesto dei tassi.
          </p>

          <h3>Formula della rata</h3>
          <div class="formula-block">
            <i>R</i> =
            <span class="frac">
              <span class="frac-top"><i>C</i> · <i>i</i></span>
              <span class="frac-bottom">1 − (1 + <i>i</i>)<sup>−<i>N</i></sup></span>
            </span>
          </div>
          <ul>
            <li><b>R</b> — rata periodica</li>
            <li><b>C</b> — capitale (importo finanziato)</li>
            <li><b>i</b> — tasso periodico = TAN annuo / numero rate per anno</li>
            <li><b>N</b> — numero totale di rate (durata in anni × rate per anno)</li>
          </ul>

          <h3>Esempio numerico</h3>
          <p>
            Mutuo di 200.000 € a 25 anni, TAN 3,5%, rata mensile.<br />
            <i>i</i> = 3,5% / 12 ≈ 0,2917%, &nbsp; <i>N</i> = 25 × 12 = 300.<br />
            <i>R</i> ≈ <b>1.001,25 €/mese</b>. Su 300 rate paghi circa 300.375 €, di cui
            ~100.375 € sono interessi (33% del totale rimborsato).
          </p>

          <p class="formula-note">
            Questo calcolatore usa l'ammortamento alla francese standard. Alcune banche
            applicano varianti minori (es. capitalizzazione trimestrale degli interessi,
            spread di indicizzazione del variabile, modalità di gestione delle date di
            scadenza) che possono produrre rate leggermente diverse. Per offerte reali, fai
            sempre riferimento al piano di ammortamento ufficiale fornito dalla banca.
          </p>
        </div>
      </details>
    </section>

    <!-- ============== CTA ============== -->
    <section class="cta-section">
      <div class="eyebrow">Vuoi un parere professionale?</div>
      <h2>Stai valutando un mutuo o vuoi capire se conviene una surroga?</h2>
      <p>
        Posso aiutarti ad analizzare la tua offerta, confrontarla con alternative di mercato e
        capire l'impatto reale del mutuo sulla tua situazione finanziaria. La prima chiamata è
        gratuita e senza impegno.
      </p>
      <div class="cta-buttons">
        <a href="/contatti" class="btn btn-primary">Prenota una consulenza</a>
        <a href="/calcolatori" class="btn btn-secondary">Torna ai calcolatori</a>
      </div>
    </section>

    <!-- ============== DISCLAIMER ============== -->
    <div class="final-disclaimer">
      <strong>Nota informativa:</strong> Le stime fornite hanno valore puramente indicativo e
      didattico. Il calcolo si basa sull'ammortamento alla francese standard e sui parametri
      inseriti dall'utente. Le offerte reali delle banche possono differire per:
      capitalizzazione degli interessi, spese non considerate, modalità di indicizzazione del
      tasso variabile, garanzie richieste e altri elementi specifici. Per un'offerta concreta
      rivolgiti alla tua banca o al tuo consulente. Questo strumento non costituisce
      consulenza finanziaria personalizzata.
    </div>
  </div>

  <style is:global>
    .calc-mu {
      --sage: #166963; --sage-light: #79B9AD; --sage-dark: #0F4F4A;
      --ochre: #AB7F62; --ochre-light: #C49A7E; --ochre-dark: #8A6449;
      --ivory: rgb(238 247 246); --ivory-warm: rgb(245 250 249);
      --charcoal: #373D42;
      --emerald: #00A652;
      --gray-soft: #DDE4E2; --gray-text: #6B7672;
      --shadow-soft: 0 4px 20px rgba(55, 61, 66, 0.06);
      --radius: 12px;

      font-family: 'Manrope', -apple-system, sans-serif;
      color: var(--charcoal);
      line-height: 1.65;
      font-size: 16px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px 60px;
    }
    .calc-mu * { box-sizing: border-box; }

    .calc-mu .calc-header {
      text-align: center;
      margin-bottom: 28px;
      padding-bottom: 22px;
      border-bottom: 1px solid var(--gray-soft);
    }
    .calc-mu .calc-header h1 {
      font-family: var(--aw-font-heading, 'Manrope', sans-serif);
      font-size: clamp(1.7rem, 3.6vw, 2.2rem);
      color: var(--sage-dark);
      font-weight: 600;
      margin-bottom: 14px;
      letter-spacing: -0.01em;
    }
    .calc-mu .calc-header p {
      color: var(--gray-text);
      font-size: 1rem;
      max-width: 760px;
      margin: 0 auto;
      line-height: 1.65;
    }

    /* Tab modalità */
    .calc-mu .modal-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 0 0 24px;
      border: 0;
      padding: 0;
    }
    .calc-mu .tab-pill {
      position: relative;
      display: block;
      padding: 14px 18px;
      border: 1.5px solid var(--gray-soft);
      border-radius: 10px;
      cursor: pointer;
      background: white;
      transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
    }
    .calc-mu .tab-pill input[type="radio"] {
      position: absolute; opacity: 0; pointer-events: none;
    }
    .calc-mu .tab-pill:hover { border-color: var(--sage-light); }
    .calc-mu .tab-pill:has(input:checked) {
      border-color: var(--emerald);
      background: rgba(0, 166, 82, 0.06);
      box-shadow: 0 0 0 3px rgba(0, 166, 82, 0.10);
    }
    .calc-mu .tab-pill:has(input:focus-visible) {
      outline: 2px solid var(--emerald);
      outline-offset: 2px;
    }
    .calc-mu .tab-content { display: block; }
    .calc-mu .tab-title {
      display: block; font-weight: 600; color: var(--sage-dark); font-size: 0.98rem;
    }
    .calc-mu .tab-desc {
      display: block; color: var(--gray-text); font-size: 0.82rem; margin-top: 2px;
    }

    /* Grid */
    .calc-mu .main-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 30px;
      align-items: start;
    }
    .calc-mu .card {
      background: white;
      border: 1px solid rgba(22, 105, 99, 0.15);
      border-radius: var(--radius);
      padding: 26px 28px;
      box-shadow: var(--shadow-soft);
    }
    .calc-mu .card-title {
      font-family: var(--aw-font-heading, 'Manrope', sans-serif);
      font-size: 1.15rem;
      color: var(--sage-dark);
      font-weight: 600;
      margin: 0 0 18px;
      letter-spacing: -0.01em;
    }

    /* Form */
    .calc-mu .form-group { margin-bottom: 16px; }
    .calc-mu .form-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .calc-mu label,
    .calc-mu .modal-tabs legend,
    .calc-mu .radio-group legend {
      display: block;
      font-weight: 500;
      color: var(--charcoal);
      margin-bottom: 6px;
      font-size: 0.9rem;
      padding: 0;
    }
    .calc-mu input[type="number"],
    .calc-mu input[type="text"],
    .calc-mu select {
      width: 100%;
      padding: 10px 12px;
      border: 1.5px solid var(--gray-soft);
      border-radius: 8px;
      font-family: 'Manrope', sans-serif;
      font-size: 0.95rem;
      color: var(--charcoal);
      background: white;
      transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .calc-mu input:focus,
    .calc-mu select:focus {
      outline: none;
      border-color: var(--emerald);
      box-shadow: 0 0 0 3px rgba(0, 166, 82, 0.15);
    }
    .calc-mu input[type="number"]::-webkit-outer-spin-button,
    .calc-mu input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none; margin: 0;
    }
    .calc-mu input[type="number"] { -moz-appearance: textfield; }

    .calc-mu .input-with-suffix { position: relative; }
    .calc-mu .input-with-suffix .suffix {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      color: var(--gray-text); font-size: 0.9rem; pointer-events: none;
    }
    .calc-mu .input-with-suffix input { padding-right: 60px; }

