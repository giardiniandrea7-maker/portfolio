      PointElement,
      BarController,
      BarElement,
      CategoryScale,
      LinearScale,
      Tooltip,
      Filler,
    } from 'chart.js';

    Chart.register(
      LineController,
      LineElement,
      PointElement,
      BarController,
      BarElement,
      CategoryScale,
      LinearScale,
      Tooltip,
      Filler
    );

    // -------------------- FORMATTERS --------------------
    const fmtEuro = new Intl.NumberFormat('it-IT', {
      style: 'currency', currency: 'EUR', maximumFractionDigits: 0,
    });
    const fmtEuroShort = (v: number): string => {
      if (!Number.isFinite(v)) return '';
      const a = Math.abs(v);
      if (a >= 1_000_000) {
        const m = v / 1_000_000;
        return (Number.isInteger(m) ? m.toString() : m.toFixed(1).replace('.', ',')) + 'M €';
      }
      if (a >= 1_000) return Math.round(v / 1000) + 'K €';
      return Math.round(v) + ' €';
    };
    const fmtPct = (v: number, digits = 2): string => {
      if (!Number.isFinite(v)) return '—';
      return v.toFixed(digits).replace('.', ',') + '%';
    };
    const fmtPctSigned = (v: number, digits = 1): string => {
      if (!Number.isFinite(v)) return '—';
      const sign = v >= 0 ? '+' : '';
      return sign + v.toFixed(digits).replace('.', ',') + '%';
    };
    const parseNum = (v: string): number => {
      if (!v) return NaN;
      return parseFloat(v.replace(',', '.'));
    };

    // -------------------- DOM REFS --------------------
    const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
      document.getElementById(id) as T;
    const inputs = {
      modalitaRadios: document.querySelectorAll<HTMLInputElement>('input[name="rd-modalita"]'),
      vistaRadios: document.querySelectorAll<HTMLInputElement>('input[name="rd-vista"]'),
      spese: $<HTMLInputElement>('rd-spese'),
      capitale: $<HTMLInputElement>('rd-capitale'),
      anni: $<HTMLInputElement>('rd-anni'),
      anniSlider: $<HTMLInputElement>('rd-anni-slider'),
      rendimento: $<HTMLInputElement>('rd-rendimento'),
      inflazione: $<HTMLInputElement>('rd-inflazione'),
      ereditaToggle: $<HTMLInputElement>('rd-eredita-toggle'),
      ereditaTarget: $<HTMLInputElement>('rd-eredita-target'),
    };

    // -------------------- VISIBILITY --------------------
    function getModalita(): ModalitaRendita {
      const r = document.querySelector<HTMLInputElement>('input[name="rd-modalita"]:checked');
      return (r?.value === 'rendita-sostenibile'
        ? 'rendita-sostenibile'
        : 'capitale-necessario') as ModalitaRendita;
    }
    function getVista(): 'nominale' | 'reale' {
      const r = document.querySelector<HTMLInputElement>('input[name="rd-vista"]:checked');
      return r?.value === 'reale' ? 'reale' : 'nominale';
    }

    function setVisibility(): void {
      const modalita = getModalita();
      const modeA = document.querySelector<HTMLElement>('.mode-a');
      const modeB = document.querySelector<HTMLElement>('.mode-b');
      if (modeA) modeA.hidden = modalita !== 'capitale-necessario';
      if (modeB) modeB.hidden = modalita !== 'rendita-sostenibile';

      const ereditaSec = $('rd-eredita-section');
      if (ereditaSec) ereditaSec.hidden = !inputs.ereditaToggle.checked;

      const tassoPrelRow = $('rd-row-tasso-prelievo');
      if (tassoPrelRow) tassoPrelRow.hidden = modalita !== 'rendita-sostenibile';
    }

    // Aggiorna l'hint sotto il toggle nominale/reale
    function aggiornaVistaHint(): void {
      const el = $('rd-vista-hint');
      if (!el) return;
      el.textContent = getVista() === 'reale'
        ? "Quanto potrai davvero comprare con quel denaro, nei prezzi di oggi."
        : "Il numero che leggerai sul tuo conto: importi in euro correnti, non aggiustati per l'inflazione.";
    }

    // -------------------- COLORI BRAND --------------------
    const COLORS = {
      emerald: '#00A652',
      sage: '#166963',
      sageLight: '#79B9AD',
      ochre: '#AB7F62',
      ochreDark: '#8A6449',
      charcoal: '#373D42',
      grayText: '#6B7672',
      red: '#c0392b',
    };

    let chart1: import('chart.js').Chart | null = null;
    let chart2: import('chart.js').Chart | null = null;
    let chart3: import('chart.js').Chart | null = null;
    let firstRender1 = true;
    let firstRender2 = true;
    let firstRender3 = true;

    // Stato condiviso letto dai callback Chart.js (evita stale closure)
    const currentChart: {
      andamento: AndamentoAnnuo[];
      vista: 'nominale' | 'reale';
      capitaleEsauritoAnno: number | null;
      capitaleIniziale: number;
      ereditaAttiva: boolean;
      ereditaTargetReale: number;
      inflazione: number;
      scenarioPess?: ScenarioCurva;
      scenarioAtt?: ScenarioCurva;
      scenarioOtt?: ScenarioCurva;
      scenarioCliff?: ScenarioCurva | null;
    } = {
      andamento: [], vista: 'reale', capitaleEsauritoAnno: null,
      capitaleIniziale: 0, ereditaAttiva: false, ereditaTargetReale: 0, inflazione: 0,
    };

    // ============== CHART 1: CURVA DI DECUMULAZIONE ==============
    function disegnaChart1(
      andamento: AndamentoAnnuo[],
      vista: 'nominale' | 'reale',
      capitaleIniziale: number,
      ereditaTargetReale: number,
      ereditaAttiva: boolean,
      capitaleEsauritoAnno: number | null,
      inflazione: number
    ): void {
      const canvas = $('rd-chart') as unknown as HTMLCanvasElement;
      if (!canvas || !andamento.length) return;

      currentChart.andamento = andamento;
      currentChart.vista = vista;
      currentChart.capitaleEsauritoAnno = capitaleEsauritoAnno;
      currentChart.capitaleIniziale = capitaleIniziale;
      currentChart.ereditaAttiva = ereditaAttiva;
      currentChart.ereditaTargetReale = ereditaTargetReale;
      currentChart.inflazione = inflazione;

      const labels = andamento.map((a) => `Anno ${a.anno}`);
      const dataCap = andamento.map((a) =>
        vista === 'nominale' ? a.capitaleNominale : a.capitaleReale
      );
      const N = andamento.length - 1;
      const milestones = new Set([0, Math.round(N / 4), Math.round(N / 2), Math.round((3 * N) / 4), N]);

      // Linea di riferimento orizzontale al capitale iniziale
      // (in vista nominale resta a capitaleIniziale; in vista reale uguale, perché
      // anno 0 non è ancora deflattato.)
      const dataRef = andamento.map(() => capitaleIniziale);

      const dataEredita = ereditaAttiva
        ? andamento.map((a) =>
            vista === 'nominale'
              ? ereditaTargetReale * Math.pow(1 + inflazione / 100, a.anno)
              : ereditaTargetReale
          )
        : null;

      const datasets: any[] = [
        {
          label: 'Capitale di partenza',
          data: dataRef,
          borderColor: 'rgba(55, 61, 66, 0.5)',
          borderDash: [4, 4],
          borderWidth: 1.5,
          pointRadius: 0,
          pointHoverRadius: 0,
          fill: false,
          tension: 0,
        },
        {
          label: 'Capitale residuo',
          data: dataCap,
          borderColor: COLORS.emerald,
          backgroundColor: 'rgba(0, 166, 82, 0.15)',
          borderWidth: 3,
          pointRadius: (ctx: any) => {
            const idx = ctx.dataIndex;
            const a = andamento[idx];
            if (capitaleEsauritoAnno !== null && a?.anno === capitaleEsauritoAnno) return 7;
            return milestones.has(idx) ? 4 : 0;
          },
          pointBackgroundColor: (ctx: any) => {
            const a = andamento[ctx.dataIndex];
            return capitaleEsauritoAnno !== null && a?.anno === capitaleEsauritoAnno
              ? COLORS.red
              : COLORS.emerald;
          },
          pointBorderColor: '#FFFFFF',
          pointBorderWidth: 2,
          pointHoverRadius: 7,
          fill: 'origin',
          tension: 0.2,
        },
      ];
      if (dataEredita) {
        datasets.push({
          label: 'Target eredità',
          data: dataEredita,
          borderColor: COLORS.sage,
          borderDash: [6, 4],
          borderWidth: 1.5,
          pointRadius: 0,
          pointHoverRadius: 0,
          fill: false,
          tension: 0,
        });
      }

      // Asse Y: NON parte da zero
      const allValues = dataCap.concat([capitaleIniziale]);
      if (dataEredita) allValues.push(...dataEredita);
      const minV = Math.min(...allValues);
      const maxV = Math.max(...allValues);
      const yMin = Math.max(0, Math.floor(minV * 0.9));
      const yMax = Math.ceil(maxV * 1.1);

      const showXTick = (idx: number): boolean =>
        N > 30 ? idx % 5 === 0 || idx === N
        : N > 15 ? idx % 3 === 0 || idx === N
        : true;

      if (chart1) {
        chart1.data.labels = labels;
        chart1.data.datasets = datasets;
        chart1.setActiveElements([]);
        if (chart1.tooltip) chart1.tooltip.setActiveElements([], { x: 0, y: 0 });
        const ys = chart1.options.scales?.y as any;
        if (ys) { ys.min = yMin; ys.max = yMax; }
        const xs = chart1.options.scales?.x as any;
        if (xs?.ticks) {
          xs.ticks.callback = function (_v: unknown, idx: number) {
            return showXTick(idx) ? labels[idx] : '';
          };
        }
        chart1.update('none');
        return;
      }

      chart1 = new Chart(canvas, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: firstRender1 ? { duration: 800, easing: 'easeOutQuart' } : false,
          layout: { padding: { top: 8, right: 8, bottom: 4, left: 4 } },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#FFFFFF',
              borderColor: 'rgba(22, 105, 99, 0.25)',
              borderWidth: 1,
              titleColor: '#0F4F4A',
              titleFont: { family: 'Manrope, sans-serif', weight: 700, size: 13 },
              bodyColor: COLORS.charcoal,
              bodyFont: { family: 'Manrope, sans-serif', size: 12 },
              padding: 12,
              cornerRadius: 8,
              displayColors: false,
              callbacks: {
                title: (items) => {
                  const a = currentChart.andamento[items[0].dataIndex];
                  return a ? `Anno ${a.anno}` : '';
                },
                label: (ctx) => {
                  const a = currentChart.andamento[ctx.dataIndex];
                  if (!a) return '';
                  if (ctx.datasetIndex === 0) return ''; // ref
                  if (ctx.datasetIndex === 2) {
                    return `Target eredità: ${fmtEuro.format(Number(ctx.parsed.y))}`;
                  }
                  const lines: string[] = [];
                  if (currentChart.vista === 'nominale') {
                    lines.push(`Capitale: ${fmtEuro.format(a.capitaleNominale)}`);
                    lines.push(`Equivalente in € di oggi: ${fmtEuro.format(a.capitaleReale)}`);
                  } else {
                    lines.push(`Potere d'acquisto: ${fmtEuro.format(a.capitaleReale)}`);
                    lines.push(`Capitale nominale: ${fmtEuro.format(a.capitaleNominale)}`);
                  }
                  if (a.anno > 0) {
                    lines.push(`Prelievo annuo: ${fmtEuro.format(a.prelievoNominale)}`);
                    lines.push(`Inflazione cumulata: ${fmtPctSigned(a.inflazioneCumulata, 1)}`);
                  }
                  if (currentChart.capitaleEsauritoAnno !== null && a.anno === currentChart.capitaleEsauritoAnno) {
                    lines.push('⚠ Capitale esaurito qui');
                  }
                  return lines;
                },
              },
            },
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: COLORS.grayText,
                font: { family: 'Manrope, sans-serif', size: 11 },
                autoSkip: false,
                callback: function (_v: any, idx: number) {
                  return showXTick(idx) ? labels[idx] : '';
                },
              },
            },
            y: {
              min: yMin,
              max: yMax,
              grid: { color: 'rgba(22, 105, 99, 0.15)', lineWidth: 1 },
              border: { display: false },
              ticks: {
                color: COLORS.grayText,
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (v) => fmtEuroShort(v as number),
              },
            },
          },
        },
      });
      requestAnimationFrame(() => {
        if (chart1 && chart1.options) (chart1.options as any).animation = false;
      });
      firstRender1 = false;
    }

    // ============== CHART 2: TRE SCENARI ==============
    function disegnaChart2(
      pess: ScenarioCurva,
      att: ScenarioCurva,
      ott: ScenarioCurva,
      capitaleIniziale: number
    ): void {
      const canvas = $('rd-chart-scenari') as unknown as HTMLCanvasElement;
      if (!canvas || !att.andamento.length) return;

      currentChart.scenarioPess = pess;
      currentChart.scenarioAtt = att;
      currentChart.scenarioOtt = ott;

      const labels = att.andamento.map((a) => `Anno ${a.anno}`);
      const N = att.andamento.length - 1;
      // Tutte le serie in valori REALI
      const dataPess = pess.andamento.map((a) => a.capitaleReale);
      const dataAtt = att.andamento.map((a) => a.capitaleReale);
      const dataOtt = ott.andamento.map((a) => a.capitaleReale);
      const dataRef = att.andamento.map(() => capitaleIniziale);

      const allValues = dataPess.concat(dataAtt, dataOtt, [capitaleIniziale]);
      const minV = Math.min(...allValues);
      const maxV = Math.max(...allValues);
      const yMin = Math.max(0, Math.floor(minV * 0.9));
      const yMax = Math.ceil(maxV * 1.1);

      const showXTick = (idx: number): boolean =>
        N > 30 ? idx % 5 === 0 || idx === N
        : N > 15 ? idx % 3 === 0 || idx === N
        : true;

      const datasets: any[] = [
        {
          label: 'Capitale di partenza',
          data: dataRef,
          borderColor: 'rgba(55, 61, 66, 0.4)',
          borderDash: [4, 4],
          borderWidth: 1.5,
          pointRadius: 0,
          fill: false,
          tension: 0,
        },
        // Ottimistico (top boundary della banda)
        {
          label: `Ottimistico (${fmtPct(ott.rendimentoUsato, 1)})`,
          data: dataOtt,
          borderColor: COLORS.sageLight,
          backgroundColor: 'rgba(55, 61, 66, 0.08)',
          borderWidth: 2,
          pointRadius: 0,
          pointHoverRadius: 5,
          fill: 3, // riempi tra ottimistico (idx 1) e pessimistico (idx 3)
          tension: 0.2,
        },
        // Atteso (linea principale)
        {
          label: `Atteso (${fmtPct(att.rendimentoUsato, 1)})`,
          data: dataAtt,
          borderColor: COLORS.emerald,
          borderWidth: 3,
          pointRadius: 0,
          pointHoverRadius: 6,
          fill: false,
          tension: 0.2,
        },
        // Pessimistico (bottom boundary della banda)
        {
          label: `Pessimistico (${fmtPct(pess.rendimentoUsato, 1)})`,
          data: dataPess,
          borderColor: COLORS.ochre,
          borderWidth: 2,
          pointRadius: 0,
          pointHoverRadius: 5,
          fill: false,
          tension: 0.2,
        },
      ];

      if (chart2) {
        chart2.data.labels = labels;
        chart2.data.datasets = datasets;
        chart2.setActiveElements([]);
        if (chart2.tooltip) chart2.tooltip.setActiveElements([], { x: 0, y: 0 });
        const ys = chart2.options.scales?.y as any;
        if (ys) { ys.min = yMin; ys.max = yMax; }
        const xs = chart2.options.scales?.x as any;
        if (xs?.ticks) {
          xs.ticks.callback = function (_v: unknown, idx: number) {
            return showXTick(idx) ? labels[idx] : '';
          };
        }
        chart2.update('none');
        return;
      }

      chart2 = new Chart(canvas, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: firstRender2 ? { duration: 800, easing: 'easeOutQuart' } : false,
          layout: { padding: { top: 8, right: 8, bottom: 4, left: 4 } },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#FFFFFF',
              borderColor: 'rgba(22, 105, 99, 0.25)',
              borderWidth: 1,
              titleColor: '#0F4F4A',
              titleFont: { family: 'Manrope, sans-serif', weight: 700, size: 13 },
              bodyColor: COLORS.charcoal,
              bodyFont: { family: 'Manrope, sans-serif', size: 12 },
              padding: 12,
              cornerRadius: 8,
              displayColors: true,
              callbacks: {
                title: (items) => {
                  const idx = items[0].dataIndex;
                  return currentChart.scenarioAtt
                    ? `Anno ${currentChart.scenarioAtt.andamento[idx]?.anno ?? idx}`
                    : '';
                },
                label: (ctx) => {
                  if (ctx.datasetIndex === 0) return ''; // ref
                  return `  ${ctx.dataset.label}: ${fmtEuro.format(Number(ctx.parsed.y))}`;
                },
                footer: (items) => {
                  if (!currentChart.scenarioPess || !currentChart.scenarioOtt) return '';
                  const idx = items[0].dataIndex;
                  const pess = currentChart.scenarioPess.andamento[idx]?.capitaleReale ?? 0;
                  const ott = currentChart.scenarioOtt.andamento[idx]?.capitaleReale ?? 0;
                  const diff = ott - pess;
                  return `Δ ottimistico − pessimistico: ${fmtEuro.format(diff)}`;
                },
              },
            },
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: COLORS.grayText,
                font: { family: 'Manrope, sans-serif', size: 11 },
                autoSkip: false,
                callback: function (_v: any, idx: number) {
                  return showXTick(idx) ? labels[idx] : '';
                },
              },
            },
            y: {
              min: yMin,
              max: yMax,
              grid: { color: 'rgba(22, 105, 99, 0.15)', lineWidth: 1 },
              border: { display: false },
              ticks: {
                color: COLORS.grayText,
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (v) => fmtEuroShort(v as number),
              },
            },
          },
        },
      });
      requestAnimationFrame(() => {
        if (chart2 && chart2.options) (chart2.options as any).animation = false;
      });
      firstRender2 = false;
    }

    // ============== CHART 3: CLIFF (condizionale) ==============
    function disegnaChart3(scenario: ScenarioCurva): void {
      const canvas = $('rd-chart-cliff') as unknown as HTMLCanvasElement;
      if (!canvas || !scenario.andamento.length) return;

      currentChart.scenarioCliff = scenario;

      const labels = scenario.andamento.map((a) => `Anno ${a.anno}`);
      const N = scenario.andamento.length - 1;
      const dataCap = scenario.andamento.map((a) => a.capitaleReale);
      const annoCriticoIdx = scenario.andamento.findIndex(
        (a) => a.anno === scenario.capitaleEsauritoAnno
      );

      const showXTick = (idx: number): boolean =>
        N > 30 ? idx % 5 === 0 || idx === N
        : N > 15 ? idx % 3 === 0 || idx === N
        : true;

      const datasets: any[] = [
        {
          label: 'Capitale residuo (peggior scenario)',
          data: dataCap,
          borderColor: COLORS.ochre,
          backgroundColor: 'rgba(171, 127, 98, 0.25)',
          borderWidth: 4,
          pointRadius: (ctx: any) => (ctx.dataIndex === annoCriticoIdx ? 8 : 0),
          pointBackgroundColor: COLORS.red,
          pointBorderColor: '#FFFFFF',
          pointBorderWidth: 2,
          pointHoverRadius: 9,
          fill: 'origin',
          tension: 0,
        },
      ];

      if (chart3) {
        chart3.data.labels = labels;
        chart3.data.datasets = datasets;
        chart3.setActiveElements([]);
        if (chart3.tooltip) chart3.tooltip.setActiveElements([], { x: 0, y: 0 });
        const xs = chart3.options.scales?.x as any;
        if (xs?.ticks) {
          xs.ticks.callback = function (_v: unknown, idx: number) {
            return showXTick(idx) ? labels[idx] : '';
          };
        }
        chart3.update('none');
        return;
      }

      chart3 = new Chart(canvas, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: firstRender3 ? { duration: 700, easing: 'easeOutQuart' } : false,
          layout: { padding: { top: 8, right: 8, bottom: 4, left: 4 } },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#FFFFFF',
              borderColor: 'rgba(171, 127, 98, 0.4)',
              borderWidth: 1,
              titleColor: COLORS.ochreDark,
              titleFont: { family: 'Manrope, sans-serif', weight: 700, size: 13 },
              bodyColor: COLORS.charcoal,
              bodyFont: { family: 'Manrope, sans-serif', size: 12 },
              padding: 12,
              cornerRadius: 8,
              displayColors: false,
              callbacks: {
                title: (items) => {
                  const sc = currentChart.scenarioCliff;
                  if (!sc) return '';
                  const a = sc.andamento[items[0].dataIndex];
                  return a ? `Anno ${a.anno}` : '';
                },
                label: (ctx) => {
                  const sc = currentChart.scenarioCliff;
                  if (!sc) return '';
                  const a = sc.andamento[ctx.dataIndex];
                  if (!a) return '';
                  const v = Number(ctx.parsed.y);
                  if (v <= 0.5 && sc.capitaleEsauritoAnno !== null) {
                    const anniSenza = a.anno - sc.capitaleEsauritoAnno;
                    return anniSenza > 0
                      ? `0 € — Capitale esaurito da ${anniSenza} ann${anniSenza === 1 ? 'o' : 'i'}`
                      : 'Capitale esaurito';
                  }
                  return `Capitale residuo: ${fmtEuro.format(v)}`;
                },
              },
            },
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: COLORS.grayText,
                font: { family: 'Manrope, sans-serif', size: 11 },
                autoSkip: false,
                callback: function (_v: any, idx: number) {
                  return showXTick(idx) ? labels[idx] : '';
                },
              },
            },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(171, 127, 98, 0.15)', lineWidth: 1 },
              border: { display: false },
              ticks: {
                color: COLORS.grayText,
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (v) => fmtEuroShort(v as number),
              },
            },
          },
        },
      });
      requestAnimationFrame(() => {
        if (chart3 && chart3.options) (chart3.options as any).animation = false;
      });
      firstRender3 = false;
    }

    // -------------------- MAIN --------------------
    let lastResult: OutputRendita | null = null;

    function aggiorna(): void {
      setVisibility();

      const modalita = getModalita();
      const anni = parseNum(inputs.anni.value);
      const rendimento = parseNum(inputs.rendimento.value);
      const inflazione = parseNum(inputs.inflazione.value);
      const ereditaToggle = inputs.ereditaToggle.checked;
      const ereditaTarget = parseNum(inputs.ereditaTarget.value);

      const anniDisp = $('rd-anni-display');
      if (anniDisp && Number.isFinite(anni)) {
        const v = Math.round(anni);
        anniDisp.textContent = `${v} ann${v === 1 ? 'o' : 'i'}`;
      }

      const blocking = $('rd-blocking');
      if (!Number.isFinite(anni) || anni < 1) {
        blocking.textContent = 'Inserisci almeno 1 anno di rendita.';
        return;
      }
      if (anni > 60) {
        blocking.textContent = 'La durata massima è 60 anni.';
        return;
      }
      if (!Number.isFinite(rendimento)) {
        blocking.textContent = 'Inserisci un rendimento valido.';
        return;
      }
      if (!Number.isFinite(inflazione)) {
        blocking.textContent = "Inserisci un valore valido per l'inflazione.";
        return;
      }
      blocking.textContent = '';

      let speseAnnueDesiderate: number | undefined;
      let capitaleDisponibile: number | undefined;
      if (modalita === 'capitale-necessario') {
        const v = parseNum(inputs.spese.value);
        if (!Number.isFinite(v) || v <= 0) {
          blocking.textContent = 'Inserisci spese annue maggiori di zero.';
          return;
        }
        speseAnnueDesiderate = v;
      } else {
        const v = parseNum(inputs.capitale.value);
        if (!Number.isFinite(v) || v <= 0) {
          blocking.textContent = 'Inserisci un capitale disponibile maggiore di zero.';
          return;
        }
        capitaleDisponibile = v;
      }

      const result = calcolaRendita({
        modalita,
        speseAnnueDesiderate,
        capitaleDisponibile,
        anni,
        rendimentoNettoPerc: rendimento,
        inflazionePerc: inflazione,
        lasciareEredita: ereditaToggle,
        ereditaTarget: Number.isFinite(ereditaTarget) ? Math.max(0, ereditaTarget) : 0,
      });

      if (!result.ok) {
        blocking.textContent = result.errore ?? 'Dati non validi.';
        return;
      }

      lastResult = result;

      // ----- Output principale -----
      const primaryLabel = $('rd-out-primary-label');
      const primaryVal = $('rd-out-primary');
      const secondary = $('rd-out-secondary');

      if (modalita === 'capitale-necessario') {
        primaryLabel.textContent = 'Capitale necessario oggi';
        primaryVal.textContent = fmtEuro.format(result.capitaleNecessario ?? 0);
        secondary.textContent = '';
      } else {
        primaryLabel.textContent = 'Rendita annua sostenibile';
        primaryVal.textContent = fmtEuro.format(result.renditaSostenibileAnnua ?? 0);
        secondary.textContent = `Corrispondono a ${fmtEuro.format(result.renditaSostenibileMensile ?? 0)} al mese`;
      }

      // ----- Dettaglio -----
      $('rd-out-rendimento-reale').textContent = fmtPct(result.rendimentoRealePerc, 2);
      $('rd-out-totale-prelevato').textContent = fmtEuro.format(result.totalePrelevato);
      $('rd-out-inflazione-cum').textContent = fmtPct(result.inflazioneCumulataFinale, 1);
      $('rd-out-residuo').textContent = fmtEuro.format(result.capitaleResiduoNominale);

      const tassoRow = $('rd-row-tasso-prelievo');
      if (modalita === 'rendita-sostenibile') {
        tassoRow.hidden = false;
        const t = result.tassoPrelevamentoIniziale;
        $('rd-out-tasso-prelievo').textContent = fmtPct(t, 2);
        const badge = $('rd-out-tasso-prelievo-badge');
        badge.classList.remove('badge-prudente', 'badge-linea', 'badge-aggressivo');
        if (t < 4) {
          badge.textContent = 'prudente';
          badge.classList.add('badge', 'badge-prudente');
        } else if (t <= 5) {
          badge.textContent = 'in linea';
          badge.classList.add('badge', 'badge-linea');
        } else {
          badge.textContent = 'aggressivo';
          badge.classList.add('badge', 'badge-aggressivo');
        }
      } else {
        tassoRow.hidden = true;
      }

      // ----- Regola del 4% -----
      const ruleLabel1 = $('rd-rule-label-1');
      const ruleVal1 = $('rd-rule-value-1');
      const ruleLabel2 = $('rd-rule-label-2');
      const ruleVal2 = $('rd-rule-value-2');
      const ruleDiff = $('rd-rule-diff');
      const conf = result.confrontoRegola4Percento;
      if (modalita === 'capitale-necessario') {
        ruleLabel1.textContent = 'Regola 4% (spese × 25)';
        ruleVal1.textContent = fmtEuro.format(conf.capitaleSecondoRegola);
        ruleLabel2.textContent = 'Il tuo calcolo';
        ruleVal2.textContent = fmtEuro.format(result.capitaleNecessario ?? 0);
      } else {
        ruleLabel1.textContent = 'Regola 4% (capitale × 4%)';
        ruleVal1.textContent = fmtEuro.format(conf.renditaSecondoRegola);
        ruleLabel2.textContent = 'Il tuo calcolo';
        ruleVal2.textContent = fmtEuro.format(result.renditaSostenibileAnnua ?? 0);
      }
      ruleDiff.textContent = fmtPctSigned(conf.differenzaPerc, 1);

      // ----- Warnings -----
      const warnEl = $('rd-warnings');
      while (warnEl.firstChild) warnEl.removeChild(warnEl.firstChild);
      if (result.warning.length) {
        const ul = document.createElement('ul');
        for (const w of result.warning) {
          const li = document.createElement('li');
          if (w.startsWith('ATTENZIONE')) li.classList.add('warn-critical');
          li.textContent = w;
          ul.appendChild(li);
        }
        warnEl.appendChild(ul);
      }

      // ----- Subtitle grafico -----
      const subtitle = $('rd-chart-subtitle');
      if (subtitle) {
        if (result.capitaleEsauritoAnno !== null) {
          subtitle.textContent = `⚠ Il capitale si esaurisce all'anno ${result.capitaleEsauritoAnno} (su ${anni} richiesti).`;
        } else if (modalita === 'capitale-necessario') {
          subtitle.textContent = `Capitale che dura ${anni} anni di rendita${ereditaToggle ? `, lasciando ${fmtEuro.format(ereditaTarget)} di eredità reale` : ''}.`;
        } else {
          subtitle.textContent = `Rendita ${fmtEuro.format(result.renditaSostenibileAnnua ?? 0)}/anno per ${anni} anni${ereditaToggle ? `, con eredità ${fmtEuro.format(ereditaTarget)}` : ''}.`;
        }
      }

      // ----- Capitale iniziale (per linea di riferimento) -----
      const capitaleIniziale =
        modalita === 'capitale-necessario'
          ? (result.capitaleNecessario ?? 0)
          : (capitaleDisponibile ?? 0);

      // ----- Aggiorna legende e hint -----
      aggiornaVistaHint();
      const legPess = $('rd-leg-pess');
      const legAtt = $('rd-leg-att');
      const legOtt = $('rd-leg-ott');
      if (legPess) legPess.textContent = `Pessimistico (${fmtPct(result.scenari.pessimistico.rendimentoUsato, 1)})`;
      if (legAtt)  legAtt.textContent  = `Atteso (${fmtPct(result.scenari.atteso.rendimentoUsato, 1)})`;
      if (legOtt)  legOtt.textContent  = `Ottimistico (${fmtPct(result.scenari.ottimistico.rendimentoUsato, 1)})`;

      // ----- Disegna grafici 1 e 2 (sempre) -----
      const ereditaTargetReale = ereditaToggle && Number.isFinite(ereditaTarget) ? Math.max(0, ereditaTarget) : 0;
      disegnaChart1(
        result.andamento,
        getVista(),
        capitaleIniziale,
        ereditaTargetReale,
        ereditaToggle,
        result.capitaleEsauritoAnno,
        inflazione
      );
      disegnaChart2(
        result.scenari.pessimistico,
        result.scenari.atteso,
        result.scenari.ottimistico,
        capitaleIniziale
      );

      // ----- Diagnostic box (sotto grafico 2) -----
      const diag = $('rd-diagnostic');
      const attEsau = result.scenari.atteso.capitaleEsauritoAnno;
      const pessEsau = result.scenari.pessimistico.capitaleEsauritoAnno;
      if (diag) {
        diag.classList.remove('is-warning', 'is-critical');
        if (attEsau !== null) {
          diag.classList.add('is-critical');
          diag.textContent = `⚠️ Critico: anche con rendimento atteso il capitale si esaurisce all'anno ${attEsau}. Riconsidera spese o orizzonte temporale.`;
        } else if (pessEsau !== null) {
          diag.classList.add('is-warning');
          diag.textContent = `⚠️ Attenzione: in caso di mercati sfavorevoli (rendimento ${fmtPct(result.scenari.pessimistico.rendimentoUsato, 1)}) il tuo capitale potrebbe esaurirsi all'anno ${pessEsau}.`;
        } else {
          diag.textContent = `✓ Il tuo piano sembra robusto: anche in scenario pessimistico (${fmtPct(result.scenari.pessimistico.rendimentoUsato, 1)}) il capitale resiste fino all'anno ${anni}.`;
        }
      }

      // ----- Cliff card (condizionale) -----
      const cliffSection = $('rd-cliff-section');
      const cliffSubtitle = $('rd-cliff-subtitle');
      if (cliffSection && cliffSubtitle) {
        const wasHidden = cliffSection.hidden;
        if (result.almenoUnoScenarioEsaurisce && result.scenarioPiuPessimisticoCheEsaurisce) {
          const sc = result.scenarioPiuPessimisticoCheEsaurisce;
          cliffSection.hidden = false;
          if (attEsau !== null) {
            cliffSubtitle.textContent =
              `Anche nello scenario ATTESO, il capitale si esaurirebbe all'anno ${attEsau}. ` +
              `Questo è un segnale forte di pianificazione insostenibile.`;
          } else {
            cliffSubtitle.textContent =
              `Nello scenario pessimistico (rendimento ${fmtPct(sc.rendimentoUsato, 1)}), ` +
              `il capitale si esaurirebbe all'anno ${sc.capitaleEsauritoAnno} (su ${anni} richiesti).`;
          }
          disegnaChart3(sc);
          // Scroll automatico solo se la card era nascosta E non siamo su mobile
          if (wasHidden && window.innerWidth > 880) {
            requestAnimationFrame(() => {
              cliffSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
          }
        } else {
          cliffSection.hidden = true;
          if (chart3) {
            chart3.destroy();
            chart3 = null;
            firstRender3 = true;
          }
        }
      }
    }

    // -------------------- DEBOUNCE + WIRING --------------------
    let timer: ReturnType<typeof setTimeout> | null = null;
    function schedule(): void {
      if (timer) clearTimeout(timer);
      timer = setTimeout(aggiorna, 200);
    }

    inputs.anniSlider.addEventListener('input', () => {
      inputs.anni.value = inputs.anniSlider.value;
      schedule();
    });
    inputs.anni.addEventListener('input', () => {
      const v = parseNum(inputs.anni.value);
      if (Number.isFinite(v) && v >= 1 && v <= 60) {
        inputs.anniSlider.value = String(Math.round(v));
      }
      schedule();
    });

    const altri: Array<HTMLInputElement> = [
      inputs.spese,
      inputs.capitale,
      inputs.rendimento,
      inputs.inflazione,
      inputs.ereditaTarget,
    ];
    for (const el of altri) {
      el.addEventListener('input', schedule);
      el.addEventListener('change', schedule);
    }
    inputs.ereditaToggle.addEventListener('change', schedule);
    inputs.modalitaRadios.forEach((el) => el.addEventListener('change', schedule));

    inputs.vistaRadios.forEach((el) =>
      el.addEventListener('change', () => {
        aggiornaVistaHint();
        if (lastResult) {
          const ereditaToggleCk = inputs.ereditaToggle.checked;
          const ereditaTargetVal = parseNum(inputs.ereditaTarget.value);
          const inflazione = parseNum(inputs.inflazione.value) || 0;
          const ereditaTargetReale = ereditaToggleCk && Number.isFinite(ereditaTargetVal) ? Math.max(0, ereditaTargetVal) : 0;
          const capitaleIniziale = lastResult.modalita === 'capitale-necessario'
            ? (lastResult.capitaleNecessario ?? 0)
            : (parseNum(inputs.capitale.value) || 0);
          disegnaChart1(
            lastResult.andamento,
            getVista(),
            capitaleIniziale,
            ereditaTargetReale,
            ereditaToggleCk,
            lastResult.capitaleEsauritoAnno,
            inflazione
          );
        }
      })
    );

    aggiorna();

    // Cleanup per Astro View Transitions (ClientRouter)
    document.addEventListener('astro:before-swap', () => {
      if (chart1) { chart1.destroy(); chart1 = null; }
      if (chart2) { chart2.destroy(); chart2 = null; }
      if (chart3) { chart3.destroy(); chart3 = null; }
      if (timer) { clearTimeout(timer); timer = null; }
    }, { once: true });
  </script>
</Layout>
