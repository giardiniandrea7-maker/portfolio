---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Calcolatore di Rendita | Andrea Giardini',
  description:
    'Calcolatore gratuito di rendita patrimoniale. Stima il capitale necessario per vivere di rendita o quanto puoi prelevare dal tuo patrimonio, considerando inflazione, rendimento atteso e regola del 4%.',
};
---

<Layout metadata={metadata}>
  <div class="calc-rd">
    <!-- ============== HERO ============== -->
    <header class="calc-header reveal">
      <h1>Calcolatore di Rendita</h1>
      <p>
        Stima quanto capitale ti serve per vivere di rendita o quanto puoi prelevare ogni anno
        dal tuo patrimonio. Lo strumento tiene conto dell'inflazione, del rendimento atteso e
        dell'orizzonte temporale, perché 50.000 € oggi non valgono 50.000 € tra 30 anni.
      </p>
    </header>

    <!-- ============== TAB MODALITÀ (sticky mobile) ============== -->
    <fieldset class="modal-tabs" role="radiogroup" aria-label="Modalità di calcolo">
      <legend class="sr-only">Modalità di calcolo</legend>
      <label class="tab-pill">
        <input type="radio" name="rd-modalita" value="capitale-necessario" checked />
        <span class="tab-content">
          <span class="tab-title">Quanto capitale mi serve?</span>
          <span class="tab-desc">Inserisci spese e durata</span>
        </span>
      </label>
      <label class="tab-pill">
        <input type="radio" name="rd-modalita" value="rendita-sostenibile" />
        <span class="tab-content">
          <span class="tab-title">Quanto posso prelevare?</span>
          <span class="tab-desc">Inserisci capitale e durata</span>
        </span>
      </label>
    </fieldset>

    <!-- ============== FORM + RISULTATI ============== -->
    <div class="main-grid">
      <!-- COLONNA SX: FORM -->
      <div class="card form-card">
        <h2 class="card-title">Inserisci i tuoi dati</h2>

        <!-- Modalità A: capitale necessario -->
        <div class="mode-a">
          <div class="form-group">
            <label for="rd-spese">
              Spese annue desiderate
              <span class="hint-tooltip" title="Quanto vuoi avere a disposizione ogni anno per vivere, in valore di oggi (potere d'acquisto attuale).">ⓘ</span>
            </label>
            <div class="input-with-suffix">
              <input
                type="number"
                id="rd-spese"
                min="0"
                step="1000"
                value="30000"
                inputmode="decimal"
              />
              <span class="suffix">€</span>
            </div>
          </div>
        </div>

        <!-- Modalità B: rendita sostenibile -->
        <div class="mode-b" hidden>
          <div class="form-group">
            <label for="rd-capitale">Capitale disponibile</label>
            <div class="input-with-suffix">
              <input
                type="number"
                id="rd-capitale"
                min="0"
                step="10000"
                value="500000"
                inputmode="decimal"
              />
              <span class="suffix">€</span>
            </div>
          </div>
        </div>

        <!-- Comuni: anni (slider) -->
        <div class="form-group">
          <label for="rd-anni">
            Per quanti anni vuoi la rendita: <span class="anni-display" id="rd-anni-display">30 anni</span>
          </label>
          <div class="anni-row">
            <input type="range" id="rd-anni-slider" min="1" max="60" step="1" value="30" />
            <input
              type="number"
              id="rd-anni"
              min="1"
              max="60"
              step="1"
              value="30"
              inputmode="numeric"
              class="anni-number"
            />
          </div>
          <p class="form-hint">Tipicamente 25–35 anni se inizi a vivere di rendita verso i 60–65.</p>
        </div>

        <!-- Comuni: rendimento -->
        <div class="form-group">
          <label for="rd-rendimento">
            Rendimento atteso netto
            <span class="hint-tooltip" title="Rendimento medio annuo atteso del tuo portafoglio, al netto di tasse e commissioni. Un portafoglio bilanciato 60/40 storicamente ha reso il 5–6% lordo, ~4% netto.">ⓘ</span>
          </label>
          <div class="input-with-suffix">
            <input
              type="number"
              id="rd-rendimento"
              min="0"
              max="15"
              step="0.1"
              value="4"
              inputmode="decimal"
            />
            <span class="suffix">%</span>
          </div>
        </div>

        <!-- Comuni: inflazione -->
        <div class="form-group">
          <label for="rd-inflazione">
            Inflazione attesa
            <span class="hint-tooltip" title="Tasso medio annuo di erosione del potere d'acquisto. Target BCE storico ~2%.">ⓘ</span>
          </label>
          <div class="input-with-suffix">
            <input
              type="number"
              id="rd-inflazione"
              min="0"
              max="10"
              step="0.1"
              value="2"
              inputmode="decimal"
            />
            <span class="suffix">%</span>
          </div>
        </div>

        <!-- Eredità toggle -->
        <div class="toggle-block">
          <label class="toggle-row">
            <input type="checkbox" id="rd-eredita-toggle" />
            <span class="toggle-text">Lascia un'eredità a fine periodo</span>
          </label>

          <div class="toggle-extra" id="rd-eredita-section" hidden>
            <div class="form-group">
              <label for="rd-eredita-target">Eredità desiderata</label>
              <div class="input-with-suffix">
                <input
                  type="number"
                  id="rd-eredita-target"
                  min="0"
                  step="10000"
                  value="100000"
                  inputmode="decimal"
                />
                <span class="suffix">€</span>
              </div>
              <p class="form-hint">
                Capitale che vuoi lasciare a fine periodo, in valore reale (potere d'acquisto di oggi).
              </p>
            </div>
          </div>
        </div>

        <p class="form-hint">Il calcolo si aggiorna automaticamente.</p>
        <p class="warn warn-blocking" id="rd-blocking" role="alert" aria-live="assertive"></p>
      </div>

      <!-- COLONNA DX: RISULTATI -->
      <div class="card results-card" aria-live="polite" aria-atomic="true">
        <h2 class="card-title">Risultati</h2>

        <div class="result-block result-primary">
          <span class="result-label" id="rd-out-primary-label">Capitale necessario oggi</span>
          <span class="result-value result-value-xl" id="rd-out-primary">—</span>
          <span class="result-secondary" id="rd-out-secondary"></span>
        </div>

        <h3 class="metrics-title">Dettaglio</h3>
        <ul class="metrics-list">
          <li>
            <span class="m-label">Rendimento reale (netto inflazione)</span>
            <span class="m-value" id="rd-out-rendimento-reale">—</span>
          </li>
          <li id="rd-row-tasso-prelievo" hidden>
            <span class="m-label">Tasso prelievo iniziale</span>
            <span class="m-value-row">
              <span class="m-value" id="rd-out-tasso-prelievo">—</span>
              <span class="badge" id="rd-out-tasso-prelievo-badge"></span>
            </span>
          </li>
          <li>
            <span class="m-label">Totale prelevato in N anni</span>
            <span class="m-value" id="rd-out-totale-prelevato">—</span>
          </li>
          <li>
            <span class="m-label">Inflazione cumulata</span>
            <span class="m-value" id="rd-out-inflazione-cum">—</span>
          </li>
          <li>
            <span class="m-label">Capitale residuo a fine periodo</span>
            <span class="m-value" id="rd-out-residuo">—</span>
          </li>
        </ul>

        <div class="warn-list" id="rd-warnings" aria-live="polite"></div>
      </div>
    </div>

    <!-- ============== CARD REGOLA DEL 4% ============== -->
    <section class="card rule-card" aria-label="Regola del 4% (Trinity Study)">
      <div class="rule-header">
        <h2 class="rule-title">Confronto con la Regola del 4% (Trinity Study)</h2>
        <span class="rule-badge">Benchmark</span>
      </div>
      <p class="rule-text">
        La regola del 4% deriva da uno studio storico americano: in un portafoglio bilanciato,
        prelevare il 4% iniziale del capitale e adeguarlo all'inflazione ogni anno ha permesso
        di sostenere 30 anni di rendita nel 95% dei casi storici.
      </p>
      <div class="rule-grid">
        <div class="rule-cell">
          <span class="rule-cell-label" id="rd-rule-label-1">Secondo la regola</span>
          <span class="rule-cell-value" id="rd-rule-value-1">—</span>
        </div>
        <div class="rule-cell rule-cell-yours">
          <span class="rule-cell-label" id="rd-rule-label-2">Il tuo calcolo</span>
          <span class="rule-cell-value" id="rd-rule-value-2">—</span>
        </div>
        <div class="rule-cell rule-cell-diff">
          <span class="rule-cell-label">Differenza</span>
          <span class="rule-cell-value" id="rd-rule-diff">—</span>
        </div>
      </div>
      <p class="rule-disclaimer">
        Lo studio originale è basato su mercati USA 1926–1995. I risultati italiani/europei
        possono variare. Considera la regola come benchmark, non come certezza.
      </p>
    </section>

    <!-- ============== GRAFICO 1 — DECUMULAZIONE ============== -->
    <section class="card chart-card" aria-label="Andamento del tuo patrimonio nel tempo">
      <div class="chart-header chart-header-row">
        <div>
          <h2 class="card-title">Andamento del tuo patrimonio nel tempo</h2>
          <p class="chart-subtitle" id="rd-chart-subtitle"></p>
        </div>
        <fieldset class="chart-toggle" role="tablist" aria-label="Vista valori">
          <legend class="sr-only">Vista valori</legend>
          <label class="chart-toggle-pill" role="tab">
            <input type="radio" name="rd-vista" value="nominale" />
            <span>Valori nominali (€ correnti)</span>
          </label>
          <label class="chart-toggle-pill" role="tab">
            <input type="radio" name="rd-vista" value="reale" checked />
            <span>Valori reali (potere d'acquisto di oggi)</span>
          </label>
        </fieldset>
      </div>
      <p class="chart-vista-hint" id="rd-vista-hint">
        Quanto potrai davvero comprare con quel denaro, nei prezzi di oggi.
      </p>
      <div class="chart-wrap">
        <canvas id="rd-chart" role="img" aria-label="Grafico a linea dell'andamento del patrimonio nel tempo"></canvas>
      </div>
      <p id="rd-chart-fallback" class="sr-only" aria-live="polite"></p>
    </section>

    <!-- ============== GRAFICO 2 — TRE SCENARI ============== -->
    <section class="card chart-card" aria-label="Confronto tre scenari">
      <div class="chart-header">
        <h2 class="card-title">Cosa succede in tre scenari diversi?</h2>
        <p class="chart-subtitle">
          Il rendimento dei mercati non è prevedibile. Ecco cosa succederebbe al tuo patrimonio
          in tre scenari realistici, mantenendo costanti tutti gli altri parametri.
        </p>
      </div>
      <div class="chart-wrap">
        <canvas id="rd-chart-scenari" role="img" aria-label="Grafico a tre linee per scenario pessimistico, atteso, ottimistico"></canvas>
      </div>
      <div class="chart-legend chart-legend-bottom" aria-hidden="true">
        <span class="legend-item"><span class="legend-swatch swatch-pess"></span><span id="rd-leg-pess">Pessimistico</span></span>
        <span class="legend-item"><span class="legend-swatch swatch-att"></span><span id="rd-leg-att">Atteso</span></span>
        <span class="legend-item"><span class="legend-swatch swatch-ott"></span><span id="rd-leg-ott">Ottimistico</span></span>
      </div>
      <div class="diagnostic-box" id="rd-diagnostic" role="status">—</div>
      <p id="rd-chart-scenari-fallback" class="sr-only" aria-live="polite"></p>
    </section>

    <!-- ============== GRAFICO 3 — CLIFF (condizionale) ============== -->
    <section class="card cliff-card" id="rd-cliff-section" aria-live="assertive" hidden>
      <div class="cliff-badge">⚠️ AVVISO IMPORTANTE</div>
      <h2 class="cliff-title">Il tuo capitale potrebbe esaurirsi prima del previsto</h2>
      <p class="cliff-subtitle" id="rd-cliff-subtitle">—</p>
      <div class="chart-wrap chart-wrap-cliff">
        <canvas id="rd-chart-cliff" role="img" aria-label="Grafico drammatico dell'esaurimento del capitale"></canvas>
      </div>
      <div class="cliff-cta">
        <h3 class="cliff-cta-title">Vuoi capire come evitare questo scenario?</h3>
        <p class="cliff-cta-text">
          Una pianificazione professionale può ridurre il rischio di esaurire il capitale.
          Strategie come la diversificazione del portafoglio, la gestione dinamica dei prelievi
          (<em>guard rails</em>), e l'integrazione con altre fonti di reddito (pensione
          integrativa, immobili a reddito) possono fare la differenza.
        </p>
        <a href="/contatti" class="btn btn-cliff">Prenota una consulenza gratuita →</a>
      </div>
    </section>

    <!-- ============== COME FUNZIONA ============== -->
    <section class="how-it-works reveal">
      <details class="math-details">
        <summary>
          <span class="summary-text">Mostra la matematica e i concetti</span>
          <span class="summary-icon" aria-hidden="true"></span>
        </summary>
        <div class="math-content">
          <h2>Come funziona il calcolatore</h2>
          <p>
            Vivere di rendita significa <b>decumulare</b> il patrimonio: invece di accumulare
            ogni anno (come durante la vita lavorativa), ogni anno preleviamo per vivere e
            lasciamo che il resto continui a generare rendimento. L'obiettivo è far <em>durare</em>
            il capitale almeno per gli anni necessari, eventualmente lasciando un'eredità.
          </p>
          <p>
            L'<b>inflazione</b> è il nemico silenzioso: 30.000 € oggi e 30.000 € tra 20 anni
            non hanno lo stesso potere d'acquisto. Per mantenere il tenore di vita serve
            adeguare i prelievi ogni anno. Per questo distinguiamo <em>rendimento nominale</em>
            (quello che vedi sul conto) e <em>rendimento reale</em> (quanto cresce davvero il
            potere d'acquisto). La formula di Fisher esatta è:
          </p>
          <div class="formula-block">
            <i>r</i><sub>reale</sub> =
            <span class="frac">
              <span class="frac-top">1 + <i>r</i></span>
              <span class="frac-bottom">1 + <i>inf</i></span>
            </span>
            − 1
          </div>
          <p>
            Con rendimento 4% e inflazione 2%, il rendimento reale non è 2% ma circa
            <b>1,96%</b>. Sembra un dettaglio, ma su 30 anni la differenza pesa.
          </p>
          <p>
            La <b>regola del 4%</b> (Trinity Study, anni '90) è il benchmark più noto della
            decumulazione: prelevare ogni anno il 4% del capitale iniziale (adeguato
            all'inflazione) ha sostenuto storicamente 30 anni di rendita nel 95% dei casi USA.
            Vivere "di interessi" (rendita perpetua) richiederebbe un capitale tipicamente
            molto più alto: la decumulazione consuma volutamente il capitale.
          </p>

          <h3>Capitale necessario</h3>
          <div class="formula-block">
            <i>C</i> = <i>S</i> ·
            <span class="frac">
              <span class="frac-top">1 − ((1+<i>inf</i>)/(1+<i>r</i>))<sup><i>N</i></sup></span>
              <span class="frac-bottom"><i>r</i> − <i>inf</i></span>
            </span>
            + <i>E</i> ·
            <span class="frac">
              <span class="frac-top">(1+<i>inf</i>)<sup><i>N</i></sup></span>
              <span class="frac-bottom">(1+<i>r</i>)<sup><i>N</i></sup></span>
            </span>
          </div>
          <p>
            Dove <i>S</i> sono le spese annue desiderate (in valore di oggi), <i>N</i> gli anni,
            ed <i>E</i> l'eventuale eredità target (in valore reale). Il primo termine è il
            valore attuale di una rendita posticipata crescente; il secondo è il valore attuale
            dell'eredità nominale a fine periodo. Per la modalità "Quanto posso prelevare?"
            invertiamo la formula per ottenere <i>S</i> dato <i>C</i>.
          </p>

          <p class="formula-note">
            Le proiezioni assumono rendimento e inflazione <em>costanti</em>: nella realtà sono
            variabili e il <em>rischio sequenza dei rendimenti</em> (subire crolli nei primi
            anni di prelievo) può compromettere seriamente il piano. Per questo conviene una
            pianificazione professionale che includa scenari di stress, glide path del rischio
            e revisione periodica.
          </p>
        </div>
      </details>
    </section>

    <!-- ============== CTA ============== -->
    <section class="cta-section reveal">
      <div class="eyebrow">Vuoi una pianificazione professionale?</div>
      <h2>Vuoi costruire un piano di rendita per la tua pensione?</h2>
      <p>
        La pianificazione di una rendita non è solo matematica: dipende dalla tua tolleranza al
        rischio, dalla composizione del patrimonio, dalla fiscalità e da scelte personali
        importanti (eredità, beneficenza, qualità della vita). Posso aiutarti a costruire un
        piano realistico e robusto. La prima chiamata è gratuita e senza impegno.
      </p>
      <div class="cta-buttons">
        <a href="/contatti" data-magnetic class="btn btn-primary">Prenota una consulenza</a>
        <a href="/calcolatori" class="btn btn-secondary">Torna ai calcolatori</a>
      </div>
    </section>

    <!-- ============== DISCLAIMER ============== -->
    <div class="final-disclaimer">
      <strong>Nota informativa:</strong> Le stime fornite hanno valore puramente indicativo e
      didattico. Le proiezioni sono basate su rendimento e inflazione costanti, ipotesi non
      realistica nei mercati reali (rischio di sequenza dei rendimenti). La regola del 4% è
      basata su dati storici USA e non garantisce risultati futuri. Per una pianificazione
      personalizzata sulla tua situazione patrimoniale, fiscale e di vita, rivolgiti al tuo
      consulente di fiducia. Questo strumento non costituisce consulenza finanziaria
      personalizzata.
    </div>
  </div>

  <style is:global>
    .calc-rd {
      --sage: #166963; --sage-light: #79B9AD; --sage-dark: #0F4F4A;
      --ochre: #AB7F62; --ochre-light: #C49A7E; --ochre-dark: #8A6449;
      --ivory: rgb(238 247 246); --ivory-warm: rgb(245 250 249);
      --charcoal: #373D42;
      --emerald: #00A652;
      --gray-soft: #DDE4E2; --gray-text: #6B7672;
      --shadow-soft: 0 4px 20px rgba(55, 61, 66, 0.06);
      --radius: 12px;

      font-family: 'Manrope', -apple-system, sans-serif;
      color: var(--charcoal);
      line-height: 1.65;
      font-size: 16px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px 60px;
    }
    .calc-rd * { box-sizing: border-box; }

    .calc-rd .calc-header {
      text-align: center;
      margin-bottom: 28px;
      padding-bottom: 22px;
      border-bottom: 1px solid var(--gray-soft);
    }
    .calc-rd .calc-header h1 {
      font-family: var(--aw-font-heading, 'Manrope', sans-serif);
      font-size: clamp(1.7rem, 3.6vw, 2.2rem);
      color: var(--sage-dark);
      font-weight: 600;
      margin-bottom: 14px;
      letter-spacing: -0.01em;
    }
    .calc-rd .calc-header p {
      color: var(--gray-text);
      font-size: 1rem;
      max-width: 760px;
      margin: 0 auto;
      line-height: 1.65;
    }

    /* Tab modalità */
    .calc-rd .modal-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 0 0 24px;
      border: 0;
      padding: 0;
    }
    .calc-rd .tab-pill {
      position: relative;
      display: block;
      padding: 14px 18px;
      border: 1.5px solid var(--gray-soft);
      border-radius: 10px;
      cursor: pointer;
      background: white;
      transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
      min-height: 48px;
    }
    .calc-rd .tab-pill input[type="radio"] {
      position: absolute; opacity: 0; pointer-events: none;
    }
    .calc-rd .tab-pill:hover { border-color: var(--sage-light); }
    .calc-rd .tab-pill:has(input:checked) {
      border-color: var(--emerald);
      background: rgba(0, 166, 82, 0.06);
      box-shadow: 0 0 0 3px rgba(0, 166, 82, 0.10);
    }
    .calc-rd .tab-pill:has(input:focus-visible) {
      outline: 2px solid var(--emerald);
      outline-offset: 2px;
    }
    .calc-rd .tab-content { display: block; }
    .calc-rd .tab-title {
      display: block; font-weight: 600; color: var(--sage-dark); font-size: 0.98rem;
    }
    .calc-rd .tab-desc {
      display: block; color: var(--gray-text); font-size: 0.82rem; margin-top: 2px;
    }

    /* Grid */
    .calc-rd .main-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 24px;
      align-items: start;
    }
    .calc-rd .card {
      background: white;
      border: 1px solid rgba(22, 105, 99, 0.15);
      border-radius: var(--radius);
      padding: 26px 28px;
      box-shadow: var(--shadow-soft);
    }
    .calc-rd .card-title {
      font-family: var(--aw-font-heading, 'Manrope', sans-serif);
      font-size: 1.15rem;
      color: var(--sage-dark);
      font-weight: 600;
      margin: 0 0 18px;
      letter-spacing: -0.01em;
    }

    /* Form */
    .calc-rd .form-group { margin-bottom: 16px; }
    .calc-rd label,
    .calc-rd .modal-tabs legend {
      display: block;
      font-weight: 500;
      color: var(--charcoal);
      margin-bottom: 6px;
      font-size: 0.92rem;
      padding: 0;
    }
    .calc-rd input[type="number"],
    .calc-rd input[type="text"],
    .calc-rd select {
      width: 100%;
      padding: 11px 12px;
      border: 1.5px solid var(--gray-soft);
      border-radius: 8px;
      font-family: 'Manrope', sans-serif;
      font-size: 0.97rem;
      color: var(--charcoal);
      background: white;
      transition: border-color 0.18s ease, box-shadow 0.18s ease;
      min-height: 44px;
    }
    .calc-rd input:focus,
    .calc-rd select:focus {
      outline: none;
      border-color: var(--emerald);
      box-shadow: 0 0 0 3px rgba(0, 166, 82, 0.15);
    }
    .calc-rd input[type="number"]::-webkit-outer-spin-button,
    .calc-rd input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none; margin: 0;
    }
    .calc-rd input[type="number"] { -moz-appearance: textfield; }

    .calc-rd .input-with-suffix { position: relative; }
    .calc-rd .input-with-suffix .suffix {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      color: var(--gray-text); font-size: 0.92rem; pointer-events: none;
    }
    .calc-rd .input-with-suffix input { padding-right: 36px; }

