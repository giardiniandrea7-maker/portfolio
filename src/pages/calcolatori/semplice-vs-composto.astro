  </style>

  <script>
    import { calcolaSempliceVsComposto } from '~/lib/calcolatori/semplice-vs-composto';
    import type {
      InputSempliceVsComposto,
      OutputSempliceVsComposto,
      DatoAnnuale,
    } from '~/lib/calcolatori/semplice-vs-composto';
    import {
      Chart,
      LineController,
      LineElement,
      PointElement,
      CategoryScale,
      LinearScale,
      Tooltip,
      Filler,
    } from 'chart.js';
    import { CountUp } from 'countup.js';

    Chart.register(LineController, LineElement, PointElement, CategoryScale, LinearScale, Tooltip, Filler);

    // -------------------- FORMATTERS --------------------
    const fmtEuro = new Intl.NumberFormat('it-IT', {
      style: 'currency', currency: 'EUR', maximumFractionDigits: 0,
    });
    const fmtEuroPrecise = new Intl.NumberFormat('it-IT', {
      style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2,
    });
    const fmtEuroShort = (v: number): string => {
      if (!Number.isFinite(v)) return '';
      const a = Math.abs(v);
      if (a >= 1_000_000) {
        const m = v / 1_000_000;
        return (Number.isInteger(m) ? m.toString() : m.toFixed(1).replace('.', ',')) + 'M €';
      }
      if (a >= 1_000) return Math.round(v / 1000) + 'K €';
      return Math.round(v) + ' €';
    };
    const parseNum = (v: string): number => {
      if (!v) return NaN;
      return parseFloat(v.replace(',', '.'));
    };
    const fmtPct = (v: number): string => {
      if (!Number.isFinite(v)) return '—';
      return v.toFixed(1).replace('.', ',') + '%';
    };

    // -------------------- DOM --------------------
    const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
      document.getElementById(id) as T;

    const inputs = {
      capitale: $<HTMLInputElement>('svc-capitale'),
      versamento: $<HTMLInputElement>('svc-versamento'),
      anni: $<HTMLInputElement>('svc-anni'),
      anniSlider: $<HTMLInputElement>('svc-anni-slider'),
      tasso: $<HTMLInputElement>('svc-tasso'),
    };

    // -------------------- COLORS --------------------
    const COLORS = {
      semplice: '#79B9AD',
      composto: '#00A652',
      compostoArea: 'rgba(0, 166, 82, 0.15)',
      sageDark: '#0F4F4A',
      ochre: '#AB7F62',
      charcoal: '#373D42',
    };

    // -------------------- CHART CLASSICO --------------------
    let chartClassic: import('chart.js').Chart | null = null;
    let firstRenderClassic = true;

    function disegnaChartClassic(out: OutputSempliceVsComposto): void {
      const canvas = $('svc-chart-classic') as unknown as HTMLCanvasElement;
      if (!canvas) return;
      const labels = out.datiAnnuali.map((d) => `${d.anno}`);
      const semplice = out.datiAnnuali.map((d) => d.capitaleSemplice);
      const composto = out.datiAnnuali.map((d) => d.capitaleComposto);

      // Punto magico (anno incrocio)
      const idxIncrocio =
        out.annoIncrocio !== null
          ? out.datiAnnuali.findIndex((d) => d.anno === out.annoIncrocio)
          : -1;
      const radii = out.datiAnnuali.map((_, i) => (i === idxIncrocio ? 8 : 0));
      const borderColors = out.datiAnnuali.map((_, i) =>
        i === idxIncrocio ? '#FFFFFF' : 'transparent'
      );

      if (chartClassic) {
        chartClassic.data.labels = labels;
        chartClassic.data.datasets[0].data = semplice;
        chartClassic.data.datasets[1].data = composto;
        (chartClassic.data.datasets[1] as any).pointRadius = radii;
        (chartClassic.data.datasets[1] as any).pointBackgroundColor = COLORS.composto;
        (chartClassic.data.datasets[1] as any).pointBorderColor = borderColors;
        chartClassic.update('none');
        return;
      }

      chartClassic = new Chart(canvas, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'Interesse semplice',
              data: semplice,
              borderColor: COLORS.semplice,
              backgroundColor: 'transparent',
              borderWidth: 3,
              tension: 0.25,
              pointRadius: 0,
              pointHoverRadius: 5,
              pointHoverBackgroundColor: COLORS.semplice,
              fill: false,
            },
            {
              label: 'Interesse composto',
              data: composto,
              borderColor: COLORS.composto,
              backgroundColor: COLORS.compostoArea,
              borderWidth: 4,
              tension: 0.25,
              pointRadius: radii,
              pointHoverRadius: 6,
              pointBackgroundColor: COLORS.composto,
              pointBorderColor: borderColors,
              pointBorderWidth: 2,
              fill: 'origin',
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: firstRenderClassic
            ? { duration: 1500, easing: 'easeOutQuart' }
            : false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#FFFFFF',
              borderColor: 'rgba(22, 105, 99, 0.25)',
              borderWidth: 1,
              titleColor: COLORS.sageDark,
              titleFont: { family: 'Manrope, sans-serif', weight: 700, size: 13 },
              bodyColor: COLORS.charcoal,
              bodyFont: { family: 'Manrope, sans-serif', size: 12 },
              footerColor: COLORS.composto,
              footerFont: { family: 'Manrope, sans-serif', weight: 700, size: 12 },
              padding: 12,
              cornerRadius: 8,
              displayColors: true,
              boxPadding: 4,
              callbacks: {
                title: (items) => `Anno ${items[0].label}`,
                label: (ctx) => {
                  const v = Number(ctx.parsed.y);
                  return `  ${ctx.dataset.label}: ${fmtEuroPrecise.format(v)}`;
                },
                footer: (items) => {
                  if (items.length < 2) return '';
                  const s = Number(items[0].parsed.y);
                  const c = Number(items[1].parsed.y);
                  const diff = c - s;
                  const pct = s > 0 ? ((c - s) / s) * 100 : 0;
                  return [
                    `Differenza: +${fmtEuroPrecise.format(diff)}`,
                    `Composto +${fmtPct(pct)} sul semplice`,
                  ];
                },
              },
            },
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (_v, idx) => {
                  const N = labels.length;
                  if (N <= 12) return labels[idx];
                  if (idx === 0 || idx === N - 1) return labels[idx];
                  const step = N > 30 ? 5 : N > 18 ? 2 : 1;
                  return idx % step === 0 ? labels[idx] : '';
                },
                maxRotation: 0,
              },
            },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(22, 105, 99, 0.1)', lineWidth: 1 },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (v) => fmtEuroShort(v as number),
              },
            },
          },
        },
      });
      requestAnimationFrame(() => {
        if (chartClassic && chartClassic.options) {
          (chartClassic.options as any).animation = false;
        }
      });
      firstRenderClassic = false;
    }

    function aggiornaTabellaConfronto(dati: DatoAnnuale[]): void {
      const tbody = $('svc-tabella-body');
      if (!tbody) return;
      while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
      const max = Math.min(11, dati.length);
      for (let i = 0; i < max; i++) {
        const d = dati[i];
        const tr = document.createElement('tr');
        tr.innerHTML =
          `<td>${d.anno}</td>` +
          `<td>${fmtEuro.format(d.versatoCumulato)}</td>` +
          `<td>${fmtEuro.format(d.capitaleSemplice)}</td>` +
          `<td>${fmtEuro.format(d.capitaleComposto)}</td>` +
          `<td class="col-magia">+${fmtEuro.format(d.differenza)}</td>`;
        tbody.appendChild(tr);
      }
    }

    function updateChartFallback(out: OutputSempliceVsComposto): void {
      const el = $('svc-chart-fallback');
      if (!el) return;
      el.textContent =
        `Capitale finale dopo ${out.datiAnnuali.length - 1} anni: ` +
        `interesse semplice ${fmtEuro.format(out.finaleSemplice)}, ` +
        `interesse composto ${fmtEuro.format(out.finaleComposto)}, ` +
        `differenza ${fmtEuro.format(out.magiaTotale)}.`;
    }

    // -------------------- ATTO 1 — RACE CHART --------------------
    let chartRace: import('chart.js').Chart | null = null;
    let raceTimer: ReturnType<typeof setTimeout> | null = null;
    let raceAttoInited = false;
    let datiCorrenti: DatoAnnuale[] = [];

    function inizializzaRaceChart(): void {
      if (chartRace) return;
      const canvas = $('svc-chart-race') as unknown as HTMLCanvasElement;
      if (!canvas) return;
      chartRace = new Chart(canvas, {
        type: 'line',
        data: {
          labels: [],
          datasets: [
            {
              label: 'Interesse semplice',
              data: [],
              borderColor: COLORS.semplice,
              backgroundColor: 'transparent',
              borderWidth: 3,
              tension: 0.25,
              pointRadius: 0,
              fill: false,
            },
            {
              label: 'Interesse composto',
              data: [],
              borderColor: COLORS.composto,
              backgroundColor: COLORS.compostoArea,
              borderWidth: 4,
              tension: 0.25,
              pointRadius: 0,
              fill: 'origin',
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: { enabled: false },
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 12 },
                maxRotation: 0,
              },
            },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(22, 105, 99, 0.1)', lineWidth: 1 },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (v) => fmtEuroShort(v as number),
              },
            },
          },
        },
      });
    }

    function avviaRaceAnimation(): void {
      if (!chartRace || !datiCorrenti.length) return;
      if (raceTimer) clearTimeout(raceTimer);

      const labels = datiCorrenti.map((d) => `${d.anno}`);
      const fullS = datiCorrenti.map((d) => d.capitaleSemplice);
      const fullC = datiCorrenti.map((d) => d.capitaleComposto);
      const N = datiCorrenti.length;
      const subtitle = $('atto1-subtitle');
      const titoloAnni = $('atto1-anni');
      if (titoloAnni) titoloAnni.textContent = String(N - 1);

      const totalDuration = 4500; // ms
      const stepDuration = totalDuration / N;

      // Reset
      chartRace.data.labels = labels;
      chartRace.data.datasets[0].data = [];
      chartRace.data.datasets[1].data = [];
      chartRace.update('none');

      // Asse Y fisso al massimo finale per evitare auto-scale durante l'animazione
      const yMax = Math.max(fullS[N - 1], fullC[N - 1]) * 1.05;
      (chartRace.options.scales!.y as any).max = yMax;
      chartRace.update('none');

      // Sottotitoli per fasi
      const fasi = [
        { soglia: 0,    msg: 'All’inizio sembrano uguali...' },
        { soglia: 0.32, msg: 'Anno dopo anno, qualcosa di magico inizia ad accadere...' },
        { soglia: 0.65, msg: 'Gli interessi composti generano altri interessi...' },
        { soglia: 0.95, msg: '' }, // sostituito alla fine
      ];
      let faseCorr = -1;

      let i = 0;
      function tick(): void {
        i++;
        if (!chartRace) return;
        chartRace.data.datasets[0].data = fullS.slice(0, i + 1);
        chartRace.data.datasets[1].data = fullC.slice(0, i + 1);
        chartRace.update('none');

        // Cambio sottotitolo per fase
        const t = i / N;
        const next = (() => {
          if (t < fasi[1].soglia) return 0;
          if (t < fasi[2].soglia) return 1;
          if (t < fasi[3].soglia) return 2;
          return 3;
        })();
        if (next !== faseCorr && subtitle) {
          faseCorr = next;
          if (next === 3) {
            const diff = fullC[N - 1] - fullS[N - 1];
            subtitle.textContent = `Risultato finale: una differenza di ${fmtEuro.format(diff)}`;
          } else {
            subtitle.textContent = fasi[next].msg;
          }
        }

        if (i < N - 1) {
          raceTimer = setTimeout(tick, stepDuration);
        } else {
          // Freeze finale: evidenzia gli ultimi punti
          if (chartRace) {
            const r = datiCorrenti.map((_, idx) => (idx === N - 1 ? 7 : 0));
            (chartRace.data.datasets[0] as any).pointRadius = r;
            (chartRace.data.datasets[0] as any).pointBackgroundColor = COLORS.semplice;
            (chartRace.data.datasets[1] as any).pointRadius = r;
            (chartRace.data.datasets[1] as any).pointBackgroundColor = COLORS.composto;
            chartRace.update('none');
          }
        }
      }
      tick();
    }

    // -------------------- ATTO 2 — TIME MACHINE --------------------
    let countUpTm: CountUp | null = null;

    function annotazionePerAnni(anni: number): string {
      if (anni < 5) return 'Inizio del viaggio: la magia è ancora dormiente.';
      if (anni < 15) return 'Inizia ad accendersi: gli interessi cominciano a fruttare.';
      if (anni < 25) return "L'effetto si amplifica: il capitale cresce visibilmente.";
      if (anni < 35) return 'Decollo: ora la magia è evidente.';
      return 'Long game: il tempo sta facendo tutto il lavoro per te.';
    }

    function aggiornaTimeMachine(): void {
      const slider = $<HTMLInputElement>('svc-tm-slider');
      const anni = Math.max(1, Math.round(parseNum(slider.value) || 1));
      $('svc-tm-anni').textContent = String(anni);

      // Calcolo on-the-fly per gli anni dello slider, mantenendo gli altri input attuali
      const C = Math.max(0, parseNum(inputs.capitale.value) || 0);
      const V = Math.max(0, parseNum(inputs.versamento.value) || 0);
      const tasso = Math.max(0, parseNum(inputs.tasso.value) || 0);
      const out = calcolaSempliceVsComposto({
        capitaleIniziale: C,
        versamentoMensile: V,
        anni: anni,
        tassoAnnuo: tasso,
      });
      if (!out.ok) return;

      const finale = out.finaleComposto;
      const versato = out.versamentoTotale;
      const magia = Math.max(0, out.magiaTotale);

      // Count-up del numero gigante
      const target = $('svc-tm-numero');
      if (countUpTm) {
        countUpTm.update(finale);
      } else {
        countUpTm = new CountUp(target, finale, {
          duration: 0.8,
          separator: '.',
          decimal: ',',
          decimalPlaces: 0,
          prefix: '',
          suffix: ' €',
        });
        countUpTm.start();
      }

      // Annotazione
      $('svc-tm-annotazione').textContent = annotazionePerAnni(anni);

      // Barra di progresso
      const totale = versato + magia;
      const pctVers = totale > 0 ? (versato / totale) * 100 : 50;
      const pctMagia = totale > 0 ? (magia / totale) * 100 : 50;
      ($('svc-tm-bar-versato') as HTMLElement).style.width = pctVers + '%';
      ($('svc-tm-bar-magia') as HTMLElement).style.width = pctMagia + '%';
      $('svc-tm-versato').textContent = fmtEuro.format(versato);
      $('svc-tm-magia').textContent = fmtEuro.format(magia);
    }

    // -------------------- ATTO 3 — COSTO RITARDO --------------------
    let chartRitardo: import('chart.js').Chart | null = null;

    function aggiornaCostoRitardo(out: OutputSempliceVsComposto, input: InputSempliceVsComposto): void {
      const cr = out.costoRitardo;
      $('svc-cr-anni-ritardo').textContent = String(cr.anniRitardo);
      $('svc-cr-anni-ritardo-2').textContent = String(cr.anniRitardo);
      $('svc-cr-anni-att').textContent = String(cr.anniRitardo);

      $('svc-cr-anni-oggi').textContent = String(input.anni);
      $('svc-cr-anni-rit').textContent = String(input.anni - cr.anniRitardo);

      $('svc-cr-oggi').textContent = fmtEuro.format(cr.capitaleFinaleOggi);
      $('svc-cr-ritardo').textContent = fmtEuro.format(cr.capitaleFinaleRitardato);

      $('svc-cr-vers-oggi').textContent = fmtEuro.format(cr.versamentiTotaliOggi);
      $('svc-cr-vers-rit').textContent = fmtEuro.format(cr.versamentiTotaliRitardato);

      const magiaOggi = cr.capitaleFinaleOggi - cr.versamentiTotaliOggi;
      const magiaRit = cr.capitaleFinaleRitardato - cr.versamentiTotaliRitardato;
      $('svc-cr-magia-oggi').textContent = `+ ${fmtEuro.format(Math.max(0, magiaOggi))}`;
      $('svc-cr-magia-rit').textContent = `+ ${fmtEuro.format(Math.max(0, magiaRit))}`;

      $('svc-cr-diff').textContent = `− ${fmtEuro.format(cr.differenzaAssoluta)}`;
      $('svc-cr-diff-pct').textContent = `−${fmtPct(cr.differenzaPercentuale)}`;

      // Grafico: due linee composte (oggi vs ritardo)
      const N = input.anni;
      const ritardo = cr.anniRitardo;
      const labels = Array.from({ length: N + 1 }, (_, i) => `${i}`);
      const oggi = out.datiAnnuali.map((d) => d.capitaleComposto);
      // Costruisci la linea ritardata: 0 dall'anno 0 a 'ritardo', poi cresce
      const C = input.capitaleIniziale;
      const V = input.versamentoMensile * 12;
      const R = input.tassoAnnuo / 100;
      const rit: number[] = [];
      for (let k = 0; k <= N; k++) {
        if (k < ritardo) {
          rit.push(0);
        } else {
          const ke = k - ritardo;
          if (ke === 0) rit.push(C);
          else if (Math.abs(R) < 1e-12) rit.push(C + V * ke);
          else rit.push(C * Math.pow(1 + R, ke) + V * (Math.pow(1 + R, ke) - 1) / R);
        }
      }

      const canvas = $('svc-chart-ritardo') as unknown as HTMLCanvasElement;
      if (!canvas) return;

      if (chartRitardo) {
        chartRitardo.data.labels = labels;
        chartRitardo.data.datasets[0].data = oggi;
        chartRitardo.data.datasets[1].data = rit;
        chartRitardo.update('none');
        return;
      }

      chartRitardo = new Chart(canvas, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'Inizia oggi',
              data: oggi,
              borderColor: COLORS.composto,
              backgroundColor: COLORS.compostoArea,
              borderWidth: 4,
              tension: 0.25,
              pointRadius: 0,
              fill: 'origin',
            },
            {
              label: 'Inizia tra anni',
              data: rit,
              borderColor: COLORS.ochre,
              backgroundColor: 'rgba(171, 127, 98, 0.12)',
              borderWidth: 3,
              tension: 0.25,
              pointRadius: 0,
              fill: 'origin',
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 700, easing: 'easeOutQuart' },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#FFFFFF',
              borderColor: 'rgba(22, 105, 99, 0.25)',
              borderWidth: 1,
              titleColor: COLORS.sageDark,
              titleFont: { family: 'Manrope, sans-serif', weight: 700, size: 13 },
              bodyColor: COLORS.charcoal,
              bodyFont: { family: 'Manrope, sans-serif', size: 12 },
              padding: 12,
              cornerRadius: 8,
              displayColors: true,
              callbacks: {
                title: (items) => `Anno ${items[0].label}`,
                label: (ctx) => `  ${ctx.dataset.label}: ${fmtEuroPrecise.format(Number(ctx.parsed.y))}`,
              },
            },
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                maxRotation: 0,
                callback: (_v, idx) => {
                  const M = labels.length;
                  if (M <= 12) return labels[idx];
                  if (idx === 0 || idx === M - 1) return labels[idx];
                  const step = M > 30 ? 5 : M > 18 ? 2 : 1;
                  return idx % step === 0 ? labels[idx] : '';
                },
              },
            },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(22, 105, 99, 0.1)', lineWidth: 1 },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (v) => fmtEuroShort(v as number),
              },
            },
          },
        },
      });
    }

    // -------------------- ATTO 4 — STORIA MARCO E LUCA --------------------
    let storiaRivelata = false;
    let countUpMarco: CountUp | null = null;
    let countUpLuca: CountUp | null = null;

    function aggiornaStoria(out: OutputSempliceVsComposto, input: InputSempliceVsComposto): void {
      const s = out.storiaMarcoLuca;
      $('svc-storia-vers-mensile').textContent = `${fmtEuro.format(input.versamentoMensile)}`;
      $('svc-storia-vers-mensile-2').textContent = `${fmtEuro.format(input.versamentoMensile)}`;
      $('svc-storia-marco-versato').textContent = fmtEuro.format(s.marco.versato);
      $('svc-storia-luca-versato').textContent = fmtEuro.format(s.luca.versato);

      // Se la storia è già stata rivelata, aggiorna i numeri immediatamente
      if (storiaRivelata) {
        const marcoEl = $('svc-riv-marco');
        const lucaEl = $('svc-riv-luca');
        marcoEl.textContent = fmtEuro.format(s.marco.finale);
        lucaEl.textContent = fmtEuro.format(s.luca.finale);
        aggiornaConfrontoStoria(s);
      }
    }

    function aggiornaConfrontoStoria(s: OutputSempliceVsComposto['storiaMarcoLuca']): void {
      const confronto = $('svc-riv-confronto');
      if (s.vincitore === 'marco') {
        const piuPct = s.luca.finale > 0 ? ((s.marco.finale - s.luca.finale) / s.luca.finale) * 100 : 0;
        confronto.innerHTML =
          `Marco ha versato <strong>un terzo</strong> di Luca, ma ha ` +
          `<strong>+${fmtPct(piuPct)}</strong> in più di patrimonio finale.`;
      } else if (s.vincitore === 'luca') {
        const piuPct = s.marco.finale > 0 ? ((s.luca.finale - s.marco.finale) / s.marco.finale) * 100 : 0;
        confronto.innerHTML =
          `Con questo tasso Luca ha più capitale di Marco (+${fmtPct(piuPct)}). ` +
          `Con un tasso più alto, l'effetto del tempo iniziale ribalterebbe la situazione.`;
      } else {
        confronto.textContent = 'Con questi parametri Marco e Luca arrivano allo stesso risultato.';
      }
    }

    function rivelaStoria(): void {
      const btn = $<HTMLButtonElement>('svc-btn-rivela');
      const content = $('svc-rivelazione-content');
      if (!btn || !content) return;
      btn.setAttribute('aria-expanded', 'true');
      content.hidden = false;
      storiaRivelata = true;

      const out = ultimoOutput;
      if (!out) return;
      const s = out.storiaMarcoLuca;

      // Count-up parallelo
      const marcoEl = $('svc-riv-marco');
      const lucaEl = $('svc-riv-luca');
      countUpMarco = new CountUp(marcoEl, s.marco.finale, {
        duration: 2.2,
        separator: '.',
        decimal: ',',
        decimalPlaces: 0,
        suffix: ' €',
      });
      countUpLuca = new CountUp(lucaEl, s.luca.finale, {
        duration: 2.2,
        separator: '.',
        decimal: ',',
        decimalPlaces: 0,
        suffix: ' €',
      });
      countUpMarco.start();
      countUpLuca.start();

      aggiornaConfrontoStoria(s);
    }

    // -------------------- INTERSECTION OBSERVER --------------------
    function setupObserver(): void {
      if (!('IntersectionObserver' in window)) {
        // Fallback: inizializza subito
        inizializzaRaceChart();
        if (datiCorrenti.length) avviaRaceAnimation();
        return;
      }
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting && e.target.id === 'atto-1' && !raceAttoInited) {
              raceAttoInited = true;
              inizializzaRaceChart();
              if (datiCorrenti.length) {
                // Piccolo delay per dare modo al DOM di stabilizzarsi
                setTimeout(avviaRaceAnimation, 200);
              }
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.3 }
      );
      const t = $('atto-1');
      if (t) obs.observe(t);
    }

    // -------------------- MAIN --------------------
    let ultimoOutput: OutputSempliceVsComposto | null = null;

    function aggiorna(): void {
      const blocking = $('svc-blocking');

      const C = parseNum(inputs.capitale.value);
      const V = parseNum(inputs.versamento.value);
      const N = parseNum(inputs.anni.value);
      const tasso = parseNum(inputs.tasso.value);

      // Sync slider/number
      const annNum = $('svc-anni-display');
      if (annNum && Number.isFinite(N)) {
        annNum.textContent = `${Math.round(N)} ann${Math.round(N) === 1 ? 'o' : 'i'}`;
      }

      if (!Number.isFinite(N) || N < 1) {
        blocking.textContent = 'Inserisci almeno 1 anno.';
        return;
      }
      if (N > 60) {
        blocking.textContent = 'Orizzonte massimo: 60 anni.';
        return;
      }
      if ((!Number.isFinite(C) || C < 0) && (!Number.isFinite(V) || V < 0)) {
        blocking.textContent = 'Inserisci capitale o versamento.';
        return;
      }

      const input: InputSempliceVsComposto = {
        capitaleIniziale: Number.isFinite(C) && C > 0 ? C : 0,
        versamentoMensile: Number.isFinite(V) && V > 0 ? V : 0,
        anni: Math.round(N),
        tassoAnnuo: Number.isFinite(tasso) && tasso > 0 ? tasso : 0,
      };

      const out = calcolaSempliceVsComposto(input);
      if (!out.ok) {
        blocking.textContent = out.errore ?? 'Dati non validi.';
        return;
      }
      blocking.textContent = '';

      ultimoOutput = out;
      datiCorrenti = out.datiAnnuali;

      // Output principale
      $('svc-out-semplice').textContent = fmtEuro.format(out.finaleSemplice);
      $('svc-out-composto').textContent = fmtEuro.format(out.finaleComposto);
      $('svc-out-magia').textContent = `+${fmtEuro.format(Math.max(0, out.magiaTotale))}`;
      $('svc-out-versato').textContent = fmtEuro.format(out.versamentoTotale);
      $('svc-out-incrocio').textContent =
        out.annoIncrocio !== null ? `Anno ${out.annoIncrocio}` : '— (non raggiunto)';

      // Warnings
      const warnEl = $('svc-warnings');
      while (warnEl.firstChild) warnEl.removeChild(warnEl.firstChild);
      if (out.warning.length) {
        const ul = document.createElement('ul');
        for (const w of out.warning) {
          const li = document.createElement('li');
          li.textContent = w;
          ul.appendChild(li);
        }
        warnEl.appendChild(ul);
      }

      disegnaChartClassic(out);
      updateChartFallback(out);
      aggiornaTabellaConfronto(out.datiAnnuali);

      // Aggiorna Atto 1 (se grafico è già stato inizializzato, riavvia)
      const titoloAnni = $('atto1-anni');
      if (titoloAnni) titoloAnni.textContent = String(input.anni);
      if (chartRace && raceAttoInited) {
        avviaRaceAnimation();
      }

      // Atto 2 e Atto 3 e Atto 4
      aggiornaTimeMachine();
      aggiornaCostoRitardo(out, input);
      aggiornaStoria(out, input);
    }

    // -------------------- DEBOUNCE + WIRING --------------------
    let timer: ReturnType<typeof setTimeout> | null = null;
    function schedule(): void {
      if (timer) clearTimeout(timer);
      timer = setTimeout(aggiorna, 200);
    }

    // Sync slider ↔ number per anni
    inputs.anniSlider.addEventListener('input', () => {
      inputs.anni.value = inputs.anniSlider.value;
      schedule();
    });
    inputs.anni.addEventListener('input', () => {
      const v = parseNum(inputs.anni.value);
      if (Number.isFinite(v) && v >= 1 && v <= 60) {
        inputs.anniSlider.value = String(Math.round(v));
      }
      schedule();
    });
    [inputs.capitale, inputs.versamento, inputs.tasso].forEach((el) => {
      el.addEventListener('input', schedule);
      el.addEventListener('change', schedule);
    });

    // Time machine slider — separato dal form principale
    const tmSlider = $<HTMLInputElement>('svc-tm-slider');
    if (tmSlider) {
      tmSlider.addEventListener('input', aggiornaTimeMachine);
    }

    // Replay race
    const replayBtn = $<HTMLButtonElement>('svc-replay-race');
    if (replayBtn) {
      replayBtn.addEventListener('click', () => {
        if (!chartRace) {
          inizializzaRaceChart();
        }
        avviaRaceAnimation();
      });
    }

    // Rivela storia
    const btnRivela = $<HTMLButtonElement>('svc-btn-rivela');
    if (btnRivela) {
      btnRivela.addEventListener('click', rivelaStoria);
    }

    // Setup observer per Atto 1
    setupObserver();

    // Allinea time-machine slider al valore principale al primo render
    tmSlider.value = inputs.anni.value;

    aggiorna();
  </script>
</Layout>
