<script is:inline>
  // ============================================================
  // PARAMETRI INPS / FISCALI
  // ============================================================
  const COEFFICIENTI = {
    62: 0.04757, 63: 0.04887, 64: 0.05025, 65: 0.05172, 66: 0.05384,
    67: 0.05608, 68: 0.05845, 69: 0.06096, 70: 0.06363, 71: 0.06655
  };

  const ALIQUOTE = { dipendente: 0.33, autonomo_ordinario: 0.2607, autonomo_forfettario: 0.2607 };

  const IRPEF_SCAGLIONI = [
    { limite: 28000, aliquota: 0.23 },
    { limite: 50000, aliquota: 0.35 },
    { limite: Infinity, aliquota: 0.43 }
  ];

  const MAX_DEDUCIBILITA = 5164.57;
  const TFR_PERCENT = 0.0691;
  const TASSO_RIVALUTAZIONE = 0.01;
  const CRESCITA_REDDITO = 0.02;
  const INFLAZIONE = 0.015;

  // ============================================================
  // STATO
  // ============================================================
  const state = {
    eta: 40, etaPensione: 67,
    versamentoMensile: 300,
    haFP: 'no', fpEsistente: 0,
    tipo: 'dipendente',
    conosceRAL: 'si',
    redditoLordo: 35000,
    stipendioNetto: 1900,
    redditoOrdinario: 40000,
    fatturatoForf: 50000,
    coefRedditivita: 0.78,
    versaTFR: 'si',
    rendimentoCustom: true,
    rendimento: 0.035,
    anniContributi: 15,
    calcolato: false
  };

  // ============================================================
  // UI HANDLERS
  // ============================================================
  function aggiornaTipo() {
    state.tipo = document.getElementById('tipo').value;
    document.querySelectorAll('[data-tipo]').forEach(el => {
      el.classList.toggle('active', el.dataset.tipo === state.tipo);
    });
  }

  function aggiornaConosceRAL() {
    state.conosceRAL = document.querySelector('input[name="conosceRAL"]:checked').value;
    document.getElementById('campoRAL').classList.toggle('active', state.conosceRAL === 'si');
    document.getElementById('campoNettoStipendio').classList.toggle('active', state.conosceRAL === 'no');
  }

  function aggiornaTFR() {
    state.versaTFR = document.querySelector('input[name="versaTFR"]:checked').value;
    document.getElementById('infoTFR').style.display = state.versaTFR === 'si' ? 'block' : 'none';
  }

  function aggiornaFP() {
    state.haFP = document.querySelector('input[name="haFP"]:checked').value;
    document.getElementById('campoFPesistente').classList.toggle('active', state.haFP === 'si');
  }

  function aggiornaRendimentoCustom() {
    state.rendimentoCustom = document.getElementById('rendimentoCustom').checked;
    document.getElementById('campoRendimento').classList.toggle('active', state.rendimentoCustom);
  }

  // ============================================================
  // CALCOLO IRPEF
  // ============================================================
  function calcolaIRPEF(redditoLordo) {
    if (redditoLordo <= 8500) return 0;
    let irpef = 0, prev = 0;
    for (const sc of IRPEF_SCAGLIONI) {
      if (redditoLordo > sc.limite) {
        irpef += (sc.limite - prev) * sc.aliquota;
        prev = sc.limite;
      } else {
        irpef += (redditoLordo - prev) * sc.aliquota;
        break;
      }
    }
    let detr = 1955;
    if (redditoLordo > 28000) detr *= Math.max(0, (50000 - redditoLordo) / 22000);
    if (redditoLordo > 50000) detr = 0;
    return Math.max(0, irpef - detr);
  }

  function aliquotaMarginale(redditoLordo) {
    if (redditoLordo > 50000) return 0.43;
    if (redditoLordo > 28000) return 0.35;
    return 0.23;
  }

  function stimaRALDaNetto(nettoMens) {
    const nettoAnno = nettoMens * 13;
    let ralStimato = nettoAnno / 0.7;
    for (let i = 0; i < 5; i++) {
      const contribLav = ralStimato * 0.0919;
      const imponibile = ralStimato - contribLav;
      const irpef = calcolaIRPEF(imponibile);
      const add = imponibile * 0.018;
      const nettoCalc = imponibile - irpef - add;
      const fattore = nettoAnno / nettoCalc;
      ralStimato *= fattore;
    }
    return ralStimato;
  }

  // ============================================================
  // CALCOLO PRINCIPALE
  // ============================================================
  function calcolaScenario() {
    state.eta = parseInt(document.getElementById('eta').value) || 40;
    state.etaPensione = parseInt(document.getElementById('etaPensione').value) || 67;
    state.versamentoMensile = parseFloat(document.getElementById('versamentoMensile').value) || 0;
    state.tipo = document.getElementById('tipo').value;
    state.haFP = document.querySelector('input[name="haFP"]:checked').value;
    state.fpEsistente = state.haFP === 'si' ? (parseFloat(document.getElementById('fpEsistente').value) || 0) : 0;
    state.anniContributi = parseInt(document.getElementById('anniContributi').value) || 0;
    state.rendimentoCustom = document.getElementById('rendimentoCustom').checked;
    if (state.rendimentoCustom) {
      state.rendimento = parseFloat(document.getElementById('rendimentoValue').value) / 100;
    } else {
      const anniRim = state.etaPensione - state.eta;
      state.rendimento = anniRim > 20 ? 0.045 : (anniRim > 10 ? 0.03 : 0.02);
    }

    let RAL = 0;
    if (state.tipo === 'dipendente') {
      state.conosceRAL = document.querySelector('input[name="conosceRAL"]:checked').value;
      if (state.conosceRAL === 'si') {
        state.redditoLordo = parseFloat(document.getElementById('redditoLordo').value) || 0;
        RAL = state.redditoLordo;
      } else {
        state.stipendioNetto = parseFloat(document.getElementById('stipendioNetto').value) || 0;
        RAL = stimaRALDaNetto(state.stipendioNetto);
        state.redditoLordo = RAL;
      }
      state.versaTFR = document.querySelector('input[name="versaTFR"]:checked').value;
    } else if (state.tipo === 'autonomo_ordinario') {
      state.redditoOrdinario = parseFloat(document.getElementById('redditoOrdinario').value) || 0;
      RAL = state.redditoOrdinario;
      state.versaTFR = 'no';
    } else {
      state.fatturatoForf = parseFloat(document.getElementById('fatturatoForf').value) || 0;
      state.coefRedditivita = parseFloat(document.getElementById('coefRedditivita').value);
      RAL = state.fatturatoForf * state.coefRedditivita;
      state.versaTFR = 'no';
    }

    if (state.eta >= state.etaPensione) {
      return { error: "L'età di pensionamento deve essere maggiore dell'età attuale." };
    }

    const anniRimanenti = state.etaPensione - state.eta;
    const versamentoAnnuo = state.versamentoMensile * 12;
    const r = state.rendimento;

    let compartoConsigliato;
    if (anniRimanenti > 25) compartoConsigliato = 'Azionario';
    else if (anniRimanenti > 15) compartoConsigliato = 'Bilanciato Dinamico';
    else if (anniRimanenti > 7) compartoConsigliato = 'Bilanciato';
    else compartoConsigliato = 'Garantito / Obbligazionario';

    let tfrAnnuo = 0;
    if (state.tipo === 'dipendente' && state.versaTFR === 'si') {
      tfrAnnuo = RAL * TFR_PERCENT;
    }

    const rMens = Math.pow(1 + r, 1/12) - 1;
    let montante = state.fpEsistente;
    const seriemont = [{ anno: 0, eta: state.eta, valore: montante }];

    for (let i = 1; i <= anniRimanenti; i++) {
      montante = montante * (1 + r);
      const contribAnnuo = versamentoAnnuo + tfrAnnuo;
      montante += contribAnnuo * (1 + r / 2);
      seriemont.push({ anno: i, eta: state.eta + i, valore: montante });
    }

    const montanteFinale = montante;
    const totaleVersato = versamentoAnnuo * anniRimanenti;
    const totaleTFR = tfrAnnuo * anniRimanenti;

    let aliqMarginale = 0;
    if (state.tipo !== 'autonomo_forfettario') {
      const baseImpFiscale = state.tipo === 'dipendente'
        ? RAL - (RAL * 0.0919)
        : RAL - (RAL * 0.2607);
      aliqMarginale = aliquotaMarginale(baseImpFiscale);
    }
    const versDeducibile = Math.min(versamentoAnnuo, MAX_DEDUCIBILITA);
    const risparmioFiscaleAnnuo = versDeducibile * aliqMarginale;
    const risparmioFiscaleTotale = risparmioFiscaleAnnuo * anniRimanenti;

    return {
      anniRimanenti,
      compartoConsigliato,
      rendimentoMostrato: r * 100,
      versamentoAnnuo,
      tfrAnnuo,
      montanteFinale,
      totaleVersato,
      totaleTFR,
      totaleInteresse: montanteFinale - state.fpEsistente - totaleVersato - totaleTFR,
      risparmioFiscaleAnnuo,
      risparmioFiscaleTotale,
      aliqMarginale,
      seriemont,
      RAL
    };
  }

  // ============================================================
  // RENDER RISULTATI
  // ============================================================
  function calcolaERender() {
    const r = calcolaScenario();

    if (r.error) {
      document.getElementById('resultsContent').innerHTML = `<p style="color: #C75D5D; text-align: center;"><strong>⚠️ ${r.error}</strong></p>`;
      return;
    }

    state.calcolato = true;

    document.getElementById('sliderContributo').value = state.versamentoMensile;
    document.getElementById('valContributo').textContent = '€ ' + state.versamentoMensile;
    document.getElementById('sliderEtaPens').value = state.etaPensione;
    document.getElementById('valEta').textContent = state.etaPensione + ' anni';
    document.getElementById('sliderRendimento').value = Math.round(state.rendimento * 1000);
    document.getElementById('valRendimento').textContent = (state.rendimento * 100).toFixed(1).replace('.', ',') + '%';

    renderResults(r);
    document.getElementById('scenarioControls').style.display = 'block';
    document.getElementById('chartSection').style.display = 'block';
    disegnaChart(r.seriemont);

    setTimeout(() => {
      document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 200);
  }

  function renderResults(r) {
    const isForf = state.tipo === 'autonomo_forfettario';
    const tfrText = (state.tipo === 'dipendente' && state.versaTFR === 'si')
      ? ` Includendo il versamento del TFR (circa <span class="number">${formatEuro(r.tfrAnnuo)}/anno</span>),` : '';

    let fiscalSentence;
    if (isForf) {
      fiscalSentence = `<p>⚠️ <strong>In regime forfettario non è prevista deducibilità fiscale dei contributi al fondo pensione</strong> (a causa del regime di imposta sostitutiva). Resta comunque importantissimo costruire una previdenza integrativa, dato che i contributi versati sono calcolati su un imponibile ridotto e la pensione INPS sarà di conseguenza più bassa.</p>`;
    } else {
      fiscalSentence = `<p>Con i versamenti volontari effettuati avrai un <strong>risparmio fiscale annuo</strong> di <span class="number">${formatEuro(r.risparmioFiscaleAnnuo)}</span>/anno. Nel corso degli anni, ipotizzando tu rimanga nel medesimo scaglione reddituale IRPEF, risparmierai <span class="number">${formatEuroDec(r.risparmioFiscaleTotale)}</span> di imposte.</p>`;
    }

    let fpEsistenteText = '';
    if (state.haFP === 'si' && state.fpEsistente > 0) {
      fpEsistenteText = ` Considerando un capitale iniziale di <span class="number">${formatEuro(state.fpEsistente)}</span> già versato nel tuo fondo,`;
    }

    document.getElementById('resultsContent').innerHTML = `
      <p>Andrai in pensione tra <span class="number">${r.anniRimanenti}</span> anni. Considerando questo lasso di tempo il comparto d'investimento consigliato è il comparto <strong>${r.compartoConsigliato}</strong>.</p>

      <p>Il rendimento medio annuo considerato per questo comparto è del <strong>${r.rendimentoMostrato.toFixed(2).replace('.', ',')}%</strong>${state.rendimentoCustom ? ' (rendimento personalizzato da te scelto)' : ' (basato sui rendimenti storici medi del comparto)'}.</p>

      ${fiscalSentence}

      <p>Versando <span class="number">${formatEuro(state.versamentoMensile)}</span>/mese (pari a <span class="number">${formatEuro(r.versamentoAnnuo)}</span>/anno),${fpEsistenteText}${tfrText} il <strong>montante lordo finale</strong> stimato alla data del tuo pensionamento corrisponde a <span class="number" style="font-size: 1.3em; color: var(--ochre-dark);">${formatEuroDec(r.montanteFinale)}</span>.</p>

      <p style="font-size: 0.92rem; color: var(--gray-text); padding: 12px 16px; background: white; border-radius: 6px; border-left: 3px solid var(--sage); margin-top: 18px;">
        <strong>Composizione del montante:</strong>
        ${state.fpEsistente > 0 ? `capitale iniziale ${formatEuro(state.fpEsistente)} + ` : ''}
        versamenti totali ${formatEuro(r.totaleVersato)}
        ${r.totaleTFR > 0 ? ` + TFR accumulato ${formatEuro(r.totaleTFR)}` : ''}
        + interessi maturati <strong>${formatEuro(r.totaleInteresse)}</strong>.
      </p>
    `;
  }

  // ============================================================
  // CHART
  // ============================================================
  function disegnaChart(seriemont) {
    const svg = document.getElementById('chartMontante');
    svg.innerHTML = '';
    const W = 800, H = 320;
    const m = { top: 25, right: 30, bottom: 45, left: 75 };
    const w = W - m.left - m.right;
    const h = H - m.top - m.bottom;
    const xMin = seriemont[0].eta;
    const xMax = seriemont[seriemont.length - 1].eta;
    const yMax = seriemont[seriemont.length - 1].valore * 1.1 || 100000;
    const x = eta => m.left + ((eta - xMin) / Math.max(1, xMax - xMin)) * w;
    const y = val => m.top + h - (val / yMax) * h;

    for (let i = 0; i <= 4; i++) {
      const val = (yMax / 4) * i;
      const yPos = y(val);
      const gl = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      gl.setAttribute('class', 'grid-line');
      gl.setAttribute('x1', m.left); gl.setAttribute('x2', m.left + w);
      gl.setAttribute('y1', yPos); gl.setAttribute('y2', yPos);
      gl.setAttribute('stroke-width', 1);
      svg.appendChild(gl);
      const lb = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      lb.setAttribute('class', 'axis-text');
      lb.setAttribute('x', m.left - 10); lb.setAttribute('y', yPos + 4);
      lb.setAttribute('text-anchor', 'end');
      lb.textContent = formatEuroShort(val);
      svg.appendChild(lb);
    }

    const ax = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    ax.setAttribute('class', 'axis-line');
    ax.setAttribute('x1', m.left); ax.setAttribute('x2', m.left + w);
    ax.setAttribute('y1', m.top + h); ax.setAttribute('y2', m.top + h);
    ax.setAttribute('stroke-width', 1);
    svg.appendChild(ax);

    const numAnni = xMax - xMin;
    const stepTick = numAnni <= 5 ? 1 : (numAnni <= 15 ? 3 : 5);
    for (let etaTick = xMin; etaTick <= xMax; etaTick += stepTick) {
      const tl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      tl.setAttribute('class', 'axis-text');
      tl.setAttribute('x', x(etaTick)); tl.setAttribute('y', m.top + h + 18);
      tl.setAttribute('text-anchor', 'middle');
      tl.textContent = etaTick;
      svg.appendChild(tl);
    }

    const xal = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    xal.setAttribute('class', 'axis-text');
    xal.setAttribute('x', m.left + w / 2); xal.setAttribute('y', H - 8);
    xal.setAttribute('text-anchor', 'middle');
    xal.textContent = 'Età';
    svg.appendChild(xal);

    let path = '';
    seriemont.forEach((p, i) => {
      path += (i === 0 ? 'M' : 'L') + x(p.eta) + ',' + y(p.valore) + ' ';
    });
    const area = path + 'L' + x(xMax) + ',' + y(0) + ' L' + x(xMin) + ',' + y(0) + ' Z';
    const a1 = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    a1.setAttribute('d', area);
    a1.setAttribute('fill', 'var(--sage)');
    a1.setAttribute('fill-opacity', '0.18');
    svg.appendChild(a1);

    const l1 = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    l1.setAttribute('d', path);
    l1.setAttribute('fill', 'none');
    l1.setAttribute('stroke', 'var(--sage)');
    l1.setAttribute('stroke-width', '2.5');
    l1.setAttribute('stroke-linejoin', 'round');
    svg.appendChild(l1);

    const len = l1.getTotalLength();
    l1.style.strokeDasharray = len;
    l1.style.strokeDashoffset = len;
    l1.getBoundingClientRect();
    l1.style.transition = 'stroke-dashoffset 1.4s cubic-bezier(0.4, 0, 0.2, 1)';
    requestAnimationFrame(() => { l1.style.strokeDashoffset = '0'; });

    const finalP = seriemont[seriemont.length - 1];
    const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    dot.setAttribute('cx', x(finalP.eta));
    dot.setAttribute('cy', y(finalP.valore));
    dot.setAttribute('r', 5);
    dot.setAttribute('fill', 'white');
    dot.setAttribute('stroke', 'var(--sage)');
    dot.setAttribute('stroke-width', 2.5);
    svg.appendChild(dot);

    const lbl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    lbl.setAttribute('class', 'axis-text-bold');
    lbl.setAttribute('x', x(finalP.eta) - 8);
    lbl.setAttribute('y', y(finalP.valore) - 10);
    lbl.setAttribute('text-anchor', 'end');
    lbl.textContent = formatEuroShort(finalP.valore);
    svg.appendChild(lbl);
  }

  // ============================================================
  // SLIDERS
  // ============================================================
  let upTimeout = null;
  function debouncedUpdate() {
    if (upTimeout) clearTimeout(upTimeout);
    upTimeout = setTimeout(() => {
      const r = calcolaScenario();
      if (r.error) return;
      renderResults(r);
      disegnaChart(r.seriemont);
    }, 80);
  }

  document.getElementById('sliderContributo').addEventListener('input', e => {
    state.versamentoMensile = parseInt(e.target.value);
    document.getElementById('valContributo').textContent = '€ ' + state.versamentoMensile;
    document.getElementById('versamentoMensile').value = state.versamentoMensile;
    debouncedUpdate();
  });
  document.getElementById('sliderEtaPens').addEventListener('input', e => {
    state.etaPensione = parseInt(e.target.value);
    document.getElementById('valEta').textContent = state.etaPensione + ' anni';
    document.getElementById('etaPensione').value = state.etaPensione;
    debouncedUpdate();
  });
  document.getElementById('sliderRendimento').addEventListener('input', e => {
    state.rendimento = parseInt(e.target.value) / 1000;
    document.getElementById('valRendimento').textContent = (state.rendimento * 100).toFixed(1).replace('.', ',') + '%';
    document.getElementById('rendimentoCustom').checked = true;
    document.getElementById('campoRendimento').classList.add('active');
    document.getElementById('rendimentoValue').value = (state.rendimento * 100).toFixed(1);
    debouncedUpdate();
  });

  // ============================================================
  // UTILS
  // ============================================================
  function formatEuro(num) {
    return Math.round(num).toLocaleString('it-IT') + ' €';
  }
  function formatEuroDec(num) {
    return num.toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  }
  function formatEuroShort(num) {
    if (num >= 1000000) return (num / 1000000).toFixed(1).replace('.', ',') + 'M €';
    if (num >= 1000) return Math.round(num / 1000) + 'k €';
    return Math.round(num) + ' €';
  }

  function inviaContatto() {
    const nome = document.getElementById('ctcNome').value;
    const email = document.getElementById('ctcEmail').value;
    const tel = document.getElementById('ctcTel').value;
    const msg = document.getElementById('ctcMsg').value;
    if (!nome || !email || !tel || !msg) {
      alert('Per favore compila tutti i campi obbligatori.');
      return;
    }
    alert(`Grazie ${nome}! Ti ricontatterò entro 24 ore.\n\n(NB: integrare backend per invio reale)`);
  }
</script>

</Layout>
