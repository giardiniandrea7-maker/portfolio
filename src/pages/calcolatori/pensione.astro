---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Calcolatore Gap Previdenziale | Andrea Giardini',
  description: 'Scopri quanto prenderai di pensione e calcola il tuo gap previdenziale. Simulatore gratuito con scenari personalizzabili.',
};
---

<Layout metadata={metadata}>
  <section class="calc-page py-8 md:py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="calc-container">

  <header class="calc-header">
    <h1>Quanto prenderai davvero di pensione?</h1>
    <p>Stima il tuo gap previdenziale, poi gioca con gli scenari per trovare la tua strategia ottimale.</p>
  </header>

  <div class="steps">
    <div class="step active" data-step="1"><div class="step-num">1</div><span>I tuoi dati</span></div>
    <div class="step-divider"></div>
    <div class="step" data-step="2"><div class="step-num">2</div><span>Lavoro</span></div>
    <div class="step-divider"></div>
    <div class="step" data-step="3"><div class="step-num">3</div><span>Reddito</span></div>
    <div class="step-divider"></div>
    <div class="step" data-step="4"><div class="step-num">4</div><span>Dashboard</span></div>
  </div>

  <div class="calc-body">

    <!-- STEP 1 -->
    <section class="form-section active" id="section-1">
      <h2 class="section-title">Iniziamo dai tuoi dati</h2>
      <p class="section-subtitle">Pochi dati anagrafici per impostare il calcolo.</p>
      <div class="form-grid">
        <div class="form-group">
          <label for="eta">La tua età attuale</label>
          <input type="number" id="eta" min="20" max="70" placeholder="Es. 40" value="40">
        </div>
        <div class="form-group">
          <label for="etaPensione">A che età vorresti andare in pensione?</label>
          <input type="number" id="etaPensione" min="62" max="71" placeholder="Es. 67" value="67">
          <span class="label-hint">Pensione di vecchiaia: 67 anni. Potrai modificarla negli scenari.</span>
        </div>
      </div>
      <div class="btn-row">
        <button class="btn btn-primary" onclick="goToStep(2)">Avanti →</button>
      </div>
    </section>

    <!-- STEP 2 -->
    <section class="form-section" id="section-2">
      <h2 class="section-title">Qual è la tua posizione lavorativa?</h2>
      <p class="section-subtitle">Le aliquote contributive e il regime fiscale variano in modo sostanziale.</p>
      <div class="form-group full-width" style="margin-bottom: 15px;">
        <div class="radio-group">
          <label class="radio-card">
            <input type="radio" name="tipo" value="dipendente" checked onchange="aggiornaCampiCondizionali()">
            <div class="radio-card-label">
              <span class="icon">👔</span>
              <div class="title">Dipendente</div>
              <div class="desc">Aliquota INPS 33%</div>
            </div>
          </label>
          <label class="radio-card">
            <input type="radio" name="tipo" value="autonomo_ordinario" onchange="aggiornaCampiCondizionali()">
            <div class="radio-card-label">
              <span class="icon">💼</span>
              <div class="title">P.IVA Ordinario</div>
              <div class="desc">Gestione separata 26,07%</div>
            </div>
          </label>
          <label class="radio-card">
            <input type="radio" name="tipo" value="autonomo_forfettario" onchange="aggiornaCampiCondizionali()">
            <div class="radio-card-label">
              <span class="icon">📋</span>
              <div class="title">P.IVA Forfettario</div>
              <div class="desc">Aliquota su reddito imponibile</div>
            </div>
          </label>
        </div>
      </div>
      <div class="info-box" id="tipoInfoBox">
        <strong>Dipendente:</strong> Il datore di lavoro versa il 33% del tuo RAL all'INPS (di cui ~9,19% a tuo carico, il resto a carico del datore). Il TFR ti permette di accantonare ulteriori risorse, che puoi tenere in azienda o destinare a un fondo pensione.
      </div>
      <div class="btn-row">
        <button class="btn btn-secondary" onclick="goToStep(1)">← Indietro</button>
        <button class="btn btn-primary" onclick="goToStep(3)">Avanti →</button>
      </div>
    </section>

    <!-- STEP 3 -->
    <section class="form-section" id="section-3">
      <h2 class="section-title">Il tuo reddito attuale</h2>
      <p class="section-subtitle">Più i dati sono accurati, più la stima sarà realistica.</p>

      <div class="conditional-field active" data-tipo="dipendente">
        <div class="form-grid">
          <div class="form-group">
            <label for="redditoLordo">RAL — Reddito Annuo Lordo (€)</label>
            <input type="number" id="redditoLordo" min="0" placeholder="Es. 35000" value="35000">
            <span class="label-hint">Lo trovi sul CUD/CU o sull'ultima busta paga (×13 o ×14)</span>
          </div>
          <div class="form-group">
            <label for="anniContributiDip">Anni di contributi già versati</label>
            <input type="number" id="anniContributiDip" min="0" max="50" placeholder="Es. 15" value="15">
            <span class="label-hint">Anni di lavoro effettivi finora</span>
          </div>
        </div>
        <div class="toggle-row" onclick="toggleTFR()">
          <input type="checkbox" id="includeTFR" class="toggle-checkbox" checked onclick="event.stopPropagation()">
          <label onclick="event.stopPropagation()"><strong>Includi il TFR</strong> nei calcoli — circa il 6,91% del RAL annuo</label>
        </div>
      </div>

      <div class="conditional-field" data-tipo="autonomo_ordinario">
        <div class="form-grid">
          <div class="form-group">
            <label for="redditoOrdinario">Reddito netto annuo (€)</label>
            <input type="number" id="redditoOrdinario" min="0" placeholder="Es. 40000" value="40000">
            <span class="label-hint">Reddito imponibile dichiarato (al netto di costi/spese deducibili)</span>
          </div>
          <div class="form-group">
            <label for="anniContributiOrd">Anni di contributi già versati</label>
            <input type="number" id="anniContributiOrd" min="0" max="50" placeholder="Es. 10" value="10">
            <span class="label-hint">Anni di attività con versamenti INPS gestione separata</span>
          </div>
        </div>
        <div class="info-box ochre">
          <strong>Nota:</strong> Per la gestione separata l'aliquota è del <strong>26,07%</strong> (2026) sul reddito imponibile, fino al massimale annuo previsto.
        </div>
      </div>

      <div class="conditional-field" data-tipo="autonomo_forfettario">
        <div class="form-grid">
          <div class="form-group">
            <label for="fatturatoForfettario">Fatturato annuo (€)</label>
            <input type="number" id="fatturatoForfettario" min="0" max="85000" placeholder="Es. 50000" value="50000">
            <span class="label-hint">Limite massimo regime forfettario: € 85.000</span>
          </div>
          <div class="form-group">
            <label for="coefficienteRedditivita">Coefficiente di redditività</label>
            <select id="coefficienteRedditivita">
              <option value="0.40">40% — Commercio al dettaglio</option>
              <option value="0.54">54% — Commercio ingrosso</option>
              <option value="0.62">62% — Industrie alimentari</option>
              <option value="0.67">67% — Servizi alloggio/ristorazione</option>
              <option value="0.78" selected>78% — Servizi professionali (consulenti, freelance)</option>
              <option value="0.86">86% — Costruzioni e attività immobiliari</option>
            </select>
            <span class="label-hint">Si applica al fatturato per ottenere il reddito imponibile</span>
          </div>
          <div class="form-group">
            <label for="anniContributiForf">Anni di contributi già versati</label>
            <input type="number" id="anniContributiForf" min="0" max="50" placeholder="Es. 5" value="5">
            <span class="label-hint">Anni di attività con P.IVA</span>
          </div>
        </div>
        <div class="info-box ochre">
          <strong>Nota importante:</strong> In regime forfettario i contributi si calcolano sul <strong>reddito imponibile</strong> (fatturato × coefficiente di redditività), non sull'intero fatturato. La tassazione è 5% (primi 5 anni nuove attività) o 15% sostitutiva. <strong>Il reddito previdenziale è generalmente più basso, e di conseguenza anche la pensione futura.</strong>
        </div>
      </div>

      <div class="btn-row">
        <button class="btn btn-secondary" onclick="goToStep(2)">← Indietro</button>
        <button class="btn btn-primary" onclick="vaiAllaDashboard()">Vai alla dashboard →</button>
      </div>
    </section>

    <!-- STEP 4 -->
    <section class="form-section" id="section-4">

      <div class="fiscal-card" id="fiscalCard">
        <span class="icon">💰</span>
        <div class="text">
          <div class="label">Risparmio fiscale annuo dal fondo pensione</div>
          <div class="value" id="fiscalValue">€ 0</div>
          <div class="desc" id="fiscalDesc">Deducibilità IRPEF dei contributi al fondo pensione (max € 5.164,57/anno)</div>
        </div>
      </div>

      <div class="dashboard">
        <div class="dash-card gauge-card">
          <div class="dash-card-title">Tasso di sostituzione</div>
          <div class="dash-card-subtitle">Quanto del tuo reddito netto attuale conserveresti</div>
          <div class="gauge-wrapper">
            <svg class="gauge-svg" id="gaugeSvg" viewBox="0 0 280 180"></svg>
          </div>
          <div class="gauge-status" id="gaugeStatus">—</div>
          <div class="gauge-explanation" id="gaugeExplanation">Calcolo in corso...</div>
        </div>

        <div class="dash-card kpi-card">
          <div>
            <div class="dash-card-title">I tuoi numeri</div>
            <div class="dash-card-subtitle">Stime mensili (valori netti)</div>
          </div>
          <div class="kpi-grid">
            <div class="kpi-row"><span class="label">Reddito netto attuale</span><span class="value" id="kpiStipendio">€ 0</span></div>
            <div class="kpi-row"><span class="label">Pensione INPS (netta)</span><span class="value" id="kpiPensione">€ 0</span></div>
            <div class="kpi-row"><span class="label">+ Rendita Fondo Pensione</span><span class="value highlight" id="kpiFP">€ 0</span></div>
            <div class="kpi-row"><span class="label">Gap mensile residuo</span><span class="value warn" id="kpiGap">€ 0</span></div>
          </div>
        </div>
      </div>

      <div class="dash-card dashboard-full" style="margin-bottom: 25px;">
        <div class="dash-card-title">Crescita del tuo capitale previdenziale</div>
        <div class="dash-card-subtitle">Passa il mouse sul grafico per esplorare anno per anno</div>
        <div class="chart-wrapper" id="chartWrapper">
          <svg class="chart-svg" id="chartMontante" viewBox="0 0 800 380" preserveAspectRatio="xMidYMid meet"></svg>
          <div class="chart-tooltip" id="chartTooltip"></div>
        </div>
        <div class="legend">
          <div class="legend-item"><span class="legend-swatch" style="background: var(--sage);"></span>Solo INPS</div>
          <div class="legend-item"><span class="legend-swatch dashed"></span>INPS + Fondo Pensione</div>
        </div>
      </div>

      <div class="scenario-panel">
        <h3>🎚️ Esplora i tuoi scenari</h3>
        <p class="scenario-panel-sub">Muovi gli slider e osserva come cambia il tuo futuro previdenziale in tempo reale.</p>
        <div class="sliders-grid">
          <div class="slider-block">
            <label><span>💰 Versamento mensile fondo pensione</span><span class="slider-value" id="valContributo">€ 200</span></label>
            <input type="range" class="custom-slider" id="sliderContributo" min="0" max="500" step="25" value="200">
            <div class="slider-meta"><span>€ 0</span><span>€ 500/mese</span></div>
          </div>
          <div class="slider-block">
            <label><span>📅 Età di pensionamento</span><span class="slider-value" id="valEta">67 anni</span></label>
            <input type="range" class="custom-slider" id="sliderEtaPens" min="62" max="71" step="1" value="67">
            <div class="slider-meta"><span>62 anni</span><span>71 anni</span></div>
          </div>
          <div class="slider-block">
            <label><span>📈 Rendimento atteso fondo pensione</span><span class="slider-value" id="valRendimento">4,0%</span></label>
            <input type="range" class="custom-slider" id="sliderRendimento" min="20" max="60" step="5" value="40">
            <div class="slider-meta"><span>2% (prudente)</span><span>6% (dinamico)</span></div>
          </div>
        </div>
      </div>

      <div class="methodology" id="methodology">
        <div class="methodology-header" onclick="toggleMethodology()">
          <h4>📐 Come funziona il calcolatore</h4>
          <span class="methodology-icon">▼</span>
        </div>
        <div class="methodology-content">
          <div class="methodology-inner">
            <p><strong>Metodo di calcolo</strong> — Il calcolatore stima la pensione applicando il <strong>sistema contributivo</strong> previsto dalla L. 335/1995, con i coefficienti di trasformazione INPS aggiornati al biennio 2025-2026 (DM 20/11/2024).</p>
            <p style="margin-top: 12px;"><strong>Step del calcolo:</strong></p>
            <ul>
              <li><strong>Montante contributivo</strong> = somma dei contributi annui (reddito × aliquota), capitalizzata anno per anno alla rivalutazione del PIL nominale (~1,5% medio storico)</li>
              <li><strong>Pensione lorda annua</strong> = Montante × Coefficiente di trasformazione (es. 5,608% a 67 anni)</li>
              <li><strong>Pensione netta</strong> = lorda − IRPEF stimata su scaglioni 2026 + addizionali medie</li>
              <li><strong>Tasso di sostituzione</strong> = Pensione netta / Reddito netto attuale</li>
            </ul>
            <p style="margin-top: 12px;"><strong>Aliquote contributive applicate:</strong></p>
            <ul>
              <li><strong>Dipendente:</strong> 33% del RAL (totale tra quota datore e lavoratore)</li>
              <li><strong>Autonomo ordinario (gestione separata):</strong> 26,07% del reddito imponibile (2026)</li>
              <li><strong>Autonomo forfettario:</strong> 26,07% sul reddito imponibile = fatturato × coefficiente di redditività</li>
            </ul>
            <p style="margin-top: 12px;"><strong>Fondo pensione:</strong> i versamenti vengono capitalizzati al rendimento scelto (default 4% annuo), e generano deducibilità IRPEF fino al limite di legge di € 5.164,57/anno (non applicabile al regime forfettario). Il TFR (per dipendenti) viene incluso al 6,91% del RAL.</p>
            <p style="margin-top: 12px; color: var(--gray-text); font-style: italic;">Tutte le stime sono indicative e basate su ipotesi semplificate. Per una valutazione precisa è necessaria una consulenza professionale.</p>
          </div>
        </div>
      </div>

      <div class="cta-section">
        <h3>Vuoi una strategia su misura?</h3>
        <p>Posso prepararti un piano previdenziale personalizzato considerando i vantaggi fiscali della deducibilità, il TFR, il regime fiscale e la tua situazione specifica.</p>
        <div class="cta-buttons">
          <a href="#" class="btn btn-cta" id="ctaCalendly" target="_blank">📅 Prenota call gratuita</a>
          <button class="btn btn-secondary" onclick="apriModalPDF()">📄 Ricevi report PDF</button>
          <a href="#" class="btn btn-secondary" id="ctaContatti">✉️ Form di contatto</a>
        </div>
      </div>

      <div class="disclaimer">
        <strong>Nota informativa:</strong> Questa simulazione è basata su ipotesi semplificate e fornisce un ordine di grandezza puramente indicativo. Il calcolo reale dipende da molti fattori (sistema misto retributivo/contributivo, periodi di disoccupazione, riscatti, evoluzioni normative, addizionali fiscali specifiche). I valori NON costituiscono consulenza finanziaria né previdenziale e non sono vincolanti. Per una valutazione precisa è necessaria una consulenza professionale.
      </div>

      <div class="btn-row">
        <button class="btn btn-secondary" onclick="ricomincia()">↻ Nuova simulazione</button>
      </div>

    </section>
  </div>
</div>

<div class="modal-overlay" id="modalPDF">
  <div class="modal">
    <h3>Ricevi il tuo report personalizzato</h3>
    <p>Lasciami la tua email e ti invierò un PDF con la tua simulazione completa.</p>
    <div class="form-group" style="margin-bottom: 15px;">
      <label for="emailReport">La tua email</label>
      <input type="email" id="emailReport" placeholder="nome@esempio.it">
    </div>
    <div class="form-group" style="margin-bottom: 20px;">
      <label for="nomeReport">Il tuo nome</label>
      <input type="text" id="nomeReport" placeholder="Mario">
    </div>
    <button class="btn btn-primary" style="width: 100%;" onclick="inviaRichiesta()">Invia richiesta</button>
    <div style="text-align: center;">
      <button class="modal-close" onclick="chiudiModalPDF()">Annulla</button>
    </div>
  </div>
</div>
    </div>
  </section>
</Layout>

<style is:inline>

  :root {
    --sage: #4A5D4F; --sage-light: #6B7F70; --sage-dark: #3A4A3F;
    --ochre: #D4A574; --ochre-light: #E0BC8F; --ochre-dark: #B8895A;
    --ivory: #F5F1E8; --ivory-warm: #FAF7EF;
    --charcoal: #2C2C2A;
    --emerald: #00A652; --emerald-light: #2BC677;
    --gray-soft: #E8E4DA; --gray-text: #6B6B68;
    --red-warn: #C75D5D;
    --shadow-soft: 0 4px 20px rgba(44, 44, 42, 0.08);
    --shadow-medium: 0 8px 30px rgba(44, 44, 42, 0.12);
    --radius: 12px; --radius-lg: 16px;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif; background: var(--ivory); color: var(--charcoal); line-height: 1.6; padding: 20px; min-height: 100vh; }
  .calc-container { max-width: 1100px; margin: 0 auto; background: #FFFFFF; border-radius: var(--radius-lg); box-shadow: var(--shadow-medium); overflow: hidden; }

  .calc-header { background: linear-gradient(135deg, var(--sage) 0%, var(--sage-dark) 100%); color: var(--ivory); padding: 40px 40px 35px; text-align: center; position: relative; }
  .calc-header::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 60px; height: 3px; background: var(--ochre); border-radius: 2px; }
  .calc-header h1 { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 600; margin-bottom: 12px; letter-spacing: -0.02em; }
  .calc-header p { font-size: clamp(0.95rem, 1.8vw, 1.05rem); opacity: 0.92; max-width: 600px; margin: 0 auto; font-weight: 300; }

  .steps { display: flex; justify-content: center; padding: 25px 20px 0; gap: 8px; flex-wrap: wrap; }
  .step { display: flex; align-items: center; gap: 8px; color: var(--gray-text); font-size: 0.85rem; font-weight: 500; }
  .step-num { width: 28px; height: 28px; border-radius: 50%; background: var(--gray-soft); color: var(--gray-text); display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 0.85rem; transition: all 0.3s ease; }
  .step.active .step-num { background: var(--sage); color: var(--ivory); }
  .step.completed .step-num { background: var(--emerald); color: white; }
  .step.active { color: var(--charcoal); }
  .step-divider { width: 30px; height: 1px; background: var(--gray-soft); }

  .calc-body { padding: 35px 40px 40px; }
  .form-section { display: none; animation: fadeIn 0.5s ease; }
  .form-section.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .section-title { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--sage-dark); margin-bottom: 8px; font-weight: 600; }
  .section-subtitle { color: var(--gray-text); margin-bottom: 25px; font-size: 0.95rem; }

  .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 25px; }
  .form-group { display: flex; flex-direction: column; }
  .form-group.full-width { grid-column: 1 / -1; }
  label { font-weight: 500; color: var(--charcoal); margin-bottom: 8px; font-size: 0.9rem; }
  .label-hint { font-size: 0.75rem; color: var(--gray-text); font-weight: 400; margin-top: 4px; }

  input[type="number"], input[type="text"], input[type="email"], select { padding: 13px 15px; border: 1.5px solid var(--gray-soft); border-radius: 8px; font-family: 'Manrope', sans-serif; font-size: 1rem; color: var(--charcoal); background: var(--ivory-warm); transition: all 0.2s ease; }
  input:focus, select:focus { outline: none; border-color: var(--sage); background: white; box-shadow: 0 0 0 3px rgba(74, 93, 79, 0.1); }

  .radio-group { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
  .radio-card { position: relative; cursor: pointer; }
  .radio-card input[type="radio"] { position: absolute; opacity: 0; pointer-events: none; }
  .radio-card-label { display: block; padding: 16px 14px; border: 1.5px solid var(--gray-soft); border-radius: 8px; background: var(--ivory-warm); transition: all 0.2s ease; text-align: center; height: 100%; }
  .radio-card-label .icon { font-size: 1.6rem; margin-bottom: 6px; display: block; }
  .radio-card-label .title { font-weight: 600; color: var(--charcoal); margin-bottom: 3px; font-size: 0.92rem; }
  .radio-card-label .desc { font-size: 0.75rem; color: var(--gray-text); line-height: 1.3; }
  .radio-card input[type="radio"]:checked + .radio-card-label { border-color: var(--sage); background: white; box-shadow: var(--shadow-soft); }
  .radio-card input[type="radio"]:checked + .radio-card-label .title { color: var(--sage-dark); }

  .conditional-field { display: none; animation: fadeIn 0.3s ease; }
  .conditional-field.active { display: block; }

  .info-box { padding: 12px 15px; background: #EEF4F0; border-left: 3px solid var(--sage); border-radius: 6px; font-size: 0.85rem; color: var(--charcoal); margin-top: 8px; line-height: 1.5; }
  .info-box.ochre { background: #FAF4EA; border-left-color: var(--ochre); }

  .toggle-row { display: flex; align-items: center; gap: 12px; padding: 14px 18px; background: var(--ivory-warm); border-radius: 8px; border: 1.5px solid var(--gray-soft); cursor: pointer; transition: all 0.2s ease; margin-top: 10px; }
  .toggle-row:hover { border-color: var(--sage-light); }
  .toggle-checkbox { width: 20px; height: 20px; accent-color: var(--sage); cursor: pointer; }
  .toggle-row label { margin-bottom: 0; cursor: pointer; flex: 1; font-weight: 400; }

  .btn-row { display: flex; gap: 12px; margin-top: 30px; flex-wrap: wrap; }
  .btn { padding: 14px 28px; border: none; border-radius: 8px; font-family: 'Manrope', sans-serif; font-weight: 600; font-size: 0.95rem; cursor: pointer; transition: all 0.2s ease; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
  .btn-primary { background: var(--sage); color: var(--ivory); flex: 1; min-width: 160px; }
