<script is:inline>

  // ============================================================
  // CONFIG
  // ============================================================
  const CONFIG = {
    calendlyUrl: '/contatti',
    contattiUrl: '/contatti',
    emailDestinazione: 'andrea@giardiniconsulenza.it'
  };
  document.getElementById('ctaCalendly').href = CONFIG.calendlyUrl;
  document.getElementById('ctaContatti').href = CONFIG.contattiUrl;

  // ============================================================
  // PARAMETRI INPS 2025-2026
  // ============================================================
  const COEFFICIENTI = {
    57: 0.04204, 58: 0.04304, 59: 0.04408, 60: 0.04518, 61: 0.04634,
    62: 0.04757, 63: 0.04887, 64: 0.05025, 65: 0.05172, 66: 0.05384,
    67: 0.05608, 68: 0.05845, 69: 0.06096, 70: 0.06363, 71: 0.06655
  };
  const ALIQUOTE = { dipendente: 0.33, autonomo_ordinario: 0.2607, autonomo_forfettario: 0.2607 };
  const IRPEF_SCAGLIONI = [
    { limite: 28000, aliquota: 0.23 },
    { limite: 50000, aliquota: 0.35 },
    { limite: Infinity, aliquota: 0.43 }
  ];
  const DETRAZIONE_LAVORO_DIP = 1955;
  const DETRAZIONE_LAVORO_AUT = 1265;
  const NO_TAX_AREA_DIP = 8500;
  const NO_TAX_AREA_AUT = 5500;
  const MAX_DEDUCIBILITA_FP = 5164.57;
  const TFR_PERCENT = 0.0691;
  const TASSO_RIVALUTAZIONE = 0.01;   // Rivalutazione PIL nominale (calibrata su benchmark RGS-MEF)
  const CRESCITA_REDDITO = 0.02;       // Crescita reddito reale + inflazione (calibrata)

  const TIPO_INFO = {
    dipendente: "<strong>Dipendente:</strong> Il datore di lavoro versa il 33% del tuo RAL all'INPS (di cui ~9,19% a tuo carico, il resto a carico del datore). Il TFR ti permette di accantonare ulteriori risorse, che puoi tenere in azienda o destinare a un fondo pensione.",
    autonomo_ordinario: "<strong>P.IVA Regime Ordinario:</strong> Versi il 26,07% (gestione separata, 2026) sul tuo reddito imponibile dichiarato. Le contribuzioni sono interamente a tuo carico, ma puoi rivalerti del 4% sul cliente se ne hai concordato l'addebito.",
    autonomo_forfettario: "<strong>P.IVA Regime Forfettario:</strong> Versi i contributi sul reddito imponibile (fatturato × coefficiente di redditività), non sull'intero fatturato. Questo riduce il carico contributivo nel breve, ma <strong>impatta significativamente sulla pensione futura</strong>. Pianificare la previdenza complementare è ancora più importante."
  };

  // ============================================================
  // STATE
  // ============================================================
  const state = {
    eta: 40, etaPensione: 67, etaPensioneScenario: 67,
    tipo: 'dipendente',
    redditoLordo: 35000,
    redditoOrdinario: 40000,
    fatturatoForfettario: 50000,
    coefficienteRedditivita: 0.78,
    anniContributi: 15,
    includeTFR: true,
    contributoFP: 200,
    rendimentoFP: 0.04
  };

  // ============================================================
  // UI
  // ============================================================
  function aggiornaCampiCondizionali() {
    const tipo = document.querySelector('input[name="tipo"]:checked').value;
    state.tipo = tipo;
    document.querySelectorAll('.conditional-field').forEach(f => {
      f.classList.toggle('active', f.dataset.tipo === tipo);
    });
    document.getElementById('tipoInfoBox').innerHTML = TIPO_INFO[tipo];
  }

  function toggleTFR() {
    const cb = document.getElementById('includeTFR');
    cb.checked = !cb.checked;
    state.includeTFR = cb.checked;
  }

  document.getElementById('includeTFR').addEventListener('change', e => {
    state.includeTFR = e.target.checked;
  });

  function goToStep(n) {
    document.querySelectorAll('.form-section').forEach(s => s.classList.remove('active'));
    document.getElementById('section-' + n).classList.add('active');
    document.querySelectorAll('.step').forEach((s, i) => {
      s.classList.remove('active', 'completed');
      if (i + 1 < n) s.classList.add('completed');
      if (i + 1 === n) s.classList.add('active');
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function ricomincia() { goToStep(1); }

  function vaiAllaDashboard() {
    state.eta = parseInt(document.getElementById('eta').value);
    state.etaPensione = parseInt(document.getElementById('etaPensione').value);
    state.etaPensioneScenario = state.etaPensione;
    state.tipo = document.querySelector('input[name="tipo"]:checked').value;

    if (state.tipo === 'dipendente') {
      state.redditoLordo = parseFloat(document.getElementById('redditoLordo').value);
      state.anniContributi = parseInt(document.getElementById('anniContributiDip').value);
      state.includeTFR = document.getElementById('includeTFR').checked;
    } else if (state.tipo === 'autonomo_ordinario') {
      state.redditoOrdinario = parseFloat(document.getElementById('redditoOrdinario').value);
      state.anniContributi = parseInt(document.getElementById('anniContributiOrd').value);
      state.includeTFR = false;
    } else {
      state.fatturatoForfettario = parseFloat(document.getElementById('fatturatoForfettario').value);
      state.coefficienteRedditivita = parseFloat(document.getElementById('coefficienteRedditivita').value);
      state.anniContributi = parseInt(document.getElementById('anniContributiForf').value);
      state.includeTFR = false;
    }

    if (!state.eta || !state.etaPensione || isNaN(state.anniContributi)) {
      alert('Per favore, compila tutti i campi.');
      return;
    }
    if (state.etaPensione <= state.eta) {
      alert("L'età della pensione deve essere maggiore dell'età attuale.");
      return;
    }

    document.getElementById('sliderEtaPens').value = state.etaPensione;
    document.getElementById('valEta').textContent = state.etaPensione + ' anni';

    goToStep(4);
    setTimeout(() => aggiornaDashboard(true), 100);
  }

  // ============================================================
  // IRPEF
  // ============================================================
  function calcolaIRPEF(redditoLordo, isDipendente = true) {
    if (redditoLordo <= 0) return 0;
    const noTax = isDipendente ? NO_TAX_AREA_DIP : NO_TAX_AREA_AUT;
    if (redditoLordo <= noTax) return 0;

    let irpefLorda = 0;
    let prevLimite = 0;
    for (const scag of IRPEF_SCAGLIONI) {
      if (redditoLordo > scag.limite) {
        irpefLorda += (scag.limite - prevLimite) * scag.aliquota;
        prevLimite = scag.limite;
      } else {
        irpefLorda += (redditoLordo - prevLimite) * scag.aliquota;
        break;
      }
    }

    let detrazione = isDipendente ? DETRAZIONE_LAVORO_DIP : DETRAZIONE_LAVORO_AUT;
    if (redditoLordo > 28000) {
      const fattore = Math.max(0, (50000 - redditoLordo) / 22000);
      detrazione *= fattore;
    }
    if (redditoLordo > 50000) detrazione = 0;

    return Math.max(0, irpefLorda - detrazione);
  }

  function calcolaRedditoNettoMensile() {
    if (state.tipo === 'dipendente') {
      const ral = state.redditoLordo;
      const contributiLav = ral * 0.0919;
      const imponibile = ral - contributiLav;
      const irpef = calcolaIRPEF(imponibile, true);
      const add = imponibile * 0.018;
      return (imponibile - irpef - add) / 12;
    }
    else if (state.tipo === 'autonomo_ordinario') {
      const r = state.redditoOrdinario;
      const contr = r * 0.2607;
      const imp = r - contr;
      const irpef = calcolaIRPEF(imp, false);
      const add = imp * 0.018;
      return (imp - irpef - add) / 12;
    }
    else {
      // Forfettario
      const fatt = state.fatturatoForfettario;
      const redditoImp = fatt * state.coefficienteRedditivita;
      const contr = redditoImp * 0.2607;
      const baseImp = redditoImp - contr;
      const imposta = baseImp * 0.15;
      // Netto = fatturato - contributi - imposta sostitutiva
      return (fatt - contr - imposta) / 12;
    }
  }

  function getRedditoPrevidenziale() {
    if (state.tipo === 'dipendente') return state.redditoLordo;
    if (state.tipo === 'autonomo_ordinario') return state.redditoOrdinario;
    return state.fatturatoForfettario * state.coefficienteRedditivita;
  }

  // ============================================================
  // CALCOLO PRINCIPALE
  // ============================================================
  function calcolaScenario() {
    const aliquota = ALIQUOTE[state.tipo];
    const redditoBase = getRedditoPrevidenziale();
    const anniRimanenti = state.etaPensioneScenario - state.eta;

    let montPregresso = 0;
    for (let i = 0; i < state.anniContributi; i++) {
      const annoIndietro = state.anniContributi - i;
      const redditoStorico = redditoBase / Math.pow(1 + CRESCITA_REDDITO, annoIndietro);
      const contr = redditoStorico * aliquota;
      montPregresso += contr * Math.pow(1 + TASSO_RIVALUTAZIONE, annoIndietro);
    }

    const serieINPS = [];
    let montINPS = montPregresso;
    serieINPS.push({ eta: state.eta, valore: montINPS });

    for (let i = 1; i <= anniRimanenti; i++) {
      const reddFut = redditoBase * Math.pow(1 + CRESCITA_REDDITO, i - 1);
      const contrAnnuo = reddFut * aliquota;
      montINPS = montINPS * (1 + TASSO_RIVALUTAZIONE) + contrAnnuo;
      serieINPS.push({ eta: state.eta + i, valore: montINPS });
    }

    let fpAccum = 0;
    const serieFPpuro = [{ eta: state.eta, valore: 0 }];
    for (let i = 1; i <= anniRimanenti; i++) {
      const cAnn = state.contributoFP * 12;
      fpAccum = fpAccum * (1 + state.rendimentoFP) + cAnn * (1 + state.rendimentoFP / 2);
      serieFPpuro.push({ eta: state.eta + i, valore: fpAccum });
    }

    let tfrAccum = 0;
    const serieTFR = [{ eta: state.eta, valore: 0 }];
    if (state.tipo === 'dipendente' && state.includeTFR) {
      for (let i = 1; i <= anniRimanenti; i++) {
        const reddFut = redditoBase * Math.pow(1 + CRESCITA_REDDITO, i - 1);
        const tfrA = reddFut * TFR_PERCENT;
        tfrAccum = tfrAccum * (1 + TASSO_RIVALUTAZIONE) + tfrA;
        serieTFR.push({ eta: state.eta + i, valore: tfrAccum });
      }
    } else {
      for (let i = 1; i <= anniRimanenti; i++) serieTFR.push({ eta: state.eta + i, valore: 0 });
    }

    const serieFP = [];
    for (let i = 0; i <= anniRimanenti; i++) {
      serieFP.push({
        eta: serieINPS[i].eta,
        valore: serieINPS[i].valore + serieFPpuro[i].valore + serieTFR[i].valore
      });
    }

    const montINPSfin = serieINPS[serieINPS.length - 1].valore;
    const fpFin = serieFPpuro[serieFPpuro.length - 1].valore;
    const tfrFin = serieTFR[serieTFR.length - 1].valore;
    const coef = COEFFICIENTI[state.etaPensioneScenario] || COEFFICIENTI[67];

    const pensAnnuaLorda = montINPSfin * coef;
    const pensMensLorda = pensAnnuaLorda / 13;

    const irpefPens = calcolaIRPEF(pensAnnuaLorda, true);
    const addPens = pensAnnuaLorda * 0.018;
    const pensAnnuaNetta = Math.max(0, pensAnnuaLorda - irpefPens - addPens);
    const pensMensNetta = pensAnnuaNetta / 13;

    const totIntegrativo = fpFin + tfrFin;
    const renditaFPanLorda = totIntegrativo * coef;
    const aliqFP = (state.anniContributi + anniRimanenti) > 35 ? 0.09 : 0.13;
    const renditaFPanNetta = renditaFPanLorda * (1 - aliqFP);
    const renditaFPmensNetta = renditaFPanNetta / 13;

    // Deflazionamento "a moneta costante": riportiamo i valori futuri al potere d'acquisto di oggi
    // Il reddito finale e la pensione finale vanno divisi per (1+inflazione)^anniRimanenti
    // Ipotesi inflazione = 1.5% (target BCE medio termine)
    const INFLAZIONE = 0.015;
    const fattoreDeflazione = Math.pow(1 + INFLAZIONE, anniRimanenti);

    const pensMensNettaReale = pensMensNetta / fattoreDeflazione;
    const renditaFPmensNettaReale = renditaFPmensNetta / fattoreDeflazione;

    const stipNettoMens = calcolaRedditoNettoMensile();

    const tasso = stipNettoMens > 0 ? pensMensNettaReale / stipNettoMens * 100 : 0;
    const tassoFP = stipNettoMens > 0 ? (pensMensNettaReale + renditaFPmensNettaReale) / stipNettoMens * 100 : 0;
    const gapMens = Math.max(0, stipNettoMens - pensMensNettaReale);
    const gapResiduo = Math.max(0, stipNettoMens - pensMensNettaReale - renditaFPmensNettaReale);

    // Risparmio fiscale
    const versamentiFPanno = state.contributoFP * 12;
    const deducibile = Math.min(versamentiFPanno, MAX_DEDUCIBILITA_FP);
    let aliqMarg;
    if (state.tipo === 'autonomo_forfettario') {
      aliqMarg = 0;
    } else {
      const reddImpFisc = state.tipo === 'dipendente'
        ? state.redditoLordo - (state.redditoLordo * 0.0919)
        : state.redditoOrdinario - (state.redditoOrdinario * 0.2607);
      if (reddImpFisc > 50000) aliqMarg = 0.43;
      else if (reddImpFisc > 28000) aliqMarg = 0.35;
      else aliqMarg = 0.23;
    }
    const risparmioFisc = deducibile * aliqMarg;

    return {
      serieINPS, serieFP,
      pensMensNetta: pensMensNettaReale,        // a moneta costante (per i KPI)
      renditaFPmensNetta: renditaFPmensNettaReale,  // a moneta costante
      pensMensNettaNominale: pensMensNetta,     // nominale (per riferimento)
      stipNettoMens,
      tasso, tassoFP,
      gapMens, gapResiduo,
      anniRimanenti,
      risparmioFisc, versamentiFPanno
    };
  }

  function aggiornaDashboard(animate = false) {
    const r = calcolaScenario();
    state.lastResult = r;

    document.getElementById('kpiStipendio').textContent = formatEuro(r.stipNettoMens);
    document.getElementById('kpiPensione').textContent = formatEuro(r.pensMensNetta);
    document.getElementById('kpiFP').textContent = '+ ' + formatEuro(r.renditaFPmensNetta);
    document.getElementById('kpiGap').textContent = formatEuro(r.gapResiduo);

    const fc = document.getElementById('fiscalCard');
    if (state.tipo === 'autonomo_forfettario') {
      document.getElementById('fiscalValue').textContent = '— non applicabile';
      document.getElementById('fiscalDesc').textContent = 'In regime forfettario non è prevista deducibilità fiscale dei contributi al fondo pensione (regime sostitutivo).';
      fc.style.opacity = '0.7';
    } else {
      document.getElementById('fiscalValue').textContent = formatEuro(r.risparmioFisc);
      document.getElementById('fiscalDesc').textContent = `Versando € ${state.contributoFP}/mese (€ ${formatNum(r.versamentiFPanno)}/anno) recuperi questa cifra in dichiarazione dei redditi.`;
      fc.style.opacity = '1';
    }

    disegnaGauge(r.tassoFP, animate);
    disegnaChart(r.serieINPS, r.serieFP, animate);
  }

  // ============================================================
  // GAUGE
  // ============================================================
  function disegnaGauge(percentuale, animate = false) {
    const svg = document.getElementById('gaugeSvg');
    svg.innerHTML = '';
    const cx = 140, cy = 140, rOuter = 110, rInner = 88;
    const pct = Math.max(0, Math.min(100, percentuale));
    const valueAngle = 180 + (pct / 100) * 180;

    const bgPath = describeArc(cx, cy, rOuter, 180, 360);
    const bgArc = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    bgArc.setAttribute('d', bgPath);
    bgArc.setAttribute('fill', 'none');
    bgArc.setAttribute('stroke', '#E8E4DA');
    bgArc.setAttribute('stroke-width', 18);
    bgArc.setAttribute('stroke-linecap', 'round');
    svg.appendChild(bgArc);

    let fillColor;
    if (pct < 40) fillColor = '#C75D5D';
    else if (pct < 60) fillColor = '#D4A574';
    else if (pct < 80) fillColor = '#6B7F70';
    else fillColor = '#00A652';

    const fgPath = describeArc(cx, cy, rOuter, 180, valueAngle);
    const fgArc = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    fgArc.setAttribute('d', fgPath);
    fgArc.setAttribute('fill', 'none');
    fgArc.setAttribute('stroke', fillColor);
    fgArc.setAttribute('stroke-width', 18);
    fgArc.setAttribute('stroke-linecap', 'round');
    fgArc.style.transition = 'stroke 0.4s ease';
    svg.appendChild(fgArc);

    if (animate) {
      const totalLength = (Math.PI * rOuter);
      fgArc.style.strokeDasharray = totalLength;
      fgArc.style.strokeDashoffset = totalLength;
      fgArc.getBoundingClientRect();
      fgArc.style.transition = 'stroke-dashoffset 1.2s cubic-bezier(0.4, 0, 0.2, 1), stroke 0.4s ease';
      const tgt = totalLength * (1 - pct / 100);
      requestAnimationFrame(() => { fgArc.style.strokeDashoffset = tgt; });
    }

    [0, 25, 50, 75, 100].forEach(t => {
      const angle = 180 + (t / 100) * 180;
      const rad = (angle * Math.PI) / 180;
      const x1 = cx + (rInner - 12) * Math.cos(rad);
      const y1 = cy + (rInner - 12) * Math.sin(rad);
      const x2 = cx + (rInner - 4) * Math.cos(rad);
      const y2 = cy + (rInner - 4) * Math.sin(rad);
      const tl = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      tl.setAttribute('x1', x1); tl.setAttribute('y1', y1);
      tl.setAttribute('x2', x2); tl.setAttribute('y2', y2);
      tl.setAttribute('stroke', '#6B6B68');
      tl.setAttribute('stroke-width', 1.5);
      svg.appendChild(tl);

      const lblX = cx + (rInner - 22) * Math.cos(rad);
      const lblY = cy + (rInner - 22) * Math.sin(rad) + 3;
      const lbl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      lbl.setAttribute('x', lblX); lbl.setAttribute('y', lblY);
      lbl.setAttribute('class', 'gauge-label');
      lbl.setAttribute('text-anchor', 'middle');
      lbl.textContent = t + '%';
      svg.appendChild(lbl);
    });

    const cv = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    cv.setAttribute('x', cx); cv.setAttribute('y', cy + 5);
    cv.setAttribute('class', 'gauge-value');
    cv.setAttribute('text-anchor', 'middle');
    cv.setAttribute('fill', fillColor);
    cv.textContent = Math.round(pct) + '%';
    svg.appendChild(cv);

    const sl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    sl.setAttribute('x', cx); sl.setAttribute('y', cy + 30);
    sl.setAttribute('class', 'gauge-label');
    sl.setAttribute('text-anchor', 'middle');
    sl.textContent = 'del tuo reddito netto';
    svg.appendChild(sl);

    const sEl = document.getElementById('gaugeStatus');
    const eEl = document.getElementById('gaugeExplanation');
    let status, expl;
    if (pct < 40) {
      status = '🔴 Situazione critica';
      expl = 'Con questo tasso di sostituzione, il tenore di vita subirebbe un calo molto significativo. È essenziale agire ora.';
    } else if (pct < 60) {
      status = '🟡 Margine di miglioramento';
      expl = 'Il gap è importante. Una pianificazione previdenziale ben fatta può cambiare radicalmente lo scenario.';
    } else if (pct < 80) {
      status = '🟢 Situazione discreta';
      expl = "Sei in una posizione ragionevole, ma c'è ancora spazio per ottimizzare la strategia.";
    } else if (pct < 100) {
      status = '🟢 Situazione solida';
      expl = "Stai già lavorando bene. Possiamo concentrarci sull'efficienza fiscale e la diversificazione.";
    } else {
      status = '🟢 Pianificazione molto efficace';
      expl = "Il piano combinato (INPS + FP + TFR) raggiunge o supera il tuo reddito attuale a moneta costante. Questo è possibile soprattutto se hai molti anni di contribuzione davanti e versamenti consistenti — è la potenza dell'interesse composto.";
    }
    sEl.textContent = status;
    sEl.style.color = fillColor;
    eEl.textContent = expl;
  }

  function describeArc(cx, cy, r, sa, ea) {
    const s = polarToCartesian(cx, cy, r, ea);
    const e = polarToCartesian(cx, cy, r, sa);
    const laf = ea - sa <= 180 ? '0' : '1';
    return ['M', s.x, s.y, 'A', r, r, 0, laf, 0, e.x, e.y].join(' ');
  }
  function polarToCartesian(cx, cy, r, ang) {
    const rad = (ang * Math.PI) / 180;
    return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
  }

  // ============================================================
  // CHART
  // ============================================================
  let chartData = null;

  function disegnaChart(serieINPS, serieFP, animate = false) {
    const svg = document.getElementById('chartMontante');
    svg.innerHTML = '';
    const W = 800, H = 380;
    const m = { top: 30, right: 30, bottom: 50, left: 75 };
    const w = W - m.left - m.right;
    const h = H - m.top - m.bottom;
    const xMin = serieINPS[0].eta;
    const xMax = serieINPS[serieINPS.length - 1].eta;
    const yMax = Math.max(serieFP[serieFP.length - 1].valore, serieINPS[serieINPS.length - 1].valore) * 1.12 || 100000;
    const x = eta => m.left + ((eta - xMin) / Math.max(1, (xMax - xMin))) * w;
    const y = val => m.top + h - (val / yMax) * h;
    chartData = { x, y, serieINPS, serieFP, m, w, h, xMin, xMax, W, H };

    for (let i = 0; i <= 4; i++) {
      const val = (yMax / 4) * i;
      const yPos = y(val);
      const gl = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      gl.setAttribute('class', 'grid-line');
      gl.setAttribute('x1', m.left); gl.setAttribute('x2', m.left + w);
      gl.setAttribute('y1', yPos); gl.setAttribute('y2', yPos);
      svg.appendChild(gl);
      const lb = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      lb.setAttribute('class', 'axis-text');
      lb.setAttribute('x', m.left - 12); lb.setAttribute('y', yPos + 4);
      lb.setAttribute('text-anchor', 'end');
      lb.textContent = formatEuroShort(val);
      svg.appendChild(lb);
    }

    const ax = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    ax.setAttribute('class', 'axis-line');
    ax.setAttribute('x1', m.left); ax.setAttribute('x2', m.left + w);
    ax.setAttribute('y1', m.top + h); ax.setAttribute('y2', m.top + h);
    svg.appendChild(ax);

    const numAnni = xMax - xMin;
    const stepTick = numAnni <= 5 ? 1 : (numAnni <= 15 ? 3 : 5);
    for (let etaTick = xMin; etaTick <= xMax; etaTick += stepTick) {
      const tl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      tl.setAttribute('class', 'axis-text');
      tl.setAttribute('x', x(etaTick)); tl.setAttribute('y', m.top + h + 22);
      tl.setAttribute('text-anchor', 'middle');
      tl.textContent = etaTick;
      svg.appendChild(tl);
    }
    if ((xMax - xMin) % stepTick !== 0) {
      const tl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      tl.setAttribute('class', 'axis-text');
      tl.setAttribute('x', x(xMax)); tl.setAttribute('y', m.top + h + 22);
      tl.setAttribute('text-anchor', 'middle');
      tl.textContent = xMax;
      svg.appendChild(tl);
    }

    const xal = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    xal.setAttribute('class', 'axis-text');
    xal.setAttribute('x', m.left + w / 2); xal.setAttribute('y', H - 10);
    xal.setAttribute('text-anchor', 'middle');
    xal.textContent = 'Età';
    svg.appendChild(xal);

    let pathINPS = '';
    serieINPS.forEach((p, i) => { pathINPS += (i === 0 ? 'M' : 'L') + x(p.eta) + ',' + y(p.valore) + ' '; });
    const areaINPSp = pathINPS + 'L' + x(xMax) + ',' + y(0) + ' L' + x(xMin) + ',' + y(0) + ' Z';
    const a1 = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    a1.setAttribute('d', areaINPSp);
    a1.setAttribute('fill', 'var(--sage)');
    a1.setAttribute('fill-opacity', '0.18');
    svg.appendChild(a1);
    const l1 = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    l1.setAttribute('d', pathINPS);
    l1.setAttribute('fill', 'none');
    l1.setAttribute('stroke', 'var(--sage)');
    l1.setAttribute('stroke-width', '2.5');
    l1.setAttribute('stroke-linejoin', 'round');
    svg.appendChild(l1);

    let pathFP = '';
    serieFP.forEach((p, i) => { pathFP += (i === 0 ? 'M' : 'L') + x(p.eta) + ',' + y(p.valore) + ' '; });
    let revINPS = '';
    for (let i = serieINPS.length - 1; i >= 0; i--) {
      revINPS += 'L' + x(serieINPS[i].eta) + ',' + y(serieINPS[i].valore) + ' ';
    }
    const aFPd = pathFP + revINPS + 'Z';
    const a2 = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    a2.setAttribute('d', aFPd);
    a2.setAttribute('fill', 'var(--emerald)');
    a2.setAttribute('fill-opacity', '0.12');
    svg.appendChild(a2);

    const l2 = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    l2.setAttribute('d', pathFP);
    l2.setAttribute('fill', 'none');
    l2.setAttribute('stroke', 'var(--emerald)');
    l2.setAttribute('stroke-width', '2.5');
    l2.setAttribute('stroke-dasharray', '6 4');
    l2.setAttribute('stroke-linejoin', 'round');
    svg.appendChild(l2);

    if (animate) {
      [l1, l2].forEach(line => {
        const len = line.getTotalLength();
        line.style.strokeDasharray = len;
        line.style.strokeDashoffset = len;
        line.getBoundingClientRect();
        line.style.transition = 'stroke-dashoffset 1.5s cubic-bezier(0.4, 0, 0.2, 1)';
        requestAnimationFrame(() => { line.style.strokeDashoffset = '0'; });
      });
      setTimeout(() => {
        l2.style.transition = '';
        l2.setAttribute('stroke-dasharray', '6 4');
        l1.style.transition = '';
        l1.style.strokeDasharray = '';
      }, 1600);
    }

    const fI = serieINPS[serieINPS.length - 1];
    const fF = serieFP[serieFP.length - 1];

    const dI = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    dI.setAttribute('cx', x(fI.eta)); dI.setAttribute('cy', y(fI.valore));
    dI.setAttribute('r', 5.5);
    dI.setAttribute('fill', 'white');
    dI.setAttribute('stroke', '#4A5D4F');
    dI.setAttribute('stroke-width', 2.5);
    svg.appendChild(dI);

    const lI = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    lI.setAttribute('class', 'axis-text-bold');
    lI.setAttribute('x', x(fI.eta) - 8); lI.setAttribute('y', y(fI.valore) + 18);
    lI.setAttribute('text-anchor', 'end');
    lI.setAttribute('fill', '#4A5D4F');
    lI.textContent = formatEuroShort(fI.valore);
    svg.appendChild(lI);

    if (fF.valore > fI.valore + 1000) {
      const dF = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      dF.setAttribute('cx', x(fF.eta)); dF.setAttribute('cy', y(fF.valore));
      dF.setAttribute('r', 5.5);
      dF.setAttribute('fill', 'white');
      dF.setAttribute('stroke', '#00A652');
      dF.setAttribute('stroke-width', 2.5);
      svg.appendChild(dF);

      const lF = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      lF.setAttribute('class', 'axis-text-bold');
      lF.setAttribute('x', x(fF.eta) - 8); lF.setAttribute('y', y(fF.valore) - 12);
      lF.setAttribute('text-anchor', 'end');
      lF.setAttribute('fill', '#00A652');
      lF.textContent = formatEuroShort(fF.valore);
      svg.appendChild(lF);
    }

    const cl = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    cl.setAttribute('class', 'crosshair-line');
    cl.setAttribute('id', 'crossLine');
    cl.setAttribute('y1', m.top); cl.setAttribute('y2', m.top + h);
    svg.appendChild(cl);

    const dhI = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    dhI.setAttribute('class', 'hover-dot');
    dhI.setAttribute('id', 'dotHoverINPS');
    dhI.setAttribute('r', 5);
    dhI.setAttribute('fill', '#4A5D4F');
    dhI.setAttribute('stroke', 'white');
    dhI.setAttribute('stroke-width', 2);
    svg.appendChild(dhI);

    const dhF = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    dhF.setAttribute('class', 'hover-dot');
    dhF.setAttribute('id', 'dotHoverFP');
    dhF.setAttribute('r', 5);
    dhF.setAttribute('fill', '#00A652');
    dhF.setAttribute('stroke', 'white');
    dhF.setAttribute('stroke-width', 2);
    svg.appendChild(dhF);

    const ov = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    ov.setAttribute('x', m.left); ov.setAttribute('y', m.top);
    ov.setAttribute('width', w); ov.setAttribute('height', h);
    ov.setAttribute('fill', 'transparent');
    ov.style.cursor = 'crosshair';
    svg.appendChild(ov);
    ov.addEventListener('mousemove', handleHover);
    ov.addEventListener('mouseleave', handleLeave);
    ov.addEventListener('touchmove', handleTouch);
    ov.addEventListener('touchend', handleLeave);
  }

  function handleHover(e) {
    if (!chartData) return;
    const svg = document.getElementById('chartMontante');
    const rect = svg.getBoundingClientRect();
    const sx = chartData.W / rect.width;
    aggiornaTooltip((e.clientX - rect.left) * sx, e.clientX, e.clientY);
  }
  function handleTouch(e) {
    if (!chartData || !e.touches[0]) return;
    e.preventDefault();
    const svg = document.getElementById('chartMontante');
    const rect = svg.getBoundingClientRect();
    const sx = chartData.W / rect.width;
    const t = e.touches[0];
    aggiornaTooltip((t.clientX - rect.left) * sx, t.clientX, t.clientY);
  }
  function aggiornaTooltip(mx, cx, cy) {
    const { x, y, serieINPS, serieFP, xMin, xMax, m } = chartData;
    const ratio = (mx - m.left) / chartData.w;
    const tEta = xMin + ratio * (xMax - xMin);
    const idx = Math.max(0, Math.min(serieINPS.length - 1, Math.round(tEta - xMin)));
    const pI = serieINPS[idx];
    const pF = serieFP[idx];
    const xPos = x(pI.eta);

    const cl = document.getElementById('crossLine');
    cl.classList.add('active');
    cl.setAttribute('x1', xPos); cl.setAttribute('x2', xPos);

    const di = document.getElementById('dotHoverINPS');
    di.classList.add('active');
    di.setAttribute('cx', xPos); di.setAttribute('cy', y(pI.valore));

    const df = document.getElementById('dotHoverFP');
    if (pF.valore > pI.valore + 100) {
      df.classList.add('active');
      df.setAttribute('cx', xPos); df.setAttribute('cy', y(pF.valore));
    } else df.classList.remove('active');

    const tt = document.getElementById('chartTooltip');
    const wr = document.getElementById('chartWrapper');
    const wrRect = wr.getBoundingClientRect();
    tt.classList.add('active');
    tt.innerHTML = `
      <div style="font-weight: 600; margin-bottom: 6px;">A ${pI.eta} anni</div>
      <div class="tooltip-row">
        <span class="tooltip-swatch" style="background: var(--sage-light);"></span>
        <span>Solo INPS: <strong>${formatEuroShort(pI.valore)}</strong></span>
      </div>
      ${pF.valore > pI.valore + 100 ? `
      <div class="tooltip-row">
        <span class="tooltip-swatch" style="background: var(--emerald);"></span>
        <span>+ FP/TFR: <strong>${formatEuroShort(pF.valore)}</strong></span>
      </div>` : ''}
    `;
    tt.style.left = (cx - wrRect.left) + 'px';
    tt.style.top = (cy - wrRect.top) + 'px';
  }
  function handleLeave() {
    const c = document.getElementById('crossLine'); if (c) c.classList.remove('active');
    const di = document.getElementById('dotHoverINPS'); if (di) di.classList.remove('active');
    const df = document.getElementById('dotHoverFP'); if (df) df.classList.remove('active');
    const tt = document.getElementById('chartTooltip'); if (tt) tt.classList.remove('active');
  }

  // ============================================================
  // SLIDERS
  // ============================================================
  let upTimeout = null;
  function debUp() {
    if (upTimeout) clearTimeout(upTimeout);
    upTimeout = setTimeout(() => aggiornaDashboard(false), 50);
  }

  document.getElementById('sliderContributo').addEventListener('input', e => {
    state.contributoFP = parseInt(e.target.value);
    document.getElementById('valContributo').textContent = '€ ' + state.contributoFP;
    debUp();
  });
  document.getElementById('sliderEtaPens').addEventListener('input', e => {
    state.etaPensioneScenario = parseInt(e.target.value);
    document.getElementById('valEta').textContent = state.etaPensioneScenario + ' anni';
    debUp();
  });
  document.getElementById('sliderRendimento').addEventListener('input', e => {
    state.rendimentoFP = parseInt(e.target.value) / 1000;
    document.getElementById('valRendimento').textContent = (state.rendimentoFP * 100).toFixed(1).replace('.', ',') + '%';
    debUp();
  });

  function toggleMethodology() {
    document.getElementById('methodology').classList.toggle('open');
  }

  // ============================================================
  // UTILS
  // ============================================================
  function formatEuro(num) { return '€ ' + Math.round(num).toLocaleString('it-IT'); }
  function formatNum(num) { return Math.round(num).toLocaleString('it-IT'); }
  function formatEuroShort(num) {
    if (num >= 1000000) return '€ ' + (num / 1000000).toFixed(1).replace('.', ',') + ' M';
    if (num >= 1000) return '€ ' + Math.round(num / 1000) + 'k';
    return '€ ' + Math.round(num);
  }

  function apriModalPDF() { document.getElementById('modalPDF').classList.add('active'); }
  function chiudiModalPDF() { document.getElementById('modalPDF').classList.remove('active'); }
  function inviaRichiesta() {
    const e = document.getElementById('emailReport').value;
    const n = document.getElementById('nomeReport').value;
    if (!e || !n) { alert('Per favore, inserisci nome ed email.'); return; }
    alert(`Grazie ${n}! Riceverai il report a ${e} entro 24 ore.\n\n(NB: integrare backend per invio reale)`);
    chiudiModalPDF();
  }
  document.getElementById('modalPDF').addEventListener('click', (e) => {
    if (e.target.id === 'modalPDF') chiudiModalPDF();
  });

</script>
