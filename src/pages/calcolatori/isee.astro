      .calc-isee .cta-buttons { flex-direction: column; }
      .calc-isee .chart-wrap-scenarios { height: 260px; }
      .calc-isee .chart-legend { gap: 10px; font-size: 0.76rem; }
      .calc-isee .agev-item { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    import { calcolaIsee } from '~/lib/calcolatori/isee';
    import type {
      InputIsee,
      OutputIsee,
      TipologiaIsee,
      ModalitaIsee,
      TipoCasa,
      TipoComune,
      TipoDisabilita,
    } from '~/lib/calcolatori/isee';
    import {
      Chart,
      BarController,
      BarElement,
      CategoryScale,
      LinearScale,
      Tooltip,
    } from 'chart.js';

    Chart.register(BarController, BarElement, CategoryScale, LinearScale, Tooltip);

    // -------------------- FORMATTERS --------------------
    const fmtEuro = new Intl.NumberFormat('it-IT', {
      style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2,
    });
    const fmtEuroNoCents = new Intl.NumberFormat('it-IT', {
      style: 'currency', currency: 'EUR', maximumFractionDigits: 0,
    });
    const fmtEuroShort = (v: number): string => {
      if (!Number.isFinite(v)) return '';
      const a = Math.abs(v);
      if (a >= 1_000_000) {
        const m = v / 1_000_000;
        return (Number.isInteger(m) ? m.toString() : m.toFixed(1).replace('.', ',')) + 'M €';
      }
      if (a >= 1_000) return Math.round(v / 1000) + 'K €';
      return Math.round(v) + ' €';
    };
    const fmtScala = (v: number): string =>
      Number.isFinite(v) ? v.toFixed(2).replace('.', ',') : '—';
    const parseNum = (v: string): number => {
      if (!v) return NaN;
      return parseFloat(v.replace(',', '.'));
    };

    // -------------------- DOM HELPERS --------------------
    const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
      document.getElementById(id) as T;
    const $$ = <T extends HTMLElement = HTMLElement>(sel: string) =>
      document.querySelectorAll<T>(sel);
    const root = document.querySelector<HTMLElement>('.calc-isee')!;

    // -------------------- READ INPUT --------------------
    function getTipologia(): TipologiaIsee {
      const r = document.querySelector<HTMLInputElement>('input[name="is-tipologia"]:checked');
      const v = r?.value;
      return (v === 'universitario' || v === 'inclusione' ? v : 'ordinario') as TipologiaIsee;
    }
    function getModalita(): ModalitaIsee {
      const r = document.querySelector<HTMLInputElement>('input[name="is-modalita"]:checked');
      return (r?.value === 'avanzata' ? 'avanzata' : 'semplice') as ModalitaIsee;
    }
    function getTipoCasa(): TipoCasa {
      const v = ($<HTMLSelectElement>('is-tipo-casa').value || 'proprieta') as TipoCasa;
      return v;
    }
    function getTipoComune(): TipoComune {
      const r = document.querySelector<HTMLInputElement>('input[name="is-comune"]:checked');
      return (r?.value === 'metropolitano' ? 'metropolitano' : 'altro') as TipoComune;
    }
    function getTipoDisabilita(): TipoDisabilita | undefined {
      const r = document.querySelector<HTMLInputElement>('input[name="is-tipo-disabilita"]:checked');
      const v = r?.value;
      if (v === 'media' || v === 'grave' || v === 'non_autosufficiente') return v;
      return undefined;
    }
    function nz(id: string, def = 0): number {
      const v = parseNum(($<HTMLInputElement>(id))?.value ?? '');
      return Number.isFinite(v) ? v : def;
    }

    // -------------------- VISIBILITY --------------------
    function setVisibility(): void {
      const modalita = getModalita();
      const tipologia = getTipologia();
      const tipoCasa = getTipoCasa();
      const numDisabili = nz('is-disabili', 0);

      // modalità: classe sul root → CSS spegne i blocchi `.advanced-only`
      root.classList.toggle('modo-semplice', modalita === 'semplice');

      // Tipologia universitaria → mostra sezione studente
      $$<HTMLElement>('.universitario-only').forEach((el) => {
        el.hidden = tipologia !== 'universitario';
      });

      // Tipo casa
      const propGroup = document.querySelector<HTMLElement>('.casa-proprieta-group');
      const affGroup = document.querySelector<HTMLElement>('.casa-affitto-group');
      if (propGroup) propGroup.hidden = tipoCasa !== 'proprieta';
      if (affGroup) affGroup.hidden = tipoCasa !== 'affitto';

      // Disabilità → mostra tipologia
      const tipoDisGroup = document.querySelector<HTMLElement>('.disabilita-tipo');
      if (tipoDisGroup) tipoDisGroup.hidden = numDisabili <= 0;

      // Fuori sede
      const fuoriSede = ($<HTMLInputElement>('is-fuori-sede'))?.checked;
      const fuoriSedeExtra = document.querySelector<HTMLElement>('.fuori-sede-extra');
      if (fuoriSedeExtra) fuoriSedeExtra.hidden = !fuoriSede;
    }

    // -------------------- BUILD INPUT --------------------
    function buildInput(): InputIsee {
      const modalita = getModalita();
      const tipologia = getTipologia();

      const inp: InputIsee = {
        tipologia,
        modalita,
        numeroComponenti: Math.max(1, Math.round(nz('is-componenti', 1))),
        numeroFigliMinorenni: Math.max(0, Math.round(nz('is-figli-minori', 0))),
        numeroFigliSottoTreAnni: Math.max(0, Math.round(nz('is-figli-tre', 0))),
        numeroFigliACarico: Math.max(0, Math.round(nz('is-figli-carico', 0))),
        numeroDisabili: Math.max(0, Math.round(nz('is-disabili', 0))),
        tipoDisabilita: nz('is-disabili', 0) > 0 ? getTipoDisabilita() : undefined,
        tipoCasa: getTipoCasa(),
        valoreCatastalePrimaCasa: Math.max(0, nz('is-valore-casa', 0)),
        mutuoResiduoPrimaCasa: Math.max(0, nz('is-mutuo-residuo', 0)),
        tipoComune: getTipoComune(),
        canoneAffitto: Math.max(0, nz('is-canone', 0)),
        contiCorrentiDepositi: Math.max(0, nz('is-conti', 0)),
        investimentiFinanziari: Math.max(0, nz('is-investimenti', 0)),
        criptovalute: Math.max(0, nz('is-cripto', 0)),
        contiEsteri: Math.max(0, nz('is-conti-esteri', 0)),
        moneyTransferEstero: Math.max(0, nz('is-money-transfer', 0)),
        redditoLavoroDipendente: Math.max(0, nz('is-red-dipendente', 0)),
        redditoLavoroAutonomo: Math.max(0, nz('is-red-autonomo', 0)),
        pensioni: Math.max(0, nz('is-pensioni', 0)),
        altriRedditi: Math.max(0, nz('is-altri-redditi', 0)),
      };

      // Avanzata
      if (modalita === 'avanzata') {
        inp.valoreAltriImmobili = Math.max(0, nz('is-altri-immobili', 0));
        inp.mutuoAltriImmobili = Math.max(0, nz('is-mutuo-altri', 0));
        inp.affittoPagato = Math.max(0, nz('is-affitto-pagato', 0));
        inp.speseSanitarieDisabili = Math.max(0, nz('is-spese-sanitarie', 0));
        inp.assegniMantenimento = Math.max(0, nz('is-assegni', 0));
        inp.speseAssistenzaDisabili = Math.max(0, nz('is-spese-assistenza', 0));
        inp.entrambiGenitoriLavorano = $<HTMLInputElement>('is-genitori-lavorano')?.checked ?? false;
      }

      // Universitario
      if (tipologia === 'universitario') {
        inp.studenteFuoriSede = $<HTMLInputElement>('is-fuori-sede')?.checked ?? false;
        inp.distanzaUniversitaKm = Math.max(0, nz('is-distanza', 0));
        inp.redditoPersonaleStudente = Math.max(0, nz('is-reddito-studente', 0));
        inp.patrimonioPersonaleStudente = Math.max(0, nz('is-patrimonio-studente', 0));
      }

      return inp;
    }

    // -------------------- FASCIA BADGE --------------------
    function fasciaIsee(isee: number): { label: string; cls: string } {
      if (isee < 9_360) return { label: 'Soglia bassa — accesso a maggior parte agevolazioni', cls: 'fascia-bassa' };
      if (isee < 15_000) return { label: 'Fascia intermedia', cls: 'fascia-media' };
      if (isee < 25_000) return { label: 'Soglia media', cls: 'fascia-alta-bassa' };
      return { label: 'Soglia alta', cls: 'fascia-alta' };
    }

    // -------------------- AGEVOLAZIONI RENDER --------------------
    function renderAgevolazioni(out: OutputIsee): void {
      const list = $('is-agevolazioni') as HTMLUListElement;
      while (list.firstChild) list.removeChild(list.firstChild);
      for (const a of out.agevolazioniAccessibili) {
        const li = document.createElement('li');
        li.className = 'agev-item';

        const nameEl = document.createElement('span');
        nameEl.className = 'agev-name';
        nameEl.textContent = a.nome;
        li.appendChild(nameEl);

        const right = document.createElement('span');
        right.style.display = 'flex';
        right.style.flexDirection = 'column';
        right.style.alignItems = 'flex-end';
        right.style.gap = '4px';

        const status = document.createElement('span');
        status.className = `agev-status ${a.accessibile ? 'ok' : 'no'}`;
        status.textContent = a.accessibile ? '✓ Possibile accesso' : '✗ Non accessibile';
        right.appendChild(status);

        if (a.importoStimato && a.importoStimato > 0 && a.accessibile) {
          const imp = document.createElement('span');
          imp.className = 'agev-importo';
          imp.textContent = `≈ ${fmtEuroNoCents.format(a.importoStimato)}/anno`;
          right.appendChild(imp);
        }
        li.appendChild(right);

        if (a.note) {
          const note = document.createElement('span');
          note.className = 'agev-note';
          note.textContent = a.note;
          li.appendChild(note);
        }

        list.appendChild(li);
      }
    }

    // -------------------- WARNINGS --------------------
    function renderWarnings(out: OutputIsee): void {
      const warnEl = $('is-warnings');
      while (warnEl.firstChild) warnEl.removeChild(warnEl.firstChild);
      if (out.warning.length) {
        const ul = document.createElement('ul');
        for (const w of out.warning) {
          const li = document.createElement('li');
          li.textContent = w;
          ul.appendChild(li);
        }
        warnEl.appendChild(ul);
      }
    }

    // -------------------- CHART COMPOSIZIONE ISE --------------------
    let chartComp: import('chart.js').Chart | null = null;

    function disegnaChartComp(out: OutputIsee): void {
      const canvas = $('is-chart-comp') as unknown as HTMLCanvasElement;
      if (!canvas) return;
      const d = out.dettaglioComponenti;

      // Componenti dell'ISE: redditi (esclusi i fittizi), 20% imm, 20% mob, fittizio
      const reddPure = Math.max(0, d.redditoNetto - d.redditoFigurativo);
      const c20Imm = d.componente20PatrimonioImmobiliare;
      const c20Mob = d.componente20PatrimonioMobiliare;
      const figur = d.redditoFigurativo;

      const datasets = [
        { label: 'Redditi netti', data: [reddPure], backgroundColor: '#373D42' },
        { label: '20% Patrimonio immobiliare', data: [c20Imm], backgroundColor: '#166963' },
        { label: '20% Patrimonio mobiliare', data: [c20Mob], backgroundColor: '#00A652' },
        { label: 'Reddito figurativo', data: [figur], backgroundColor: '#AB7F62' },
      ];

      if (chartComp) {
        chartComp.data.datasets.forEach((ds, i) => { ds.data = datasets[i].data; });
        chartComp.update('none');
        return;
      }

      chartComp = new Chart(canvas, {
        type: 'bar',
        data: { labels: ['ISE'], datasets },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 500, easing: 'easeOutQuart' },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#FFFFFF',
              borderColor: 'rgba(22, 105, 99, 0.25)',
              borderWidth: 1,
              titleColor: '#0F4F4A',
              titleFont: { family: 'Manrope, sans-serif', weight: 700, size: 13 },
              bodyColor: '#373D42',
              bodyFont: { family: 'Manrope, sans-serif', size: 12 },
              padding: 12,
              cornerRadius: 8,
              displayColors: true,
              boxPadding: 4,
              callbacks: {
                title: () => 'Composizione ISE',
                label: (ctx) =>
                  `  ${ctx.dataset.label}: ${fmtEuro.format(Number(ctx.parsed.x))}`,
              },
            },
          },
          scales: {
            x: {
              stacked: true,
              beginAtZero: true,
              grid: { color: 'rgba(22, 105, 99, 0.1)', lineWidth: 1 },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (v) => fmtEuroShort(v as number),
              },
            },
            y: {
              stacked: true,
              grid: { display: false },
              border: { display: false },
              ticks: { display: false },
            },
          },
        },
      });
    }

    // -------------------- CHART SCENARI --------------------
    let chartScen: import('chart.js').Chart | null = null;

    function calcolaScenari(baseInput: InputIsee): { label: string; isee: number }[] {
      const scenari: { label: string; input: InputIsee }[] = [
        { label: 'Attuale', input: baseInput },
        {
          label: 'Mobiliare −10K',
          input: {
            ...baseInput,
            contiCorrentiDepositi: Math.max(0, baseInput.contiCorrentiDepositi - 10_000),
          },
        },
        {
          label: 'Affitto +2K dedotto',
          input: {
            ...baseInput,
            modalita: 'avanzata',
            affittoPagato: (baseInput.affittoPagato || 0) + 2_000,
          },
        },
        {
          label: '+1 figlio nucleo',
          input: {
            ...baseInput,
            numeroComponenti: baseInput.numeroComponenti + 1,
            numeroFigliMinorenni: baseInput.numeroFigliMinorenni + 1,
            numeroFigliACarico: baseInput.numeroFigliACarico + 1,
          },
        },
        {
          label: 'Acquisto casa 100K',
          input: {
            ...baseInput,
            tipoCasa: 'proprieta',
            valoreCatastalePrimaCasa: baseInput.valoreCatastalePrimaCasa + 100_000,
          },
        },
      ];
      return scenari.map((s) => {
        const r = calcolaIsee(s.input);
        return { label: s.label, isee: r.ok ? r.iseeStimato : 0 };
      });
    }

    function disegnaChartScenari(baseInput: InputIsee): void {
      const canvas = $('is-chart-scenari') as unknown as HTMLCanvasElement;
      if (!canvas) return;
      const data = calcolaScenari(baseInput);
      const labels = data.map((d) => d.label);
      const values = data.map((d) => d.isee);
      const colors = data.map((_, i) => i === 0 ? '#00A652' : '#79B9AD');

      if (chartScen) {
        chartScen.data.labels = labels;
        chartScen.data.datasets[0].data = values;
        (chartScen.data.datasets[0] as any).backgroundColor = colors;
        chartScen.update('none');
        return;
      }

      chartScen = new Chart(canvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'ISEE',
            data: values,
            backgroundColor: colors,
            borderWidth: 0,
            borderRadius: 6,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 500, easing: 'easeOutQuart' },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#FFFFFF',
              borderColor: 'rgba(22, 105, 99, 0.25)',
              borderWidth: 1,
              titleColor: '#0F4F4A',
              titleFont: { family: 'Manrope, sans-serif', weight: 700, size: 13 },
              bodyColor: '#373D42',
              bodyFont: { family: 'Manrope, sans-serif', size: 12 },
              padding: 12,
              cornerRadius: 8,
              displayColors: false,
              callbacks: {
                label: (ctx) => `ISEE: ${fmtEuroNoCents.format(Number(ctx.parsed.y))}`,
              },
            },
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                maxRotation: 30,
                minRotation: 0,
              },
            },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(22, 105, 99, 0.12)', lineWidth: 1 },
              border: { display: false },
              ticks: {
                color: '#6B7672',
                font: { family: 'Manrope, sans-serif', size: 11 },
                callback: (v) => fmtEuroShort(v as number),
              },
            },
          },
        },
      });
    }

    // -------------------- MAIN --------------------
    function aggiorna(): void {
      setVisibility();

      const blocking = $('is-blocking');
      const inp = buildInput();
      const out = calcolaIsee(inp);

      if (!out.ok) {
        blocking.textContent = out.errore ?? 'Dati non validi.';
        return;
      }
      blocking.textContent = '';

      // Output principale
      $('is-out-isee').textContent = fmtEuro.format(out.iseeStimato);
      const fascia = fasciaIsee(out.iseeStimato);
      const badge = $('is-fascia-badge');
      badge.textContent = fascia.label;
      badge.className = `result-badge ${fascia.cls}`;

      $('is-primary-label').textContent =
        inp.tipologia === 'universitario' ? 'ISEE Universitario stimato'
        : inp.tipologia === 'inclusione' ? 'ISEE Inclusione stimato'
        : 'ISEE Ordinario stimato';

      // Indicatori
      $('is-out-isr').textContent = fmtEuroNoCents.format(out.isr);
      $('is-out-isp').textContent = fmtEuroNoCents.format(out.isp);
      $('is-out-ise').textContent = fmtEuroNoCents.format(out.ise);
      $('is-out-figurativo').textContent = fmtEuroNoCents.format(out.dettaglioComponenti.redditoFigurativo);
      $('is-out-scala').textContent = fmtScala(out.scalaEquivalenza);

      // Patrimonio
      const d = out.dettaglioComponenti;
      $('is-out-imm-lordo').textContent = fmtEuroNoCents.format(d.patrimonioImmobiliareLordo);
      $('is-out-franchigia-imm').textContent = fmtEuroNoCents.format(d.franchigiaApplicata);
      $('is-out-imm-netto').textContent = fmtEuroNoCents.format(d.patrimonioImmobiliareNetto);
      $('is-out-mob-lordo').textContent = fmtEuroNoCents.format(d.patrimonioMobiliareLordo);
      $('is-out-franchigia-mob').textContent = fmtEuroNoCents.format(d.franchigiaMobiliare);
      $('is-out-mob-netto').textContent = fmtEuroNoCents.format(d.patrimonioMobiliareNetto);

      // Redditi
      $('is-out-red-lordi').textContent = fmtEuroNoCents.format(d.redditiTotali);
      $('is-out-abb20').textContent = `− ${fmtEuroNoCents.format(d.abbattimento20Percento)}`;
      $('is-out-deduzioni').textContent = `− ${fmtEuroNoCents.format(d.deduzioniTotali)}`;
      $('is-out-red-netto').textContent = fmtEuroNoCents.format(d.redditoNetto);

      // Confronto tipologie
      $('is-cmp-ord').textContent = fmtEuro.format(out.iseeOrdinario);
      $('is-cmp-uni').textContent = fmtEuro.format(out.iseeUniversitario);
      $('is-cmp-inc').textContent = fmtEuro.format(out.iseeInclusione);
      const tipo = inp.tipologia;
      $('is-row-ord').classList.toggle('is-active', tipo === 'ordinario');
      $('is-row-uni').classList.toggle('is-active', tipo === 'universitario');
      $('is-row-inc').classList.toggle('is-active', tipo === 'inclusione');

      // Scala display
      $('is-scala-display').textContent = fmtScala(out.scalaEquivalenza);

      // Warnings
      renderWarnings(out);

      // Agevolazioni
      renderAgevolazioni(out);

      // Charts
      disegnaChartComp(out);
      disegnaChartScenari(inp);
    }

    // -------------------- DEBOUNCE + WIRING --------------------
    let timer: ReturnType<typeof setTimeout> | null = null;
    function schedule(): void {
      if (timer) clearTimeout(timer);
      timer = setTimeout(aggiorna, 200);
    }

    // Tutti gli input/select cambiano → ricalcola
    $$<HTMLInputElement | HTMLSelectElement>('.calc-isee input, .calc-isee select').forEach((el) => {
      el.addEventListener('input', schedule);
      el.addEventListener('change', schedule);
    });

    aggiorna();
  </script>
</Layout>
