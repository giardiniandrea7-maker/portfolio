        <a href="/calcolatori" class="btn btn-secondary">Torna ai calcolatori</a>
      </div>
    </section>

    <!-- ============== DISCLAIMER ============== -->
    <div class="final-disclaimer">
      <strong>Nota informativa:</strong> Le stime fornite hanno valore puramente indicativo e si
