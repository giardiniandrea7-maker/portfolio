    .calc-isee .btn-primary { background: var(--sage); color: var(--ivory); }
    .calc-isee .btn-primary:hover { background: var(--sage-dark); }
    .calc-isee .btn-secondary {
      background: transparent;
      color: var(--sage);
      border: 1.5px solid var(--sage);
    }
    .calc-isee .btn-secondary:hover { background: var(--sage); color: var(--ivory); }

    .calc-isee .final-disclaimer {
      margin-top: 30px;
      padding: 18px 22px;
      background: var(--ivory-warm);
      border-left: 3px solid var(--ochre);
      border-radius: 4px;
      font-size: 0.82rem;
      color: var(--gray-text);
      line-height: 1.6;
    }
    .calc-isee .final-disclaimer strong { color: var(--charcoal); }

    /* Visibilità per modalità */
    .calc-isee.modo-semplice .advanced-only { display: none !important; }

    /* Responsive */
    @media (max-width: 880px) {
      .calc-isee { padding: 25px 16px 40px; }
