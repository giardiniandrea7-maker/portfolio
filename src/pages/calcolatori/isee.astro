      .calc-isee .modalita-toggle { justify-content: flex-start; }
      .calc-isee .main-grid { grid-template-columns: 1fr; gap: 18px; }
      .calc-isee .card { padding: 22px 22px; }
      .calc-isee .form-row-2 { grid-template-columns: 1fr; gap: 0; }
      .calc-isee .math-content,
      .calc-isee .ammortamento-content { padding: 4px 18px 24px; }
