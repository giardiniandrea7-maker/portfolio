---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Login — Area Clienti | Andrea Giardini',
  description: "Accedi all'area riservata ai clienti di Andrea Giardini.",
};
---

<Layout metadata={metadata}>

  <section class="bg-[rgb(238_247_246)] py-16 md:py-24 min-h-[calc(100vh-200px)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Banner "in attivazione" in alto -->
      <div class="max-w-5xl mx-auto mb-10">
        <div class="flex items-start gap-3 bg-[var(--aw-color-accent)]/10 border border-[var(--aw-color-accent)]/30 rounded-md p-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <div class="text-sm text-[var(--aw-color-text-default)]">
            <strong class="text-[var(--aw-color-text-heading)]">Sistema di autenticazione in fase di attivazione.</strong>
            Il form è visibile in anteprima; le credenziali non sono ancora attive. Per qualsiasi esigenza <a href="mailto:andrea@giardiniconsulenza.it" class="text-[var(--aw-color-primary)] underline font-semibold hover:text-[var(--aw-color-accent)]">scrivimi</a>.
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-start max-w-5xl mx-auto">

        <!-- SX: Istruzioni -->
        <div>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--aw-color-text-heading)] mb-8 leading-tight font-heading">
            Entra nell'area riservata ai clienti
          </h1>

          <div class="space-y-5 text-base md:text-lg text-[var(--aw-color-text-default)] leading-relaxed">
            <p>
              Per accedere all'area riservata inserisci le credenziali oppure <a href="/registrazione" class="text-[var(--aw-color-primary)] underline font-semibold hover:text-[var(--aw-color-accent)] transition-colors">registrati come cliente</a>.
            </p>

            <p>
              <strong>Se ti sei appena registrato</strong> attendi che un amministratore ti comunichi la corretta attivazione dell'account.
            </p>

            <p>
              <strong>Se accedi per la prima volta</strong> ti sarà richiesto di accettare i termini di servizio e la privacy policy.
            </p>

            <p>
              Per qualsiasi problema relativamente all'accesso non esitare a contattare il servizio clienti <a href="mailto:andrea@giardiniconsulenza.it" class="text-[var(--aw-color-primary)] underline font-semibold hover:text-[var(--aw-color-accent)] transition-colors">andrea@giardiniconsulenza.it</a>, indicando il tuo nome e il tuo cognome, possibilmente dall'indirizzo su cui ricevi le nostre comunicazioni.
            </p>

            <p>
              Una volta autenticato potrai accedere ai contenuti a te riservati e modificare le impostazioni relative al tuo account, alle newsletters e alla privacy.
            </p>

            <p class="font-bold text-[var(--aw-color-text-heading)]">
              Ti ricordiamo che l'area riservata è disponibile per i soli clienti.
            </p>
          </div>
        </div>

        <!-- DX: Form Login -->
        <div class="md:sticky md:top-24">
          <div class="bg-white rounded-md p-8 md:p-10 shadow-xl border border-gray-100">
            <h2 class="text-2xl md:text-3xl font-bold text-[var(--aw-color-text-heading)] mb-8 font-heading">
              Login
            </h2>

            <form class="space-y-5" action="#" method="POST" onsubmit="event.preventDefault(); alert('Sistema di autenticazione in fase di attivazione — riprova più tardi');">

              <!-- Nome utente -->
              <div>
                <label for="login-username" class="sr-only">Nome utente</label>
                <div class="relative">
                  <div class="absolute left-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-[var(--aw-color-primary)]/10 flex items-center justify-center pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                      <circle cx="12" cy="7" r="4"/>
                    </svg>
                  </div>
                  <input type="text" id="login-username" name="username" required placeholder="Nome utente"
                    class="w-full pl-14 pr-4 py-4 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] focus:ring-1 focus:ring-[var(--aw-color-primary)] transition-colors text-[var(--aw-color-text-heading)]"/>
                </div>
              </div>

              <!-- Password -->
              <div>
                <label for="login-password" class="sr-only">Password</label>
                <div class="relative">
                  <div class="absolute left-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-[var(--aw-color-primary)]/10 flex items-center justify-center pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                  </div>
                  <input type="password" id="login-password" name="password" required placeholder="Password"
                    class="w-full pl-14 pr-4 py-4 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] focus:ring-1 focus:ring-[var(--aw-color-primary)] transition-colors text-[var(--aw-color-text-heading)]"/>
                </div>
              </div>

              <!-- Ricordami -->
              <label class="flex items-center gap-2 text-sm text-[var(--aw-color-text-default)] cursor-pointer pt-1">
                <input type="checkbox" class="w-4 h-4 text-[var(--aw-color-primary)] border-gray-300 rounded focus:ring-[var(--aw-color-primary)]"/>
                <span>Ricordami</span>
              </label>

              <!-- Accesso -->
              <button type="submit"
                class="btn-brand--dark w-full px-6 py-4 text-base">
                Accesso
              </button>

              <!-- Link secondari -->
              <ul class="space-y-2 pt-4 text-sm">
                <li>
                  <a href="/registrazione" class="inline-flex items-center gap-1 text-[var(--aw-color-primary)] hover:text-[var(--aw-color-accent)] font-semibold transition-colors">
                    <span>Registrati</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"/>
                    </svg>
                  </a>
                </li>
                <li>
                  <a href="mailto:andrea@giardiniconsulenza.it?subject=Nome%20utente%20dimenticato" class="text-[var(--aw-color-primary)] hover:text-[var(--aw-color-accent)] font-semibold transition-colors">
                    Hai dimenticato il tuo nome utente?
                  </a>
                </li>
                <li>
                  <a href="mailto:andrea@giardiniconsulenza.it?subject=Password%20dimenticata" class="text-[var(--aw-color-primary)] hover:text-[var(--aw-color-accent)] font-semibold transition-colors">
                    Password dimenticata?
                  </a>
                </li>
              </ul>

            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>
