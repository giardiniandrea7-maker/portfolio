---
import { Icon } from 'astro-icon/components';
import QRCode from 'qrcode';
import '@fontsource/playfair-display/400.css';

import SiteLayout from '~/components/site/SiteLayout.astro';
import SectionTitle from '~/components/site/SectionTitle.astro';
import InfoTip from '~/components/site/InfoTip.astro';

import { siteContacts, siteQualifica } from '~/navigation';
import { DEDUCIBILITA_MAX, FASCE_IRPEF, FONTI, RENDIMENTI, TENORI } from '~/data/previdenza';
import { LIMITI } from '~/lib/previdenza';
import { COLORI } from '~/lib/grafici-previdenza';

const metadata = {
  title: 'La tua pensione, passo dopo passo | Andrea Giardini',
  ignoreTitleTemplate: true,
  description:
    'Scopri quanto potrebbe servirti in pensione e come la previdenza complementare ti aiuta a costruirlo: motore fiscale, datore di lavoro e tempo.',
};

// QR-code del PDF generato a build-time (indirizzo fisso)
const qrDataUrl = await QRCode.toDataURL('https://giardiniconsulenza.it/contatti', {
  margin: 1,
  width: 320,
  color: { dark: '#1E2421', light: '#FFFFFF' },
});

const lavori = [
  { value: 'privato', icon: 'tabler:briefcase', title: 'Dipendente privato', text: 'Lavori per un’azienda o uno studio.' },
  { value: 'pubblico', icon: 'tabler:building-bank', title: 'Dipendente pubblico', text: 'Lavori per un ente o un’amministrazione.' },
  { value: 'autonomo', icon: 'tabler:user-star', title: 'Autonomo o professionista', text: 'Lavori in proprio, con partita IVA.' },
];

const tenori = [
  { value: TENORI.essenziale, icon: 'tabler:home-heart', title: 'Essenziale', text: 'Le spese di casa e qualche piccolo piacere.' },
  { value: TENORI.comeOggi, icon: 'tabler:coffee', title: 'Come oggi', text: 'Le tue abitudini di sempre, con serenità.' },
  { value: TENORI.senzaRinunce, icon: 'tabler:plane', title: 'Senza rinunce', text: 'Viaggi, passioni e tempo per chi ami.' },
];

const versamenti = [50, 100, 150, 200, 300];

const datoreOpzioni = [
  { value: 'si', icon: 'tabler:check', title: 'Sì' },
  { value: 'no', icon: 'tabler:minus', title: 'No' },
  { value: 'nonso', icon: 'tabler:help', title: 'Non lo so' },
];

const ipotesi = [
  { value: 'prudente', label: 'Prudente' },
  { value: 'equilibrato', label: 'Equilibrato' },
  { value: 'dinamico', label: 'Dinamico' },
];

const faq = [
  {
    q: 'Cos’è la previdenza complementare?',
    a: 'È un risparmio dedicato alla pensione, che si affianca a quella pubblica. Ci versi tu, a volte anche il tuo datore di lavoro, e lo Stato ti riconosce un vantaggio fiscale. Lo ritrovi quando vai in pensione, come capitale o come cifra mensile.',
  },
  {
    q: 'Perché lo Stato mi restituisce dei soldi?',
    a: `Quello che versi per la pensione complementare si può togliere dal reddito su cui paghi le tasse, fino a ${DEDUCIBILITA_MAX.toLocaleString('it-IT')} € l’anno. Così paghi meno tasse e, con la dichiarazione dei redditi, ti torna una parte di quanto hai versato.`,
  },
  {
    q: 'Questa è una consulenza?',
    a: 'No. È una simulazione a scopo informativo ed educativo, con ipotesi semplificate. Serve a farti un’idea e a orientarti. Per un percorso costruito sulla tua situazione possiamo parlarne insieme.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'La tua pensione, passo dopo passo',
    url: 'https://giardiniconsulenza.it/la-tua-pensione',
    description: metadata.description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    browserRequirements: 'Richiede JavaScript',
    inLanguage: 'it-IT',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    author: { '@type': 'Person', name: 'Andrea Giardini', jobTitle: siteQualifica.estesa },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

// Stili ricorrenti
const card =
  'flex h-full items-center gap-4 rounded-[12px] border-2 border-transparent bg-white p-5 md:p-6 text-left shadow-[0_10px_30px_-20px_rgba(0,40,22,0.35)] transition-all cursor-pointer hover:border-brand/40 peer-checked:border-brand peer-checked:bg-brand/[0.04] peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ember';
const chip =
  'inline-flex items-center justify-center min-w-[4.5rem] rounded-full border border-brand px-5 py-3 text-base text-brand cursor-pointer transition-colors hover:bg-brand/10 peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ember';
const domanda = 'font-playfair text-3xl md:text-4xl text-charcoal leading-tight focus:outline-none';
const eyebrow = 'text-xs uppercase tracking-[0.2em] font-semibold text-brand';
const capTitle = 'mt-3 font-playfair text-3xl md:text-4xl text-charcoal leading-tight';
const btnPrimary =
  'inline-flex items-center justify-center gap-2 bg-brand text-white uppercase tracking-[0.15em] text-sm py-4 px-8 hover:bg-brand/90 disabled:opacity-40 disabled:cursor-not-allowed transition-colors';
const btnGhost =
  'inline-flex items-center justify-center gap-2 border border-brand text-brand uppercase tracking-[0.15em] text-sm py-4 px-6 hover:bg-brand hover:text-white transition-colors';
const sw = 'w-3 h-3 rounded-sm shrink-0';
---

<SiteLayout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <div
    data-pensione
    data-qr={qrDataUrl}
    data-telefono={siteContacts.phone}
    data-email={siteContacts.email}
    data-qualifica={siteQualifica.estesa}
  >
    <!-- INTRO -->
    <section data-intro class="bg-ivory py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-4 md:px-8 text-center">
        <h1 class="font-playfair text-4xl md:text-6xl leading-tight text-charcoal text-balance">Come vuoi vivere domani?</h1>
        <p class="mt-6 text-lg md:text-xl text-charcoal/80 leading-relaxed text-balance">
          In pochi passi scopri quanto potrebbe servirti in pensione e come costruirlo, un mattone alla volta.
        </p>
        <button type="button" data-inizia class:list={[btnPrimary, 'mt-10 px-12']}>
          Iniziamo <Icon name="tabler:arrow-right" class="w-5 h-5" aria-hidden="true" />
        </button>
        <p class="mt-6 flex items-center justify-center gap-2 text-xs text-charcoal/70">
          <Icon name="tabler:lock" class="w-4 h-4 text-brand" aria-hidden="true" />
          Tutto viene calcolato nel tuo browser: nessun dato viene salvato o inviato.
        </p>
        <noscript>
          <p class="mt-6 text-sm text-charcoal">Per usare il percorso attiva JavaScript nel browser.</p>
        </noscript>
      </div>
    </section>

    <!-- PERCORSO A DOMANDE -->
    <section data-percorso hidden class="bg-linen py-12 md:py-20 scroll-mt-16 md:scroll-mt-20" aria-label="Percorso a domande">
      <div class="max-w-3xl mx-auto px-4 md:px-8">
        <div class="flex items-center justify-between text-xs uppercase tracking-[0.15em] text-charcoal/70">
          <span data-passo-testo>Passo 1 di 6</span>
        </div>
        <div
          class="mt-3 h-1.5 w-full rounded-full bg-sand overflow-hidden"
          role="progressbar"
          aria-label="Avanzamento del percorso"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          data-progresso
        >
          <span data-progresso-barra class="block h-full bg-brand transition-[width] duration-500" style="width:0%"></span>
        </div>

        <form data-form novalidate class="mt-10 md:mt-14">
          <!-- 1. Età -->
          <fieldset data-step="eta" class="text-center">
            <legend class="sr-only">Quanti anni hai?</legend>
            <h2 class={domanda} tabindex="-1" data-step-title>Quanti anni hai?</h2>
            <p class="mt-8">
              <output for="q-eta" data-out="eta" class="font-playfair text-7xl md:text-8xl text-brand">35</output>
              <span class="block mt-1 text-charcoal/70">anni</span>
            </p>
            <label for="q-eta" class="sr-only">La tua età</label>
            <input id="q-eta" name="eta" type="range" min={LIMITI.etaMin} max={LIMITI.etaMax} step="1" value="35" class="pp-range mt-8 w-full max-w-md" />
          </fieldset>

          <!-- 2. Lavoro -->
          <fieldset data-step="lavoro" hidden>
            <legend class="sr-only">Che lavoro fai?</legend>
            <h2 class:list={[domanda, 'text-center']} tabindex="-1" data-step-title>Che lavoro fai?</h2>
            <div class="mt-10 grid gap-4">
              {
                lavori.map((l) => (
                  <label class="block">
                    <input type="radio" name="tipo" value={l.value} class="peer sr-only" />
                    <span class={card}>
                      <span class="w-14 h-14 shrink-0 rounded-full bg-ivory flex items-center justify-center">
                        <Icon name={l.icon} class="w-7 h-7 text-brand [&_*]:stroke-[1.4]" aria-hidden="true" />
                      </span>
                      <span>
                        <span class="block text-lg font-semibold text-charcoal">{l.title}</span>
                        <span class="block text-sm text-charcoal/70">{l.text}</span>
                      </span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 3. Reddito -->
          <fieldset data-step="reddito" hidden class="text-center">
            <legend class="sr-only">Quanto ti entra al mese?</legend>
            <h2 class={domanda} tabindex="-1" data-step-title>Quanto ti entra al mese?</h2>
            <p class="mt-3 text-charcoal/70">Lo stipendio o il guadagno netto, quello che arriva sul conto.</p>
            <div class="mt-8 inline-flex items-baseline gap-3 border-b-2 border-brand px-2">
              <label for="q-netto" class="sr-only">Entrate nette al mese, in euro</label>
              <input
                id="q-netto"
                name="netto"
                type="text"
                inputmode="numeric"
                autocomplete="off"
                value="2.200"
                aria-describedby="e-netto"
                class="w-[7ch] bg-transparent text-center font-playfair text-6xl md:text-7xl text-brand focus:outline-none"
              />
              <span class="font-playfair text-4xl text-brand" aria-hidden="true">€</span>
            </div>
            <p id="e-netto" data-errore="nettoMese" class="mt-3 text-sm text-ember-dark" hidden></p>

            <div class="mt-10">
              <p class="text-sm text-charcoal">
                Il tuo reddito lordo annuo è circa…
                <InfoTip
                  term="reddito lordo e aliquota"
                  text="Ci serve per calcolare quanto ti restituisce lo Stato. Il lordo è il reddito prima di tasse e contributi; la fascia indica la tua aliquota, cioè la percentuale di tasse sull’ultima parte del reddito."
                />
              </p>
              <div class="mt-4 flex flex-wrap justify-center gap-3" role="radiogroup" aria-label="Fascia di reddito lordo annuo">
                {
                  FASCE_IRPEF.map((f) => (
                    <label>
                      <input type="radio" name="fascia" value={f.id} class="peer sr-only" />
                      <span class={chip}>{f.etichetta}</span>
                    </label>
                  ))
                }
              </div>
              <p class="mt-3 text-xs text-charcoal/60">L’abbiamo stimata dal netto: puoi cambiarla.</p>
            </div>
          </fieldset>

          <!-- 4. Tenore -->
          <fieldset data-step="tenore" hidden>
            <legend class="sr-only">Come vorresti vivere in pensione?</legend>
            <h2 class:list={[domanda, 'text-center']} tabindex="-1" data-step-title>Come vorresti vivere in pensione?</h2>
            <div class="mt-10 grid md:grid-cols-3 gap-4">
              {
                tenori.map((t) => (
                  <label class="block">
                    <input type="radio" name="tenore" value={t.value} class="peer sr-only" />
                    <span class:list={[card, 'md:flex-col md:text-center md:py-8']}>
                      <span class="w-14 h-14 md:w-16 md:h-16 shrink-0 rounded-full bg-ivory flex items-center justify-center">
                        <Icon name={t.icon} class="w-7 h-7 md:w-8 md:h-8 text-brand [&_*]:stroke-[1.4]" aria-hidden="true" />
                      </span>
                      <span class="flex-1">
                        <span class="block text-lg font-semibold text-charcoal">{t.title}</span>
                        <span class="block mt-1 text-sm text-charcoal/70">{t.text}</span>
                      </span>
                      <span class="shrink-0 text-right md:text-center">
                        <span class="block font-playfair text-2xl text-brand">{t.value}%</span>
                        <span class="block text-[11px] leading-tight text-charcoal/60 max-w-[5.5rem] md:max-w-none">di quanto ti entra oggi</span>
                      </span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 5. Versamento -->
          <fieldset data-step="versamento" hidden class="text-center">
            <legend class="sr-only">Quanto potresti mettere da parte ogni mese?</legend>
            <h2 class={domanda} tabindex="-1" data-step-title>Quanto potresti mettere da parte ogni mese?</h2>
            <p class="mt-3 text-charcoal/70">Anche una cifra piccola fa la differenza, se è costante.</p>
            <div class="mt-10 flex flex-wrap justify-center gap-3">
              {
                versamenti.map((v) => (
                  <label>
                    <input type="radio" name="versamento" value={v} class="peer sr-only" />
                    <span class={chip}>{v} €</span>
                  </label>
                ))
              }
              <label>
                <input type="radio" name="versamento" value="altro" class="peer sr-only" />
                <span class={chip}>Altro</span>
              </label>
            </div>
            <div data-altro hidden class="mt-6">
              <label for="q-altro" class="block text-sm text-charcoal">La tua cifra al mese, in euro</label>
              <input
                id="q-altro"
                name="altro"
                type="text"
                inputmode="numeric"
                autocomplete="off"
                placeholder="80"
                aria-describedby="e-versamento"
                class="mt-2 w-40 text-center bg-white border border-gray-300 rounded-[8px] px-4 py-3 text-xl text-charcoal focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand"
              />
            </div>
            <p id="e-versamento" data-errore="versamentoMese" class="mt-3 text-sm text-ember-dark" hidden></p>
          </fieldset>

          <!-- 6. Datore (solo dipendenti privati) -->
          <fieldset data-step="datore" hidden>
            <legend class="sr-only">Il tuo contratto prevede che il datore versi in un fondo pensione?</legend>
            <h2 class:list={[domanda, 'text-center']} tabindex="-1" data-step-title>
              Il tuo contratto prevede che il datore versi in un fondo pensione?
            </h2>
            <p class="mt-3 text-center text-charcoal/70">
              Fondo pensione
              <InfoTip
                term="fondo pensione"
                text="È lo strumento della previdenza complementare legato al tuo lavoro o al tuo contratto: ci versi tu, spesso anche il datore."
              />
            </p>
            <div class="mt-10 grid sm:grid-cols-3 gap-4">
              {
                datoreOpzioni.map((o) => (
                  <label class="block">
                    <input type="radio" name="datore" value={o.value} class="peer sr-only" />
                    <span class:list={[card, 'justify-center']}>
                      <Icon name={o.icon} class="w-6 h-6 text-brand" aria-hidden="true" />
                      <span class="text-lg font-semibold text-charcoal">{o.title}</span>
                    </span>
                  </label>
                ))
              }
            </div>
            <p data-nota-nonso hidden class="mt-6 text-center text-sm text-charcoal/80">
              Ne parliamo insieme: spesso è un contributo che si lascia sul tavolo. Per ora non lo contiamo.
            </p>
          </fieldset>

          <div class="mt-12 flex items-center justify-between gap-4">
            <button type="button" data-indietro class="inline-flex items-center gap-2 text-sm uppercase tracking-[0.15em] text-charcoal hover:text-brand py-3 disabled:invisible">
              <Icon name="tabler:arrow-left" class="w-5 h-5" aria-hidden="true" /> Indietro
            </button>
            <button type="button" data-avanti class={btnPrimary}>
              <span data-avanti-label>Avanti</span>
              <Icon name="tabler:arrow-right" class="w-5 h-5" aria-hidden="true" />
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- RISULTATI -->
    <div data-risultati hidden>
      <p data-annuncio class="sr-only" aria-live="polite"></p>

      <!-- Riepilogo risposte + età pensione -->
      <section class="bg-white border-b border-charcoal/10 scroll-mt-16 md:scroll-mt-20" data-risultati-top>
        <div class="max-w-6xl mx-auto px-4 md:px-8 py-6 md:py-8 md:flex md:items-center md:justify-between md:gap-10">
          <div>
            <h2 class="text-xs uppercase tracking-[0.2em] font-semibold text-charcoal/70 focus:outline-none" tabindex="-1" data-risultati-titolo>
              Le tue risposte
            </h2>
            <p data-out="riepilogo" class="mt-2 text-sm md:text-base text-charcoal"></p>
            <button type="button" data-modifica class="mt-2 text-sm text-brand underline underline-offset-4">Modifica le risposte</button>
          </div>
          <div class="mt-6 md:mt-0 md:w-80 shrink-0">
            <div class="flex items-baseline justify-between text-sm">
              <label for="r-pensione" class="font-semibold text-charcoal">In pensione a</label>
              <output for="r-pensione" data-out="etaPensione" class="font-playfair text-xl text-brand">67 anni</output>
            </div>
            <input id="r-pensione" type="range" min={LIMITI.etaPensioneMin} max={LIMITI.etaPensioneMax} step="1" value="67" class="pp-range mt-2 w-full" />
          </div>
        </div>
      </section>

      <!-- Capitolo 1 -->
      <section class="bg-linen py-14 md:py-20">
        <div class="max-w-4xl mx-auto px-4 md:px-8">
          <p class={eyebrow}>Capitolo 1</p>
          <h2 class={capTitle}>Il tuo punto di partenza</h2>
          <p data-out="frase1" class="mt-5 text-lg md:text-xl text-charcoal leading-relaxed"></p>
          <figure class="mt-8 bg-white rounded-[12px] p-4 md:p-6">
            <div data-gradino class="[&_svg]:w-full [&_svg]:h-auto"></div>
            <figcaption>
              <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-charcoal">
                <li class="flex items-center gap-2"><span class={sw} style={`background:${COLORI.reddito}`}></span>Reddito di oggi</li>
                <li class="flex items-center gap-2"><span class={sw} style={`background:${COLORI.pensione}`}></span>Pensione pubblica stimata</li>
                <li class="flex items-center gap-2">
                  <span class={sw} style={`background:repeating-linear-gradient(45deg,#FBF1E4 0 2px,${COLORI.divario} 2px 4px);outline:1px dashed ${COLORI.divario}`}></span>Da costruire
                </li>
                <li class="flex items-center gap-2"><span class="w-4 border-t-2 border-dashed" style={`border-color:${COLORI.divario}`}></span>Come vorresti vivere</li>
              </ul>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- Capitolo 2 -->
      <section class="bg-ivory py-14 md:py-20">
        <div class="max-w-6xl mx-auto px-4 md:px-8">
          <div class="max-w-3xl">
            <p class={eyebrow}>Capitolo 2</p>
            <h2 class={capTitle}>I motori che lavorano per te</h2>
            <p class="mt-5 text-lg text-charcoal leading-relaxed">
              Con la previdenza complementare<InfoTip
                term="previdenza complementare"
                text="Un risparmio dedicato alla pensione che si affianca a quella pubblica, con vantaggi fiscali e, per molti dipendenti, il contributo del datore."
              />
              il tuo impegno non lavora da solo: altri motori si aggiungono, anno dopo anno.
            </p>
          </div>

          <div class="mt-10 lg:grid lg:grid-cols-12 lg:gap-10 lg:items-start">
            <!-- Torre -->
            <figure class="lg:col-span-5 bg-white rounded-[12px] p-5 md:p-6 lg:sticky lg:top-24">
              <div data-torre class="mx-auto max-w-[320px] [&_svg]:w-full [&_svg]:h-auto"></div>
              <div class="mt-4">
                <div class="flex items-baseline justify-between text-sm">
                  <label for="r-anno" class="font-semibold text-charcoal">Guarda la torre crescere</label>
                  <output for="r-anno" data-out="annoTorre" class="font-playfair text-lg text-brand">A 67 anni</output>
                </div>
                <input id="r-anno" type="range" min="0" max="32" step="1" value="32" class="pp-range mt-2 w-full" />
              </div>
              <figcaption>
                <p class="mt-3 text-xs text-charcoal/70">Capitale accumulato, prima delle tasse in uscita.</p>
                <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-xs text-charcoal">
                  <li class="flex items-center gap-2"><span class={sw} style={`background:${COLORI.tuo}`}></span>Il tuo versamento</li>
                  <li class="flex items-center gap-2"><span class={sw} style={`background:${COLORI.fiscale}`}></span>Motore fiscale</li>
                  <li class="[&:not([hidden])]:flex items-center gap-2" data-solo-datore><span class={sw} style={`background:${COLORI.datore}`}></span>Datore di lavoro</li>
                  <li class="[&:not([hidden])]:flex items-center gap-2" data-solo-tfr><span class={sw} style={`background:${COLORI.tfr}`}></span>TFR</li>
                  <li class="flex items-center gap-2">
                    <span class={sw} style={`background:radial-gradient(${COLORI.crescitaPunti} 1px, ${COLORI.crescita} 1.2px) 0 0/4px 4px`}></span>Crescita nel tempo
                  </li>
                  <li class="flex items-center gap-2"><span class="w-4 border-t-2 border-dashed" style={`border-color:${COLORI.divario}`}></span>Il tuo obiettivo</li>
                </ul>
              </figcaption>
            </figure>

            <!-- Motori -->
            <div class="mt-8 lg:mt-0 lg:col-span-7 space-y-4">
              <article class="bg-white rounded-[12px] p-5 md:p-6 border-l-4" style={`border-color:${COLORI.tuo}`}>
                <div class="flex items-start justify-between gap-4">
                  <h3 class="flex items-center gap-2 font-semibold text-charcoal"><Icon name="tabler:pig-money" class="w-5 h-5 text-brand" aria-hidden="true" />Il tuo impegno</h3>
                  <p class="font-playfair text-2xl text-charcoal" data-conta="mTuo">—</p>
                </div>
                <p class="mt-2 text-sm text-charcoal/80">Metti da parte <span data-out="versamento"></span> al mese.</p>
              </article>

