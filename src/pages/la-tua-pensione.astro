---
import { Icon } from 'astro-icon/components';
import QRCode from 'qrcode';
import '@fontsource/playfair-display/400.css';

import SiteLayout from '~/components/site/SiteLayout.astro';
import SectionTitle from '~/components/site/SectionTitle.astro';
import InfoTip from '~/components/site/InfoTip.astro';

import { siteContacts, siteQualifica } from '~/navigation';
import {
  ANTICIPAZIONE_CASA,
  CAPITALE_MAX_USCITA,
  DEDUCIBILITA_MAX,
  ETA_MAX,
  ETA_MIN,
  ETA_PENSIONE,
  EXTRA_DEDUZIONE_GIOVANI,
  FASCE,
  FONTI,
  SOGLIA_PROFILO,
} from '~/data/previdenza';
import { MENSILE_MASSIMO } from '~/lib/previdenza';
import { DISCLAIMER } from '~/lib/vantaggi';
import { intero } from '~/lib/formato';

const metadata = {
  title: 'Vantaggi fiscali della previdenza complementare | Andrea Giardini',
  ignoreTitleTemplate: true,
  // Pagina nascosta finché la compliance non approva: niente link dal sito, niente indicizzazione
  robots: { index: false, follow: false },
  description:
    'Scopri in un minuto quanto lo Stato ti restituisce ogni anno se metti da parte per la tua pensione. Calcolo semplice, nessun dato salvato.',
};

// QR-code del PDF generato a build-time (indirizzo fisso)
const qrDataUrl = await QRCode.toDataURL('https://giardiniconsulenza.it/contatti', {
  margin: 1,
  width: 320,
  color: { dark: '#1E2421', light: '#FFFFFF' },
});

const importi = [50, 100, 200, 300];
const ETA_DEFAULT = 35;
// Separatore delle migliaia sempre presente (5.300, 2.650)
const nf = intero;

const vantaggiTempo = [
  { icon: 'tabler:hourglass', titolo: 'Il tempo è dalla tua parte' },
  { icon: 'tabler:home', titolo: 'Un aiuto anche per la casa' },
  { icon: 'tabler:gift', titolo: 'Un vantaggio in più per chi inizia ora' },
];
const vantaggiFisco = [
  { icon: 'tabler:receipt-tax', titolo: 'Meno tasse, ogni anno' },
  { icon: 'tabler:scale', titolo: 'Alla fine paghi meno' },
  { icon: 'tabler:shield-check', titolo: 'Protetto e flessibile' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Vantaggi fiscali della previdenza complementare',
  url: 'https://giardiniconsulenza.it/la-tua-pensione',
  description: metadata.description,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Richiede JavaScript',
  inLanguage: 'it-IT',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: { '@type': 'Person', name: 'Andrea Giardini', jobTitle: siteQualifica.estesa },
};

const chip =
  'inline-flex items-center justify-center rounded-full border border-brand px-4 py-2.5 text-sm md:text-base text-brand cursor-pointer transition-colors hover:bg-brand/10 peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ember';
const domanda = 'font-semibold text-lg text-charcoal';
const btnPrimary =
  'inline-flex items-center justify-center gap-2 bg-brand text-white uppercase tracking-[0.15em] text-sm py-4 px-8 hover:bg-brand/90 transition-colors';
---

<SiteLayout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <div data-vantaggi data-qr={qrDataUrl} data-telefono={siteContacts.phone} data-email={siteContacts.email} data-qualifica={siteQualifica.estesa}>
    <!-- INTRO -->
    <section class="bg-ivory pt-14 pb-10 md:pt-20 md:pb-14">
      <div class="max-w-3xl mx-auto px-4 md:px-8 text-center">
        <h1 class="font-playfair text-3xl md:text-5xl leading-tight text-charcoal text-balance">
          Quanto ti restituisce lo Stato se pensi al tuo domani?
        </h1>
        <p class="mt-5 text-lg text-charcoal/80">Tre domande, meno di un minuto.</p>
      </div>
    </section>

    <!-- DOMANDE + RISULTATO -->
    <section class="bg-linen py-10 md:py-16">
      <div class="max-w-6xl mx-auto px-4 md:px-8 lg:grid lg:grid-cols-12 lg:gap-10 lg:items-start">
        <form data-form novalidate class="lg:col-span-6 bg-white rounded-[12px] p-5 md:p-8 space-y-10" aria-label="Le tue risposte">
          <!-- 1. Età -->
          <div>
            <div class="flex items-end justify-between gap-4">
              <label for="v-eta" class={domanda}>Quanti anni hai?</label>
              <output for="v-eta" data-out="eta" class="font-playfair text-5xl md:text-6xl text-brand leading-none">{ETA_DEFAULT}</output>
            </div>
            <input id="v-eta" name="eta" type="range" min={ETA_MIN} max={ETA_MAX} step="1" value={ETA_DEFAULT} class="vp-range mt-4 w-full" />
            <div class="mt-1 flex justify-between text-xs text-charcoal/75" aria-hidden="true"><span>{ETA_MIN}</span><span>{ETA_MAX}</span></div>
          </div>

          <!-- 2. Reddito -->
          <fieldset>
            <legend class={domanda}>
              Qual è il tuo reddito annuo, lordo?
              <InfoTip term="reddito lordo" text="È il reddito prima di tasse e contributi. Serve per sapere quante tasse risparmi." />
            </legend>
            <div class="mt-4 flex flex-wrap gap-2.5">
              {
                FASCE.map((f) => (
                  <label>
                    <input type="radio" name="fascia" value={f.id} checked={f.id === 'da28a50'} class="peer sr-only" />
                    <span class={chip}>{f.etichetta}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 3. Importo -->
          <fieldset>
            <legend class={domanda}>Quanto potresti mettere da parte al mese?</legend>
            <div class="mt-4 flex flex-wrap gap-2.5">
              {
                importi.map((v) => (
                  <label>
                    <input type="radio" name="mensile" value={v} checked={v === 200} class="peer sr-only" />
                    <span class={chip}>{v} €</span>
                  </label>
                ))
              }
              <label>
                <input type="radio" name="mensile" value={MENSILE_MASSIMO} class="peer sr-only" />
                <span class={chip}>Il massimo ({MENSILE_MASSIMO} €)</span>
              </label>
            </div>
            <p class="mt-3 text-xs text-charcoal/70">
              Il massimo corrisponde al limite deducibile di {nf(DEDUCIBILITA_MAX)} € l’anno.
              <InfoTip
                term="limite deducibile"
                text={`È la cifra massima, ${nf(DEDUCIBILITA_MAX)} € l’anno, che puoi togliere dal reddito su cui paghi le tasse (si dice "dedurre").`}
              />
            </p>
          </fieldset>

          <p class="flex items-start gap-2 text-xs text-charcoal/75 leading-relaxed">
            <Icon name="tabler:lock" class="w-4 h-4 shrink-0 mt-0.5 text-brand" aria-hidden="true" />
            Il calcolo avviene solo nel tuo browser: nessun dato viene salvato o inviato.
          </p>
        </form>

        <!-- Risultato -->
        <div class="mt-8 lg:mt-0 lg:col-span-6 lg:sticky lg:top-24" aria-labelledby="titolo-risultato">
          <h2 id="titolo-risultato" class="sr-only">Il tuo risultato</h2>
          <p data-annuncio class="sr-only" aria-live="polite"></p>
          <div class="bg-white rounded-[12px] p-6 md:p-8">
            <p class="inline-flex items-center gap-2 rounded-full bg-brand/10 px-4 py-1.5 text-sm font-semibold text-brand">
              <Icon name="tabler:sparkles" class="w-4 h-4" aria-hidden="true" /><span data-out="badge">Hai il tempo dalla tua parte</span>
            </p>
            <p class="mt-6 text-charcoal">Ogni anno lo Stato ti restituisce circa</p>
            <p class="mt-1 font-playfair text-6xl md:text-7xl leading-none text-ochre-v" data-conta="rimborsoAnno">—</p>
            <p class="mt-4 text-base md:text-lg text-charcoal" data-out="fraseTotale"></p>

            <div class="mt-6 grid grid-cols-2 gap-3 md:gap-4">
              <div class="rounded-[12px] border-2 border-brand/70 p-4">
                <p class="text-xs uppercase tracking-[0.15em] font-semibold text-charcoal/70">Metti da parte</p>
                <p class="mt-2 font-playfair text-3xl text-brand leading-none" data-conta="mensile">—</p>
                <p class="mt-1 text-xs text-charcoal/70">al mese</p>
              </div>
              <div class="rounded-[12px] border-2 p-4 border-ochre-v">
                <p class="text-xs uppercase tracking-[0.15em] font-semibold text-charcoal/70">
                  Ti costa davvero<InfoTip term="Ti costa davvero" text="È quanto spendi al netto del rimborso fiscale." />
                </p>
                <p class="mt-2 font-playfair text-3xl text-charcoal leading-none" data-conta="costoReale">—</p>
                <p class="mt-1 text-xs text-charcoal/70">al mese</p>
              </div>
            </div>
            <p class="mt-4 text-xs text-charcoal/75">Valori indicativi e stimati, arrotondati alle decine di euro.</p>
          </div>

          <!-- Disclaimer sempre visibile sotto i risultati -->
          <div class="mt-4 rounded-[12px] bg-ivory border border-charcoal/10 p-4 md:p-5 text-xs leading-relaxed text-charcoal/80">
            <p>{DISCLAIMER}</p>
            <p class="mt-2"><strong>Fonti:</strong> {FONTI.dlgs252}; {FONTI.bilancio2026}; {FONTI.irpef2026}.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- I TUOI 3 VANTAGGI -->
    <section class="bg-ivory py-14 md:py-20">
      <div class="max-w-6xl mx-auto px-4 md:px-8">
        <SectionTitle class="mb-10 md:mb-14">I tuoi 3 vantaggi</SectionTitle>
        {
          [
            { id: 'tempo', items: vantaggiTempo },
            { id: 'fisco', items: vantaggiFisco },
          ].map((set) => (
            <ul data-set={set.id} hidden={set.id === 'fisco'} class="[&:not([hidden])]:grid md:grid-cols-3 gap-5">
              {set.items.map((v, n) => (
                <li class="bg-white rounded-[12px] p-6 md:p-7 flex flex-col">
                  <span class="w-14 h-14 rounded-full bg-ivory flex items-center justify-center">
                    <Icon name={v.icon} class="w-7 h-7 text-brand [&_*]:stroke-[1.4]" aria-hidden="true" />
                  </span>
                  <h3 class="mt-5 text-lg font-semibold text-charcoal">{v.titolo}</h3>
                  <p class="mt-2 font-playfair text-xl text-ochre-v-dark" data-vantaggio-numero={`${set.id}-${n}`} />
                  <p class="mt-2 text-sm text-charcoal/80 leading-relaxed" data-vantaggio-testo={`${set.id}-${n}`} />
                </li>
              ))}
            </ul>
          ))
        }
        <p class="mt-6 text-xs text-charcoal/70 text-center">
          Parole utili:
          <span class="whitespace-nowrap">dedurre<InfoTip term="dedurre" text="Togliere una cifra dal reddito su cui si calcolano le tasse: per questo ne paghi meno." /></span>
          ·
          <span class="whitespace-nowrap">anni di partecipazione<InfoTip term="anni di partecipazione" text="Gli anni trascorsi da quando hai aderito alla previdenza complementare." /></span>
          ·
          <span class="whitespace-nowrap">pignorabile<InfoTip term="pignorabile" text="Che può essere bloccato da un creditore per recuperare un debito." /></span>
          ·
          <span class="whitespace-nowrap">in capitale<InfoTip term="in capitale" text="Ricevere una somma tutta insieme, invece che a rate mensili." /></span>
        </p>
      </div>
    </section>

    <!-- CHIUSURA -->
    <section class="bg-linen py-14 md:py-20">
      <div class="max-w-3xl mx-auto px-4 md:px-8 text-center">
        <p class="font-playfair text-2xl md:text-3xl text-charcoal leading-snug text-balance" data-out="chiusura"></p>
        <div class="mt-10 flex flex-col items-center gap-5">
          <a href="/contatti?da=pensione" data-parliamone class={btnPrimary}>
            <Icon name="tabler:message-circle" class="w-5 h-5" aria-hidden="true" />Ne parliamo insieme
          </a>
          <button type="button" data-pdf class="inline-flex items-center gap-2 text-sm text-charcoal underline decoration-brand decoration-2 underline-offset-4 hover:text-brand disabled:opacity-60 disabled:cursor-wait">
            <Icon name="tabler:download" class="w-4 h-4" aria-hidden="true" /><span data-pdf-label>Scarica il riepilogo PDF</span>
          </button>
          <p data-pdf-stato class="text-sm text-charcoal/80 min-h-[1.25rem]" role="status"></p>
        </div>

        <details class="group mt-10 text-left bg-white rounded-[12px] border border-brand/20">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-5 md:p-6 font-semibold text-charcoal [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-3"><Icon name="tabler:info-circle" class="w-5 h-5 text-brand" aria-hidden="true" />Come funziona il calcolo</span>
            <Icon name="tabler:chevron-down" class="w-5 h-5 text-brand transition-transform group-open:rotate-180" aria-hidden="true" />
          </summary>
          <ul class="px-5 md:px-6 pb-6 space-y-3 text-sm md:text-base text-charcoal/85 leading-relaxed list-disc pl-10 md:pl-11">
            <li>
              <strong>Rimborso annuo:</strong> quanto versi in un anno, fino a {nf(DEDUCIBILITA_MAX)} €, moltiplicato per l’aliquota
              della tua fascia di reddito (23%, 33% o 43%).
            </li>
            <li><strong>Ti costa davvero:</strong> quanto metti da parte al mese, meno un dodicesimo del rimborso annuo.</li>
            <li><strong>Totale:</strong> il rimborso annuo moltiplicato per gli anni che mancano ai {ETA_PENSIONE} anni.</li>
            <li>
              <strong>Tassazione in uscita:</strong> 15%, ridotta di 0,30 punti per ogni anno di partecipazione oltre il quindicesimo,
              fino al 9%.
            </li>
            <li>
              <strong>Altre regole citate:</strong> anticipazione fino al {ANTICIPAZIONE_CASA.percentualeMax}% per la prima casa dopo
              {ANTICIPAZIONE_CASA.dopoAnni} anni; deduzione aggiuntiva fino a {nf(EXTRA_DEDUZIONE_GIOVANI.importo)} € l’anno per chi ha
              iniziato a lavorare dal {EXTRA_DEDUZIONE_GIOVANI.primaOccupazioneDal}; ritiro in capitale fino al {CAPITALE_MAX_USCITA}%.
            </li>
            <li>Il profilo cambia a {SOGLIA_PROFILO} anni: prima conta di più il tempo, dopo il vantaggio fiscale.</li>
            <li>
              <strong>Semplificazioni:</strong> non consideriamo alcuna ipotesi di crescita del capitale, le addizionali regionali e
              comunali, le detrazioni e la capienza d’imposta (cioè se le tue tasse sono abbastanza alte da ricevere tutto il
              rimborso).
            </li>
            <li><strong>Fonti:</strong> {FONTI.dlgs252}; {FONTI.bilancio2026}; {FONTI.irpef2026}.</li>
          </ul>
        </details>
      </div>
    </section>
  </div>
</SiteLayout>

<style is:global>
  .text-ochre-v {
    color: #9a5f22;
  }
  .text-ochre-v-dark {
    color: #8a5520;
  }
  .border-ochre-v {
    border-color: #d9984f;
  }
  .vp-range {
    appearance: none;
    -webkit-appearance: none;
    height: 32px;
    background: transparent;
    accent-color: #006937;
    --p: 50%;
  }
  .vp-range::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(to right, #006937 var(--p), #ece3d4 var(--p));
  }
  .vp-range::-moz-range-track {
    height: 6px;
    border-radius: 999px;
    background: #ece3d4;
  }
  .vp-range::-moz-range-progress {
    height: 6px;
    border-radius: 999px;
    background: #006937;
  }
  .vp-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 28px;
    height: 28px;
    margin-top: -11px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid #006937;
    box-shadow: 0 2px 6px rgba(0, 40, 22, 0.2);
  }
  .vp-range::-moz-range-thumb {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid #006937;
  }
</style>

<script>
  import { onPageLoad } from '~/scripts/page-load';
  import { calcola, type FasciaId, type Input } from '~/lib/previdenza';
  import { BADGE, eur, fraseChiusura, vantaggi } from '~/lib/vantaggi';
  import { euro } from '~/lib/formato';
  import { FASCE } from '~/data/previdenza';

  function init() {
    const root = document.querySelector<HTMLElement>('[data-vantaggi]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const form = q<HTMLFormElement>('[data-form]');
    const eta = q<HTMLInputElement>('#v-eta');
    const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ultimo: { input: Input; r: ReturnType<typeof calcola> } | null = null;
    let timer: number | undefined;

    const set = (k: string, v: string) => root.querySelectorAll<HTMLElement>(`[data-out="${k}"]`).forEach((el) => (el.textContent = v));
    const radio = (n: string) => (form.elements.namedItem(n) as RadioNodeList).value;

    function conta(k: string, valore: number, fmt = eur) {
      root.querySelectorAll<HTMLElement>(`[data-conta="${k}"]`).forEach((el) => {
        const da = Number(el.dataset.v ?? 0);
        el.dataset.v = String(valore);
        if (ridotto || da === valore || !el.textContent || el.textContent === '—') {
          el.textContent = fmt(valore);
          return;
        }
        const t0 = performance.now();
        const step = (t: number) => {
          const p = Math.min(1, (t - t0) / 450);
          el.textContent = fmt(da + (valore - da) * (1 - Math.pow(1 - p, 3)));
          if (p < 1 && el.dataset.v === String(valore)) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }

    function aggiorna() {
      const input: Input = { eta: Number(eta.value), fascia: radio('fascia') as FasciaId, mensile: Number(radio('mensile')) };
      const r = calcola(input);
      ultimo = { input, r };

      set('eta', eta.value);
      eta.style.setProperty('--p', `${((Number(eta.value) - Number(eta.min)) / (Number(eta.max) - Number(eta.min))) * 100}%`);
      set('badge', BADGE[r.profilo]);
      conta('rimborsoAnno', r.rimborsoAnno);
      // L'importo scelto resta esatto (es. 442 €), gli altri valori sono arrotondati alle decine
      conta('mensile', input.mensile, (v) => euro(v, 1));
      conta('costoReale', r.costoReale);
      set('fraseTotale', `In ${r.anni} anni fanno circa ${eur(r.rimborsoTotale)} di tasse in meno.`);
      set('chiusura', fraseChiusura(r));

      root.querySelectorAll<HTMLElement>('[data-set]').forEach((ul) => (ul.hidden = ul.dataset.set !== r.profilo));
      vantaggi(r).forEach((v, n) => {
        const num = root.querySelector(`[data-vantaggio-numero="${r.profilo}-${n}"]`);
        const txt = root.querySelector(`[data-vantaggio-testo="${r.profilo}-${n}"]`);
        if (num) num.textContent = v.numero;
        if (txt) txt.textContent = v.testo;
      });

      const fascia = FASCE.find((f) => f.id === input.fascia)!;
      const params = new URLSearchParams({
        da: 'pensione',
        eta: String(input.eta),
        fascia: fascia.breve,
        mensile: String(input.mensile),
        rimborso: String(Math.round(r.rimborsoAnno / 10) * 10),
      });
      q<HTMLAnchorElement>('[data-parliamone]').href = `/contatti?${params}`;

      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        q('[data-annuncio]').textContent = `${BADGE[r.profilo]}. Ogni anno lo Stato ti restituisce circa ${eur(r.rimborsoAnno)}. Ti costa davvero ${eur(r.costoReale)} al mese.`;
      }, 700);
    }

    form.addEventListener('input', aggiorna);
    form.addEventListener('change', aggiorna);
    form.addEventListener('submit', (e) => e.preventDefault());

    const pdfBtn = q<HTMLButtonElement>('[data-pdf]');
    const pdfLabel = q('[data-pdf-label]');
    const pdfStato = q('[data-pdf-stato]');
    pdfBtn.addEventListener('click', async () => {
      if (!ultimo) return;
      pdfBtn.disabled = true;
      pdfLabel.textContent = 'Preparo il riepilogo…';
      pdfStato.textContent = '';
      try {
        const { creaRiepilogo, scaricaPdf } = await import('~/lib/report-vantaggi');
        const { blob, nomeFile } = await creaRiepilogo({
          input: ultimo.input,
          risultato: ultimo.r,
          qrDataUrl: root.dataset.qr ?? '',
          logoUrl: '/logo-firma.jpeg',
          contatti: { telefono: root.dataset.telefono ?? '', email: root.dataset.email ?? '' },
          qualifica: root.dataset.qualifica ?? '',
        });
        scaricaPdf(blob, nomeFile);
        pdfStato.textContent = 'Il tuo riepilogo è pronto.';
      } catch (err) {
        console.error(err);
        pdfStato.textContent = 'Il riepilogo richiede un nuovo tentativo: riprova tra poco.';
      } finally {
        pdfBtn.disabled = false;
        pdfLabel.textContent = 'Scarica il riepilogo PDF';
      }
    });

    aggiorna();
  }

  onPageLoad(init);
</script>
