---
import SiteLayout from '~/components/site/SiteLayout.astro';
import HomeHero from '~/components/home/HomeHero.astro';
import HomeCertificazioni from '~/components/home/HomeCertificazioni.astro';
import HomeSpecializzazioni from '~/components/home/HomeSpecializzazioni.astro';
import HomeBlog from '~/components/home/HomeBlog.astro';
import HomeImprese from '~/components/home/HomeImprese.astro';
import SectionTitle from '~/components/site/SectionTitle.astro';

import { findLatestPosts } from '~/utils/blog';

const metadata = {
  title: 'Andrea Giardini | Consulente Finanziario di Fideuram',
  ignoreTitleTemplate: true,
  description:
    "Andrea Giardini, Consulente Finanziario abilitato all'offerta fuori sede di Fideuram – Intesa Sanpaolo Private Banking. Ti affianco nella pianificazione dei tuoi obiettivi di vita.",
}

const latestPosts = await findLatestPosts({ count: 3 });
---

<SiteLayout metadata={metadata}>
  <!-- 2. HERO -->
  <HomeHero />

  <!-- 3. TI RACCONTO QUALCOSA DI ME -->
  <section id="chi-sono" class="bg-white py-16 md:py-24 scroll-mt-16 md:scroll-mt-20">
    <div class="max-w-5xl mx-auto px-4 md:px-8 grid lg:grid-cols-[5fr_6fr] gap-6 lg:gap-16 items-center">
      <div class="reveal text-center lg:text-left">
        <span aria-hidden="true" class="inline-block w-10 h-[3px] bg-ember mb-6"></span>
        <SectionTitle size="lg" align="left" class="text-center lg:text-left">
          Ti racconto qualcosa di me.
        </SectionTitle>
      </div>
      <p class="reveal text-base md:text-lg text-charcoal/85 leading-relaxed text-center lg:text-left lg:border-l lg:border-charcoal/10 lg:pl-12 max-w-2xl mx-auto lg:mx-0">
        Ti accompagno nella costruzione di un percorso su misura per i tuoi obiettivi di vita. Ascolto i tuoi progetti, li
        trasformo in un piano chiaro e resto al tuo fianco in ogni fase, con attenzione, metodo e continuità.
      </p>
    </div>
  </section>

  <!-- 4. LE MIE CERTIFICAZIONI -->
  <HomeCertificazioni />

  <!-- 5. LE MIE AREE DI SPECIALIZZAZIONE -->
  <HomeSpecializzazioni />

  <!-- 6. FASCIA IMPRENDITORI -->
  <HomeImprese />

  <!-- 7. ULTIME NOTIZIE DAL BLOG -->
  <HomeBlog posts={latestPosts} />
</SiteLayout>

