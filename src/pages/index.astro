---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Andrea Giardini — Consulente Finanziario',
  description:
    'Costruiamo insieme un piano finanziario chiaro e su misura. Diagnosi gratuita del portafoglio, pianificazione patrimoniale, previdenza. Iscritto OCF n. 2965.',
};

// 4 pilastri del progetto
const pilastri = [
  {
    icon: 'file',
    title: 'Articoli',
    description: 'Approfondimenti scritti su temi di educazione finanziaria, mercati, strumenti.',
    href: '#',
  },
  {
    icon: 'calculator',
    title: 'Calcolatori',
    description: 'Strumenti interattivi per pensione, interesse composto, inflazione.',
    href: '/calcolatori',
  },
  {
    icon: 'chart',
    title: 'Diagnosi di portafoglio',
    description: 'Analisi gratuita e imparziale del tuo portafoglio investimenti.',
    href: '/richiedi-diagnosi',
  },
  {
    icon: 'news',
    title: 'News',
    description: 'Aggiornamenti curati sui principali eventi di mercato ed economia.',
    href: '#',
  },
];

// Servizi (4 card)
const servizi = [
  {
    icon: 'search',
    title: 'Diagnosi di Portafoglio',
    description: 'Analisi gratuita e imparziale dei tuoi investimenti. Costi, rischi, rendimenti attesi.',
    href: '/servizi/diagnosi',
    cta: 'Scopri di più',
  },
  {
    icon: 'trending',
    title: 'Pianificazione Finanziaria',
    description: 'Un piano personalizzato per i tuoi obiettivi di vita: casa, figli, pensione.',
    href: '/servizi/pianificazione',
    cta: 'Scopri di più',
  },
  {
    icon: 'clock',
    title: 'Previdenza Complementare',
    description: "L'evoluzione che sta subendo il mondo delle pensioni rende questo servizio necessario.",
    href: '/servizi/previdenza',
    cta: 'Scopri di più',
  },
];
---

<Layout metadata={metadata}>

  <!-- =========================================================
       1. HERO CORTO — video sx + testo dx + 2 CTA
       ========================================================= -->
  <section class="bg-[rgb(238_247_246)] py-12 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">

        <!-- Video placeholder sx -->
        <div class="hero-anim hero-anim-4 relative aspect-video bg-gradient-to-br from-[rgb(22_105_99)] to-[rgb(14_74_69)] rounded-md overflow-hidden shadow-xl group cursor-pointer">
          <div class="absolute top-4 left-4 right-4 flex items-start gap-3 z-10">
            <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4"/>
                <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
              </svg>
            </div>
            <div class="text-white">
              <p class="text-sm font-bold font-heading leading-tight">Benvenuto</p>
              <p class="text-xs opacity-75">Andrea Giardini | Consulente Finanziario</p>
            </div>
          </div>

          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-red-600 flex items-center justify-center shadow-2xl group-hover:scale-105 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="white">
                <polygon points="6 4 20 12 6 20 6 4"/>
              </svg>
            </div>
          </div>

          <div class="absolute bottom-4 right-4 bg-black/80 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1.5">
            <span class="opacity-80">Guarda su</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#FF0000">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span>YouTube</span>
          </div>

          <div class="absolute inset-0 flex items-end justify-start p-4 pointer-events-none">
            <span class="text-[10px] tracking-[0.3em] uppercase text-white/50">Video placeholder</span>
          </div>
        </div>

        <!-- Testo dx -->
        <div>
          <h1 class="hero-anim hero-anim-1 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--aw-color-text-heading)] mb-6 leading-[1.15] font-heading">
            Il tuo futuro finanziario, costruito con metodo e chiarezza.
          </h1>

          <div class="hero-anim hero-anim-2 space-y-4 text-base md:text-lg text-[var(--aw-color-text-default)] leading-relaxed mb-8">
            <p>
              Sono <strong class="text-[var(--aw-color-primary)]">Andrea Giardini</strong>, consulente finanziario.
              Aiuto persone e famiglie a mettere ordine nelle proprie finanze: ridurre i <strong class="text-[var(--aw-color-primary)]">costi nascosti</strong> del portafoglio,
              pianificare gli <strong class="text-[var(--aw-color-primary)]">obiettivi</strong> di vita e costruire una strategia che regge nel tempo.
            </p>
            <p>
              Il primo passo è una <a href="/servizi/diagnosi" class="text-[var(--aw-color-primary)] underline underline-offset-2 font-semibold hover:text-[var(--aw-color-accent)] transition-colors">diagnosi gratuita del tuo portafoglio</a> —
              senza impegno, senza costi, con un report chiaro e comprensibile.
            </p>
          </div>

          <!-- 2 CTA -->
          <div class="hero-anim hero-anim-3 flex flex-col sm:flex-row gap-3">
            <a
              href="/richiedi-diagnosi"
              class="flex-1 px-6 py-4 bg-[var(--aw-color-primary)] hover:bg-[var(--aw-color-secondary)] text-white text-base md:text-lg font-bold rounded-sm text-center transition-all hover:shadow-xl hover:-translate-y-0.5 font-heading"
            >
              Richiedi diagnosi gratuita
            </a>
            <a
              href="/chi-sono"
              class="flex-1 px-6 py-4 bg-transparent border-2 border-[var(--aw-color-primary)] hover:bg-[var(--aw-color-primary)] hover:text-white text-[var(--aw-color-primary)] text-base md:text-lg font-bold rounded-sm flex items-center justify-center transition-all font-heading"
            >
              Scopri chi sono
            </a>
          </div>

          <p class="hero-anim hero-anim-3 text-xs text-[var(--aw-color-text-muted)] mt-5 leading-relaxed">
            Consulente finanziario <strong class="text-[var(--aw-color-primary)]">abilitato</strong> <strong class="text-[var(--aw-color-primary)]">OCF</strong> n. 2965 · Soggetto autorizzato e vigilato.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================
       3. IL PROGETTO — 4 pilastri icone
       ========================================================= -->
  <section class="bg-[rgb(238_247_246)] py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="reveal max-w-3xl mx-auto text-center mb-14">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--aw-color-text-heading)] mb-6 leading-tight font-heading">
          Il progetto
        </h2>
        <p class="text-base md:text-lg text-[var(--aw-color-text-default)] leading-relaxed">
          La finanza non dovrebbe essere un privilegio di pochi o un labirinto incomprensibile.
          Questo progetto nasce per portare <strong class="text-[var(--aw-color-primary)]">educazione finanziaria</strong> concreta a chiunque voglia
          capire come far lavorare i propri soldi — con strumenti pratici, contenuti chiari e
          la possibilità di ricevere una guida professionale quando ne hai bisogno.
        </p>
      </div>

      <div class="reveal-stagger grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 mb-12">
        {pilastri.map((p) => (
          <a
            href={p.href}
            class="reveal group flex flex-col items-center text-center p-6 md:p-8 bg-white rounded-md shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all"
          >
            <!-- Icona -->
            <div class="mb-5 w-16 h-16 md:w-20 md:h-20 rounded-full bg-[var(--aw-color-primary)]/10 flex items-center justify-center group-hover:bg-[var(--aw-color-primary)]/20 transition-colors">
              {p.icon === 'file' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="8" y1="13" x2="16" y2="13"/>
                  <line x1="8" y1="17" x2="14" y2="17"/>
                </svg>
              )}
              {p.icon === 'calculator' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="2" width="16" height="20" rx="2"/>
                  <line x1="8" y1="6" x2="16" y2="6"/>
                  <line x1="8" y1="10" x2="10" y2="10"/>
                  <line x1="12" y1="10" x2="14" y2="10"/>
                  <line x1="16" y1="10" x2="16" y2="10"/>
                  <line x1="8" y1="14" x2="10" y2="14"/>
                  <line x1="12" y1="14" x2="14" y2="14"/>
                  <line x1="16" y1="14" x2="16" y2="14"/>
                  <line x1="8" y1="18" x2="10" y2="18"/>
                  <line x1="12" y1="18" x2="16" y2="18"/>
                </svg>
              )}
              {p.icon === 'chart' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 17 9 11 13 15 21 7"/>
                  <polyline points="14 7 21 7 21 14"/>
                </svg>
              )}
              {p.icon === 'news' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
                  <path d="M18 14h-8"/>
                  <path d="M15 18h-5"/>
                  <path d="M10 6h8v4h-8V6Z"/>
                </svg>
              )}
            </div>

            <h3 class="text-base md:text-lg font-bold text-[var(--aw-color-text-heading)] mb-2 leading-tight font-heading">
              {p.title}
            </h3>
            <p class="text-xs md:text-sm text-[var(--aw-color-text-muted)] leading-relaxed">
              {p.description}
            </p>
          </a>
        ))}
      </div>

      <!-- CTA Inizia ora -->
      <div class="reveal text-center">
        <a
          href="/richiedi-diagnosi"
          class="inline-block px-10 py-4 bg-[var(--aw-color-primary)] hover:bg-[var(--aw-color-secondary)] text-white text-lg font-bold rounded-sm transition-all hover:shadow-xl hover:-translate-y-0.5 font-heading"
        >
          Inizia ora!
        </a>
      </div>

    </div>
  </section>

  <!-- =========================================================
       4. BIO BREVE — foto dx + testo sx
       ========================================================= -->
  <section class="bg-white py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">

        <!-- Testo sx -->
        <div class="reveal">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--aw-color-text-heading)] mb-3 leading-tight font-heading">
            Andrea Giardini
          </h2>
          <p class="text-base md:text-lg font-semibold text-[var(--aw-color-accent)] mb-6 tracking-wide">
            Consulente Finanziario
          </p>

          <p class="text-base md:text-lg text-[var(--aw-color-text-default)] leading-relaxed mb-8">
            Affianco persone e famiglie nella <strong class="text-[var(--aw-color-primary)]">pianificazione finanziaria</strong> con un <strong class="text-[var(--aw-color-primary)]">metodo</strong> chiaro, <strong class="text-[var(--aw-color-primary)]">trasparente</strong> e costruito sui loro <strong class="text-[var(--aw-color-primary)]">obiettivi</strong> di vita — proteggere il <strong class="text-[var(--aw-color-primary)]">patrimonio</strong>, pianificare il futuro, vivere con più <strong class="text-[var(--aw-color-primary)]">serenità</strong>.
          </p>

          <!-- 2 CTA piccole -->
          <div class="flex flex-wrap gap-3">
            <a
              href="/chi-sono"
              class="px-6 py-3 bg-[var(--aw-color-primary)] hover:bg-[var(--aw-color-secondary)] text-white font-semibold rounded-sm transition-colors"
            >
              Chi sono
            </a>
            <a
              href="/come-lavoro"
              class="px-6 py-3 border-2 border-[var(--aw-color-primary)] hover:bg-[var(--aw-color-primary)] hover:text-white text-[var(--aw-color-primary)] font-semibold rounded-sm transition-colors"
            >
              Come lavoro
            </a>
          </div>
        </div>

        <!-- Foto placeholder dx -->
        <div class="reveal flex items-center justify-center">
          <div class="relative w-full max-w-sm aspect-[3/4] rounded-md overflow-hidden shadow-xl bg-gradient-to-br from-[var(--aw-color-primary)] to-[rgb(22_105_99)]">
            <div class="absolute inset-0 flex flex-col items-center justify-center text-white/70 p-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mb-4">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 22v-2a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v2"/>
              </svg>
              <p class="text-xs tracking-[0.3em] uppercase text-white/60">Foto Andrea Giardini</p>
              <p class="text-[10px] tracking-[0.2em] uppercase text-white/40 mt-2">In arrivo</p>
            </div>
            <div class="absolute inset-0 border-2 border-[var(--aw-color-accent)]/30 rounded-md pointer-events-none"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================
       6. 4 SERVIZI — grid cards con CTA
       ========================================================= -->
  <section class="bg-[rgb(238_247_246)] py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <h2 class="reveal text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--aw-color-text-heading)] text-center mb-14 leading-tight font-heading">
        Servizi
      </h2>

      <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8 max-w-4xl mx-auto">
        {servizi.map((s) => (
          <div class="reveal flex flex-col bg-white rounded-md p-7 md:p-8 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all">
            <!-- Icona -->
            <div class="w-14 h-14 rounded-full bg-[var(--aw-color-primary)]/10 flex items-center justify-center mb-5">
              {s.icon === 'search' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7"/>
                  <line x1="21" y1="21" x2="16.5" y2="16.5"/>
                  <text x="11" y="14" text-anchor="middle" font-size="8" font-weight="700" fill="var(--aw-color-primary)" stroke="none">€</text>
                </svg>
              )}
              {s.icon === 'trending' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 17 9 11 13 15 21 7"/>
                  <polyline points="14 7 21 7 21 14"/>
                </svg>
              )}
              {s.icon === 'clock' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              )}
              {s.icon === 'bank' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="3 10 12 4 21 10 21 11 3 11 3 10"/>
                  <line x1="6" y1="11" x2="6" y2="18"/>
                  <line x1="10" y1="11" x2="10" y2="18"/>
                  <line x1="14" y1="11" x2="14" y2="18"/>
                  <line x1="18" y1="11" x2="18" y2="18"/>
                  <line x1="3" y1="21" x2="21" y2="21"/>
                </svg>
              )}
            </div>

            <h3 class="text-lg md:text-xl font-bold text-[var(--aw-color-text-heading)] mb-3 leading-tight font-heading">
              {s.title}
            </h3>
            <p class="text-sm text-[var(--aw-color-text-default)] leading-relaxed mb-6 flex-1">
              {s.description}
            </p>

            <a
              href={s.href}
              class="inline-flex items-center gap-2 text-[var(--aw-color-primary)] font-semibold hover:text-[var(--aw-color-accent)] transition-colors"
            >
              <span>{s.cta}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =========================================================
       7. BANNER DIAGNOSI — full width sage
       ========================================================= -->
  <section class="bg-[var(--aw-color-primary)] py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="reveal grid md:grid-cols-[1fr_auto] gap-8 items-center">

        <div class="text-center md:text-left">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-3 leading-tight font-heading">
            Richiedi una diagnosi di portafoglio
          </h2>
        </div>

        <a
          href="/richiedi-diagnosi"
          class="px-10 py-5 bg-white text-[var(--aw-color-primary)] text-lg font-bold rounded-sm hover:bg-[var(--aw-color-accent)] hover:text-white transition-colors text-center font-heading shadow-lg"
        >
          Online e gratuita
        </a>

      </div>
    </div>
  </section>

  <!-- =========================================================
       8. CONTATTI — split
       ========================================================= -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">

        <!-- Testo sx -->
        <div class="reveal">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--aw-color-text-heading)] mb-8 leading-tight font-heading">
            Mettiti in contatto
          </h2>

          <p class="text-base md:text-lg text-[var(--aw-color-text-default)] leading-relaxed mb-8">
            Per contattarmi visita la <a href="/contatti" class="text-[var(--aw-color-primary)] underline font-semibold hover:text-[var(--aw-color-accent)] transition-colors">sezione contatti</a> e compila la form oppure chiamami o mandami una mail.
          </p>

          <div class="space-y-4">
            <a href="tel:+393515456845" class="flex items-center gap-3 text-base md:text-lg text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-primary)] transition-colors">
              <div class="w-10 h-10 rounded-full bg-[var(--aw-color-primary)]/10 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <span class="font-semibold">+39 351 545 6845</span>
            </a>

            <a href="mailto:andrea@giardiniconsulenza.it" class="flex items-center gap-3 text-base md:text-lg text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-primary)] transition-colors">
              <div class="w-10 h-10 rounded-full bg-[var(--aw-color-primary)]/10 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <span class="font-semibold break-all">andrea@giardiniconsulenza.it</span>
            </a>
          </div>
        </div>

        <!-- Mappa/foto studio placeholder dx -->
        <div class="reveal flex items-center justify-center">
          <div class="relative w-full aspect-[4/3] rounded-md overflow-hidden shadow-xl bg-gradient-to-br from-[rgb(238_247_246)] to-[rgb(221_240_238)]">
