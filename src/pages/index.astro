---
import SiteLayout from '~/components/site/SiteLayout.astro';
import HomeHero from '~/components/home/HomeHero.astro';
import HomeCertificazioni from '~/components/home/HomeCertificazioni.astro';
import HomeSpecializzazioni from '~/components/home/HomeSpecializzazioni.astro';
import HomeBlog from '~/components/home/HomeBlog.astro';
import SectionTitle from '~/components/site/SectionTitle.astro';

import { findLatestPosts } from '~/utils/blog';

const metadata = {
  title: 'Andrea Giardini — Consulente Finanziario',
  ignoreTitleTemplate: true,
  description:
    'Costruiamo insieme un piano finanziario chiaro e su misura. Diagnosi gratuita del portafoglio, pianificazione patrimoniale, previdenza. Iscritto OCF n. 2965.',
};

const latestPosts = await findLatestPosts({ count: 3 });
---

<SiteLayout metadata={metadata}>
  <!-- 2. HERO -->
  <HomeHero />

  <!-- 3. TI RACCONTO QUALCOSA DI ME -->
  <section id="chi-sono" class="bg-ivory pt-12 md:pt-20 lg:pt-0 pb-4 md:pb-8 scroll-mt-16 md:scroll-mt-20">
    <div class="max-w-5xl mx-auto px-4 md:px-8">
      <div
        class="reveal relative bg-white px-6 py-10 md:px-14 md:py-16 text-center lg:text-left lg:-mt-16 shadow-[0_20px_50px_-30px_rgba(0,40,22,0.35)]"
      >
        <span aria-hidden="true" class="absolute left-0 top-10 bottom-10 hidden lg:block w-[3px] bg-sand"></span>
        <SectionTitle size="lg" align="left" class="mb-6 md:mb-8 text-center lg:text-left">
          Ti racconto<span class="lg:hidden">&nbsp;</span><br class="hidden lg:block" />qualcosa di me.
        </SectionTitle>
        <p class="text-base md:text-lg text-charcoal leading-relaxed max-w-3xl mx-auto lg:mx-0">
          Ti accompagno nella costruzione di un percorso su misura per i tuoi obiettivi di vita. Ascolto i tuoi progetti,
          li trasformo in un piano chiaro e resto al tuo fianco in ogni fase, con attenzione, metodo e continuità.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. LE MIE CERTIFICAZIONI -->
  <HomeCertificazioni />

  <!-- 5. LE MIE AREE DI SPECIALIZZAZIONE -->
  <HomeSpecializzazioni />

  <!-- 6. ULTIME NOTIZIE DAL BLOG -->
  <HomeBlog posts={latestPosts} />
</SiteLayout>

