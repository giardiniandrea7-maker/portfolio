---
import Layout from '~/layouts/PageLayout.astro';
import VoceCard from '~/components/glossario/VoceCard.astro';
import CategoriaIcon from '~/components/glossario/CategoriaIcon.astro';
import MarkdownInline from '~/components/glossario/MarkdownInline.astro';
import {
  CATEGORIE,
  CATEGORIE_VISUAL_IDENTITY,
  LIVELLI,
  getVociPubblicate,
  getVociAlfabetiche,
  getNeighbors,
  getCorrelate,
  type VoceGlossario,
} from '~/data/glossario';

// La numerazione progressiva NON viene piu' mostrata sulla pagina
// dettaglio (rimane solo nelle card hub per orientamento). La mappa
// resta utile per le card 'Termini correlati' che mostrano il numero.
const TOTALE_PIANIFICATE = 100;
const numerazione = new Map<string, number>();
getVociAlfabetiche().forEach((v, i) => numerazione.set(v.slug, i + 1));

export async function getStaticPaths() {
  return getVociPubblicate().map((voce) => ({
    params: { slug: voce.slug },
    props: { voce },
  }));
}

interface Props {
  voce: VoceGlossario;
}

const { voce } = Astro.props;
const liv = LIVELLI[voce.livello];
const ident = CATEGORIE_VISUAL_IDENTITY[voce.categoria];
const { prev, next } = getNeighbors(voce.slug);
const correlate = getCorrelate(voce.slug);

const canonicalUrl = `https://giardiniconsulenza.it/glossario/${voce.slug}`;
const metadata = {
  title: `${voce.titolo} | Glossario | Andrea Giardini`,
  description: voce.metaDescription,
  canonical: canonicalUrl,
};

// Schema.org DefinedTerm: usa la frase essenziale come definizione (testo
// pulito, senza markdown), come da spec.
function stripMarkdown(s: string): string {
  return s
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  '@id': canonicalUrl,
  name: voce.titolo,
  alternateName: voce.sigla,
  description: stripMarkdown(voce.fraseEssenziale),
  url: canonicalUrl,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'Glossario finanziario di Andrea Giardini',
    url: 'https://giardiniconsulenza.it/glossario',
  },
};

const livelloBadgeClass = {
  sage:  'bg-[var(--aw-color-primary)]/10 text-[var(--aw-color-primary)] border-[var(--aw-color-primary)]/30',
  ochre: 'bg-[var(--aw-color-accent)]/15 text-[var(--aw-color-accent)] border-[var(--aw-color-accent)]/30',
  red:   'bg-[rgba(192,57,43,0.10)] text-[#A04032] border-[#c0392b]/30',
}[liv.color];

// Indice della sidebar (target ID + label visibile).
const sidebarSezioni = [
  { id: 'livello-1-essenziale', label: 'La frase essenziale' },
  { id: 'livello-2-esempio',    label: 'Esempio' },
  { id: 'livello-3-perche',     label: 'Perché ti riguarda' },
  { id: 'livello-4-tecnica',    label: 'Definizione tecnica' },
  { id: 'livello-5-errori',     label: 'Errori comuni' },
];
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="bg-white">

    <!-- Bordo superiore 4px nel colore categoria -->
    <div
      aria-hidden="true"
      class="h-1"
      style={`background-color: ${ident.accent};`}
    ></div>

    <!-- ===================== BREADCRUMB ===================== -->
    <nav aria-label="Breadcrumb" class="bg-white border-b border-[var(--aw-color-primary)]/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-[var(--aw-color-text-muted)]">
          <li><a href="/" class="hover:text-[var(--aw-color-primary)] transition-colors">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/glossario" class="hover:text-[var(--aw-color-primary)] transition-colors">Glossario</a></li>
          <li aria-hidden="true">›</li>
          <li class="text-[var(--aw-color-text-heading)] font-medium" aria-current="page">{voce.titolo}</li>
        </ol>
      </div>
    </nav>

    <!-- ===================== HEADER VOCE ===================== -->
    <header class="bg-white pt-10 md:pt-14 pb-6">
      <div class="reveal max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Categoria + livello prominentemente, sopra il titolo -->
        <div class="flex flex-wrap items-center gap-3 mb-5">
          <span
            class="inline-flex items-center gap-2 text-sm font-medium px-3 py-1 rounded-full border"
            style={`background-color: ${ident.accentSoft}; border-color: ${ident.accent}; color: ${ident.accent};`}
          >
            <CategoriaIcon iconKey={ident.iconKey} size={16} />
            {CATEGORIE[voce.categoria]}
          </span>
          <span class:list={['inline-flex items-center gap-1 text-[11px] font-semibold tracking-wide px-2.5 py-1 rounded-full border', livelloBadgeClass]}>
            <span aria-hidden="true">{liv.emoji}</span>
            <span>{liv.label}</span>
          </span>
        </div>

        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight text-[var(--aw-color-text-heading)] leading-[1.1] mb-2">
          {voce.titolo}
        </h1>

        {voce.sigla && (
          <p class="text-lg md:text-xl text-[var(--aw-color-primary)] font-medium">
            {voce.sigla}
          </p>
        )}
      </div>
    </header>

    <!-- ===================== LAYOUT 75/25 ===================== -->
    <div class="bg-white pb-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-12 xl:gap-16">

          <!-- ============ COLONNA PRINCIPALE: 5 LIVELLI ============ -->
          <main>

            <!-- Mobile / tablet: indice in cima come accordion -->
            <details class="lg:hidden mb-10 rounded-2xl border border-[var(--aw-color-primary)]/15 bg-[rgb(238_247_246)]/50 overflow-hidden group">
              <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <span class="font-display text-base font-medium text-[var(--aw-color-text-heading)]">
                  In questa voce
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--aw-color-primary)] transition-transform group-open:rotate-180" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>
              <ul class="px-5 pb-5 space-y-2">
                {sidebarSezioni.map((s) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      class="block text-sm text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-primary)] transition-colors py-1"
                    >
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>

            <!-- LIVELLO 1 — Frase essenziale: pull quote drammatico -->
            <section
              id="livello-1-essenziale"
              data-spy-section
              class="reveal relative scroll-mt-28 rounded-3xl bg-[rgb(238_247_246)] p-8 md:p-12 lg:p-16 mt-0"
              aria-label="La frase essenziale"
            >
              <!-- Virgolette decorative -->
              <span
                aria-hidden="true"
                class="absolute -top-2 left-6 md:left-10 font-display text-7xl md:text-9xl leading-none text-[var(--aw-color-primary)]/25 select-none"
              >“</span>

              <MarkdownInline
                as="p"
                text={voce.fraseEssenziale}
                class="font-display italic text-2xl md:text-3xl lg:text-4xl text-[var(--aw-color-text-heading)] leading-snug pl-2 md:pl-4"
              />
            </section>

            <!-- LIVELLO 2 — Esempio concreto: etichetta + flow narrativo -->
            <section
              id="livello-2-esempio"
              data-spy-section
              class="reveal scroll-mt-28 mt-16 max-w-3xl"
              aria-label="Esempio concreto"
            >
              <div class="flex items-center gap-3 mb-5">
                <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[#00A652]">
                  Esempio
                </span>
                <span aria-hidden="true" class="flex-grow h-px bg-[#00A652]/30 max-w-[120px]"></span>
              </div>
              <MarkdownInline
                as="p"
                text={voce.esempioConcreto}
                class="text-lg text-[var(--aw-color-text-default)] leading-relaxed"
              />
            </section>

            <!-- LIVELLO 3 — Perche' ti riguarda: citazione importante -->
            <section
              id="livello-3-perche"
              data-spy-section
              class="reveal scroll-mt-28 mt-16 max-w-3xl pl-6 md:pl-8 border-l-4 border-[#00A652]"
              aria-label="Perché ti riguarda"
            >
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--aw-color-text-heading)]/70 mb-4">
                Perché ti riguarda
              </p>
              <MarkdownInline
                as="p"
                text={voce.perchéTiRiguarda}
                class="text-lg text-[var(--aw-color-text-heading)] leading-relaxed"
              />
            </section>

            <!-- LIVELLO 4 — Definizione tecnica: box charcoal/5 -->
            <section
              id="livello-4-tecnica"
              data-spy-section
              class="reveal scroll-mt-28 mt-16 rounded-2xl bg-[rgba(55,61,66,0.05)] p-7 md:p-10"
              aria-label="Definizione tecnica"
            >
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--aw-color-text-heading)]/60 mb-3">
                Per chi vuole approfondire
              </p>
              <h3 class="font-display text-xl md:text-2xl font-medium text-[var(--aw-color-text-heading)] mb-5">
                La definizione tecnica
              </h3>
              <MarkdownInline
                as="p"
                text={voce.definizioneTecnica}
                class="text-base text-[var(--aw-color-text-default)] leading-relaxed"
              />
            </section>

            <!-- LIVELLO 5 — Errori comuni: lista warning ochre/5 -->
            <section
              id="livello-5-errori"
              data-spy-section
              class="reveal scroll-mt-28 mt-16 rounded-2xl bg-[rgba(171,127,98,0.06)] p-7 md:p-10"
              aria-label="Errori comuni"
            >
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#8A6449] mb-3">
                Errori comuni
              </p>
              <h3 class="font-display text-xl md:text-2xl font-medium text-[var(--aw-color-text-heading)] mb-6">
                Da evitare
              </h3>
              <ul class="space-y-4">
                {voce.erroriComuni.map((err) => (
                  <li class="flex gap-4">
                    <span class="flex-shrink-0 mt-1 text-[var(--aw-color-accent)]" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                      </svg>
                    </span>
                    <MarkdownInline as="span" text={err} class="text-base text-[var(--aw-color-text-default)] leading-relaxed" />
                  </li>
                ))}
              </ul>
            </section>

          </main>

          <!-- ============ SIDEBAR DESTRA STICKY (DESKTOP ONLY) ============ -->
          <aside class="hidden lg:block">
            <nav
              id="glossario-sidebar"
              aria-label="Indice voce"
              class="sticky top-28"
            >
              <h2 class="font-display text-base font-medium text-[var(--aw-color-text-heading)] mb-4">
                In questa voce
              </h2>
              <ul class="space-y-1">
                {sidebarSezioni.map((s) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      data-spy-link
                      data-target={s.id}
                      class="block text-sm pl-3 py-1.5 -ml-px border-l-2 border-transparent text-[var(--aw-color-text-muted)] hover:text-[var(--aw-color-text-heading)] transition-colors"
                    >
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
              <div class="mt-6 pt-5 border-t border-[var(--aw-color-primary)]/15">
                <button
                  type="button"
                  id="glossario-back-top"
                  class="text-sm font-medium text-[var(--aw-color-primary)] hover:text-[var(--aw-color-accent)] transition-colors inline-flex items-center gap-1.5"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="19" x2="12" y2="5"/>
                    <polyline points="5 12 12 5 19 12"/>
                  </svg>
                  Torna all'inizio
                </button>
              </div>
            </nav>
          </aside>

        </div>
      </div>
    </div>

    <!-- ===================== TERMINI CORRELATI ===================== -->
    {correlate.length > 0 && (
      <section class="bg-[rgb(238_247_246)] py-14 md:py-16">
        <div class="reveal max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="font-display text-2xl md:text-3xl font-semibold text-[var(--aw-color-text-heading)] mb-6">
            Termini correlati
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {correlate.map((c) => (
              <VoceCard
                voce={c}
                numero={numerazione.get(c.slug)}
                totale={TOTALE_PIANIFICATE}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ===================== APPROFONDISCI CON UN CALCOLATORE ===================== -->
    {voce.calcolatoreCorrelato && (
      <section class="bg-white py-14 md:py-16">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="reveal rounded-2xl border border-[var(--aw-color-primary)]/20 bg-[rgba(0,166,82,0.04)] p-8 md:p-10 text-center">
            <p class="text-xs tracking-[0.18em] uppercase font-semibold text-[var(--aw-color-primary)] mb-3">
              Approfondisci con uno strumento
            </p>
            <h2 class="font-display text-2xl md:text-3xl font-semibold text-[var(--aw-color-text-heading)] mb-3">
              {voce.calcolatoreCorrelato.titolo}
            </h2>
            <p class="text-[var(--aw-color-text-muted)] leading-relaxed mb-6 max-w-xl mx-auto">
              Per vedere come questo concetto si traduce in numeri concreti, prova il calcolatore
              dedicato.
            </p>
            <a
              href={voce.calcolatoreCorrelato.slug}
              class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--aw-color-primary)] hover:bg-[var(--aw-color-secondary)] text-white font-medium rounded-lg transition-all hover:shadow-lg"
            >
              Apri il calcolatore
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- ===================== PREV / NEXT NAVIGATION ===================== -->
    <nav class="bg-[rgb(238_247_246)]/40 py-12 border-t border-[var(--aw-color-primary)]/10" aria-label="Navigazione voci glossario">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {prev ? (
            <a
              href={`/glossario/${prev.slug}`}
              class="group block rounded-2xl border border-[var(--aw-color-primary)]/15 hover:border-[var(--aw-color-primary)]/50 hover:shadow-md p-5 transition-all bg-white"
            >
              <span class="block text-xs tracking-[0.08em] uppercase font-semibold text-[var(--aw-color-text-muted)] mb-1">
                ← Voce precedente
              </span>
              <span class="block font-display text-lg font-medium text-[var(--aw-color-text-heading)] group-hover:text-[var(--aw-color-primary)] transition-colors">
                {prev.titolo}
              </span>
            </a>
          ) : <div></div>}
          {next ? (
            <a
              href={`/glossario/${next.slug}`}
              class="group block rounded-2xl border border-[var(--aw-color-primary)]/15 hover:border-[var(--aw-color-primary)]/50 hover:shadow-md p-5 transition-all md:text-right bg-white"
            >
              <span class="block text-xs tracking-[0.08em] uppercase font-semibold text-[var(--aw-color-text-muted)] mb-1">
                Voce successiva →
              </span>
              <span class="block font-display text-lg font-medium text-[var(--aw-color-text-heading)] group-hover:text-[var(--aw-color-primary)] transition-colors">
                {next.titolo}
              </span>
            </a>
          ) : <div></div>}
        </div>
        <div class="mt-6 text-center">
          <a href="/glossario" class="inline-flex items-center gap-2 text-sm font-medium text-[var(--aw-color-primary)] hover:underline underline-offset-4">
            ← Torna al glossario
          </a>
        </div>
      </div>
    </nav>

    <!-- ===================== CTA FINALE ===================== -->
    <section class="bg-white py-16 md:py-20">
      <div class="reveal max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-xs tracking-[0.18em] uppercase font-semibold text-[var(--aw-color-accent)] mb-3">
          Vuoi capire come questo concetto si applica al tuo caso?
        </p>
        <h2 class="font-display text-2xl md:text-3xl font-semibold text-[var(--aw-color-text-heading)] mb-4 leading-tight">
          Ogni situazione è diversa.
        </h2>
        <p class="text-base md:text-lg text-[var(--aw-color-text-muted)] leading-relaxed mb-8 max-w-2xl mx-auto">
          Se vuoi capire come <strong>{voce.titolo}</strong> si applica concretamente alla tua
          situazione patrimoniale, posso aiutarti. La prima chiamata è gratuita e senza impegno.
        </p>
        <a
          href="/contatti"
          data-magnetic
          class="inline-flex items-center justify-center px-8 py-4 bg-[#00A652] hover:bg-[#0F4F4A] text-white font-medium rounded-lg transition-colors hover:shadow-lg"
        >
          Prenota una consulenza
        </a>
      </div>
    </section>
  </article>

  <!-- ===================== SCROLLSPY + BACK-TO-TOP ===================== -->
  <script>
    function initGlossarioSidebar() {
      const links = document.querySelectorAll<HTMLAnchorElement>('[data-spy-link]');
      if (links.length === 0) return;

      // Stile attivo: bordo sinistro emerald + testo emerald
      const activeClasses = ['border-[#00A652]', 'text-[var(--aw-color-text-heading)]', 'font-medium'];

      function setActive(targetId: string) {
        links.forEach((link) => {
          const isActive = link.dataset.target === targetId;
          activeClasses.forEach((c) => link.classList.toggle(c, isActive));
          link.classList.toggle('border-transparent', !isActive);
          if (isActive) {
            link.setAttribute('aria-current', 'true');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      }

      const sections = document.querySelectorAll<HTMLElement>('[data-spy-section]');
      if (sections.length === 0) return;

      // IntersectionObserver: aggiorna lo stato attivo in base alla
      // sezione che e' al centro del viewport.
      const observer = new IntersectionObserver(
        (entries) => {
          // Trova la sezione piu' visibile (prendiamo la prima
          // intersecting in ordine di posizione DOM).
          const visibili = entries.filter((e) => e.isIntersecting);
          if (visibili.length === 0) return;
          // Ordina per top piu' vicino al centro del viewport
          visibili.sort((a, b) => {
            const aDist = Math.abs(a.boundingClientRect.top);
            const bDist = Math.abs(b.boundingClientRect.top);
            return aDist - bDist;
          });
          const id = visibili[0].target.id;
          if (id) setActive(id);
        },
        {
          rootMargin: '-30% 0px -50% 0px',
          threshold: 0,
        }
      );

      sections.forEach((s) => observer.observe(s));

      // Smooth scroll on click
      links.forEach((link) => {
        link.addEventListener('click', (e) => {
          const targetId = link.dataset.target;
          if (!targetId) return;
          const target = document.getElementById(targetId);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${targetId}`);
        });
      });

      // Back-to-top
      const backTopBtn = document.getElementById('glossario-back-top');
      if (backTopBtn) {
        backTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    }

    // Init al primo carico e ad ogni navigazione (View Transitions)
    document.addEventListener('astro:page-load', initGlossarioSidebar);
  </script>
</Layout>
