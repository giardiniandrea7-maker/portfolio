---
import Layout from '~/layouts/PageLayout.astro';
import ServiceLayout from '~/components/ServiceLayout.astro';

const metadata = {
  title: 'Diagnosi di Portafoglio — Analisi gratuita | Andrea Giardini',
  description:
    'Richiedi una diagnosi gratuita del tuo portafoglio di investimenti. Analisi online, imparziale e completa in meno di una settimana.',
};
---

<Layout metadata={metadata}>

  <ServiceLayout
    heroTitle="Analisi di portafoglio gratuita"
    heroParagraphs={[
      `Richiedere una <strong class="text-[var(--aw-color-primary)]">diagnosi di portafoglio</strong> significa fare chiarezza sul proprio <strong class="text-[var(--aw-color-primary)]">portafoglio</strong>: capire cosa si possiede, come è strutturato e se è coerente con i propri <strong class="text-[var(--aw-color-primary)]">obiettivi</strong> e il proprio profilo di <strong class="text-[var(--aw-color-primary)]">rischio</strong>.`,
      `Quali <strong class="text-[var(--aw-color-primary)]">rendimenti</strong> stai ottenendo? Quali <strong class="text-[var(--aw-color-primary)]">costi</strong> stai sostenendo? Il tuo portafoglio è adeguato al tuo orizzonte temporale? Sono domande legittime, ma non sempre facili a cui rispondere senza il supporto di un professionista.`,
      `Se non hai risposte chiare, una <strong class="text-[var(--aw-color-primary)]">diagnosi gratuita</strong> è il primo passo per ottenerle.`,
    ]}
    heroCtaText="Richiedila Ora!"
    heroCtaHref="#come-ricevere"
    heroVideoLabel="Diagnosi di Portafoglio"

    showExample={false}

    detailTitle="Cosa faccio per te"
    detailIntro={[
      `Analizzo il tuo <strong class="text-[var(--aw-color-primary)]">portafoglio</strong> nel dettaglio e ti restituisco un quadro chiaro: cosa possiedi, quanto ti costa e se ha senso rispetto ai tuoi <strong class="text-[var(--aw-color-primary)]">obiettivi</strong>.`,
    ]}
    advantagesTitle="In concreto:"
    advantages={[
      `Ti mostro le <strong class="text-[var(--aw-color-primary)]">probabili evoluzioni</strong> del tuo portafoglio così com'è strutturato oggi;`,
      `Lo confronto con le reali potenzialità di rendimento del tuo capitale;`,
      `Applico modelli statistici professionali per individuare margini di <strong class="text-[var(--aw-color-primary)]">ottimizzazione</strong>;`,
      `Tengo conto del tuo orizzonte temporale, della tua tolleranza al <strong class="text-[var(--aw-color-primary)]">rischio</strong> e della coerenza complessiva.`,
    ]}
    analysisTitle="Cosa analizzo:"
    analysisItems={[
      `Fondi comuni di investimento`,
      `Polizze assicurative`,
      `Fondi pensione`,
      `Azioni e obbligazioni`,
      `Certificati`,
      `<strong class="text-[var(--aw-color-primary)]">ETF</strong>`,
    ]}
    detailOutro={[
      `In pratica, qualsiasi strumento ti sia stato proposto in banca, in posta o in assicurazione.`,
      `La <strong class="text-[var(--aw-color-primary)]">diagnosi è gratuita</strong> e senza impegno. Se non sai da dove partire, questo è il primo passo.`,
    ]}

    faqTitle="Risolvi i tuoi dubbi"
    faqParagraphs={[
      `Perché effettuare l'analisi gratuita? Quali sono i vantaggi? Cosa si rischia? Quanto tempo bisogna attendere per un riscontro?`,
      `Rispondo alle domande più frequenti in un video dedicato: chiaro, completo e senza giri di parole.`,
    ]}
    faqVideoLabel="Rispondo alle domande sulla diagnosi gratuita"

    bannerTitle="Ottienila online gratuitamente"
    bannerSubtitle="pronta in meno di una settimana"

    receiveTitle="Come ricevere la diagnosi"
    receiveParagraphs={[
      `Puoi richiedere la diagnosi compilando il modulo qui sotto, scrivendo a <a href="mailto:diagnosi@giardiniconsulenza.it" class="text-[var(--aw-color-primary)] underline font-semibold">diagnosi@giardiniconsulenza.it</a> o inviando un messaggio WhatsApp al <strong class="text-[var(--aw-color-primary)]">+39 351 545 6845</strong>.`,
      `Basta uno screen o una foto del tuo <strong class="text-[var(--aw-color-primary)]">portafoglio</strong>. Parto dalla visione d'insieme per capire se la struttura attuale è coerente con i tuoi <strong class="text-[var(--aw-color-primary)]">obiettivi</strong> e il tuo profilo — <strong class="text-[var(--aw-color-primary)]">senza costi</strong>, senza documenti complessi.`,
    ]}
    receiveCtaText="Come richiedere la diagnosi"

    showForm={true}
    formTitle="Modulo di richiesta"
    formSubtitle={[
      `Compila la form e carica i documenti o gli screen dei tuoi investimenti.`,
      `È <strong class="text-[var(--aw-color-primary)]">gratis</strong> e <strong class="text-[var(--aw-color-primary)]">senza impegno</strong>.`,
    ]}
    showFileUpload={true}
    showInvestmentDate={true}
  />

</Layout>
