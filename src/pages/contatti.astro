---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import QRCode from 'qrcode';

import SiteLayout from '~/components/site/SiteLayout.astro';
import SectionTitle from '~/components/site/SectionTitle.astro';
import Placeholder from '~/components/site/Placeholder.astro';
import FormField from '~/components/site/FormField.astro';
import EmailLink from '~/components/site/EmailLink.astro';
import Web3Form from '~/components/site/Web3Form.astro';

import { siteContacts, siteOffice, officeMapsUrl, officeDirectionsUrl } from '~/navigation';
import { findAssetImage } from '~/utils/home-assets';

const metadata = {
  title: 'Contatti | Andrea Giardini — Consulente Finanziario di Fideuram',
  ignoreTitleTemplate: true,
  description: 'Prenota un incontro: in ufficio, a domicilio o in videochiamata.',
};

const ufficio = findAssetImage('contatti-ufficio.jpg');

// QR-code generato a build-time: punta alla vCard in public/
const vcardPath = '/andrea-giardini.vcf';
const qrSvg = await QRCode.toString(`https://giardiniconsulenza.it${vcardPath}`, {
  type: 'svg',
  margin: 0,
  color: { dark: '#1E2421', light: '#00000000' },
});

const giorni = ['In settimana', 'Nel weekend'];
const fasce = ['09:00–11:00', '11:00–13:00', '14:00–16:00', '16:00–18:00'];

const circle = 'w-[200px] h-[200px] rounded-full bg-ivory flex items-center justify-center';
const itemTitle = 'mt-6 font-sans font-medium uppercase tracking-[0.15em] text-base text-charcoal';
const revealBtn =
  'mt-3 text-sm text-charcoal underline decoration-brand decoration-2 underline-offset-4 hover:text-brand';
---

<SiteLayout metadata={metadata}>
  <!-- 1-3. Su desktop: form + "Dove raggiungermi" a sinistra, recapiti in colonna a destra -->
  <div class="lg:grid lg:grid-cols-12">
    <div class="lg:col-span-7 flex flex-col">
      <!-- 1. CONTATTAMI -->
      <section class="bg-charcoal text-white py-16 md:py-24 lg:py-20 lg:flex-1">
        <div class="max-w-3xl lg:max-w-2xl mx-auto px-4 md:px-8">
          <SectionTitle as="h1" size="lg" tone="white" class="mb-6 lg:text-left">Contattami</SectionTitle>
          <p class="text-center lg:text-left text-base md:text-lg text-white/90 mb-10">
            Inviami una richiesta, ti ricontatto al più presto.
          </p>

          <Web3Form
            id="form-contatti"
            subject="Nuova richiesta di contatto — Sito"
            successMessage="Grazie! Ti ricontatto nella fascia che hai scelto."
            submitLabel="Invia la richiesta"
            submitAlign="right"
            dark
          >
            <div class="grid sm:grid-cols-2 gap-5">
              <FormField name="nome" label="Nome" required autocomplete="given-name" dark />
              <FormField name="cognome" label="Cognome" required autocomplete="family-name" dark />
              <FormField name="telefono" type="tel" label="Telefono" required autocomplete="tel" dark />
              <FormField name="email" type="email" label="Email" required autocomplete="email" dark />
              <FormField as="select" name="quando" label="Quando vuoi essere contattato?" options={giorni} dark />
              <FormField as="select" name="fascia_oraria" label="In che fascia oraria?" options={fasce} dark />
            </div>
            <FormField as="textarea" name="esigenze" label="Descrivi le tue esigenze" dark />
          </Web3Form>
        </div>
      </section>

      <!-- 2. DOVE RAGGIUNGERMI -->
      <section class="relative h-[340px] md:h-[400px] bg-gray-300 overflow-hidden">
        {
          ufficio ? (
            <Image
              src={ufficio}
              alt="Andrea Giardini nel suo ufficio di Faenza"
              widths={[640, 1200]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              class="absolute inset-0 w-full h-full object-cover object-[50%_42%]"
            />
          ) : (
            <Placeholder label="foto contatti-ufficio.jpg" class="absolute inset-x-0 top-0 h-12 border-0" />
          )
        }
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-black/40 py-5 md:py-6">
          <SectionTitle tone="white">Dove raggiungermi</SectionTitle>
        </div>
      </section>
    </div>

    <!-- 3. RECAPITI -->
    <section class="bg-linen py-16 md:py-24 lg:col-span-5 lg:flex lg:items-center">
      <ul
        class="reveal-stagger max-w-5xl mx-auto px-4 md:px-8 grid grid-cols-1 md:grid-cols-3 lg:grid-cols-1 gap-14 md:gap-8 lg:gap-12"
      >
        <li class="flex flex-col items-center text-center">
          <span class={circle}
            ><Icon
              name="tabler:device-mobile"
              class="w-20 h-20 text-charcoal [&_*]:stroke-[0.75]"
              aria-hidden="true"
            /></span
          >
          <h2 class={itemTitle}>Telefono</h2>
          <p>
            <button type="button" data-reveal-contact class={revealBtn}>Mostra numero di telefono</button>
            <a
              href={siteContacts.phoneHref}
              class="mt-3 [&:not([hidden])]:block text-sm text-charcoal hover:text-brand"
              hidden>{siteContacts.phone}</a
            >
          </p>
        </li>
        <li class="flex flex-col items-center text-center">
          <span class={circle}
            ><Icon name="tabler:mail" class="w-20 h-20 text-charcoal [&_*]:stroke-[0.75]" aria-hidden="true" /></span
          >
          <h2 class={itemTitle}>Email</h2>
          <p>
            <button type="button" data-reveal-contact class={revealBtn}>Mostra indirizzo email</button>
            <EmailLink class="mt-3 [&:not([hidden])]:block text-sm text-charcoal hover:text-brand break-all" hidden />
          </p>
        </li>
        <li class="flex flex-col items-center text-center">
          <span class={circle}
            ><Icon name="tabler:qrcode" class="w-20 h-20 text-charcoal [&_*]:stroke-[0.75]" aria-hidden="true" /></span
          >
          <h2 class={itemTitle}>QR-code</h2>
          <a href={vcardPath} download="andrea-giardini.vcf" data-vcard-link class={revealBtn}
            >Scansiona e salva in rubrica</a
          >
          <div
            class="hidden md:block mt-6 w-36 h-36 bg-white p-3 [&_svg]:w-full [&_svg]:h-full"
            role="img"
            aria-label="QR-code per salvare il contatto in rubrica"
          >
            <Fragment set:html={qrSvg} />
          </div>
        </li>
      </ul>
    </section>
  </div>

  <!-- 4-5. Mappa e blocco ufficio: impilati su mobile, affiancati da lg -->
  <div class="lg:grid lg:grid-cols-12">
    <!-- 4. MAPPA: anteprima locale (nessuna richiesta a Google). La mappa Google si carica
       solo con il consenso ai contenuti esterni o con il clic su «Mostra la mappa qui».
       Un clic sulla mappa apre Google Maps in una nuova scheda. -->
    <section class="bg-gray-200 lg:col-span-8">
      <div
        data-map
        data-query={siteOffice.mapsQuery}
        data-href={officeMapsUrl}
        class="relative h-[320px] md:h-[420px] overflow-hidden"
      >
        <a
          href={officeMapsUrl}
          target="_blank"
          rel="noopener"
          data-map-preview
          aria-label={`Apri ${siteOffice.address} in Google Maps`}
          class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-center px-4 text-charcoal bg-[linear-gradient(90deg,rgba(44,44,42,0.06)_1px,transparent_1px),linear-gradient(rgba(44,44,42,0.06)_1px,transparent_1px)] bg-[size:48px_48px] hover:text-brand transition-colors"
        >
          <Icon name="tabler:map-pin" class="w-12 h-12 [&_*]:stroke-[1.25]" aria-hidden="true" />
          <span class="uppercase tracking-[0.15em] text-sm">{siteOffice.street}</span>
          <span class="text-sm">{siteOffice.postalCode} {siteOffice.locality} ({siteOffice.region})</span>
          <span class="mt-2 text-xs underline underline-offset-4">Apri in Google Maps</span>
        </a>
        <button
          type="button"
          data-map-load
          class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-white text-charcoal text-xs uppercase tracking-[0.12em] py-3 px-5 shadow-sm hover:text-brand"
        >
          Mostra la mappa qui
        </button>
      </div>
      <p class="max-w-6xl mx-auto px-4 md:px-8 py-3 text-xs text-charcoal/70">
        La mappa interattiva è fornita da Google Maps, che può impostare cookie propri: si attiva con il tuo consenso.
        <button type="button" data-cookie-settings class="underline underline-offset-4">Gestisci le preferenze</button>
      </p>
    </section>

    <!-- 5. BLOCCO UFFICIO -->
    <section class="bg-charcoal text-white py-14 md:py-20 lg:col-span-4 lg:flex lg:items-center">
      <div class="max-w-6xl w-full mx-auto lg:mx-0 px-4 md:px-8 lg:px-10">
        <p class="font-playfair text-2xl md:text-3xl">Ufficio {siteOffice.city}</p>
        <p class="mt-3 text-base text-white/90">{siteOffice.address}</p>
        <a
          href={officeDirectionsUrl}
          target="_blank"
          rel="noopener"
          class="inline-block mt-6 text-white underline underline-offset-4 hover:text-ember transition-colors"
        >
          Ottieni indicazioni
        </a>
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  import { onPageLoad } from '~/scripts/page-load';
  import { onConsent } from '~/scripts/consent';

  function initMap() {
    const box = document.querySelector<HTMLElement>('[data-map]');
    const btn = box?.querySelector<HTMLButtonElement>('[data-map-load]');
    if (!box || !btn || box.dataset.ready) return;
    box.dataset.ready = 'true';

    const load = () => {
      if (box.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.google.com/maps?q=${encodeURIComponent(box.dataset.query ?? '')}&output=embed`;
      iframe.title = 'Mappa dell’ufficio';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.tabIndex = -1;
      iframe.className = 'absolute inset-0 w-full h-full border-0 grayscale pointer-events-none';
      // Livello cliccabile sopra la mappa: apre Google Maps
      const link = document.createElement('a');
      link.href = box.dataset.href ?? '#';
      link.target = '_blank';
      link.rel = 'noopener';
      link.className = 'absolute inset-0';
      link.setAttribute('aria-label', 'Apri la posizione in Google Maps');
      box.replaceChildren(iframe, link);
    };

    btn.addEventListener('click', load);
    onConsent('esterni', load);
  }

  onPageLoad(initMap);
</script>
