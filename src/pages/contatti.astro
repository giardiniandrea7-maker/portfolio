---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import QRCode from 'qrcode';

import SiteLayout from '~/components/site/SiteLayout.astro';
import SectionTitle from '~/components/site/SectionTitle.astro';
import Placeholder from '~/components/site/Placeholder.astro';
import FormField from '~/components/site/FormField.astro';
import Web3Form from '~/components/site/Web3Form.astro';

import { siteContacts, siteOffice } from '~/navigation';
import { findAssetImage } from '~/utils/home-assets';

const metadata = {
  title: 'Contatti | Andrea Giardini — Consulente finanziario',
  ignoreTitleTemplate: true,
  description: 'Prenota un incontro: in ufficio, a domicilio o in videochiamata.',
};

const ufficio = findAssetImage('contatti-ufficio.jpg');

// QR-code generato a build-time: punta alla vCard in public/
const vcardPath = '/andrea-giardini.vcf';
const qrSvg = await QRCode.toString(`https://giardiniconsulenza.it${vcardPath}`, {
  type: 'svg',
  margin: 0,
  color: { dark: '#2C2C2A', light: '#00000000' },
});

const directionsUrl = siteOffice.mapsQuery
  ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(siteOffice.mapsQuery)}`
  : '#';

const giorni = ['In settimana', 'Nel weekend'];
const fasce = ['09:00–11:00', '11:00–13:00', '14:00–16:00', '16:00–18:00'];

const circle = 'w-[200px] h-[200px] rounded-full bg-ivory flex items-center justify-center';
const itemTitle = 'mt-6 font-sans font-medium uppercase tracking-[0.15em] text-base text-charcoal';
const revealBtn = 'mt-3 text-sm text-charcoal underline decoration-sage decoration-2 underline-offset-4 hover:text-sage';
---

<SiteLayout metadata={metadata}>
  <!-- 1. CONTATTAMI -->
  <section class="bg-charcoal text-white py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      <SectionTitle as="h1" size="lg" tone="white" class="mb-6">Contattami</SectionTitle>
      <p class="text-center text-base md:text-lg text-white/90 mb-10">Inviami una richiesta, ti ricontatto al più presto.</p>

      <Web3Form
        id="form-contatti"
        subject="Nuova richiesta di contatto — Sito"
        successMessage="Grazie! Ti ricontatto nella fascia che hai scelto."
        submitLabel="Invia la richiesta"
        submitAlign="right"
        dark
      >
        <div class="grid sm:grid-cols-2 gap-5">
          <FormField name="nome" label="Nome" required autocomplete="given-name" dark />
          <FormField name="cognome" label="Cognome" required autocomplete="family-name" dark />
          <FormField name="telefono" type="tel" label="Telefono" required autocomplete="tel" dark />
          <FormField name="email" type="email" label="Email" required autocomplete="email" dark />
          <FormField as="select" name="quando" label="Quando vuoi essere contattato?" options={giorni} dark />
          <FormField as="select" name="fascia_oraria" label="In che fascia oraria?" options={fasce} dark />
        </div>
        <FormField as="textarea" name="esigenze" label="Descrivi le tue esigenze" dark />
      </Web3Form>
    </div>
  </section>

  <!-- 2. DOVE RAGGIUNGERMI -->
  <section class="relative h-[300px] bg-gray-300 overflow-hidden">
    {
      ufficio ? (
        <Image
          src={ufficio}
          alt="L'ufficio di Andrea Giardini"
          widths={[640, 1280, 1920]}
          sizes="100vw"
          class="absolute inset-0 w-full h-full object-cover"
        />
      ) : (
        <Placeholder label="foto contatti-ufficio.jpg" class="absolute inset-x-0 top-0 h-12 border-0" />
      )
    }
    <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 bg-black/50 py-6">
      <SectionTitle tone="white">Dove raggiungermi</SectionTitle>
    </div>
  </section>

  <!-- 3. RECAPITI -->
  <section class="bg-linen py-16 md:py-24">
    <ul class="max-w-5xl mx-auto px-4 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-14 md:gap-8">
      <li class="flex flex-col items-center text-center">
        <span class={circle}><Icon name="tabler:device-mobile" class="w-20 h-20 text-charcoal [&_*]:stroke-[0.75]" aria-hidden="true" /></span>
        <h2 class={itemTitle}>Telefono</h2>
        <p>
          <button type="button" data-reveal-contact class={revealBtn}>Mostra numero di telefono</button>
          <a href={siteContacts.phoneHref} class="mt-3 [&:not([hidden])]:block text-sm text-charcoal hover:text-sage" hidden>{siteContacts.phone}</a>
        </p>
      </li>
      <li class="flex flex-col items-center text-center">
        <span class={circle}><Icon name="tabler:mail" class="w-20 h-20 text-charcoal [&_*]:stroke-[0.75]" aria-hidden="true" /></span>
        <h2 class={itemTitle}>Email</h2>
        <p>
          <button type="button" data-reveal-contact class={revealBtn}>Mostra indirizzo email</button>
          <a href={`mailto:${siteContacts.email}`} class="mt-3 [&:not([hidden])]:block text-sm text-charcoal hover:text-sage break-all" hidden>
            {siteContacts.email}
          </a>
        </p>
      </li>
      <li class="flex flex-col items-center text-center">
        <span class={circle}><Icon name="tabler:qrcode" class="w-20 h-20 text-charcoal [&_*]:stroke-[0.75]" aria-hidden="true" /></span>
        <h2 class={itemTitle}>QR-code</h2>
        <a href={vcardPath} download="andrea-giardini.vcf" data-vcard-link class={revealBtn}>Scansiona e salva in rubrica</a>
        <div class="hidden md:block mt-6 w-36 h-36 bg-white p-3 [&_svg]:w-full [&_svg]:h-full" role="img" aria-label="QR-code per salvare il contatto in rubrica">
          <Fragment set:html={qrSvg} />
        </div>
      </li>
    </ul>
  </section>

  <!-- 4. MAPPA (caricata solo su richiesta: nessun cookie di terze parti prima del clic) -->
  <section class="bg-gray-200">
    <div data-map data-query={siteOffice.mapsQuery} class="relative h-[320px] md:h-[420px] flex items-center justify-center">
      <button
        type="button"
        data-map-load
        class="flex flex-col items-center gap-3 text-charcoal uppercase tracking-[0.15em] text-sm hover:text-sage transition-colors"
      >
        <Icon name="tabler:map-pin" class="w-10 h-10 [&_*]:stroke-[1.25]" aria-hidden="true" />
        Mostra la mappa
        <span class="normal-case tracking-normal text-xs text-charcoal/60">Carica Google Maps</span>
      </button>
    </div>
  </section>

  <!-- 5. BLOCCO UFFICIO -->
  <section class="bg-charcoal text-white py-14 md:py-20">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <p class="font-playfair text-2xl md:text-3xl">Ufficio {siteOffice.city}</p>
      <p class="mt-3 text-base text-white/90">{siteOffice.address}</p>
      <a
        href={directionsUrl}
        target="_blank"
        rel="noopener"
        class="inline-block mt-6 text-white underline underline-offset-4 hover:text-ochre transition-colors"
      >
        Ottieni indicazioni
      </a>
    </div>
  </section>
</SiteLayout>

<script>
  function initMap() {
    const box = document.querySelector<HTMLElement>('[data-map]');
    const btn = box?.querySelector<HTMLButtonElement>('[data-map-load]');
    if (!box || !btn || box.dataset.ready) return;
    box.dataset.ready = 'true';

    btn.addEventListener('click', () => {
      const query = box.dataset.query ?? '';
      if (!query) {
        box.innerHTML = '<p class="px-4 text-center text-sm font-semibold uppercase tracking-wider text-charcoal/60">[TODO: indirizzo ufficio per la mappa]</p>';
        return;
      }
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
      iframe.title = 'Mappa dell’ufficio';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'absolute inset-0 w-full h-full border-0 grayscale';
      box.replaceChildren(iframe);
    });
  }

  document.addEventListener('astro:page-load', initMap);
</script>
