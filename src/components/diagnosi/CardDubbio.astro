---
// Card per le 4 preoccupazioni della Sezione 2.
// Icona Heroicons-style line color sage in alto, titolo Playfair, paragrafo.
// Le icone sono passate come stringa-key e renderizzate inline.
interface Props {
  icona: 'commissioni' | 'rischio' | 'rendimento' | 'liquidita';
  titolo: string;
  testo: string;
}
const { icona, titolo, testo } = Astro.props;
---

<article
  class="reveal flex flex-col gap-4 rounded-2xl border border-[var(--aw-color-primary)]/15 bg-white p-6 lg:p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-[var(--aw-color-primary)]/40"
>
  <span
    class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--aw-color-primary)]/10 text-[var(--aw-color-primary)]"
    aria-hidden="true"
  >
    {icona === 'commissioni' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/>
        <path d="M15.5 9a4 4 0 1 0 0 6"/>
        <path d="M8.5 11h5"/>
        <path d="M8.5 13h5"/>
      </svg>
    )}
    {icona === 'rischio' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3z"/>
        <path d="M12 8v4"/>
        <circle cx="12" cy="16" r="0.5" fill="currentColor"/>
      </svg>
    )}
    {icona === 'rendimento' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 17 9 11 13 15 21 7"/>
        <polyline points="14 7 21 7 21 14"/>
      </svg>
    )}
    {icona === 'liquidita' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="3 10 12 4 21 10 21 11 3 11 3 10"/>
        <line x1="6" y1="11" x2="6" y2="18"/>
        <line x1="10" y1="11" x2="10" y2="18"/>
        <line x1="14" y1="11" x2="14" y2="18"/>
        <line x1="18" y1="11" x2="18" y2="18"/>
        <line x1="3" y1="21" x2="21" y2="21"/>
      </svg>
    )}
  </span>
  <h3 class="font-display text-xl md:text-2xl font-medium leading-snug text-[var(--aw-color-text-heading)]">
    {titolo}
  </h3>
  <p class="text-base md:text-lg leading-relaxed text-[var(--aw-color-text-default)]">
    {testo}
  </p>
</article>
