---
// Step della Sezione 4 "Come funziona — in 3 passi".
// Numero grande sage Playfair, icona, titolo, paragrafo, badge tempo.
interface Props {
  numero: number;
  icona: 'documento' | 'analisi' | 'consegna';
  titolo: string;
  testo: string;
  tempoLabel: string;
}
const { numero, icona, titolo, testo, tempoLabel } = Astro.props;
---

<article
  class="reveal flex flex-col gap-5 rounded-2xl border border-[var(--aw-color-primary)]/15 bg-white p-7 lg:p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
>
  <div class="flex items-center gap-4">
    <span
      class="font-display text-5xl md:text-6xl font-semibold leading-none text-[var(--aw-color-primary)]/85"
      aria-hidden="true"
    >
      {numero}
    </span>
    <span
      class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--aw-color-primary)]/10 text-[var(--aw-color-primary)]"
      aria-hidden="true"
    >
      {icona === 'documento' && (
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <path d="M12 18v-6"/>
          <polyline points="9 15 12 12 15 15"/>
        </svg>
      )}
      {icona === 'analisi' && (
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 7v5l3 3"/>
          <path d="M3 12h2"/>
          <path d="M19 12h2"/>
        </svg>
      )}
      {icona === 'consegna' && (
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <polyline points="9 14 11 16 15 12"/>
        </svg>
      )}
    </span>
  </div>

  <h3 class="font-display text-xl md:text-2xl font-medium leading-snug text-[var(--aw-color-text-heading)]">
    {titolo}
  </h3>
  <p class="text-base md:text-lg leading-relaxed text-[var(--aw-color-text-default)] flex-grow">
    {testo}
  </p>

  <span
    class="self-start inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--aw-color-primary)]/10 text-[var(--aw-color-text-heading)] text-xs md:text-sm font-medium"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <polyline points="12 6 12 12 16 14"/>
    </svg>
    {tempoLabel}
  </span>
</article>
