---
// Tre pilastri: cerchio grande con icona line-art, titolo maiuscolo e testo breve.
import { Icon } from 'astro-icon/components';

export interface Props {
  items: Array<{ icon: string; title: string; text: string }>;
  circle?: 'white' | 'ivory';
}

const { items, circle = 'white' } = Astro.props;
---

<ul class="grid grid-cols-1 md:grid-cols-3 gap-14 md:gap-8">
  {
    items.map((item) => (
      <li class="flex flex-col items-center text-center">
        <span
          class:list={[
            'w-60 h-60 lg:w-[280px] lg:h-[280px] md:w-52 md:h-52 rounded-full flex items-center justify-center',
            circle === 'white' ? 'bg-white' : 'bg-ivory',
          ]}
        >
          <Icon name={item.icon} class="w-24 h-24 lg:w-28 lg:h-28 text-charcoal [&_*]:stroke-[0.75]" aria-hidden="true" />
        </span>
        <h3 class="mt-8 font-sans font-medium uppercase tracking-[0.15em] text-base md:text-lg text-charcoal">
          {item.title}
        </h3>
        <p class="mt-3 max-w-xs text-sm md:text-base text-charcoal/80 leading-relaxed">{item.text}</p>
      </li>
    ))
  }
</ul>
