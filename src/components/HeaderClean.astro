---
import Logo from '~/components/Logo.astro';
---

<!-- =========================================================
     HEADER — sticky bianco
     Desktop: logo + menu orizzontale + CTA
     Mobile:  logo + hamburger (apre sidebar)
     ========================================================= -->
<header
  id="header-clean"
  class="sticky top-0 left-0 right-0 z-40 bg-white border-b border-gray-100 shadow-sm"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative flex items-center justify-between h-16 md:h-20 gap-4">

      <!-- LOGO -->
      <Logo />

      <!-- NOME CENTRATO (solo mobile) -->
      <div class="absolute left-1/2 -translate-x-1/2 flex flex-col items-center text-center md:hidden pointer-events-none">
        <span class="text-sm font-bold tracking-tight text-[var(--aw-color-text-heading)] whitespace-nowrap">Andrea Giardini</span>
        <span class="text-[9px] font-medium tracking-[0.12em] uppercase text-[var(--aw-color-text-muted)] whitespace-nowrap">Consulente Finanziario</span>
      </div>

      <!-- ============================================= -->
      <!-- NAV DESKTOP (md+)                             -->
      <!-- ============================================= -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Menu principale">

        <!-- HOME -->
        <a
          href="/"
          class="px-3 py-2 text-sm font-semibold text-[var(--aw-color-primary)] hover:text-[var(--aw-color-accent)] transition-colors"
        >
          Home
        </a>

        <!-- CHI SONO -->
        <a
          href="/chi-sono"
          class="px-3 py-2 text-sm font-semibold text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] transition-colors"
        >
          Chi sono
        </a>

        <!-- SERVIZI ▾ -->
        <div class="nav-dropdown relative">
          <button
            type="button"
            class="nav-trigger flex items-center gap-1 px-3 py-2 text-sm font-semibold text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] transition-colors"
          >
            <span>Servizi</span>
            <svg class="nav-chevron w-3 h-3 opacity-60 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="nav-menu absolute left-1/2 -translate-x-1/2 top-full mt-0 min-w-[280px] bg-[rgb(238_247_246)] shadow-xl rounded-sm opacity-0 invisible translate-y-2 transition-all duration-200 pointer-events-none">
            <ul class="py-2">
              <li><a href="/servizi/diagnosi" class="block px-7 py-4 text-xs font-semibold tracking-[0.15em] uppercase text-center text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] hover:bg-white border-b border-gray-200/60 transition-colors">Diagnosi di portafoglio</a></li>
              <li><a href="/servizi/pianificazione" class="block px-7 py-4 text-xs font-semibold tracking-[0.15em] uppercase text-center text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] hover:bg-white border-b border-gray-200/60 transition-colors">Pianificazione Finanziaria</a></li>
              <li><a href="/servizi/previdenza" class="block px-7 py-4 text-xs font-semibold tracking-[0.15em] uppercase text-center text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] hover:bg-white transition-colors">Previdenza Complementare</a></li>
            </ul>
          </div>
        </div>

        <!-- RISORSE ▾ -->
        <div class="nav-dropdown relative">
          <button
            type="button"
            class="nav-trigger flex items-center gap-1 px-3 py-2 text-sm font-semibold text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] transition-colors"
          >
            <span>Risorse</span>
            <svg class="nav-chevron w-3 h-3 opacity-60 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="nav-menu absolute left-1/2 -translate-x-1/2 top-full mt-0 min-w-[260px] bg-[rgb(238_247_246)] shadow-xl rounded-sm opacity-0 invisible translate-y-2 transition-all duration-200 pointer-events-none">
            <ul class="py-2">
              <li><a href="#" class="block px-7 py-4 text-xs font-semibold tracking-[0.15em] uppercase text-center text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] hover:bg-white border-b border-gray-200/60 transition-colors">Articoli <span class="block mt-1 text-[9px] tracking-wider text-[var(--aw-color-accent)]">In arrivo</span></a></li>
              <li><a href="/calcolatori" class="block px-7 py-4 text-xs font-semibold tracking-[0.15em] uppercase text-center text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] hover:bg-white border-b border-gray-200/60 transition-colors">Calcolatori</a></li>
              <li><a href="/glossario" class="block px-7 py-4 text-xs font-semibold tracking-[0.15em] uppercase text-center text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] hover:bg-white border-b border-gray-200/60 transition-colors">Glossario</a></li>
              <li><a href="#" class="block px-7 py-4 text-xs font-semibold tracking-[0.15em] uppercase text-center text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] hover:bg-white transition-colors">FAQ <span class="block mt-1 text-[9px] tracking-wider text-[var(--aw-color-accent)]">In arrivo</span></a></li>
            </ul>
          </div>
        </div>

        <!-- CTA CONTATTAMI -->
        <a
          href="/contatti"
          class="ml-2 lg:ml-3 inline-flex items-center justify-center px-5 lg:px-6 py-2.5 bg-[var(--aw-color-primary)] hover:bg-[var(--aw-color-secondary)] text-white text-sm font-semibold rounded-sm transition-all hover:shadow-md"
        >
          Contattami
        </a>
      </nav>

      <!-- ============================================= -->
      <!-- HAMBURGER MOBILE (solo < md)                  -->
      <!-- ============================================= -->
      <button
        id="hamburger-btn"
        type="button"
        aria-label="Apri menu"
        class="md:hidden p-3 -mr-3 text-[var(--aw-color-primary)] hover:bg-gray-50 rounded-lg transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

    </div>
  </div>
</header>

<!-- OVERLAY MOBILE -->
<div
  id="menu-overlay"
  class="fixed inset-0 z-40 opacity-0 pointer-events-none transition-all duration-300 backdrop-blur-md bg-white/30 md:hidden"
></div>

<!-- SIDEBAR MENU MOBILE -->
<aside
  id="sidebar-menu"
  class="fixed top-0 right-0 h-full w-[85%] sm:w-[420px] bg-white z-50 shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col md:hidden"
>

  <!-- HEADER SIDEBAR -->
  <div class="flex items-center justify-between p-6 border-b border-gray-100">
    <span class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--aw-color-text-muted)]">
      Menu
    </span>
    <button
      id="close-btn"
      type="button"
      aria-label="Chiudi menu"
      class="p-2 -mr-2 text-[var(--aw-color-primary)] hover:bg-gray-100 rounded-full transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- CONTENUTO SCROLLABILE -->
  <nav class="flex-1 overflow-y-auto py-4 px-6">

    <!-- HOME -->
    <a href="/" class="menu-link block py-3 text-xl font-bold text-[var(--aw-color-primary)] hover:text-[var(--aw-color-accent)] transition-colors border-b border-gray-100">
      Home
    </a>

    <!-- CHI SONO -->
    <a href="/chi-sono" class="menu-link block py-3 text-xl font-semibold text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] transition-colors border-b border-gray-100">
      Chi sono
    </a>

    <!-- SERVIZI ▼ -->
    <div class="submenu-group border-b border-gray-100">
      <button class="submenu-toggle w-full flex items-center justify-between py-3 text-xl font-semibold text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] transition-colors">
        <span>Servizi</span>
        <svg class="submenu-arrow w-5 h-5 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
      <ul class="submenu-list hidden pb-3 pl-4 space-y-2">
        <li><a href="/servizi/diagnosi" class="menu-link block py-1.5 text-sm text-[var(--aw-color-text-muted)] hover:text-[var(--aw-color-accent)] transition-colors">Diagnosi di portafoglio</a></li>
        <li><a href="/servizi/pianificazione" class="menu-link block py-1.5 text-sm text-[var(--aw-color-text-muted)] hover:text-[var(--aw-color-accent)] transition-colors">Pianificazione Finanziaria</a></li>
        <li><a href="/servizi/previdenza" class="menu-link block py-1.5 text-sm text-[var(--aw-color-text-muted)] hover:text-[var(--aw-color-accent)] transition-colors">Previdenza Complementare</a></li>
      </ul>
    </div>

    <!-- RISORSE ▼ -->
    <div class="submenu-group border-b border-gray-100">
      <button class="submenu-toggle w-full flex items-center justify-between py-3 text-xl font-semibold text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] transition-colors">
        <span>Risorse</span>
        <svg class="submenu-arrow w-5 h-5 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
      <ul class="submenu-list hidden pb-3 pl-4 space-y-2">
        <li><a href="#" class="menu-link block py-1.5 text-sm text-[var(--aw-color-text-muted)] hover:text-[var(--aw-color-accent)] transition-colors flex items-center gap-2">Articoli <span class="text-[10px] text-[var(--aw-color-accent)] font-semibold uppercase tracking-wider">In arrivo</span></a></li>
        <li><a href="/calcolatori" class="menu-link block py-1.5 text-sm text-[var(--aw-color-text-muted)] hover:text-[var(--aw-color-accent)] transition-colors flex items-center gap-2">Calcolatori</a></li>
        <li><a href="/glossario" class="menu-link block py-1.5 text-sm text-[var(--aw-color-text-muted)] hover:text-[var(--aw-color-accent)] transition-colors flex items-center gap-2">Glossario</a></li>
        <li><a href="#" class="menu-link block py-1.5 text-sm text-[var(--aw-color-text-muted)] hover:text-[var(--aw-color-accent)] transition-colors flex items-center gap-2">FAQ <span class="text-[10px] text-[var(--aw-color-accent)] font-semibold uppercase tracking-wider">In arrivo</span></a></li>
      </ul>
    </div>

    <!-- CONTATTI -->
    <a href="/contatti" class="menu-link block py-3 text-xl font-semibold text-[var(--aw-color-text-default)] hover:text-[var(--aw-color-accent)] transition-colors border-b border-gray-100">
      Contatti
    </a>

    <!-- BOTTONI CTA -->
    <div class="mt-6 space-y-3">
      <a
        href="/contatti"
        class="menu-link block w-full text-center bg-[var(--aw-color-primary)] hover:bg-[var(--aw-color-secondary)] text-white py-3.5 px-6 rounded-sm font-semibold transition-colors text-sm"
      >
        Contattami →
      </a>
      <a
        href="tel:+393515456845"
        class="menu-link block w-full text-center bg-white border-2 border-[var(--aw-color-primary)] text-[var(--aw-color-primary)] hover:bg-[var(--aw-color-primary)] hover:text-white py-3.5 px-6 rounded-sm font-semibold transition-colors text-sm"
      >
        Chiamami
      </a>
    </div>

    <!-- CONTATTI INFO -->
    <div class="mt-6 pt-6 border-t border-gray-100 space-y-3">
      <a href="tel:+393515456845" class="flex items-center gap-3 text-sm text-[var(--aw-color-text-muted)] hover:text-[var(--aw-color-accent)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        +39 351 545 6845
      </a>
      <a href="mailto:andrea@giardiniconsulenza.it" class="flex items-center gap-3 text-sm text-[var(--aw-color-text-muted)] hover:text-[var(--aw-color-accent)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <polyline points="3 7 12 13 21 7"/>
        </svg>
        andrea@giardiniconsulenza.it
      </a>
    </div>

    <!-- SOCIAL -->
    <div class="mt-6 pt-6 border-t border-gray-100">
      <p class="text-[11px] font-semibold tracking-[0.2em] uppercase text-[var(--aw-color-text-muted)] mb-3">Seguimi</p>
      <div class="flex items-center gap-3">
        <a href="https://www.instagram.com/andreagiardini.finanza/" target="_blank" rel="noopener" class="w-10 h-10 flex items-center justify-center rounded-full bg-[var(--aw-color-primary)] text-white hover:bg-[var(--aw-color-accent)] transition-colors" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href="https://www.youtube.com/@AlphaGiardini" target="_blank" rel="noopener" class="w-10 h-10 flex items-center justify-center rounded-full bg-[var(--aw-color-primary)] text-white hover:bg-[var(--aw-color-accent)] transition-colors" aria-label="YouTube">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Padding bottom per scroll -->
    <div class="h-6"></div>
  </nav>

</aside>

<!-- ============================================= -->
<!-- STILI DROPDOWN DESKTOP                         -->
<!-- ============================================= -->
<style>
  .nav-dropdown:hover .nav-menu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }
  .nav-dropdown:hover .nav-chevron {
    transform: rotate(180deg);
  }
  .nav-menu::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }
</style>

<!-- ============================================= -->
<!-- JAVASCRIPT MENU MOBILE                         -->
<!-- ============================================= -->
<!-- data-astro-rerun: ri-esegue questo script ad ogni navigazione
     View Transitions, cosi' i listener vengono riagganciati ai
     nuovi elementi DOM (hamburger, sidebar, overlay) dopo lo swap. -->
<script data-astro-rerun>
  // I listener locali agli elementi (hamburger, closeBtn, overlay,
  // submenu, menu-link, nav-trigger) sono attaccati ad elementi che
  // vengono ri-creati ad ogni navigazione: niente leak, ogni rerun
  // li riaggancia ai nuovi nodi.
  // I listener su `document` (keydown Escape) invece persistono fra
  // rerun: per evitarne l'accumulo, smonto quello precedente prima
  // di registrarne uno nuovo.

  const hamburger = document.getElementById('hamburger-btn');
  const closeBtn  = document.getElementById('close-btn');
  const sidebar   = document.getElementById('sidebar-menu');
  const overlay   = document.getElementById('menu-overlay');

  function closeMenu() {
    sidebar?.classList.add('translate-x-full');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    overlay?.classList.remove('opacity-100');
    document.body.style.overflow = '';
  }
  function openMenu() {
    sidebar?.classList.remove('translate-x-full');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    overlay?.classList.add('opacity-100');
    document.body.style.overflow = 'hidden';
  }

  hamburger?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  // Escape chiude il menu — listener globale "singleton".
  // Rimuovo l'eventuale precedente per non duplicare ad ogni navigazione.
  // @ts-ignore - chiave non standard, intenzionale per la persistenza fra rerun
  if (window.__giardiniEscapeHandler) {
    // @ts-ignore
    document.removeEventListener('keydown', window.__giardiniEscapeHandler);
  }
  const escapeHandler = (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      // Re-query per usare gli elementi correnti (post-swap)
      const sb = document.getElementById('sidebar-menu');
      const ov = document.getElementById('menu-overlay');
      if (sb && ov && !sb.classList.contains('translate-x-full')) {
        sb.classList.add('translate-x-full');
        ov.classList.add('opacity-0', 'pointer-events-none');
        ov.classList.remove('opacity-100');
        document.body.style.overflow = '';
      }
    }
  };
  document.addEventListener('keydown', escapeHandler);
  // @ts-ignore
  window.__giardiniEscapeHandler = escapeHandler;

  document.querySelectorAll('.submenu-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const list  = btn.nextElementSibling;
      const arrow = btn.querySelector('.submenu-arrow');
      list?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });
  });

  document.querySelectorAll('.menu-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.querySelectorAll('.nav-trigger').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      (e.currentTarget as HTMLElement).blur();
    });
    btn.addEventListener('mouseleave', (e) => {
      (e.currentTarget as HTMLElement).blur();
    });
  });
</script>
