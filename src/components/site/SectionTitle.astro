---
// Titolo di sezione stile istituzionale: Manrope light, maiuscolo, tracking ampio.
export interface Props {
  as?: 'h1' | 'h2';
  size?: 'md' | 'lg' | 'xl';
  align?: 'left' | 'center';
  tone?: 'charcoal' | 'brand' | 'white';
  class?: string;
}

const { as: Tag = 'h2', size = 'md', align = 'center', tone = 'charcoal', class: className = '' } = Astro.props;

const sizes = {
  md: 'text-lg md:text-2xl',
  lg: 'text-2xl md:text-4xl',
  xl: 'text-3xl md:text-5xl',
};
const tones = { charcoal: 'text-charcoal', brand: 'text-brand', white: 'text-white' };
---

<Tag
  class:list={[
    'font-sans font-light uppercase tracking-[0.12em] md:tracking-[0.15em] leading-snug text-balance',
    sizes[size],
    tones[tone],
    align === 'center' ? 'text-center' : 'text-left',
    className,
  ]}
>
  <slot />
</Tag>
