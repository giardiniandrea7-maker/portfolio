---
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/600.css';

import LogoFirma from '~/components/LogoFirma.astro';
import { siteMenuLinks, siteContacts, siteQualifica } from '~/navigation';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  data-site-header
  class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-charcoal/10 transition-shadow duration-300 [&.is-scrolled]:shadow-[0_6px_24px_-12px_rgba(0,40,22,0.25)]"
>
  <div class="max-w-7xl mx-auto px-4 md:px-8 h-16 md:h-20 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center shrink-0" aria-label="Andrea Giardini, Consulente Finanziario — Home">
      <LogoFirma nameClass="lg:hidden xl:flex" />
    </a>

    <!-- Navigazione desktop -->
    <nav aria-label="Menu principale" class="hidden lg:flex h-full items-stretch gap-0.5 xl:gap-1.5">
      {
        siteMenuLinks.map((link) => {
          const active = !link.href.includes('#') && currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative flex items-center px-2.5 xl:px-3 whitespace-nowrap text-xs uppercase tracking-[0.15em] text-charcoal hover:text-brand transition-colors',
                "after:absolute after:left-3 after:right-3 after:top-0 after:h-[3px] after:bg-ember after:origin-left after:transition-transform after:duration-300",
                active ? 'after:scale-x-100 text-brand' : 'after:scale-x-0 hover:after:scale-x-100',
              ]}
            >
              {link.text}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={siteContacts.areaClientiFideuram}
        target="_blank"
        rel="noopener"
        class="hidden 2xl:inline-flex items-center whitespace-nowrap border border-brand text-brand uppercase tracking-[0.12em] text-[11px] py-2.5 px-4 hover:bg-brand hover:text-white transition-colors"
      >
        Area clienti
      </a>
      <a
        href="/contatti"
        class="hidden lg:inline-flex items-center whitespace-nowrap bg-brand text-white uppercase tracking-[0.12em] text-[11px] py-2.5 px-4 hover:bg-brand-light transition-colors"
      >
        Prenota un incontro
      </a>
      <button
        type="button"
        data-home-menu-open
        aria-controls="home-menu"
        aria-expanded="false"
        aria-label="Apri il menu"
        class="lg:hidden w-11 h-11 -mr-2 flex flex-col items-center justify-center gap-[6px]"
      >
        <span class="block w-6 h-px bg-charcoal"></span>
        <span class="block w-6 h-px bg-charcoal"></span>
        <span class="block w-6 h-px bg-charcoal"></span>
      </button>
    </div>
  </div>
</header>

<!-- Menu a schermo intero -->
<div
  id="home-menu"
  data-home-menu
  data-lenis-prevent
  role="dialog"
  aria-modal="true"
  aria-label="Menu principale"
  class="fixed inset-0 z-50 bg-white [&:not([hidden])]:flex flex-col overflow-y-auto"
  hidden
>
  <div class="max-w-6xl w-full mx-auto px-4 md:px-8 h-16 md:h-20 flex items-center justify-between shrink-0">
    <LogoFirma />
    <button
      type="button"
      data-home-menu-close
      aria-label="Chiudi il menu"
      class="w-11 h-11 -mr-2 flex items-center justify-center"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-charcoal">
        <path d="M5 5l14 14M19 5L5 19"></path>
      </svg>
    </button>
  </div>

  <nav class="max-w-6xl w-full mx-auto px-4 md:px-8 pt-8 md:pt-12 flex-1" aria-label="Menu">
    <ul class="flex flex-col gap-1">
      {
        siteMenuLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-home-menu-link
              class="group relative block py-3 pl-5 uppercase tracking-[0.15em] text-base md:text-lg text-charcoal hover:text-brand transition-colors"
            >
              <span
                aria-hidden="true"
                class="absolute left-0 top-1/2 -translate-y-1/2 h-6 w-[3px] bg-brand opacity-0 group-[.is-active]:opacity-100 transition-opacity"
              />
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-col sm:flex-row gap-3 max-w-xl">
      <a
        href="/contatti"
        data-home-menu-link
        class="flex-1 text-center bg-brand text-white uppercase tracking-[0.15em] text-sm py-4 px-6 hover:bg-brand/90 transition-colors"
      >
        Prenota un incontro
      </a>
      <a
        href={siteContacts.areaClientiFideuram}
        target="_blank"
        rel="noopener"
        class="flex-1 text-center bg-charcoal text-white uppercase tracking-[0.15em] text-sm py-4 px-6 hover:bg-charcoal/90 transition-colors"
      >
        Area clienti Fideuram
      </a>
    </div>
  </nav>

  <div class="bg-charcoal mt-12 shrink-0">
    <div class="max-w-6xl mx-auto px-4 md:px-8 py-8">
      <p class="text-white uppercase tracking-[0.15em] text-sm">Andrea Giardini</p>
      <p class="mt-2 text-white/80 text-xs md:text-sm leading-relaxed">{siteQualifica.estesa}</p>
    </div>
  </div>
</div>

<script>
  import { onPageLoad } from '~/scripts/page-load';
  function initHomeMenu() {
    const menu = document.querySelector<HTMLElement>('[data-home-menu]');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-home-menu-open]');
    if (!menu || !openBtn || menu.dataset.ready) return;
    menu.dataset.ready = 'true';

    // Voce attiva: in home la sezione in cui si trova l'utente, altrove la pagina corrente
    const markActive = () => {
      const links = menu.querySelectorAll<HTMLAnchorElement>('nav li a');
      const path = location.pathname.replace(/\/$/, '') || '/';
      let activeHref = path === '/' ? '' : path;
      if (path === '/') {
        for (const id of ['chi-sono']) {
          const section = document.getElementById(id);
          if (section && section.getBoundingClientRect().top <= 120) activeHref = `/#${id}`;
        }
      }
      let marked = false;
      links.forEach((a) => {
        const isActive = !marked && activeHref !== '' && a.getAttribute('href') === activeHref;
        if (isActive) marked = true;
        a.classList.toggle('is-active', isActive);
        if (isActive) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };

    const open = () => {
      markActive();
      menu.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      menu.querySelector<HTMLButtonElement>('[data-home-menu-close]')?.focus();
    };
    const close = () => {
      menu.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      openBtn.focus();
    };

    openBtn.addEventListener('click', open);
    menu.querySelector('[data-home-menu-close]')?.addEventListener('click', close);
    menu.querySelectorAll('[data-home-menu-link]').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) close();
    });
  }

  onPageLoad(initHomeMenu);

  // Ombra morbida sull'header quando la pagina scorre
  function initHeaderShadow() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.ready) return;
    header.dataset.ready = 'true';
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
  onPageLoad(initHeaderShadow);
  document.addEventListener('astro:before-swap', () => {
    document.documentElement.style.overflow = '';
  });
</script>
