---
// Card articolo della pagina /blog. I data-* servono alla ricerca client-side.
import Image from '~/components/common/Image.astro';
import type { Post } from '~/types';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
  // Card in evidenza (primo articolo, solo da lg): occupa 2 colonne e 2 righe
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

const image = await findImage(post.image);
const href = getPermalink(post.permalink, 'post');
const searchText = [post.title, post.excerpt ?? '', ...(post.tags ?? []).map((t) => t.title)].join(' ').toLowerCase();
---

<li data-post-card data-search={searchText} class:list={[featured && 'lg:col-span-2 lg:row-span-2']}>
  <article class="group bg-white h-full flex flex-col transition-shadow duration-300 hover:shadow-[0_22px_45px_-28px_rgba(0,40,22,0.45)]">
    <a
      href={href}
      class:list={['block aspect-video bg-gray-200 overflow-hidden', featured && 'lg:aspect-auto lg:flex-1 lg:min-h-[340px]']}
      tabindex="-1"
      aria-hidden="true"
      transition:name={`cover-${post.slug}`}
    >
      {
        image && (
          <Image
            src={image}
            alt=""
            widths={[400, 800]}
            width={400}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 400px"
            aspectRatio="16:9"
            layout="cover"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
          />
        )
      }
    </a>
    <div class="flex flex-col flex-1 p-5 md:p-6">
      <h2 class:list={['font-sans font-medium uppercase tracking-[0.12em] text-charcoal leading-snug', featured ? 'text-sm md:text-base lg:text-xl' : 'text-sm md:text-base']}>
        <a href={href} class="hover:text-brand transition-colors">{post.title}</a>
      </h2>
      {post.excerpt && <p class="mt-3 text-sm text-charcoal/80 leading-relaxed line-clamp-3">{post.excerpt}</p>}
      <div class="mt-auto pt-6 flex items-end justify-between gap-4">
        <time datetime={post.publishDate.toISOString()} class="text-xs text-charcoal/60">
          {getFormattedDate(post.publishDate)}
        </time>
        <a
          href={href}
          class="inline-block uppercase tracking-[0.15em] text-xs font-semibold text-charcoal border-b-[3px] border-ember pb-1 hover:text-brand transition-colors"
        >
          Leggi di più
        </a>
      </div>
    </div>
  </article>
</li>
