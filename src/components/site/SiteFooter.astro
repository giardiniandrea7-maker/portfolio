---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import Placeholder from './Placeholder.astro';
import { siteMenuLinks, siteContacts, siteOffice, officeMapsUrl, siteMandante } from '~/navigation';
import { findLatestPosts } from '~/utils/blog';
import { findAssetImage } from '~/utils/home-assets';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

const posts = await findLatestPosts({ count: 2 });

const fideuram = findAssetImage('fideuram-logo.svg');

const social = [
  { label: 'WhatsApp', text: 'Scrivimi su WhatsApp', icon: 'tabler:brand-whatsapp', href: siteContacts.whatsapp },
  { label: 'LinkedIn', text: 'Seguimi su LinkedIn', icon: 'tabler:brand-linkedin', href: siteContacts.linkedin },
  { label: 'Instagram', text: 'Seguimi su Instagram', icon: 'tabler:brand-instagram', href: siteContacts.instagram },
];

const pagineUtili = [
  { text: 'Informativa privacy', href: '/privacy-policy' },
  { text: 'Cookie policy', href: '/cookie-policy' },
  { text: 'Note legali', href: '/note-legali' },
];

const blogItems = await Promise.all(
  posts.map(async (post) => ({
    post,
    image: await findImage(post.image),
    href: getPermalink(post.permalink, 'post'),
  }))
);

const colTitle = 'uppercase tracking-[0.15em] text-xs font-semibold text-charcoal mb-5';
const linkClass = 'text-sm text-charcoal hover:text-brand transition-colors';
---

<!-- Fascia social -->
<section class="bg-sand">
  <div class="max-w-6xl mx-auto px-4 md:px-8 py-5 flex justify-end gap-5 lg:gap-10">
    {
      social.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener"
          aria-label={s.label}
          class="group flex items-center gap-2 text-charcoal hover:text-brand-dark transition-colors"
        >
          <Icon name={s.icon} class="w-7 h-7 lg:w-5 lg:h-5 transition-transform duration-300 group-hover:-translate-y-0.5" />
          <span class="hidden lg:inline text-xs uppercase tracking-[0.15em] font-medium">{s.text}</span>
        </a>
      ))
    }
  </div>
</section>

<!-- Footer / contatti -->
<footer id="contatti" class="bg-ivory scroll-mt-16 md:scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4 md:px-8 py-14 md:py-20 grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-8">
    <nav aria-label="Menu del footer">
      <h2 class={colTitle}>Menù</h2>
      <ul class="space-y-3">
        {
          siteMenuLinks.map((link) => (
            <li>
              <a href={link.href} class={`${linkClass} uppercase tracking-[0.1em]`}>
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class={colTitle}>Contatti</h2>
      <dl class="space-y-5 text-sm text-charcoal">
        <div>
          <dt class="font-semibold mb-1">Telefono</dt>
          <dd>
            <button type="button" data-reveal-contact class="underline underline-offset-4 hover:text-brand transition-colors">
              Mostra numero di telefono
            </button>
            <a href={siteContacts.phoneHref} class={linkClass} hidden>{siteContacts.phone}</a>
          </dd>
        </div>
        <div>
          <dt class="font-semibold mb-1">Email</dt>
          <dd>
            <button type="button" data-reveal-contact class="underline underline-offset-4 hover:text-brand transition-colors">
              Mostra indirizzo email
            </button>
            <a href={`mailto:${siteContacts.email}`} class={`${linkClass} break-all`} hidden>{siteContacts.email}</a>
          </dd>
        </div>
        <div>
          <dt class="font-semibold mb-1">Ufficio</dt>
          <dd>
            <a href={officeMapsUrl} target="_blank" rel="noopener" class={linkClass}>
              {siteOffice.street}<br />
              {siteOffice.postalCode} {siteOffice.locality} ({siteOffice.region})
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <div>
      <h2 class={colTitle}>Pagine utili</h2>
      <ul class="space-y-3">
        {
          pagineUtili.map((p) => (
            <li>
              <a href={p.href} class={linkClass}>
                {p.text}
              </a>
            </li>
          ))
        }
        <li>
          <button type="button" data-cookie-settings class={`${linkClass} text-left`}>Rivedi il consenso cookie</button>
        </li>
      </ul>
    </div>

    {
      blogItems.length > 0 && (
    <div>
      <h2 class={colTitle}>Ultime dal blog</h2>
      <ul class="space-y-4">
        {
          blogItems.map(({ post, image, href }) => (
            <li>
              <a href={href} class="flex gap-3 items-start group">
                <span class="w-20 shrink-0 aspect-video bg-gray-200 overflow-hidden">
                  {image && (
                    <Image
                      src={image}
                      alt=""
                      widths={[160]}
                      width={160}
                      aspectRatio="16:9"
                      layout="cover"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  )}
                </span>
                <span class="text-sm text-charcoal leading-snug line-clamp-3 group-hover:text-brand transition-colors">
                  {post.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
      )
    }
  </div>
</footer>

<!-- Disclaimer -->
<section class="bg-brand-dark">
  <div class="max-w-6xl mx-auto px-4 md:px-8 py-10 md:py-12 text-white/75">
    <p class="text-xs md:text-sm leading-relaxed max-w-4xl">
      Le informazioni contenute nel presente sito, curate da Andrea Giardini, hanno finalità esclusivamente informative
      e non costituiscono raccomandazioni personalizzate né ricerca in materia di investimenti. Prima di qualsiasi
      operazione è necessario sottoscrivere l'apposito contratto e consultare la documentazione d'offerta disponibile
      presso {siteMandante.name} e presso i consulenti finanziari abilitati all'offerta fuori sede.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      {
        fideuram ? (
          <!-- Logo a colori su riquadro bianco: leggibile anche sul fondo scuro -->
          <span class="inline-flex self-start bg-white rounded-[6px] px-3 py-2">
            <img src={fideuram.src} alt="Fideuram - Intesa Sanpaolo Private Banking" class="h-7 w-auto" />
          </span>
        ) : (
          <Placeholder label="logo Fideuram" dark class="h-9 w-36" />
        )
      }
      <p class="text-xs">© 2026 Andrea Giardini · P.IVA {siteContacts.vatId}</p>
    </div>
  </div>
</section>

<!-- Torna su: compare dopo un po' di scroll, sopra il bottone WhatsApp -->
<button
  type="button"
  data-back-to-top
  aria-label="Torna all'inizio della pagina"
  class="fixed bottom-[5.5rem] right-6 z-30 w-11 h-11 rounded-full bg-white text-charcoal shadow-md border border-charcoal/10 flex items-center justify-center opacity-0 translate-y-2 pointer-events-none transition-all duration-300 hover:text-brand [&.is-visible]:opacity-100 [&.is-visible]:translate-y-0 [&.is-visible]:pointer-events-auto"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"></path></svg>
</button>

<!-- WhatsApp flottante -->
<a
  href={siteContacts.whatsapp}
  target="_blank"
  rel="noopener"
  aria-label="Scrivimi su WhatsApp"
  class="fixed bottom-5 right-5 z-30 w-14 h-14 rounded-full bg-brand text-white shadow-lg flex items-center justify-center hover:bg-brand/90 transition-colors"
>
  <Icon name="tabler:brand-whatsapp" class="w-7 h-7" />
</a>

<script>
  import { onPageLoad } from '~/scripts/page-load';
  function initRevealContacts() {
    document.querySelectorAll<HTMLButtonElement>('[data-reveal-contact]').forEach((btn) => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = 'true';
      btn.addEventListener('click', () => {
        const link = btn.nextElementSibling as HTMLAnchorElement | null;
        if (!link) return;
        link.hidden = false;
        btn.hidden = true;
        link.focus();
      });
    });
  }

  onPageLoad(initRevealContacts);

  function initBackToTop() {
    const btn = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
    if (!btn || btn.dataset.ready) return;
    btn.dataset.ready = 'true';
    const update = () => btn.classList.toggle('is-visible', window.scrollY > 700);
    update();
    window.addEventListener('scroll', update, { passive: true });
    btn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      document.getElementById('contenuto')?.focus({ preventScroll: true });
    });
  }
  onPageLoad(initBackToTop);
</script>
