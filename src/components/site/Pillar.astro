---
// Pilastro: cerchio grande con icona line-art, titolo maiuscolo e testo breve.
import { Icon } from 'astro-icon/components';

export interface Props {
  icon: string;
  title: string;
  text: string;
  circleColor?: 'white' | 'ivory';
}

const { icon, title, text, circleColor = 'white' } = Astro.props;
---

<li class="flex flex-col items-center text-center">
  <span
    class:list={[
      'w-60 h-60 md:w-52 md:h-52 lg:w-[280px] lg:h-[280px] rounded-full flex items-center justify-center',
      circleColor === 'white' ? 'bg-white' : 'bg-ivory',
    ]}
  >
    <Icon name={icon} class="w-24 h-24 lg:w-28 lg:h-28 text-charcoal [&_*]:stroke-[0.75]" aria-hidden="true" />
  </span>
  <h3 class="mt-8 font-sans font-medium uppercase tracking-[0.15em] text-base md:text-lg text-charcoal">
    {title}
  </h3>
  <p class="mt-3 max-w-xs text-sm md:text-base text-charcoal/80 leading-relaxed">{text}</p>
</li>
