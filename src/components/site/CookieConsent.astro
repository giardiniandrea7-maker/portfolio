---
// Banner e pannello preferenze cookie, presente su tutte le pagine.
// Qualsiasi elemento [data-cookie-settings] riapre il pannello ("Rivedi il consenso cookie").
---

<div
  data-cookie-banner
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-title"
  class="fixed inset-x-0 bottom-0 z-[60] bg-white border-t border-[#1E2421]/15 shadow-[0_-8px_24px_rgba(0,0,0,0.08)] font-sans text-[#1E2421]"
  hidden
>
  <div class="relative max-w-5xl mx-auto px-4 md:px-8 py-6 md:py-7">
    <button
      type="button"
      data-cookie-reject
      aria-label="Chiudi e continua con i soli cookie necessari"
      class="absolute top-3 right-3 w-10 h-10 flex items-center justify-center text-[#1E2421]/70 hover:text-[#1E2421]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>

    <p id="cookie-title" class="uppercase tracking-[0.15em] text-sm font-semibold pr-10">La tua privacy</p>
    <p class="mt-3 text-sm leading-relaxed max-w-3xl">
      Uso solo cookie tecnici necessari al funzionamento del sito. Con il tuo consenso attivo anche la mappa di Google
      Maps nella pagina Contatti, che può impostare cookie propri. Puoi
      cambiare idea in ogni momento da «Rivedi il consenso cookie» in fondo alla pagina. Dettagli nella
      <a href="/cookie-policy" class="underline underline-offset-4">cookie policy</a>.
    </p>

    <div data-cookie-prefs class="mt-5 border border-[#1E2421]/15 rounded-[6px] divide-y divide-[#1E2421]/10" hidden>
      <div class="flex items-start justify-between gap-4 p-4">
        <div>
          <p class="text-sm font-semibold">Necessari</p>
          <p class="text-xs leading-relaxed mt-1">Ricordano la tua scelta sui cookie e mantengono il sito sicuro. Sempre attivi.</p>
        </div>
        <span class="text-xs uppercase tracking-wider text-[#006937] shrink-0 pt-0.5">Sempre attivi</span>
      </div>
      <label class="flex items-start justify-between gap-4 p-4 cursor-pointer">
        <span>
          <span class="block text-sm font-semibold">Contenuti di servizi esterni</span>
          <span class="block text-xs leading-relaxed mt-1">Google Maps (mappa dell'ufficio nella pagina Contatti).</span>
        </span>
        <input type="checkbox" data-cookie-esterni class="mt-1 w-5 h-5 accent-[#006937] shrink-0" />
      </label>
    </div>

    <div class="mt-5 flex flex-col sm:flex-row sm:flex-wrap gap-3">
      <button type="button" data-cookie-reject class="sm:flex-1 border border-[#1E2421] bg-[#1E2421] text-white uppercase tracking-[0.12em] text-xs py-3.5 px-5 hover:bg-[#006937] hover:border-[#006937] transition-colors">
        Solo necessari
      </button>
      <button type="button" data-cookie-customize class="sm:flex-1 border border-[#1E2421] text-[#1E2421] uppercase tracking-[0.12em] text-xs py-3.5 px-5 hover:bg-[#1E2421] hover:text-white transition-colors">
        Personalizza
      </button>
      <button type="button" data-cookie-save class="sm:flex-1 border border-[#1E2421] text-[#1E2421] uppercase tracking-[0.12em] text-xs py-3.5 px-5 hover:bg-[#1E2421] hover:text-white transition-colors" hidden>
        Salva le preferenze
      </button>
      <button type="button" data-cookie-accept class="sm:flex-1 border border-[#1E2421] bg-[#1E2421] text-white uppercase tracking-[0.12em] text-xs py-3.5 px-5 hover:bg-[#006937] hover:border-[#006937] transition-colors">
        Accetta tutti
      </button>
    </div>
  </div>
</div>

<script>
  import { onPageLoad } from '~/scripts/page-load';
  import { readConsent, saveConsent } from '~/scripts/consent';

  function initCookieConsent() {
    const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
    if (!banner || banner.dataset.ready) return;
    banner.dataset.ready = 'true';

    const prefs = banner.querySelector<HTMLElement>('[data-cookie-prefs]')!;
    const esterni = banner.querySelector<HTMLInputElement>('[data-cookie-esterni]')!;
    const customize = banner.querySelector<HTMLButtonElement>('[data-cookie-customize]')!;
    const save = banner.querySelector<HTMLButtonElement>('[data-cookie-save]')!;

    const open = (withPrefs: boolean) => {
      esterni.checked = readConsent()?.esterni === true;
      prefs.hidden = !withPrefs;
      customize.hidden = withPrefs;
      save.hidden = !withPrefs;
      banner.hidden = false;
    };
    const decide = (value: boolean) => {
      saveConsent(value);
      banner.hidden = true;
    };

    banner.querySelectorAll('[data-cookie-reject]').forEach((b) => b.addEventListener('click', () => decide(false)));
    banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => decide(true));
    customize.addEventListener('click', () => open(true));
    save.addEventListener('click', () => decide(esterni.checked));

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement | null)?.closest('[data-cookie-settings], a[href="#cookie-settings"]');
      if (!trigger) return;
      e.preventDefault();
      open(true);
    });

    if (!readConsent()) open(false);
  }

  onPageLoad(initCookieConsent);
</script>
