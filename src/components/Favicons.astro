---
// Icone generate da scripts/icons.mjs (npm run icons) dal simbolo del logo firma (public/logo-firma.*).
// Il suffisso di versione nei nomi obbliga browser, iPhone e Google a riscaricarle.
---

<link rel="icon" type="image/svg+xml" href="/favicon-v4.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-v4.png" />
<link rel="icon" href="/favicon-v4.ico" sizes="16x16 32x32 48x48" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v4.png" />
<link rel="mask-icon" href="/mask-icon-v4.svg" color="#1A7F1A" />
<link rel="manifest" href="/site-v4.webmanifest" />
<meta name="theme-color" content="#F5F1E8" />
