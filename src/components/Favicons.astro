---
// Icone generate da scripts/icons.mjs (npm run icons).
// Provvisorie: cerchio verde senza segni grafici, in attesa del logo firma ufficiale.
// Il suffisso di versione nei nomi obbliga browser, iPhone e Google a riscaricarle.
---

<link rel="icon" type="image/svg+xml" href="/favicon-v3.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-v3.png" />
<link rel="icon" href="/favicon-v3.ico" sizes="16x16 32x32 48x48" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v3.png" />
<link rel="mask-icon" href="/mask-icon-v3.svg" color="#006837" />
<link rel="manifest" href="/site-v3.webmanifest" />
<meta name="theme-color" content="#F5F1E8" />
