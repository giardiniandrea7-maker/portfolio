---
import Image from '~/components/common/Image.astro';
import SectionTitle from '~/components/site/SectionTitle.astro';
import type { Post } from '~/types';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;

const cards = await Promise.all(
  posts.map(async (post) => ({
    post,
    image: await findImage(post.image),
    href: getPermalink(post.permalink, 'post'),
  }))
);
---

{/* La sezione compare solo quando ci sono articoli pubblicati */}
{
  cards.length > 0 && (
    <section class="bg-linen py-16 md:py-24" data-home-carousel>
      <div class="max-w-6xl mx-auto px-4 md:px-8">
        <SectionTitle align="left" class="mb-8 md:mb-12">
          Ultime notizie dal blog
        </SectionTitle>

        <ul
          data-carousel-track
          class="flex gap-4 md:gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          data-lenis-prevent
        >
          {cards.map(({ post, image, href }) => (
            <li class="snap-start shrink-0 w-[85%] sm:w-[calc(50%-0.75rem)] lg:w-[calc((100%-3rem)/3)]">
              <article class="group bg-white h-full flex flex-col transition-shadow duration-300 hover:shadow-[0_22px_45px_-28px_rgba(0,40,22,0.45)]">
                <a href={href} class="block aspect-video bg-gray-200 overflow-hidden" tabindex="-1" aria-hidden="true">
                  {image && (
                    <Image
                      src={image}
                      alt=""
                      widths={[400, 800]}
                      width={400}
                      sizes="(max-width: 640px) 85vw, 400px"
                      aspectRatio="16:9"
                      layout="cover"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                    />
                  )}
                </a>
                <div class="flex flex-col flex-1 p-5 md:p-6">
                  <h3 class="font-sans text-base md:text-lg font-semibold tracking-normal text-charcoal leading-snug line-clamp-3">
                    <a href={href} class="hover:text-brand transition-colors">
                      {post.title}
                    </a>
                  </h3>
                  {post.excerpt && (
                    <p class="mt-3 text-sm text-charcoal/80 leading-relaxed line-clamp-4">{post.excerpt}</p>
                  )}
                  <div class="mt-auto pt-6 text-right">
                    <a
                      href={href}
                      class="inline-block uppercase tracking-[0.15em] text-xs font-semibold text-charcoal border-b-[3px] border-ember pb-1 hover:text-brand transition-colors"
                    >
                      Leggi di più
                    </a>
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>

        <div class="mt-6 flex gap-3">
          <button
            type="button"
            data-carousel-prev
            aria-label="Articolo precedente"
            class="w-11 h-11 bg-ivory text-charcoal flex items-center justify-center hover:bg-ember-light transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M15 6l-6 6 6 6" />
            </svg>
          </button>
          <button
            type="button"
            data-carousel-next
            aria-label="Articolo successivo"
            class="w-11 h-11 bg-ivory text-charcoal flex items-center justify-center hover:bg-ember-light transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M9 6l6 6-6 6" />
            </svg>
          </button>
        </div>
      </div>
    </section>
  )
}

<script>
  import { onPageLoad } from '~/scripts/page-load';
  function initHomeCarousel() {
    document.querySelectorAll<HTMLElement>('[data-home-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-carousel-track]');
      if (!track || root.dataset.ready) return;
      root.dataset.ready = 'true';
      const step = () => (track.firstElementChild as HTMLElement | null)?.offsetWidth ?? track.clientWidth;
      root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step() }));
      root.querySelector('[data-carousel-next]')?.addEventListener('click', () => track.scrollBy({ left: step() }));
    });
  }

  onPageLoad(initHomeCarousel);
</script>
