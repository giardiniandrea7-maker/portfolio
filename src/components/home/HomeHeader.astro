---
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/600.css';

import Placeholder from './Placeholder.astro';
import { homeMenuLinks, homeContacts } from '~/navigation';
import { findAssetImage } from '~/utils/home-assets';

const fideuramWhite = findAssetImage('fideuram-logo-white.svg');
---

<header class="sticky top-0 z-40 bg-white border-b border-charcoal/10">
  <div class="max-w-6xl mx-auto px-4 md:px-8 h-16 md:h-20 flex items-center justify-between">
    <a href="/" class="flex flex-col leading-tight">
      <span class="font-playfair uppercase tracking-[0.08em] text-sage text-lg md:text-xl">Andrea Giardini</span>
      <span class="font-sans text-xs md:text-sm text-charcoal">Consulente finanziario</span>
    </a>

    <button
      type="button"
      data-home-menu-open
      aria-controls="home-menu"
      aria-expanded="false"
      aria-label="Apri il menu"
      class="w-11 h-11 -mr-2 flex flex-col items-center justify-center gap-[6px]"
    >
      <span class="block w-6 h-px bg-charcoal"></span>
      <span class="block w-6 h-px bg-charcoal"></span>
      <span class="block w-6 h-px bg-charcoal"></span>
    </button>
  </div>
</header>

<!-- Menu a schermo intero -->
<div
  id="home-menu"
  data-home-menu
  data-lenis-prevent
  role="dialog"
  aria-modal="true"
  aria-label="Menu principale"
  class="fixed inset-0 z-50 bg-white [&:not([hidden])]:flex flex-col overflow-y-auto"
  hidden
>
  <div class="max-w-6xl w-full mx-auto px-4 md:px-8 h-16 md:h-20 flex items-center justify-between shrink-0">
    <span class="flex flex-col leading-tight">
      <span class="font-playfair uppercase tracking-[0.08em] text-sage text-lg md:text-xl">Andrea Giardini</span>
      <span class="font-sans text-xs md:text-sm text-charcoal">Consulente finanziario</span>
    </span>
    <button
      type="button"
      data-home-menu-close
      aria-label="Chiudi il menu"
      class="w-11 h-11 -mr-2 flex items-center justify-center"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-charcoal">
        <path d="M5 5l14 14M19 5L5 19"></path>
      </svg>
    </button>
  </div>

  <nav class="max-w-6xl w-full mx-auto px-4 md:px-8 pt-8 md:pt-12 flex-1" aria-label="Menu">
    <ul class="flex flex-col gap-1">
      {
        homeMenuLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-home-menu-link
              class="group relative block py-3 pl-5 uppercase tracking-[0.15em] text-base md:text-lg text-charcoal hover:text-sage transition-colors"
            >
              <span
                aria-hidden="true"
                class="absolute left-0 top-1/2 -translate-y-1/2 h-6 w-[3px] bg-sage opacity-0 group-[.is-active]:opacity-100 transition-opacity"
              />
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-col sm:flex-row gap-3 max-w-xl">
      <a
        href="#contatti"
        data-home-menu-link
        class="flex-1 text-center bg-sage text-white uppercase tracking-[0.15em] text-sm py-4 px-6 hover:bg-sage/90 transition-colors"
      >
        Prenota un incontro
      </a>
      <a
        href={homeContacts.areaClientiFideuram}
        class="flex-1 text-center bg-charcoal text-white uppercase tracking-[0.15em] text-sm py-4 px-6 hover:bg-charcoal/90 transition-colors"
      >
        Area clienti Fideuram
      </a>
    </div>
  </nav>

  <div class="bg-charcoal mt-12 shrink-0">
    <div class="max-w-6xl mx-auto px-4 md:px-8 py-8 flex items-center justify-between gap-6">
      <span class="text-white uppercase tracking-[0.15em] text-sm">Andrea Giardini</span>
      {
        fideuramWhite ? (
          <img src={fideuramWhite.src} alt="Fideuram" class="h-8 w-auto" />
        ) : (
          <Placeholder label="logo Fideuram bianco" dark class="h-10 w-36" />
        )
      }
    </div>
  </div>
</div>

<script>
  function initHomeMenu() {
    const menu = document.querySelector<HTMLElement>('[data-home-menu]');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-home-menu-open]');
    if (!menu || !openBtn || menu.dataset.ready) return;
    menu.dataset.ready = 'true';

    // La voce attiva è quella della sezione in cui si trova l'utente
    const markActive = () => {
      const links = menu.querySelectorAll<HTMLAnchorElement>('nav li a');
      let activeHref = '';
      for (const id of ['chi-sono', 'specializzazioni', 'contatti']) {
        const section = document.getElementById(id);
        if (section && section.getBoundingClientRect().top <= 120) activeHref = `#${id}`;
      }
      let marked = false;
      links.forEach((a) => {
        const isActive = !marked && activeHref !== '' && a.getAttribute('href') === activeHref;
        if (isActive) marked = true;
        a.classList.toggle('is-active', isActive);
        if (isActive) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };

    const open = () => {
      markActive();
      menu.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      menu.querySelector<HTMLButtonElement>('[data-home-menu-close]')?.focus();
    };
    const close = () => {
      menu.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      openBtn.focus();
    };

    openBtn.addEventListener('click', open);
    menu.querySelector('[data-home-menu-close]')?.addEventListener('click', close);
    menu.querySelectorAll('[data-home-menu-link]').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) close();
    });
  }

  document.addEventListener('astro:page-load', initHomeMenu);
  document.addEventListener('astro:before-swap', () => {
    document.documentElement.style.overflow = '';
  });
</script>
