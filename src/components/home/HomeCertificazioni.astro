---
import SectionTitle from '~/components/site/SectionTitle.astro';
import Placeholder from '~/components/site/Placeholder.astro';
import { findPublicFile } from '~/utils/home-assets';

const certificazioni = [
  {
    name: 'OCF',
    logo: findPublicFile('images/certificazioni/ocf.svg'),
    bullets: [
      "Consulente finanziario abilitato all'offerta fuori sede, incaricato da [TODO: società mandante S.p.A.].",
      "Iscrizione all'Albo unico dei consulenti finanziari n. 2965.",
      'In possesso dei requisiti di onorabilità e professionalità previsti dalla normativa.',
    ],
    link: {
      text: 'Verifica le credenziali',
      href: 'https://www.organismocf.it/portal/web/portale-ocf/ricerca-nelle-sezioni-dell-albo',
    },
  },
  {
    name: 'IVASS',
    logo: findPublicFile('images/certificazioni/ivass.png'),
    bullets: [
      'Intermediario iscritto al RUI con numero [TODO].',
      'Sede legale: [TODO].',
      'Per eventuali reclami: [TODO: URL reclami].',
    ],
    link: { text: 'Consulta il registro', href: 'https://ruipubblico.ivass.it/rui-pubblica/ng/' },
  },
];
---

<section class="bg-ivory py-16 md:py-24">
  <div class="max-w-3xl mx-auto px-4 md:px-8">
    <SectionTitle class="mb-10 md:mb-14">Le mie certificazioni</SectionTitle>

    <div class="flex flex-col gap-5 md:gap-6">
      {
        certificazioni.map((c) => {
          const [first, ...rest] = c.bullets;
          return (
            <article class="bg-white p-6 md:p-10">
              <div class="h-12 md:h-14 mb-6 flex items-center">
                {c.logo ? (
                  <img src={c.logo} alt={`Logo ${c.name}`} class="h-full w-auto" />
                ) : (
                  <Placeholder label={`logo ${c.name}`} class="h-full w-32" />
                )}
              </div>

              <ul class="list-disc pl-5 text-sm md:text-base text-charcoal leading-relaxed">
                <li>{first}</li>
              </ul>

              <details class="group mt-4">
                <summary class="flex items-center gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden text-sm uppercase tracking-[0.12em] text-charcoal select-none">
                  <span class="w-8 h-8 rounded-full border border-charcoal/40 flex items-center justify-center transition-transform group-open:rotate-180">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </span>
                  Scopri di più
                </summary>
                <ul class="list-disc pl-5 mt-4 space-y-2 text-sm md:text-base text-charcoal leading-relaxed">
                  {rest.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <a
                  href={c.link.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-block mt-5 text-sm md:text-base text-sage underline underline-offset-4 hover:text-charcoal transition-colors"
                >
                  {c.link.text}
                </a>
              </details>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
