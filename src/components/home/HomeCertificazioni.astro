---
import SectionTitle from '~/components/site/SectionTitle.astro';
import Placeholder from '~/components/site/Placeholder.astro';
import { findPublicImage } from '~/utils/home-assets';
import { siteMandante, siteRui } from '~/navigation';

const certificazioni = [
  {
    name: 'OCF',
    logo: findPublicImage('images/certificazioni/ocf'),
    logoClass: 'h-full w-auto',
    bullets: [
      `Consulente Finanziario abilitato all'offerta fuori sede, incaricato da ${siteMandante.name}`,
      "Iscrizione all'Albo unico dei consulenti finanziari n. 2965.",
      'In possesso dei requisiti di onorabilità e professionalità previsti dalla normativa (D.M. 472 dell’11/11/1998).',
    ],
    link: {
      text: 'Verifica le credenziali',
      href: 'https://www.organismocf.it/portal/web/portale-ocf/ricerca-nelle-sezioni-dell-albo',
    },
  },
  {
    name: 'IVASS',
    logo: findPublicImage('images/certificazioni/ivass'),
    // Il file IVASS ha ampi margini bianchi: lo ingrandisco per compensare
    logoClass: 'h-[180%] w-auto -ml-[6%]',
    bullets: [
      `Collaboratore di intermediario iscritto al RUI, sezione ${siteRui.section}, con numero ${siteRui.number} dal ${siteRui.since}.`,
      `Opera per ${siteMandante.name}, iscritta in sezione ${siteMandante.ruiSection} con numero ${siteMandante.ruiNumber}.`,
      `Sede legale: ${siteMandante.sedeLegale}.`,
      `Per eventuali reclami: <a href="${siteMandante.reclamiUrl}" target="_blank" rel="noopener" class="underline underline-offset-4 decoration-ember">pagina reclami di Fideuram</a>.`,
    ],
    link: { text: 'Consulta il registro', href: 'https://ruipubblico.ivass.it/rui-pubblica/ng/' },
  },
];
---

<section class="bg-ivory py-16 md:py-24">
  <div class="max-w-5xl mx-auto px-4 md:px-8">
    <SectionTitle class="mb-10 md:mb-14">Le mie certificazioni</SectionTitle>

    <div class="reveal-stagger grid grid-cols-1 lg:grid-cols-2 gap-5 md:gap-6">
      {
        certificazioni.map((c) => {
          const [first, ...rest] = c.bullets;
          const linkEl = (
            <a
              href={c.link.href}
              target="_blank"
              rel="noopener"
              class="inline-block mt-5 text-sm md:text-base text-brand underline underline-offset-4 decoration-ember hover:text-charcoal transition-colors"
            >
              {c.link.text}
            </a>
          );
          return (
            <article class="bg-white p-6 md:p-10 flex flex-col transition-shadow duration-300 hover:shadow-[0_18px_40px_-24px_rgba(0,40,22,0.35)]">
              <div class="h-12 md:h-14 mb-6 flex items-center">
                {c.logo ? (
                  <img src={c.logo} alt={`Logo ${c.name}`} class={c.logoClass} />
                ) : (
                  <Placeholder label={`logo ${c.name}`} class="h-full w-32" />
                )}
              </div>

              <!-- Desktop: tutti i punti visibili -->
              <div class="hidden lg:flex flex-col flex-1">
                <ul class="list-disc pl-5 space-y-3 text-[15px] text-charcoal leading-relaxed marker:text-ember">
                  {c.bullets.map((b) => (
                    <li set:html={b} />
                  ))}
                </ul>
                <div class="mt-auto pt-2">{linkEl}</div>
              </div>

              <!-- Mobile: primo punto + tendina -->
              <div class="lg:hidden">
                <ul class="list-disc pl-5 text-sm md:text-base text-charcoal leading-relaxed marker:text-ember">
                  <li set:html={first} />
                </ul>

                <details class="group mt-4">
                  <summary class="flex items-center gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden text-sm uppercase tracking-[0.12em] text-charcoal select-none">
                    <span class="w-8 h-8 rounded-full border border-charcoal/40 flex items-center justify-center transition-transform group-open:rotate-180">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 9l6 6 6-6" />
                      </svg>
                    </span>
                    Scopri di più
                  </summary>
                  <ul class="list-disc pl-5 mt-4 space-y-2 text-sm md:text-base text-charcoal leading-relaxed marker:text-ember">
                    {rest.map((b) => (
                      <li set:html={b} />
                    ))}
                  </ul>
                  {linkEl}
                </details>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
