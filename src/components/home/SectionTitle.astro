---
// Titolo di sezione stile istituzionale: Manrope light, maiuscolo, tracking ampio.
export interface Props {
  as?: 'h1' | 'h2';
  size?: 'md' | 'lg';
  align?: 'left' | 'center';
  class?: string;
}

const { as: Tag = 'h2', size = 'md', align = 'center', class: className = '' } = Astro.props;
---

<Tag
  class:list={[
    'font-sans font-light uppercase tracking-[0.15em] text-charcoal leading-snug',
    size === 'lg' ? 'text-2xl md:text-4xl' : 'text-lg md:text-2xl',
    align === 'center' ? 'text-center' : 'text-left',
    className,
  ]}
>
  <slot />
</Tag>
