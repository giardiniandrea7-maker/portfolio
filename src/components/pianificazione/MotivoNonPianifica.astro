---
// Card per le 4 ragioni della Sezione 2 "Perche' molti non pianificano".
// Numero grande in stile editoriale + titolo + paragrafo.
interface Props {
  numero: number;
  titolo: string;
  testo: string;
}
const { numero, titolo, testo } = Astro.props;
---

<article
  class="reveal group flex flex-col gap-3 rounded-2xl border border-[var(--aw-color-primary)]/15 bg-white p-7 md:p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-[var(--aw-color-primary)]/40"
>
  <span
    class="font-display text-5xl md:text-6xl font-semibold leading-none text-[var(--aw-color-primary)]/90"
    aria-hidden="true"
  >
    {numero}
  </span>
  <h3 class="font-display text-xl md:text-2xl font-medium leading-snug text-[var(--aw-color-text-heading)]">
    {titolo}
  </h3>
  <p class="text-base md:text-lg leading-relaxed text-[var(--aw-color-text-default)]">
    {testo}
  </p>
</article>
