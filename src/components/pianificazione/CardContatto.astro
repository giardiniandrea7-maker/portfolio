---
// Card singola del metodo di contatto Sezione 6.
// Tre varianti di icona: 'modulo', 'email', 'whatsapp'.

interface Props {
  titolo: string;
  testo: string;
  href: string;
  icona: 'modulo' | 'email' | 'whatsapp';
  /** Se true, lo link viene aperto nella stessa scheda (es. anchor #form). */
  sameTab?: boolean;
}

const { titolo, testo, href, icona, sameTab = false } = Astro.props;
const target = sameTab || href.startsWith('#') ? undefined : '_blank';
const rel = target === '_blank' ? 'noopener noreferrer' : undefined;
---

<a
  href={href}
  target={target}
  rel={rel}
  class="reveal group flex flex-col items-center text-center gap-4 rounded-2xl border border-[var(--aw-color-primary)]/15 bg-white p-7 md:p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-[var(--aw-color-primary)]/40"
>
  <span
    class="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--aw-color-primary)]/10 text-[var(--aw-color-primary)] group-hover:bg-[var(--aw-color-primary)] group-hover:text-white transition-colors"
    aria-hidden="true"
  >
    {icona === 'modulo' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="9" y1="13" x2="15" y2="13"/>
        <line x1="9" y1="17" x2="15" y2="17"/>
      </svg>
    )}
    {icona === 'email' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
    )}
    {icona === 'whatsapp' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
    )}
  </span>

  <h3 class="font-display text-lg md:text-xl font-medium text-[var(--aw-color-text-heading)]">
    {titolo}
  </h3>
  <p class="text-base text-[var(--aw-color-text-default)] leading-relaxed break-all">
    {testo}
  </p>
</a>
