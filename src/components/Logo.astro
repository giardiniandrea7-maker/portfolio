---
import { getHomePermalink } from '~/utils/permalinks';
import logoSrc from '~/assets/images/logo-ag.png';
import { Image } from 'astro:assets';
---

<a
  class="flex items-center gap-3 shrink-0"
  href={getHomePermalink()}
  aria-label="Andrea Giardini — Home"
>
  <Image src={logoSrc} alt="Monogramma AG — Andrea Giardini" height={48} class="h-10 md:h-12 w-auto" />

  <span class="hidden sm:block w-px h-8 bg-gray-300"></span>

  <span class="hidden sm:flex flex-col leading-tight">
    <span class="text-sm md:text-base font-bold tracking-tight text-[var(--aw-color-text-heading)] whitespace-nowrap">
      Andrea Giardini
    </span>
    <span class="text-[10px] md:text-[11px] font-medium tracking-[0.12em] uppercase text-[var(--aw-color-text-muted)] whitespace-nowrap">
      Consulente Finanziario
    </span>
  </span>
</a>
