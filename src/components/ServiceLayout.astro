<!-- ======================================================
     FORM RICHIESTA
     ====================================================== -->
{showForm && (
  <section id="form-richiesta" class="reveal bg-white pb-16 md:pb-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="bg-white border border-gray-200 rounded-md shadow-xl p-8 md:p-12">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--aw-color-text-heading)] mb-4 font-heading">
          {formTitle}
        </h2>

        {formSubtitle.length > 0 && (
          <div class="mb-10 space-y-2 text-sm md:text-base text-[var(--aw-color-text-muted)]">
            {formSubtitle.map((s) => (
              <p set:html={s} />
            ))}
          </div>
        )}

        <form id="service-form" class="space-y-6" action="https://api.web3forms.com/submit" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="access_key" value="0d00a04d-f883-4684-ba20-f0f134c63d36" />
          <input type="hidden" name="subject" value="Nuova richiesta servizio da giardiniconsulenza.it" />
          <input type="hidden" name="from_name" value="giardiniconsulenza.it" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <!-- Nome -->
          <div>
            <label for="svc-name" class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
              1. Nome <span class="text-[rgb(160_50_50)]">*</span>
            </label>
            <input type="text" id="svc-name" name="name" required
