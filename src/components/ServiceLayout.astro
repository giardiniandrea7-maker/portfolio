                  <option value="responsabile">Responsabile tesoreria</option>
                  <option value="consulente">Commercialista / Consulente</option>
                  <option value="altro">Altro</option>
                </select>
              </div>

              <!-- Anni di attività -->
              <div>
                <label for="svc-years" class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
                  6. Da quanti anni è aperta l'azienda?
                </label>
                <select id="svc-years" name="company_age" class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] focus:ring-1 focus:ring-[var(--aw-color-primary)] bg-white transition-colors">
                  <option value="">Seleziona...</option>
                  <option value="0-2">Meno di 2 anni</option>
                  <option value="2-5">Da 2 a 5 anni</option>
                  <option value="5-10">Da 5 a 10 anni</option>
                  <option value="10-20">Da 10 a 20 anni</option>
                  <option value="20+">Oltre 20 anni</option>
                </select>
              </div>

              <!-- Fatturato -->
              <div>
                <label for="svc-revenue" class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
                  7. A quanto ammonta il fatturato dell'azienda?
                </label>
                <select id="svc-revenue" name="revenue" class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] focus:ring-1 focus:ring-[var(--aw-color-primary)] bg-white transition-colors">
                  <option value="">Seleziona...</option>
                  <option value="0-500k">Fino a 500.000 €</option>
                  <option value="500k-1m">Da 500.000 € a 1 milione €</option>
                  <option value="1m-5m">Da 1 a 5 milioni €</option>
                  <option value="5m-10m">Da 5 a 10 milioni €</option>
                  <option value="10m+">Oltre 10 milioni €</option>
                </select>
              </div>

              <!-- Liquidità disponibile -->
              <div>
                <label for="svc-liquidity" class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
                  8. A quanto ammonta la liquidità disponibile in azienda?
                </label>
                <select id="svc-liquidity" name="liquidity" class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] focus:ring-1 focus:ring-[var(--aw-color-primary)] bg-white transition-colors">
                  <option value="">Seleziona...</option>
                  <option value="0-100k">Fino a 100.000 €</option>
                  <option value="100k-250k">Da 100.000 € a 250.000 €</option>
                  <option value="250k-500k">Da 250.000 € a 500.000 €</option>
                  <option value="500k-1m">Da 500.000 € a 1 milione €</option>
                  <option value="1m+">Oltre 1 milione €</option>
                </select>
              </div>

              <!-- Investimenti attivi -->
              <div>
                <label for="svc-investments" class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
                  9. L'azienda ha già degli investimenti attivi?
                </label>
                <select id="svc-investments" name="active_investments" class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] focus:ring-1 focus:ring-[var(--aw-color-primary)] bg-white transition-colors">
                  <option value="">Seleziona...</option>
                  <option value="si">Sì</option>
                  <option value="no">No</option>
                  <option value="valutando">Stiamo valutando</option>
                </select>
              </div>
            </>
          )}

          <!-- Messaggio -->
          <div>
            <label for="svc-message" class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
              {formMode === 'business' ? '10.' : (showInvestmentDate ? '6.' : '5.')}
              {formMode === 'business' ? " Scrivi sinteticamente la situazione dell'azienda in questione. Nei box successivi carica eventuali file se necessari." : ' Messaggio'}
              <span class="text-[rgb(160_50_50)]">*</span>
            </label>
            <p class="text-xs text-[var(--aw-color-text-muted)] mb-2">Ulteriori informazioni</p>
            <textarea id="svc-message" name="message" rows="5" required maxlength="2000"
              class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] focus:ring-1 focus:ring-[var(--aw-color-primary)] transition-colors resize-y"></textarea>
            <p class="text-xs text-right text-[var(--aw-color-text-muted)] mt-1">0/2000</p>
          </div>

          <!-- Upload file -->
          {showFileUpload && formMode === 'standard' && (
            <div>
              <label class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
                {showInvestmentDate ? '7.' : '6.'} Carica i file qui sotto
              </label>
              <div class="relative border-2 border-dashed border-gray-300 rounded-md p-8 text-center hover:border-[var(--aw-color-primary)] transition-colors bg-[rgb(238_247_246)]/30">
                <input type="file" id="svc-files" name="files" multiple
                  class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                  accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.csv"/>
                <div class="flex flex-col items-center gap-3 pointer-events-none">
                  <div class="w-14 h-14 rounded-full bg-[var(--aw-color-primary)]/10 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                      <polyline points="17 8 12 3 7 8"/>
                      <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                  </div>
                  <p class="text-sm text-[var(--aw-color-text-default)]">
                    <span class="text-[var(--aw-color-primary)] font-semibold underline">Scegli un file da caricare</span>
                    <span class="text-[var(--aw-color-text-muted)]"> o trascinali e rilasciali qui</span>
                  </p>
                  <p class="text-xs text-[var(--aw-color-text-muted)]">PDF, immagini, Excel, CSV (max 10MB)</p>
                </div>
              </div>
            </div>
          )}

          <!-- 3 Upload file (business mode) -->
          {showFileUpload && formMode === 'business' && (
            <>
              {[1, 2, 3].map((n) => (
                <div>
                  <label class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
                    {10 + n}. Carica File {n}
                  </label>
                  <div class="relative border-2 border-dashed border-gray-300 rounded-md p-6 text-center hover:border-[var(--aw-color-primary)] transition-colors bg-[rgb(238_247_246)]/30">
                    <input type="file" name={`file_${n}`}
                      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                      accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.csv,.doc,.docx"/>
                    <div class="flex flex-col items-center gap-2 pointer-events-none">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                      </svg>
                      <p class="text-sm">
                        <span class="text-[var(--aw-color-primary)] font-semibold underline">Scegli un file da caricare</span>
                        <span class="text-[var(--aw-color-text-muted)]"> o trascinali e rilasciali qui</span>
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </>
          )}

          <!-- Privacy -->
          <div>
            <label class="flex items-start gap-3 text-sm text-[var(--aw-color-text-default)] cursor-pointer">
              <input type="checkbox" required
                class="mt-0.5 w-4 h-4 text-[var(--aw-color-primary)] border-gray-300 rounded focus:ring-[var(--aw-color-primary)]"/>
              <span>
                Dichiaro di aver letto la <a href="/privacy" class="text-[var(--aw-color-primary)] underline underline-offset-2 hover:text-[var(--aw-color-accent)]">privacy policy</a>
                e acconsento al trattamento dei dati ivi indicato. <span class="text-[rgb(160_50_50)]">*</span>
              </span>
            </label>
          </div>

          <!-- Submit -->
          <div class="pt-4 flex justify-end">
            <button type="submit" id="service-submit"
              class="px-10 py-3.5 bg-[var(--aw-color-primary)] hover:bg-[var(--aw-color-secondary)] text-white font-semibold rounded-sm transition-colors shadow-md hover:shadow-lg">
              Invia
            </button>
          </div>

          <div id="service-result" class="hidden rounded-sm p-4 text-sm font-semibold text-center"></div>
        </form>
      </div>

    </div>
  </section>
)}

<script>
  import '~/utils/web3forms';
  // Contatore caratteri messaggio
  const textarea = document.querySelector('#svc-message') as HTMLTextAreaElement | null;
  const counter = textarea?.parentElement?.querySelector('.text-xs.text-right') as HTMLElement | null;
  if (textarea && counter) {
    textarea.addEventListener('input', () => {
      counter.textContent = `${textarea.value.length}/2000`;
    });
  }

  // Mostra nome file caricato
  const fileInput = document.querySelector('#svc-files') as HTMLInputElement | null;
  if (fileInput) {
    fileInput.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const files = target.files;
      if (files && files.length > 0) {
        const dropzone = target.parentElement;
        if (dropzone) {
          const label = dropzone.querySelector('p.text-sm') as HTMLElement | null;
          if (label) {
            const names = Array.from(files).map((f) => f.name).join(', ');
            label.innerHTML = `<span class="text-[var(--aw-color-primary)] font-semibold">✓ ${files.length} file selezionati:</span> <span class="text-[var(--aw-color-text-default)]">${names}</span>`;
          }
        }
      }
    });
  }
</script>
