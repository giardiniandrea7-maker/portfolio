          <!-- Email -->
          <div>
            <label for="svc-email" class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
              3. Email <span class="text-[rgb(160_50_50)]">*</span>
            </label>
            <input type="email" id="svc-email" name="email" required
              class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] focus:ring-1 focus:ring-[var(--aw-color-primary)] transition-colors"/>
          </div>

          <!-- Inizio investimenti (opzionale) -->
          {showInvestmentDate && (
            <div>
              <label for="svc-invdate" class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
                4. Indicativamente quando hai iniziato a investire?
              </label>
              <input type="text" id="svc-invdate" name="investment_date" placeholder="es. 2020, 5 anni fa, da poco..."
                class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] focus:ring-1 focus:ring-[var(--aw-color-primary)] transition-colors"/>
            </div>
          )}

          <!-- Contatto telefonico -->
          <div>
            <label class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
              {showInvestmentDate ? '5.' : '4.'} Contatto telefonico
            </label>
            <div class="grid grid-cols-[100px_1fr] gap-3">
              <select name="phone_prefix" class="px-3 py-3 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] bg-white">
                <option value="+39">🇮🇹 +39</option>
                <option value="+41">🇨🇭 +41</option>
                <option value="+44">🇬🇧 +44</option>
                <option value="+33">🇫🇷 +33</option>
                <option value="+49">🇩🇪 +49</option>
                <option value="+34">🇪🇸 +34</option>
              </select>
              <input type="tel" name="phone"
                class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:outline-none focus:border-[var(--aw-color-primary)] focus:ring-1 focus:ring-[var(--aw-color-primary)] transition-colors"/>
            </div>
          </div>

          {formMode === 'business' && (
            <>
              <!-- Ruolo in azienda -->
              <div>
                <label for="svc-role" class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
