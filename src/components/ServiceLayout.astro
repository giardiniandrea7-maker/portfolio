          </div>

          <!-- Cognome -->
          <div>
            <label for="svc-surname" class="block text-sm font-semibold text-[var(--aw-color-text-heading)] mb-2">
              2. Cognome <span class="text-[rgb(160_50_50)]">*</span>
            </label>
            <input type="text" id="svc-surname" name="surname" required
