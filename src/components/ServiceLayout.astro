---
// ========================================================
// SERVICE LAYOUT — Componente riutilizzabile per pagine servizio
// Struttura replicata da davideberti.it/servizi/[slug]
// Sezioni:
//   1. Hero (split: video + testo + CTA)
//   2. Box "Guarda esempio" (PDF)
//   3. Più nel dettaglio (testo + liste)
//   4. Risolvi i tuoi dubbi (split: testo + video FAQ)
//   5. Banner + Come ricevere + Form richiesta
// ========================================================

export interface Props {
  // HERO
  heroTitle: string;
  heroParagraphs?: string[];
  heroCtaText?: string;
  heroCtaHref?: string;
  heroVideoLabel?: string;

  // ESEMPIO PDF
  showExample?: boolean;
  exampleLabel?: string;
  exampleNote?: string;
  examplePdfHref?: string;

  // PIU' NEL DETTAGLIO
  detailTitle?: string;
  detailIntro?: string[];
  advantagesTitle?: string;
  advantages?: string[];
  analysisTitle?: string;
  analysisItems?: string[];
  detailOutro?: string[];

  // FAQ
  faqTitle?: string;
  faqParagraphs?: string[];
  faqVideoLabel?: string;

  // BANNER
  bannerTitle?: string;
  bannerSubtitle?: string;

  // COME RICEVERE
  receiveTitle?: string;
  receiveParagraphs?: string[];
  receiveCtaText?: string;

  // FORM
  showForm?: boolean;
  formTitle?: string;
  formSubtitle?: string[];
  showFileUpload?: boolean;
  showInvestmentDate?: boolean;

  // ==== EXTRA SECTIONS (Pianificazione style) ====

  // Sezione "Non pianificare significa rischiare" con illustrazione LEGO
  showRiskSection?: boolean;
  riskTitle?: string;
  riskParagraphs?: string[];
  riskBlocks?: string[]; // 4 etichette per i blocchi LEGO (es. ['Risk Management', 'Acquisto Casa', 'Obiettivi di Vita', 'Pensione'])

  // Sezione 5 step con icone grandi
  showStepsSection?: boolean;
  stepsSectionTitle?: string;
  stepsItems?: Array<{ number: string; title: string; icon?: string }>;

  // ==== EXTRA SECTIONS (Previdenza style) ====

  // Sezione "La pensione deve essere un traguardo" con curva SVG
  showPensionSection?: boolean;
  pensionTitle?: string;
  pensionParagraphs?: string[];

  // Banner inline "Puoi simulare" con link testuale
  showSimulatorBanner?: boolean;
  simulatorTitle?: string;
  simulatorLinkText?: string;
  simulatorLinkHref?: string;
  simulatorSuffix?: string;

  // Sezione "Ma quali soluzioni per te?" con slogan retorico
  showSolutionsSection?: boolean;
  solutionsTitle?: string;
  solutionsParagraphs?: string[];
  solutionsLinkText?: string;
  solutionsLinkHref?: string;
  solutionsSlogan?: string;

  // Flag per nascondere sezioni esistenti
  showBanner?: boolean;  // il banner sage "Ottienila online..."
  showReceive?: boolean; // sezione "Come ricevere" con Excel mockup

  // ==== EXTRA SECTIONS (Rolling style) ====

  // Sezione "Liberati dalle proposte..." con 3 card problemi laterali
  showProblemsSection?: boolean;
  problemsTitle?: string;
  problemsParagraphs?: string[];
  problemsCards?: Array<{ icon?: string; title: string; description: string }>;

  // Sezione "Liquidità remunerata" con timeline 12 mesi
  showTimelineSection?: boolean;
  timelineTitle?: string;
  timelineParagraphs?: string[];

  // Sezione "I vantaggi" 2 colonne
  showBenefitsSection?: boolean;
  benefitsTitle?: string;
  benefitsItems?: string[];

  // Form mode: 'standard' o 'business' (form esteso aziendale)
  formMode?: 'standard' | 'business';

  // Versione semplice di "Come richiedere" (solo testo, niente mockup Excel)
  showSimpleReceive?: boolean;
  simpleReceiveTitle?: string;
  simpleReceiveParagraphs?: string[];

  // Flag per nascondere sezioni standard (utile per landing ibride)
  showHero?: boolean;
  showDetail?: boolean;
}

const {
  heroTitle,
  heroParagraphs = [],
  heroCtaText = 'Richiedila Ora!',
  heroCtaHref = '#come-ricevere',
  heroVideoLabel = 'Video di presentazione',

  showExample = true,
  exampleLabel = 'Guarda un esempio',
  exampleNote = '',
  examplePdfHref = '#',

  detailTitle = 'Più nel dettaglio',
  detailIntro = [],
  advantagesTitle = 'I vantaggi:',
  advantages = [],
  analysisTitle = '',
  analysisItems = [],
  detailOutro = [],

  faqTitle = 'Risolvi i tuoi dubbi',
  faqParagraphs = [],
  faqVideoLabel = 'Domande frequenti',

  bannerTitle = '',
  bannerSubtitle = '',

  receiveTitle = 'Come ricevere il servizio',
  receiveParagraphs = [],
  receiveCtaText = 'Istruzioni per la compilazione della richiesta',

  showForm = true,
  formTitle = 'Modulo di richiesta',
  formSubtitle = [],
  showFileUpload = true,
  showInvestmentDate = false,

  // Sezioni extra (default: disattivate)
  showRiskSection = false,
  riskTitle = '',
  riskParagraphs = [],
  riskBlocks = [],

  showStepsSection = false,
  stepsSectionTitle = '',
  stepsItems = [],

  // Previdenza-style sections
  showPensionSection = false,
  pensionTitle = '',
  pensionParagraphs = [],

  showSimulatorBanner = false,
  simulatorTitle = '',
  simulatorLinkText = '',
  simulatorLinkHref = '#',
  simulatorSuffix = '',

  showSolutionsSection = false,
  solutionsTitle = '',
  solutionsParagraphs = [],
  solutionsLinkText = '',
  solutionsLinkHref = '#',
  solutionsSlogan = '',

  // Flag per nascondere sezioni esistenti (default: visibili)
  showBanner = true,
  showReceive = true,

  // Rolling-style sections
  showProblemsSection = false,
  problemsTitle = '',
  problemsParagraphs = [],
  problemsCards = [],

  showTimelineSection = false,
  timelineTitle = '',
  timelineParagraphs = [],

  showBenefitsSection = false,
  benefitsTitle = 'I vantaggi',
  benefitsItems = [],

  formMode = 'standard',

  showSimpleReceive = false,
  simpleReceiveTitle = 'Come richiedere il servizio',
  simpleReceiveParagraphs = [],

  showHero = true,
  showDetail = true,
} = Astro.props;
---

<!-- ======================================================
     1. HERO — video sx + testo dx
     ====================================================== -->
{showHero && (
<section class="reveal bg-[rgb(238_247_246)] py-12 md:py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">

      <!-- Video placeholder sx -->
      <div class="relative aspect-video bg-gradient-to-br from-[rgb(22_105_99)] to-[rgb(14_74_69)] rounded-md overflow-hidden shadow-xl group cursor-pointer">
        <!-- Overlay titolo video -->
        <div class="absolute top-4 left-4 right-4 flex items-start gap-3 z-10">
          <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4"/>
              <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
            </svg>
          </div>
          <div class="text-white">
            <p class="text-sm font-bold font-heading leading-tight">{heroVideoLabel}</p>
            <p class="text-xs opacity-75">Andrea Giardini | Consulente Finanziario</p>
          </div>
        </div>

        <!-- Play icon centrato -->
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-red-600 flex items-center justify-center shadow-2xl group-hover:scale-105 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="white">
              <polygon points="6 4 20 12 6 20 6 4"/>
            </svg>
          </div>
        </div>

        <!-- Bottom bar "Guarda su YouTube" -->
        <div class="absolute bottom-4 right-4 bg-black/80 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1.5">
          <span class="opacity-80">Guarda su</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#FF0000">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>YouTube</span>
        </div>

        <!-- Watermark "Video" -->
        <div class="absolute inset-0 flex items-end justify-start p-4 pointer-events-none">
          <span class="text-[10px] tracking-[0.3em] uppercase text-white/50">Video placeholder</span>
        </div>
      </div>

      <!-- Testo dx -->
      <div>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[var(--aw-color-text-heading)] mb-8 leading-[1.1] font-heading">
          {heroTitle}
        </h1>

        <div class="space-y-5 text-base md:text-lg text-[var(--aw-color-text-default)] leading-relaxed mb-10">
          {heroParagraphs.map((p) => (
            <p set:html={p} />
          ))}
        </div>

        <a
          href={heroCtaHref}
          class="block w-full text-center px-8 py-5 md:py-6 bg-[var(--aw-color-primary)] hover:bg-[var(--aw-color-secondary)] text-white text-xl md:text-2xl font-bold rounded-sm transition-all hover:shadow-xl hover:-translate-y-0.5 font-heading"
        >
          {heroCtaText}
        </a>
      </div>

    </div>
  </div>
</section>
)}

<!-- ======================================================
     2. GUARDA UN ESEMPIO (PDF)
     ====================================================== -->
{showExample && (
  <section class="reveal bg-[rgb(238_247_246)] py-10 md:py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <a
        href={examplePdfHref}
        target="_blank"
        rel="noopener"
        class="block bg-white rounded-md shadow-md hover:shadow-xl transition-all p-8 md:p-10 text-center group cursor-pointer"
      >
        <div class="flex items-center justify-center gap-5 flex-wrap">
          <!-- Icona PDF -->
          <div class="relative w-16 h-20 bg-[var(--aw-color-primary)] rounded-sm flex flex-col items-center justify-center group-hover:scale-105 transition-transform shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-1">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <span class="text-[10px] font-bold text-white tracking-wider">PDF</span>
          </div>
          <!-- Label -->
          <span class="text-xl md:text-2xl font-bold text-[var(--aw-color-text-heading)] font-heading">
            {exampleLabel}*
          </span>
        </div>

        <!-- Badge "in arrivo" -->
        <div class="mt-4">
          <span class="inline-block px-3 py-1 bg-[var(--aw-color-accent)]/20 text-[var(--aw-color-primary)] text-[10px] font-bold tracking-[0.2em] uppercase rounded-sm">
            PDF di esempio in arrivo
          </span>
        </div>
      </a>

      {exampleNote && (
        <p class="text-center text-xs md:text-sm text-[var(--aw-color-text-muted)] italic mt-6 max-w-2xl mx-auto leading-relaxed" set:html={`*${exampleNote}`} />
      )}

    </div>
  </section>
)}

<!-- ======================================================
     EXTRA 1. SEZIONE RISK / LEGO (Pianificazione)
     ====================================================== -->
{showRiskSection && (
  <section class="reveal bg-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">

        <!-- Testo sx -->
        <div>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--aw-color-text-heading)] mb-8 leading-tight font-heading">
            {riskTitle}
          </h2>
          <div class="space-y-5 text-base md:text-lg text-[var(--aw-color-text-default)] leading-relaxed">
            {riskParagraphs.map((p) => (
              <p set:html={p} />
            ))}
          </div>
        </div>

        <!-- Illustrazione LEGO dx -->
        <div class="relative">
          <svg viewBox="0 0 480 420" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- Filtro per un lieve shadow -->
              <filter id="lego-shadow" x="-10%" y="-10%" width="120%" height="120%">
                <feDropShadow dx="0" dy="2" stdDeviation="2" flood-opacity="0.08"/>
              </filter>
            </defs>

            <g stroke="var(--aw-color-text-heading)" stroke-width="2" fill="none" stroke-linejoin="round" filter="url(#lego-shadow)">

              <!-- BLOCCO 1: Risk Management (in alto-sinistra) -->
              <g>
                <!-- bottoni -->
                {[0,1,2,3].map((i) => (
                  <g>
                    <ellipse cx={50 + i*30} cy="30" rx="14" ry="6" fill="white"/>
                    <line x1={50 + i*30 - 14} y1="30" x2={50 + i*30 - 14} y2="40"/>
                    <line x1={50 + i*30 + 14} y1="30" x2={50 + i*30 + 14} y2="40"/>
                    <ellipse cx={50 + i*30} cy="40" rx="14" ry="6" fill="white"/>
                  </g>
                ))}
                <!-- corpo blocco -->
                <path d="M 35 45 L 35 130 L 185 130 L 185 45" fill="white"/>
                <!-- dettaglio frontale 3D -->
                <path d="M 35 45 L 45 55 L 45 140 L 35 130" fill="#F5F1E8" fill-opacity="0.6"/>
                <path d="M 185 45 L 195 55 L 195 140 L 185 130" fill="#F5F1E8" fill-opacity="0.4"/>
                <path d="M 45 55 L 195 55" />
              </g>

              <!-- Icona scudo in Risk Management -->
              <g transform="translate(62, 70)" stroke-width="1.8">
                <path d="M 20 0 L 0 8 L 0 24 C 0 34 8 42 20 46 C 32 42 40 34 40 24 L 40 8 Z" fill="none"/>
                <path d="M 14 22 L 18 26 L 26 16" stroke-linecap="round"/>
              </g>

              <!-- Testo Risk Management -->
              <text x="110" y="82" text-anchor="middle" font-family="Manrope, sans-serif" font-size="12" font-weight="700" fill="var(--aw-color-text-heading)" stroke="none">Risk</text>
              <text x="110" y="98" text-anchor="middle" font-family="Manrope, sans-serif" font-size="12" font-weight="700" fill="var(--aw-color-text-heading)" stroke="none">Management</text>

              <!-- BLOCCO 2: Acquisto Casa (in alto-destra) -->
              <g>
                {[0,1,2,3].map((i) => (
                  <g>
                    <ellipse cx={270 + i*30} cy="30" rx="14" ry="6" fill="white"/>
                    <line x1={270 + i*30 - 14} y1="30" x2={270 + i*30 - 14} y2="40"/>
                    <line x1={270 + i*30 + 14} y1="30" x2={270 + i*30 + 14} y2="40"/>
                    <ellipse cx={270 + i*30} cy="40" rx="14" ry="6" fill="white"/>
                  </g>
                ))}
                <path d="M 255 45 L 255 130 L 405 130 L 405 45" fill="white"/>
                <path d="M 255 45 L 265 55 L 265 140 L 255 130" fill="#F5F1E8" fill-opacity="0.6"/>
                <path d="M 405 45 L 415 55 L 415 140 L 405 130" fill="#F5F1E8" fill-opacity="0.4"/>
                <path d="M 265 55 L 415 55" />
              </g>

              <!-- Icona casa -->
              <g transform="translate(290, 70)" stroke-width="1.8">
                <path d="M 0 20 L 20 2 L 40 20 L 40 40 L 0 40 Z" fill="none"/>
                <path d="M 15 40 L 15 28 L 25 28 L 25 40"/>
              </g>

              <text x="330" y="82" text-anchor="middle" font-family="Manrope, sans-serif" font-size="12" font-weight="700" fill="var(--aw-color-text-heading)" stroke="none">Acquisto</text>
              <text x="330" y="98" text-anchor="middle" font-family="Manrope, sans-serif" font-size="12" font-weight="700" fill="var(--aw-color-text-heading)" stroke="none">Casa</text>

              <!-- BLOCCO 3: Obiettivi di Vita (in basso-sinistra) -->
              <g>
                {[0,1,2,3].map((i) => (
                  <g>
                    <ellipse cx={50 + i*30} cy="175" rx="14" ry="6" fill="white"/>
                    <line x1={50 + i*30 - 14} y1="175" x2={50 + i*30 - 14} y2="185"/>
                    <line x1={50 + i*30 + 14} y1="175" x2={50 + i*30 + 14} y2="185"/>
                    <ellipse cx={50 + i*30} cy="185" rx="14" ry="6" fill="white"/>
                  </g>
                ))}
                <path d="M 35 190 L 35 275 L 185 275 L 185 190" fill="white"/>
                <path d="M 35 190 L 45 200 L 45 285 L 35 275" fill="#F5F1E8" fill-opacity="0.6"/>
                <path d="M 185 190 L 195 200 L 195 285 L 185 275" fill="#F5F1E8" fill-opacity="0.4"/>
                <path d="M 45 200 L 195 200" />
              </g>

              <!-- Icona cappello laurea -->
              <g transform="translate(75, 217)" stroke-width="1.8">
                <path d="M 20 0 L 0 8 L 20 16 L 40 8 Z" fill="none"/>
                <path d="M 5 10 L 5 24 C 5 30 15 32 20 32 C 25 32 35 30 35 24 L 35 10"/>
                <line x1="40" y1="8" x2="40" y2="20" stroke-linecap="round"/>
              </g>

              <text x="110" y="232" text-anchor="middle" font-family="Manrope, sans-serif" font-size="12" font-weight="700" fill="var(--aw-color-text-heading)" stroke="none">Obiettivi</text>
              <text x="110" y="248" text-anchor="middle" font-family="Manrope, sans-serif" font-size="12" font-weight="700" fill="var(--aw-color-text-heading)" stroke="none">di Vita</text>

              <!-- BLOCCO 4: Pensione (in basso-destra) -->
              <g>
                {[0,1,2,3].map((i) => (
                  <g>
                    <ellipse cx={270 + i*30} cy="175" rx="14" ry="6" fill="white"/>
                    <line x1={270 + i*30 - 14} y1="175" x2={270 + i*30 - 14} y2="185"/>
                    <line x1={270 + i*30 + 14} y1="175" x2={270 + i*30 + 14} y2="185"/>
                    <ellipse cx={270 + i*30} cy="185" rx="14" ry="6" fill="white"/>
                  </g>
                ))}
                <path d="M 255 190 L 255 275 L 405 275 L 405 190" fill="white"/>
                <path d="M 255 190 L 265 200 L 265 285 L 255 275" fill="#F5F1E8" fill-opacity="0.6"/>
                <path d="M 405 190 L 415 200 L 415 285 L 405 275" fill="#F5F1E8" fill-opacity="0.4"/>
                <path d="M 265 200 L 415 200" />
              </g>

              <!-- Icona sacco soldi -->
              <g transform="translate(295, 215)" stroke-width="1.8">
                <path d="M 10 8 C 10 4 14 0 20 0 C 26 0 30 4 30 8 L 34 12 C 38 18 40 26 40 32 C 40 38 32 40 20 40 C 8 40 0 38 0 32 C 0 26 2 18 6 12 Z" fill="none"/>
                <text x="20" y="28" text-anchor="middle" font-size="14" font-weight="700" fill="var(--aw-color-text-heading)" stroke="none">€</text>
              </g>

              <text x="330" y="232" text-anchor="middle" font-family="Manrope, sans-serif" font-size="14" font-weight="700" fill="var(--aw-color-text-heading)" stroke="none">Pensione</text>

            </g>
          </svg>
        </div>

      </div>
    </div>
  </section>
)}

<!-- ======================================================
     EXTRA 2. SEZIONE 5 STEP CON ICONE (Pianificazione)
     ====================================================== -->
{showStepsSection && (
  <section class="reveal bg-[rgb(238_247_246)] py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      {stepsSectionTitle && (
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[var(--aw-color-text-heading)] text-center mb-14 leading-tight font-heading">
          {stepsSectionTitle}
        </h2>
      )}

      <div class="grid grid-cols-2 md:grid-cols-5 gap-8 md:gap-4">
        {stepsItems.map((step) => (
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <!-- Icona dinamica in base a step.icon -->
              {step.icon === 'target' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-text-heading)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <circle cx="12" cy="12" r="6"/>
                  <circle cx="12" cy="12" r="2" fill="var(--aw-color-text-heading)"/>
                </svg>
              )}
              {step.icon === 'books' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-text-heading)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                  <line x1="8" y1="6" x2="16" y2="6"/>
                  <line x1="8" y1="10" x2="14" y2="10"/>
                </svg>
              )}
              {step.icon === 'shield' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-text-heading)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              )}
              {step.icon === 'chart' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-text-heading)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 17 9 11 13 15 21 7"/>
                  <polyline points="14 7 21 7 21 14"/>
                </svg>
              )}
              {step.icon === 'search' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="var(--aw-color-text-heading)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7"/>
                  <line x1="21" y1="21" x2="16.5" y2="16.5"/>
                </svg>
              )}
            </div>
            <h3 class="text-base md:text-lg font-bold text-[var(--aw-color-text-heading)] font-heading leading-tight">
              <span class="text-[var(--aw-color-primary)]">{step.number}.</span> {step.title}
            </h3>
          </div>
        ))}
      </div>

    </div>
  </section>
)}

<!-- ======================================================
     EXTRA 3. SEZIONE "La pensione deve essere un traguardo" (Previdenza)
     Split: testo sx + curva SVG dx
     ====================================================== -->
{showPensionSection && (
  <section class="reveal bg-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">

        <!-- Testo sx -->
